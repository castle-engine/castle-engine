#X3D V4.0 utf8
PROFILE Interchange

# Objects lit by the projector light (in another scene, data/projector_light.x3dv).

# The light's effect needs the world position of the lit point.
# This Effect (without any code) enables the "EyeWorldSpace" shader library
# (castle_CameraInverseMatrix uniform) for all shapes in this scene.
Effect {
  language "GLSL"
  shaderLibraries "castle-shader:/EyeWorldSpace.glsl"
}

# The shapes use Phong shading (shading "PHONG"):
# light effects that use castle_vertex_eye need it.

# A dim light without effects, so that the unlit parts are not black.
DirectionalLight {
  direction -0.3 -1 -0.4
  intensity 0.25
}

Transform {
  translation 0 -0.1 0
  children Shape {
    shading "PHONG"
    appearance Appearance { material DEF ObjectMaterial Material { diffuseColor 0.9 0.9 0.85 } }
    geometry Box { size 16 0.2 16 }
  }
}

Transform {
  translation -2.5 0.75 1
  children Shape {
    shading "PHONG"
    appearance Appearance { material USE ObjectMaterial }
    geometry Box { size 1.5 1.5 1.5 }
  }
}

Transform {
  translation 2.5 1 -1
  children Shape {
    shading "PHONG"
    appearance Appearance { material USE ObjectMaterial }
    geometry Sphere { radius 1 }
  }
}

Transform {
  translation 0 1.25 -3
  children Shape {
    shading "PHONG"
    appearance Appearance { material USE ObjectMaterial }
    geometry Cylinder { radius 0.5 height 2.5 }
  }
}
