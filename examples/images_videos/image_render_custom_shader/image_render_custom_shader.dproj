                <DeployFile LocalName="image_render_custom_shader" Configuration="Release" Class="ProjectOutput">
                    <Platform Name="Linux64">
                        <RemoteName>image_render_custom_shader</RemoteName>
                        <Overwrite>true</Overwrite>
                    </Platform>
                </DeployFile>

