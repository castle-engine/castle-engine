{ Test CastleInternalOpenTypeFont and CastleInternalGlyphRasterizer units
  (pure Pascal font reading and rendering, used when CASTLE_FREETYPE_PASCAL
  is defined). }
unit TestCastleInternalOpenTypeFont;

{$I ../../../src/common_includes/castleconf.inc}

interface

uses Classes, SysUtils,
  CastleTester, CastleInternalOpenTypeFont;

type
  TTestCastleInternalOpenTypeFont = class(TCastleTestCase)
  strict private
    { Check glyph for character C.
      Expected values were calculated by a reference implementation
      of the same algorithm. }
    procedure CheckGlyph(const Font: TOpenTypeFont; const C: Char;
      const ExpectedGlyph, ExpectedAdvance, ExpectedCommands: Integer;
      const PixelSize: Integer; const Mono: Boolean;
      const ExpectedWidth, ExpectedHeight, ExpectedLeft, ExpectedTop,
      ExpectedPitch, ExpectedSum: Integer);
    { Font data truncated or corrupted may cause only EOpenTypeFontError
      or EReadError. }
    procedure CheckRobustness(const Url: String);
  published
    { Test font with TrueType outlines. }
    procedure TestTrueType;
    { Test real-world font with CFF outlines (Type 2 charstrings). }
    procedure TestCff;
    { Test font with CFF outlines generated by castle_test_cff_generate.py,
      that uses many Type 2 charstring operators. }
    procedure TestCffGenerated;
    procedure TestInvalid;
    procedure TestRobustness;
  end;

implementation

uses CastleDownload, CastleInternalGlyphRasterizer;

procedure TTestCastleInternalOpenTypeFont.CheckGlyph(const Font: TOpenTypeFont;
  const C: Char; const ExpectedGlyph, ExpectedAdvance, ExpectedCommands: Integer;
  const PixelSize: Integer; const Mono: Boolean;
  const ExpectedWidth, ExpectedHeight, ExpectedLeft, ExpectedTop,
  ExpectedPitch, ExpectedSum: Integer);

  function CountBits(B: Byte): Integer;
  begin
    Result := 0;
    while B <> 0 do
    begin
      Result := Result + (B and 1);
      B := B shr 1;
    end;
  end;

var
  Glyph, I, Sum: Integer;
  Outline: TGlyphOutline;
  Rasterized: TRasterizedGlyph;
begin
  Glyph := Font.GlyphIndex(Ord(C));
  AssertEquals(ExpectedGlyph, Glyph);
  AssertEquals(ExpectedAdvance, Font.AdvanceWidth(Glyph));

  Outline := TGlyphOutline.Create;
  try
    Font.GetGlyphOutline(Glyph, Outline);
    AssertEquals(ExpectedCommands, Outline.Count);

    RasterizeGlyph(Outline, PixelSize / Font.UnitsPerEm, 0, 0, Mono, Rasterized);
    AssertEquals(ExpectedWidth, Rasterized.Width);
    AssertEquals(ExpectedHeight, Rasterized.Height);
    AssertEquals(ExpectedLeft, Rasterized.Left);
    AssertEquals(ExpectedTop, Rasterized.Top);
    AssertEquals(ExpectedPitch, Rasterized.Pitch);
    AssertEquals(Mono, Rasterized.Mono);
    AssertEquals(Int64(ExpectedPitch * ExpectedHeight), Int64(Length(Rasterized.Data)));

    Sum := 0;
    for I := 0 to Length(Rasterized.Data) - 1 do
      if Mono then
        Sum := Sum + CountBits(Rasterized.Data[I])
      else
        Sum := Sum + Rasterized.Data[I];
    { Allow small differences, as floating-point calculations may differ
      a bit between compilers and platforms. }
    AssertTrue(Format('Glyph "%s" pixels sum %d, expected %d', [C, Sum, ExpectedSum]),
      Abs(Sum - ExpectedSum) <= ExpectedSum div 50 + 2);
  finally FreeAndNil(Outline) end;
end;

procedure TTestCastleInternalOpenTypeFont.TestTrueType;
var
  Font: TOpenTypeFont;
begin
  { TOpenTypeFont owns the stream }
  Font := TOpenTypeFont.Create(
    Download('castle-data:/fonts/PARPG.ttf', [soForceMemoryStream]) as TCustomMemoryStream);
  try
    AssertEquals(1, Font.NumFaces);
    AssertEquals(176, Font.NumGlyphs);
    AssertEquals(1024, Font.UnitsPerEm);
    AssertEquals('Fixed', String(Font.FamilyName));
    AssertEquals('Regular', String(Font.StyleName));
    AssertFalse(Font.Bold);
    AssertFalse(Font.Italic);
    AssertFalse(Font.HasKerning);
    AssertEquals(1224, Font.Ascender);
    AssertEquals(-107, Font.Descender);
    AssertEquals(92, Font.LineGap);

    CheckGlyph(Font, 'A', 33, 734, 91, 32, false, 21, 27, 6, 31, 21, 40758);
    CheckGlyph(Font, 'A', 33, 734, 91, 32, true, 19, 26, 7, 31, 4, 166);
    CheckGlyph(Font, 'g', 71, 734, 149, 32, false, 20, 26, 7, 24, 20, 45171);
    CheckGlyph(Font, 'g', 71, 734, 149, 32, true, 20, 25, 7, 24, 4, 176);
    { space is not mapped in this font, so it gives glyph 0 (empty) }
    CheckGlyph(Font, ' ', 0, 734, 0, 32, false, 0, 0, 0, 0, 0, 0);
  finally FreeAndNil(Font) end;
end;

procedure TTestCastleInternalOpenTypeFont.TestCff;
var
  Font: TOpenTypeFont;
begin
  { TOpenTypeFont owns the stream }
  Font := TOpenTypeFont.Create(
    Download('castle-data:/fonts/Urbanist-Regular.otf', [soForceMemoryStream]) as TCustomMemoryStream);
  try
    AssertEquals(1, Font.NumFaces);
    AssertEquals(535, Font.NumGlyphs);
    AssertEquals(2000, Font.UnitsPerEm);
    AssertEquals('Urbanist', String(Font.FamilyName));
    AssertEquals('Regular', String(Font.StyleName));
    AssertFalse(Font.Bold);
    AssertFalse(Font.Italic);
    AssertFalse(Font.HasKerning);
    AssertEquals(1900, Font.Ascender);
    AssertEquals(-500, Font.Descender);
    AssertEquals(0, Font.LineGap);

    CheckGlyph(Font, 'A', 1, 1353, 11, 32, false, 20, 23, 1, 23, 20, 32364);
    CheckGlyph(Font, 'A', 1, 1353, 11, 32, true, 19, 22, 1, 22, 4, 123);
    CheckGlyph(Font, 'g', 223, 1175, 18, 32, false, 17, 25, 0, 17, 17, 40527);
    CheckGlyph(Font, 'g', 223, 1175, 18, 32, true, 16, 24, 1, 16, 2, 159);
    CheckGlyph(Font, ' ', 400, 480, 0, 32, false, 0, 0, 0, 0, 0, 0);
  finally FreeAndNil(Font) end;
end;

