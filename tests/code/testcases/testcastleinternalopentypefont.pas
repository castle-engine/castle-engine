begin
  { TOpenTypeFont owns the stream }
  Font := TOpenTypeFont.Create(
    Download('castle-data:/fonts/castle_test_cff.otf', [soForceMemoryStream]) as TCustomMemoryStream);
  try
    AssertEquals(1, Font.NumFaces);
    AssertEquals(11, Font.NumGlyphs);
    AssertEquals(1000, Font.UnitsPerEm);
    AssertEquals('Castle Test CFF', String(Font.FamilyName));
    AssertEquals('Regular', String(Font.StyleName));
    AssertFalse(Font.Bold);
    AssertFalse(Font.Italic);
    AssertFalse(Font.HasKerning);
    AssertEquals(800, Font.Ascender);
    AssertEquals(-200, Font.Descender);
    AssertEquals(0, Font.LineGap);

    { See castle_test_cff_generate.py for what each glyph tests. }
    CheckGlyph(Font, ' ', 1, 250, 0, 32, false, 0, 0, 0, 0, 0, 0);
    CheckGlyph(Font, 'A', 2, 650, 13, 32, false, 27, 20, 1, 21, 27, 46989);
    CheckGlyph(Font, 'A', 2, 650, 13, 32, true, 26, 19, 2, 21, 4, 192);
    CheckGlyph(Font, 'B', 3, 500, 8, 32, false, 13, 15, -1, 15, 13, 33160);
    CheckGlyph(Font, 'B', 3, 500, 8, 32, true, 11, 14, 0, 14, 2, 129);
    CheckGlyph(Font, 'C', 4, 700, 8, 32, false, 22, 22, -2, 22, 22, 52830);
    CheckGlyph(Font, 'C', 4, 700, 8, 32, true, 21, 22, -2, 22, 4, 207);
    CheckGlyph(Font, 'D', 5, 500, 8, 32, false, 14, 18, 1, 18, 14, 41261);
    CheckGlyph(Font, 'D', 5, 500, 8, 32, true, 12, 18, 2, 18, 2, 160);
    CheckGlyph(Font, 'E', 6, 800, 15, 32, false, 22, 16, 1, 17, 22, 9226);
    CheckGlyph(Font, 'E', 6, 800, 15, 32, true, 20, 15, 2, 16, 4, 50);
    CheckGlyph(Font, 'F', 7, 500, 4, 32, false, 7, 7, 3, 10, 7, 10409);
    CheckGlyph(Font, 'F', 7, 500, 4, 32, true, 7, 7, 3, 10, 2, 49);
    CheckGlyph(Font, 'G', 8, 550, 9, 32, false, 10, 20, 3, 20, 10, 47295);
    CheckGlyph(Font, 'G', 8, 550, 9, 32, true, 10, 19, 3, 19, 2, 190);
    CheckGlyph(Font, 'H', 9, 500, 5, 32, false, 11, 20, 1, 20, 11, 47226);
    CheckGlyph(Font, 'H', 9, 500, 5, 32, true, 9, 19, 2, 20, 2, 171);
    CheckGlyph(Font, 'I', 10, 500, 7, 32, false, 10, 14, 3, 15, 10, 31348);
    CheckGlyph(Font, 'I', 10, 500, 7, 32, true, 10, 12, 3, 14, 2, 120);
  finally FreeAndNil(Font) end;
end;

procedure TTestCastleInternalOpenTypeFont.TestInvalid;

  { Assert that font data in Stream is invalid.
    Stream becomes owned by this routine (like by TOpenTypeFont.Create). }
  procedure AssertInvalid(const Stream: TCustomMemoryStream);
  var
    Font: TOpenTypeFont;
  begin
    try
      Font := TOpenTypeFont.Create(Stream);
      FreeAndNil(Font);
      Fail('Invalid font data should raise EOpenTypeFontError or EReadError');
    except
      on EOpenTypeFontError do ; // expected for invalid data
      on EReadError do ; // expected for truncated data
    end;
  end;

  function GarbageStream(const Size: Integer): TMemoryStream;
  var
    I: Integer;
    B: Byte;
  begin
    Result := TMemoryStream.Create;
    for I := 0 to Size - 1 do
    begin
      B := I;
      Result.WriteBuffer(B, 1);
    end;
  end;

var
  Data: TStream;
  Truncated: TMemoryStream;
begin
  AssertInvalid(GarbageStream(100));
  AssertInvalid(GarbageStream(4)); // too small

  Data := Download('castle-data:/fonts/PARPG.ttf', [soForceMemoryStream]);
  try
    Truncated := TMemoryStream.Create;
    Truncated.CopyFrom(Data, 200);
  finally FreeAndNil(Data) end;
  AssertInvalid(Truncated);
end;

procedure TTestCastleInternalOpenTypeFont.CheckRobustness(const Url: String);
const
  TestChars = 'AgQ@';
var
  Original: TStream;
  Corrupted: TMemoryStream;
  Font: TOpenTypeFont;
  Outline: TGlyphOutline;
  Rasterized: TRasterizedGlyph;
  Iteration, I, Size: Integer;
  Bytes: PByte;
begin
  RandSeed := 12345;
  Original := Download(Url, [soForceMemoryStream]);
  Outline := TGlyphOutline.Create;
  try
    for Iteration := 0 to 199 do
    begin
      { make truncated or corrupted copy of the font }
      Corrupted := TMemoryStream.Create;
      Corrupted.CopyFrom(Original, 0);
      if Iteration < 50 then
      begin
        Size := 12 + Random(Integer(Original.Size) - 12);
        Corrupted.Size := Size;
      end else
      begin
        Size := Integer(Original.Size);
        Bytes := PByte(Corrupted.Memory);
        for I := 0 to Random(40) do
          Bytes[Random(Size)] := Random(256);
      end;

      try
        { TOpenTypeFont owns Corrupted (also when constructor fails) }
        Font := TOpenTypeFont.Create(Corrupted);
        try
          for I := 1 to Length(TestChars) do
          begin
            Font.GetGlyphOutline(Font.GlyphIndex(Ord(TestChars[I])), Outline);
            RasterizeGlyph(Outline, 32 / Font.UnitsPerEm, 0, 0, false, Rasterized);
            RasterizeGlyph(Outline, 32 / Font.UnitsPerEm, 0, 0, true, Rasterized);
          end;
        finally FreeAndNil(Font) end;
      except
        on EOpenTypeFontError do ; // expected for invalid data
        on EReadError do ; // expected for truncated data
      end;
    end;
  finally
    FreeAndNil(Outline);
    FreeAndNil(Original);
  end;
end;

procedure TTestCastleInternalOpenTypeFont.TestRobustness;
begin
  CheckRobustness('castle-data:/fonts/PARPG.ttf');
  CheckRobustness('castle-data:/fonts/Urbanist-Regular.otf');
  CheckRobustness('castle-data:/fonts/castle_test_cff.otf');
end;

initialization
  RegisterTest(TTestCastleInternalOpenTypeFont);
end.
