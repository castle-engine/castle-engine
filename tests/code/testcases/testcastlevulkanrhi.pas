    Mat.SpecularColor := Vector3(1.0, 1.0, 1.0);
    Mat.EmissiveColor := Vector3(0.1, 0.1, 0.1);
    Mat.Transparency := 0.25;
    App.Material := Mat;
    ShapeNode.Appearance := App;

    IFS := TIndexedFaceSetNode.Create;
    Coord := TCoordinateNode.Create;
    Coord.SetPoint([
      Vector3(-1, -1, 0),
