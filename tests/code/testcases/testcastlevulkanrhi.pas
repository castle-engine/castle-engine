procedure TTestCastleVulkanRHI.TestViewportSubRectScreenEffectsAndOuterPassRHI;
var
  Device: TVulkanRHIDevice;
  Cmd: TVulkanRHICommandList;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedCtx: TRenderContext;
  SavedBackend: TRenderBackend;
  Ctx: TRenderContext;
  OuterColorTex, OuterDepthTex: TRHITexture;
  OuterPassInfo: TRHIRenderingInfo;
  Container: TTestHeadlessVulkanContainer;
  Viewport: TCastleViewport;
  Scene: TCastleScene;
  Root: TX3DRootNode;
  ShapeNode: TShapeNode;
  App: TAppearanceNode;
  Mat: TPhysicalMaterialNode;
  Box: TBoxNode;
  ScFx1, ScFx2: TScreenEffectNode;
  ScShader1, ScShader2: TComposedShaderNode;
  ScPart1, ScPart2: TShaderPartNode;
  OverlayImg: TDrawableImage;
  SrcImg: TRGBAlphaImage;
begin
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedCtx := RenderContext;
  SavedBackend := ApplicationProperties.RenderBackend;
  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($1001)));
  Cmd := nil;
  Ctx := nil;
  OuterColorTex := nil;
  OuterDepthTex := nil;
  Container := nil;
  Viewport := nil;
  Scene := nil;
  OverlayImg := nil;
  SrcImg := nil;
  try
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(Device);
    Ctx := TRenderContext.Create(nil);
    RenderContext := Ctx;

    { Create an outer pass with pfBGRA8_UNorm color and pfD32_Float depth (256x256) }
    OuterColorTex := Device.CreateTexture(TRHITextureDesc.Create2D(256, 256, pfBGRA8_UNorm,
      [tuColorAttachment, tuSampled, tuTransferSrc]));
    OuterDepthTex := Device.CreateTexture(TRHITextureDesc.Create2D(256, 256, pfD32_Float,
      [tuDepthStencil, tuSampled]));

    Root := TX3DRootNode.Create;
    ShapeNode := TShapeNode.Create;
    App := TAppearanceNode.Create;
    Mat := TPhysicalMaterialNode.Create;
    Mat.BaseColor := Vector3(0.2, 0.7, 0.9);
    App.Material := Mat;
    ShapeNode.Appearance := App;
    Box := TBoxNode.Create;
    ShapeNode.Geometry := Box;
    Root.AddChildren(ShapeNode);

    { Add 2 chained TScreenEffectNode passes to exercise ping-pong + outer pass resume }
    ScFx1 := TScreenEffectNode.Create;
    ScShader1 := TComposedShaderNode.Create;
    ScPart1 := TShaderPartNode.Create;
    ScPart1.ShaderType := stFragment;
    ScPart1.Contents :=
      'void main (void) {' + LineEnding +
      '  gl_FragColor = screen_get_color(screen_position());' + LineEnding +
      '}';
    ScShader1.FdParts.Add(ScPart1);
    ScFx1.FdShaders.Add(ScShader1);

    ScFx2 := TScreenEffectNode.Create;
    ScShader2 := TComposedShaderNode.Create;
    ScPart2 := TShaderPartNode.Create;
    ScPart2.ShaderType := stFragment;
    ScPart2.Contents :=
      'void main (void) {' + LineEnding +
      '  gl_FragColor = screen_get_color(screen_position());' + LineEnding +
      '}';
    ScShader2.FdParts.Add(ScPart2);
    ScFx2.FdShaders.Add(ScShader2);

    Scene := TCastleScene.Create(nil);
    Scene.Load(Root, True);

    { Place Viewport at a non-zero sub-rectangle (Left=40, Bottom=30, Width=120, Height=90) }
    Container := TTestHeadlessVulkanContainer.Create(nil);
    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := False;
    Viewport.Translation := Vector2(40, 30);
    Viewport.Width := 120;
    Viewport.Height := 90;
    Viewport.Items.Add(Scene);
    Viewport.AddScreenEffect(ScFx1);
    Viewport.AddScreenEffect(ScFx2);
    Container.Controls.InsertFront(Viewport);
    Viewport.GLContextOpen;
    Viewport.BeforeRender;

    SrcImg := TRGBAlphaImage.Create(16, 16);
    SrcImg.Clear(Vector4Byte(255, 128, 64, 255));
    OverlayImg := TDrawableImage.Create(SrcImg, True, False);

    Cmd := Device.BeginFrame as TVulkanRHICommandList;
    SetActiveCommandList(Cmd);

    OuterPassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 256, 256),
      OuterColorTex, loClear, Vector4(0.1, 0.1, 0.1, 1.0),
      OuterDepthTex, loClear, 1.0);
    Cmd.BeginRendering(OuterPassInfo);

    { 1. Viewport.Render begins rendering to FRHIScreenTextureDest and translates ViewportDelta }
    Viewport.Render;
    AssertEquals('During screen effects offscreen pass, ViewportDelta.X must be -40',
      -40, RenderContext.ViewportDelta.X);
    AssertEquals('During screen effects offscreen pass, ViewportDelta.Y must be -30',
      -30, RenderContext.ViewportDelta.Y);
    AssertEquals('During screen effects offscreen pass, EffectiveViewportRect.Left must be 0',
      0, RenderContext.EffectiveViewportRect.Left);
    AssertEquals('During screen effects offscreen pass, EffectiveViewportRect.Bottom must be 0',
      0, RenderContext.EffectiveViewportRect.Bottom);
    AssertEquals('During screen effects offscreen pass, EffectiveViewportRect.Width must be 120',
      120, RenderContext.EffectiveViewportRect.Width);
    AssertEquals('During screen effects offscreen pass, EffectiveViewportRect.Height must be 90',
      90, RenderContext.EffectiveViewportRect.Height);

    { 2. Viewport.RenderOverChildren ends RTT, resets ViewportDelta, runs 2 screen effect passes,
      and renders the final pass directly into the resumed outer pass at (40, 30, 120, 90) }
    Viewport.RenderOverChildren;

    AssertEquals('After RenderOverChildren, ViewportDelta.X must be reset to 0',
      0, RenderContext.ViewportDelta.X);
    AssertEquals('After RenderOverChildren, ViewportDelta.Y must be reset to 0',
      0, RenderContext.ViewportDelta.Y);
    AssertTrue('Outer render pass must remain active after Viewport.RenderOverChildren',
      Cmd.IsRendering);
    AssertEquals('2 screen effect passes must have executed',
      2, Integer(Viewport.RHIScreenPassCount));
    AssertEquals('2 screen effect fullscreen quad draws must have executed',
      2, Integer(Viewport.RHIScreenDrawCount));
    AssertEquals('Final screen effect pass must set dynamic viewport Left to 40',
      40, Round(Cmd.DynamicViewportRect.Left));
    AssertEquals('Final screen effect pass must set dynamic viewport Bottom to 30',
      30, Round(Cmd.DynamicViewportRect.Bottom));
    AssertEquals('Final screen effect pass must set dynamic viewport Width to 120',
      120, Round(Cmd.DynamicViewportRect.Width));
    AssertEquals('Final screen effect pass must set dynamic viewport Height to 90',
      90, Round(Cmd.DynamicViewportRect.Height));
    AssertEquals('Final screen effect pass pipeline must adapt to outer pass pfBGRA8_UNorm color format',
      Ord(pfBGRA8_UNorm), Ord(Cmd.BoundPipeline.Desc.ColorAttachmentFormats[0]));
    AssertEquals('Final screen effect pass pipeline must adapt to outer pass pfD32_Float depth format',
      Ord(pfD32_Float), Ord(Cmd.BoundPipeline.Desc.DepthAttachmentFormat));

    { 3. Subsequent UI draws in the outer pass continue without losing the pass }
    OverlayImg.Draw(10, 10);
    TDrawableImage.BatchingFlush;
    AssertTrue('Outer render pass remains active after subsequent UI draw', Cmd.IsRendering);

    Cmd.EndRendering;
    Device.EndFrameAndPresent;
  finally
    FreeAndNil(OverlayImg);
    FreeAndNil(SrcImg);
    FreeAndNil(Viewport);
    FreeAndNil(Container);
    FreeAndNil(Scene);
    FreeAndNil(OuterDepthTex);
    FreeAndNil(OuterColorTex);
    RenderContext := SavedCtx;
    FreeAndNil(Ctx);
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(Device);
  end;
end;

procedure TTestCastleVulkanRHI.TestX3DGLSLProgramSetupUniformsTextureFieldsRHI;
var
  Device: TVulkanRHIDevice;
  SavedRHI: TRHIDevice;
  SavedBackend: TRenderBackend;
  Scene: TCastleScene;
  Root: TX3DRootNode;
  ShapeNode: TShapeNode;
  App: TAppearanceNode;
  ShaderNode: TComposedShaderNode;
  FieldSingleTex: TSFNode;
  FieldMultiTex: TMFNode;
  FieldScale: TSFFloat;
  FieldTint: TSFVec3f;
  DeclSingleTex, DeclMultiTex, DeclScale, DeclTint: TX3DInterfaceDeclaration;
  TexNode1, TexNode2, TexNode3: TPixelTextureNode;
  Prog: TX3DGLSLProgram;
  BoundUnits: Cardinal;
  StoredVal: TVector4;
begin
  SavedRHI := RHIDevice;
  SavedBackend := ApplicationProperties.RenderBackend;
  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($1002)));
  Scene := nil;
  Prog := nil;
  try
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(Device);
    AssertTrue('GLFeatures must be nil in pure headless Vulkan RHI mode', GLFeatures = nil);

    TexNode1 := TPixelTextureNode.Create;
    TexNode1.FdImage.Value := TRGBAlphaImage.Create(4, 4);
    TRGBAlphaImage(TexNode1.FdImage.Value).Clear(Vector4Byte(255, 0, 0, 255));

    TexNode2 := TPixelTextureNode.Create;
    TexNode2.FdImage.Value := TRGBAlphaImage.Create(4, 4);
    TRGBAlphaImage(TexNode2.FdImage.Value).Clear(Vector4Byte(0, 255, 0, 255));

    TexNode3 := TPixelTextureNode.Create;
    TexNode3.FdImage.Value := TRGBAlphaImage.Create(4, 4);
    TRGBAlphaImage(TexNode3.FdImage.Value).Clear(Vector4Byte(0, 0, 255, 255));

    ShaderNode := TComposedShaderNode.Create;

    FieldSingleTex := TSFNode.Create(ShaderNode, True, 'myMainTex', [TAbstractTextureNode], TexNode1);
    DeclSingleTex := TX3DInterfaceDeclaration.Create(ShaderNode);
    DeclSingleTex.FieldOrEvent := FieldSingleTex;
    ShaderNode.InterfaceDeclarations.Add(DeclSingleTex);

    FieldMultiTex := TMFNode.Create(ShaderNode, True, 'myLayerTexs', [TAbstractTextureNode]);
    FieldMultiTex.Add(TexNode2);
    FieldMultiTex.Add(TexNode3);
    DeclMultiTex := TX3DInterfaceDeclaration.Create(ShaderNode);
    DeclMultiTex.FieldOrEvent := FieldMultiTex;
    ShaderNode.InterfaceDeclarations.Add(DeclMultiTex);

    FieldScale := TSFFloat.Create(ShaderNode, True, 'myScale', 2.5);
    DeclScale := TX3DInterfaceDeclaration.Create(ShaderNode);
    DeclScale.FieldOrEvent := FieldScale;
    ShaderNode.InterfaceDeclarations.Add(DeclScale);

    FieldTint := TSFVec3f.Create(ShaderNode, True, 'myTint', Vector3(0.25, 0.5, 0.75));
    DeclTint := TX3DInterfaceDeclaration.Create(ShaderNode);
    DeclTint.FieldOrEvent := FieldTint;
    ShaderNode.InterfaceDeclarations.Add(DeclTint);

    Root := TX3DRootNode.Create;
    ShapeNode := TShapeNode.Create;
    App := TAppearanceNode.Create;
    App.FdShaders.Add(ShaderNode);
    ShapeNode.Appearance := App;
    ShapeNode.Geometry := TBoxNode.Create;
    Root.AddChildren(ShapeNode);

    Scene := TCastleScene.Create(nil);
    Scene.Load(Root, True);
    Scene.ProcessEvents := True;

    Prog := TX3DGLSLProgram.Create;
    Prog.AttachVertexShader(
      'void main(void) { gl_Position = vec4(0.0, 0.0, 0.0, 1.0); }');
    Prog.AttachFragmentShader(
      'uniform sampler2D myMainTex;' + LineEnding +
      'uniform sampler2D myLayerTexs[2];' + LineEnding +
      'uniform float myScale;' + LineEnding +
      'uniform vec3 myTint;' + LineEnding +
      'void main(void) { gl_FragColor = vec4(myTint * myScale, 1.0); }');
    Prog.Link;

    { BindUniforms registers TSFNode/TMFNode in UniformsTextures and immediately sets non-texture fields }
    Prog.BindUniforms(ShaderNode, True);
    AssertTrue('myScale uniform must be recorded', Prog.GetRHIUniformValue('myScale', StoredVal));
    AssertSameValue(2.5, StoredVal.X, 0.001);
    AssertTrue('myTint uniform must be recorded', Prog.GetRHIUniformValue('myTint', StoredVal));
    AssertSameValue(0.25, StoredVal.X, 0.001);
    AssertSameValue(0.50, StoredVal.Y, 0.001);
    AssertSameValue(0.75, StoredVal.Z, 0.001);

    { SetupUniforms prepares and binds TSFNode (unit 1) and TMFNode (units 2, 3) when BoundUnits starts at 1 }
    BoundUnits := 1;
    AssertTrue('SetupUniforms must succeed in pure Vulkan RHI mode with GLFeatures = nil',
      Prog.SetupUniforms(BoundUnits));
    AssertEquals('BoundTextureUnits must advance from 1 to 4 (1 single + 2 array textures)',
      4, Integer(BoundUnits));
    AssertTrue('TexNode1 RHI texture resource must be prepared automatically',
      TTextureResources.Get(TexNode1) <> nil);
    AssertTrue('TexNode2 RHI texture resource must be prepared automatically',
      TTextureResources.Get(TexNode2) <> nil);
    AssertTrue('TexNode3 RHI texture resource must be prepared automatically',
      TTextureResources.Get(TexNode3) <> nil);
    AssertTrue('myMainTex uniform must be bound to texture unit 1',
      Prog.GetRHIUniformValue('myMainTex', StoredVal));
    AssertSameValue(1.0, StoredVal.X, 0.001);
    AssertTrue('myLayerTexs array uniform must be bound to texture units [2, 3]',
      Prog.GetRHIUniformValue('myLayerTexs', StoredVal));
    AssertSameValue(2.0, StoredVal.X, 0.001);
    AssertSameValue(3.0, StoredVal.Y, 0.001);
    AssertTrue('myLayerTexs[0] must be 2',
      Prog.GetRHIUniformValue('myLayerTexs[0]', StoredVal));
    AssertSameValue(2.0, StoredVal.X, 0.001);
    AssertTrue('myLayerTexs[1] must be 3',
      Prog.GetRHIUniformValue('myLayerTexs[1]', StoredVal));
    AssertSameValue(3.0, StoredVal.X, 0.001);

    { Dynamically changing an exposed field fires EventReceive and updates RHI uniform }
    FieldScale.Send(5.0);
    AssertTrue(Prog.GetRHIUniformValue('myScale', StoredVal));
    AssertSameValue(5.0, StoredVal.X, 0.001);
  finally
    FreeAndNil(Prog);
    TTextureResources.Unprepare(TexNode1);
    TTextureResources.Unprepare(TexNode2);
    TTextureResources.Unprepare(TexNode3);
    FreeAndNil(Scene);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(Device);
  end;
end;

procedure TTestCastleVulkanRHI.TestCastleInspectorAndGLInformationStringRHI;
var
  Device: TVulkanRHIDevice;
  Cmd: TVulkanRHICommandList;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedCtx: TRenderContext;
  SavedBackend: TRenderBackend;
  Container: TTestHeadlessVulkanContainer;
  Viewport: TCastleViewport;
  Scene: TCastleScene;
  Box: TBoxNode;
  ShapeNode: TShapeNode;
  Root: TX3DRootNode;
  Inspector: TCastleInspector;
  HandleInput: Boolean;
  InfoStr, SummaryStr: String;
  TargetTex: TRHITexture;
  TargetPassInfo: TRHIRenderingInfo;
  Batch2D: TCastleBatch2DRenderer;
  QuadsBefore: Cardinal;
begin
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedCtx := RenderContext;
  SavedBackend := ApplicationProperties.RenderBackend;
  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($1003)));
  Container := nil;
  Viewport := nil;
  Scene := nil;
  Inspector := nil;
  TargetTex := nil;
  try
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(Device);

    { 1. Verify GLInformationString and GLInformationStringSummary in pure Vulkan RHI mode }
    InfoStr := GLInformationString;
    SummaryStr := GLInformationStringSummary;
    AssertTrue('GLInformationString must report Vulkan / RHI info when RHIDevice <> nil',
      Pos('Vulkan', InfoStr) > 0);
    AssertTrue('GLInformationStringSummary must be non-empty in Vulkan RHI mode',
      SummaryStr <> '');

    { 2. Create a container with a Viewport and Scene, and attach TCastleInspector }
    Container := TTestHeadlessVulkanContainer.Create(nil);
    RenderContext := Container.Context;

    Root := TX3DRootNode.Create;
    ShapeNode := TShapeNode.Create;
    Box := TBoxNode.Create;
    ShapeNode.Geometry := Box;
    Root.AddChildren(ShapeNode);

    Scene := TCastleScene.Create(nil);
    Scene.Name := 'InspectorTestScene';
    Scene.Load(Root, True);

    Viewport := TCastleViewport.Create(nil);
    Viewport.Name := 'InspectorTestViewport';
    Viewport.FullSize := True;
    Viewport.Items.Add(Scene);
    Container.Controls.InsertFront(Viewport);

    Inspector := TCastleInspector.Create(nil);
    Container.Controls.InsertFront(Inspector);

    { Select Viewport and test SelectedComponent persistence + Update }
    Inspector.SelectedComponent := Viewport;
    AssertTrue('Inspector.SelectedComponent must persist Viewport selection',
      Inspector.SelectedComponent = Viewport);

    HandleInput := True;
    Inspector.Update(0.016, HandleInput);

    { Render TCastleInspector (hierarchy/properties/profiler/log) into an offscreen RHI texture
      via Container.RenderControl }
    TargetTex := Device.CreateTexture(TRHITextureDesc.Create2D(800, 600, pfRGBA8_UNorm,
      [tuColorAttachment, tuSampled, tuTransferSrc]));
    Cmd := Device.BeginFrame as TVulkanRHICommandList;
    SetActiveCommandList(Cmd);

    TargetPassInfo := TRHIRenderingInfo.CreateColorDepth(Rectangle(0, 0, 800, 600),
      TargetTex, loClear, Vector4(0, 0, 0, 1), nil, loDontCare, 1.0);
    Cmd.BeginRendering(TargetPassInfo);

    Batch2D := EnsureBatch2DRenderer(Device);
    QuadsBefore := Batch2D.TotalQuadsDrawn;
    Container.RenderControl(Inspector, Rectangle(0, 0, 800, 600));
    TDrawableImage.BatchingFlush;
    AssertTrue('Rendering TCastleInspector must issue 2D RHI quad draws',
      Batch2D.TotalQuadsDrawn > QuadsBefore);

    Cmd.EndRendering;
    Device.EndFrameAndPresent;
  finally
    RenderContext := SavedCtx;
    FreeAndNil(Inspector);
    FreeAndNil(Viewport);
    FreeAndNil(Scene);
    FreeAndNil(Container);
    FreeAndNil(TargetTex);
    FreeGlobalBatch2DRenderer;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(Device);
  end;
end;

type
  TTestViewportScreenEffectAccess = class(TCastleViewport);

procedure TTestCastleVulkanRHI.TestGLSLScreenEffectAndViewportSSAOSSRUniformsRHI;
var
  Device: TVulkanRHIDevice;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  CustomSE: TGLSLScreenEffect;
  Pipe: TRHIPipeline;
  Mapped: PByte;
  FVal: Single;
  V3Val: TVector3;
  M4Val: TMatrix4;
  Viewport: TCastleViewport;
  DS0, DS1: TRHIDescriptorSet;
begin
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($1011)));
  CustomSE := nil;
  Viewport := nil;
  try
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(Device);

    { 1. Verify TGLSLScreenEffect custom uniform parsing, std140 UBO upload, and Set 2 descriptor set }
    CustomSE := TGLSLScreenEffect.Create;
    CustomSE.Name := 'CustomTestScreenEffect';
    CustomSE.NeedsDepth := True;
    CustomSE.ScreenEffectShader :=
      'uniform float near;' + LineEnding +
      'uniform float far;' + LineEnding +
      'uniform vec3 castle_CameraPosition;' + LineEnding +
      'uniform mat4 castle_ViewProjectionMatrix;' + LineEnding +
      'void main(void) { gl_FragColor = vec4(castle_CameraPosition * near, 1.0); }';
    CustomSE.Link;

    CustomSE.Uniform('near').SetValue(0.25);
    CustomSE.Uniform('far').SetValue(500.0);
    CustomSE.Uniform('castle_CameraPosition').SetValue(Vector3(10.0, 20.0, 30.0));
    CustomSE.Uniform('castle_ViewProjectionMatrix').SetValue(TranslationMatrix(Vector3(1.0, 2.0, 3.0)));

    Pipe := CustomSE.GetOrCreateRHIPipeline(Device);
    AssertTrue('Custom TGLSLScreenEffect RHI pipeline must be created', Pipe <> nil);
    AssertEquals('Custom TGLSLScreenEffect must declare 4 user uniforms', 4, CustomSE.RHIUserEffectUniformCount);
    AssertTrue('Custom TGLSLScreenEffect RHIFragmentGLSL must preserve castle_CameraPosition in CastleUserEffectBlock',
      Pos('u_user_castle_CameraPosition', CustomSE.RHIFragmentGLSL) > 0);
    AssertTrue('Custom TGLSLScreenEffect RHIFragmentGLSL must emit #undef near before #define near',
      Pos('#undef near', CustomSE.RHIFragmentGLSL) > 0);
    AssertTrue('Custom TGLSLScreenEffect must allocate RHIUserEffectBuffer', CustomSE.RHIUserEffectBuffer <> nil);
    AssertTrue('Custom TGLSLScreenEffect must allocate RHIUserEffectDescriptorSet', CustomSE.RHIUserEffectDescriptorSet <> nil);
    AssertEquals('Custom TGLSLScreenEffect pipeline layout must have 3 descriptor set layouts (Set 0 + Set 2)',
      3, Length(Pipe.Desc.DescriptorSetLayouts));

    AssertEquals('UpdateRHIUniforms must pack 4 set uniform values', 4, CustomSE.UpdateRHIUniforms);
    Mapped := PByte(CustomSE.RHIUserEffectBuffer.Map);
    AssertTrue('RHIUserEffectBuffer must map non-nil', Mapped <> nil);
    try
      Move(Mapped[0], FVal, 4);
      AssertSameValue(0.25, FVal, 0.001);
      Move(Mapped[4], FVal, 4);
      AssertSameValue(500.0, FVal, 0.001);
      { vec3 castle_CameraPosition is 16-byte aligned at offset 16 }
      Move(Mapped[16], V3Val, 12);
      AssertVectorEquals(Vector3(10.0, 20.0, 30.0), V3Val, 0.001);
      { mat4 castle_ViewProjectionMatrix is 16-byte aligned at offset 32 }
      Move(Mapped[32], M4Val, 64);
      AssertSameValue(1.0, M4Val.Data[3][0], 0.001);
      AssertSameValue(2.0, M4Val.Data[3][1], 0.001);
      AssertSameValue(3.0, M4Val.Data[3][2], 0.001);
    finally
      CustomSE.RHIUserEffectBuffer.Unmap;
    end;

    { 2. Verify TCastleViewport SSAO + SSR built-in screen effects bind Set 2 user descriptor sets }
    Viewport := TTestViewportScreenEffectAccess.Create(nil);
    Viewport.FullSize := False;
    Viewport.Width := 320;
    Viewport.Height := 240;
    Viewport.ScreenSpaceAmbientOcclusion := True;
    Viewport.ScreenSpaceReflections := True;
    Viewport.ScreenSpaceReflectionsSurfaceGlossiness := 0.75;
    Viewport.Camera.SetWorldView(Vector3(4.0, 5.0, 6.0), Vector3(0.0, 0.0, -1.0), Vector3(0.0, 1.0, 0.0));

    AssertEquals('Viewport must have 2 extra screen effects (SSAO + SSR)',
      2, TTestViewportScreenEffectAccess(Viewport).InternalExtraScreenEffectsCount);
    Pipe := TTestViewportScreenEffectAccess(Viewport).InternalExtraGetScreenEffectRHIPipeline(0);
    AssertTrue('SSAO RHI pipeline must be non-nil', Pipe <> nil);
    DS0 := TTestViewportScreenEffectAccess(Viewport).InternalExtraGetScreenEffectRHIUserDescriptorSet(0);
    AssertTrue('SSAO Set 2 user descriptor set must be non-nil', DS0 <> nil);

    Pipe := TTestViewportScreenEffectAccess(Viewport).InternalExtraGetScreenEffectRHIPipeline(1);
    AssertTrue('SSR RHI pipeline must be non-nil', Pipe <> nil);
    DS1 := TTestViewportScreenEffectAccess(Viewport).InternalExtraGetScreenEffectRHIUserDescriptorSet(1);
    AssertTrue('SSR Set 2 user descriptor set must be non-nil', DS1 <> nil);
    AssertTrue('SSR and SSAO Set 2 user descriptor sets must be distinct', DS0 <> DS1);
  finally
    FreeAndNil(Viewport);
    FreeAndNil(CustomSE);
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(Device);
  end;
end;

procedure TTestCastleVulkanRHI.TestViewportChildSceneScreenEffectsAndDynamicToggleRHI;
var
  Device: TVulkanRHIDevice;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  Viewport: TCastleViewport;
  ChildScene1, ChildScene2: TCastleScene;
  Root1, Root2: TX3DRootNode;
  SENode1, SENode2: TScreenEffectNode;
  Shader1, Shader2: TComposedShaderNode;
  Part1, Part2: TShaderPartNode;
  IntensityField: TSFFloat;
begin
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($1012)));
  Viewport := nil;
  ChildScene1 := nil;
  ChildScene2 := nil;
  try
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(Device);

    { 1. Build ChildScene1 with an enabled ScreenEffectNode (NeedsDepth = False) and a custom uniform }
    Root1 := TX3DRootNode.Create;
    SENode1 := TScreenEffectNode.Create;
    SENode1.NeedsDepth := False;
    Shader1 := TComposedShaderNode.Create;
    IntensityField := TSFFloat.Create(Shader1, True, 'u_intensity', 0.8);
    Shader1.AddCustomField(IntensityField);
    Part1 := TShaderPartNode.Create;
    Part1.ShaderType := stFragment;
    Part1.Contents :=
      'uniform float u_intensity;' + LineEnding +
      'void main(void) { gl_FragColor = screenf_get_original_color() * u_intensity; }';
    Shader1.SetParts([Part1]);
    SENode1.SetShaders([Shader1]);
    Root1.AddChildren(SENode1);

    ChildScene1 := TCastleScene.Create(nil);
    ChildScene1.Load(Root1, True);

    { 2. Build ChildScene2 with a ScreenEffectNode initially disabled (Enabled = False, NeedsDepth = True) }
    Root2 := TX3DRootNode.Create;
    SENode2 := TScreenEffectNode.Create;
    SENode2.Enabled := False;
    SENode2.NeedsDepth := True;
    Shader2 := TComposedShaderNode.Create;
    Part2 := TShaderPartNode.Create;
    Part2.ShaderType := stFragment;
    Part2.Contents := 'void main(void) { gl_FragColor = vec4(screenf_get_original_depth()); }';
    Shader2.SetParts([Part2]);
    SENode2.SetShaders([Shader2]);
    Root2.AddChildren(SENode2);

    ChildScene2 := TCastleScene.Create(nil);
    ChildScene2.Load(Root2, True);

    { 3. Add both scenes to Viewport.Items WITHOUT setting deprecated Items.MainScene }
    Viewport := TTestViewportScreenEffectAccess.Create(nil);
    Viewport.Items.Add(ChildScene1);
    Viewport.Items.Add(ChildScene2);

    AssertEquals('Viewport must discover 1 enabled screen effect in child scenes (ChildScene1)',
      1, TTestViewportScreenEffectAccess(Viewport).InternalExtraScreenEffectsCount);
    AssertFalse('NeedsDepth must be False while ChildScene2 screen effect is disabled',
      TTestViewportScreenEffectAccess(Viewport).InternalExtraScreenEffectsNeedDepth);
    AssertTrue('ChildScene1 RHI screen effect pipeline must be returned at index 0',
      TTestViewportScreenEffectAccess(Viewport).InternalExtraGetScreenEffectRHIPipeline(0) <> nil);
    AssertTrue('ChildScene1 Set 2 user descriptor set must be returned at index 0',
      TTestViewportScreenEffectAccess(Viewport).InternalExtraGetScreenEffectRHIUserDescriptorSet(0) <> nil);

    { 4. Dynamically enable SENode2 at runtime -> lazy RHI pipeline compilation + NeedsDepth = True }
    SENode2.FdEnabled.Value := True;
    AssertEquals('Viewport must now discover 2 enabled screen effects across child scenes',
      2, TTestViewportScreenEffectAccess(Viewport).InternalExtraScreenEffectsCount);
    AssertTrue('NeedsDepth must now be True because SENode2 is enabled and requires depth',
      TTestViewportScreenEffectAccess(Viewport).InternalExtraScreenEffectsNeedDepth);
    AssertTrue('ChildScene2 RHI screen effect pipeline must be lazily compiled and returned at index 1',
      TTestViewportScreenEffectAccess(Viewport).InternalExtraGetScreenEffectRHIPipeline(1) <> nil);

    { 5. Verify assigning deprecated Items.MainScene := ChildScene1 does not double-count ChildScene1 }
    {$warnings off}
    Viewport.Items.MainScene := ChildScene1;
    {$warnings on}
    AssertEquals('Setting MainScene := ChildScene1 must not double-count ChildScene1 screen effects',
      2, TTestViewportScreenEffectAccess(Viewport).InternalExtraScreenEffectsCount);

    { 6. Dynamically disable SENode1 at runtime -> only SENode2 remains active }
    SENode1.FdEnabled.Value := False;
    AssertEquals('Disabling SENode1 must leave 1 active screen effect (SENode2)',
      1, TTestViewportScreenEffectAccess(Viewport).InternalExtraScreenEffectsCount);
    AssertTrue('Remaining screen effect at index 0 must be SENode2 pipeline',
      TTestViewportScreenEffectAccess(Viewport).InternalExtraGetScreenEffectRHIPipeline(0) <> nil);
  finally
    FreeAndNil(Viewport);
    FreeAndNil(ChildScene2);
    FreeAndNil(ChildScene1);
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(Device);
  end;
end;

procedure TTestCastleVulkanRHI.TestViewportPrepareShadowVolumesAnd2DUIControlsRHI;
var
  Device: TVulkanRHIDevice;
  Cmd: TVulkanRHICommandList;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedCtx: TRenderContext;
  SavedBackend: TRenderBackend;
  SavedGLFeatures: TGLFeatures;
  Container: TTestHeadlessVulkanContainer;
  Viewport: TCastleViewport;
  Scene: TCastleScene;
  Root: TX3DRootNode;
  LightNode: TDirectionalLightNode;
  ShapeNode: TShapeNode;
  Box: TBoxNode;
  TargetTex: TRHITexture;
  TargetPassInfo: TRHIRenderingInfo;
  ShapeCtrl: TCastleShape;
  Crosshair: TCastleCrosshair;
  ScrollView: TCastleScrollView;
  FloatSlider: TCastleFloatSlider;
  IntSlider: TCastleIntegerSlider;
  ST: TShapeType;
  HandleInput: Boolean;
  PrimDrawsBefore: Cardinal;
  Batch2D: TCastleBatch2DRenderer;
  QuadsBefore: Cardinal;
begin
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedCtx := RenderContext;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedGLFeatures := GLFeatures;
  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($1013)));
  Container := nil;
  Viewport := nil;
  Scene := nil;
  ShapeCtrl := nil;
  Crosshair := nil;
  ScrollView := nil;
  FloatSlider := nil;
  IntSlider := nil;
  TargetTex := nil;
  try
    ApplicationProperties.RenderBackend := backendVulkan;
    GLFeatures := nil; // Pure Vulkan RHI mode without GLFeatures
    SetRHIDevice(Device);

    Container := TTestHeadlessVulkanContainer.Create(nil);
    RenderContext := Container.Context;

    { 1. Build a scene with a shadow-volume main light and a 2-manifold box }
    Root := TX3DRootNode.Create;
    LightNode := TDirectionalLightNode.Create;
    LightNode.FdShadowVolumes.Value := True;
    LightNode.FdShadowVolumesMain.Value := True;
    Root.AddChildren(LightNode);

    ShapeNode := TShapeNode.Create;
    Box := TBoxNode.Create;
    ShapeNode.Geometry := Box;
    Root.AddChildren(ShapeNode);

    Scene := TCastleScene.Create(nil);
    Scene.Load(Root, True);
    Scene.CastGlobalLights := True;

    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := True;
    Viewport.ShadowVolumes := True;
    Viewport.Items.Add(Scene);
    Container.Controls.InsertFront(Viewport);

    AssertTrue('InternalShadowVolumeRenderer must be nil before PrepareResources',
      Viewport.InternalShadowVolumeRenderer = nil);

    { Call Viewport.PrepareResources in pure Vulkan RHI mode (GLFeatures = nil) }
    Viewport.PrepareResources;
    AssertTrue('Viewport.PrepareResources must initialize InternalShadowVolumeRenderer in pure RHI mode when ShadowVolumes = True',
      Viewport.InternalShadowVolumeRenderer <> nil);

    { 2. Render 2D UI controls (TCastleShape, TCastleCrosshair, TCastleScrollView, TCastleFloatSlider, TCastleIntegerSlider)
      in pure Vulkan RHI mode (GLFeatures = nil) }
    ShapeCtrl := TCastleShape.Create(nil);
    ShapeCtrl.Width := 80;
    ShapeCtrl.Height := 60;
    ShapeCtrl.Color := Vector4(0.2, 0.6, 0.9, 1.0);
    ShapeCtrl.OutlineColor := Vector4(1.0, 1.0, 1.0, 1.0);
    ShapeCtrl.OutlineWidth := 2.0;
    Container.Controls.InsertFront(ShapeCtrl);

    Crosshair := TCastleCrosshair.Create(nil);
    Container.Controls.InsertFront(Crosshair);

    ScrollView := TCastleScrollView.Create(nil);
    ScrollView.Width := 200;
    ScrollView.Height := 150;
    ScrollView.ScrollArea.Height := 400;
    HandleInput := True;
    ScrollView.Update(0.016, HandleInput);
    Container.Controls.InsertFront(ScrollView);

    FloatSlider := TCastleFloatSlider.Create(nil);
    FloatSlider.Min := 0.0;
    FloatSlider.Max := 10.0;
    FloatSlider.Value := 4.5;
    FloatSlider.Caption := 'Exposure';
    Container.Controls.InsertFront(FloatSlider);

    IntSlider := TCastleIntegerSlider.Create(nil);
    IntSlider.Min := 1;
    IntSlider.Max := 8;
    IntSlider.Value := 4;
    IntSlider.Caption := 'Cascades';
    Container.Controls.InsertFront(IntSlider);

    TargetTex := Device.CreateTexture(TRHITextureDesc.Create2D(800, 600, pfRGBA8_UNorm,
      [tuColorAttachment, tuSampled, tuTransferSrc]));
    Cmd := Device.BeginFrame as TVulkanRHICommandList;
    SetActiveCommandList(Cmd);

    TargetPassInfo := TRHIRenderingInfo.CreateColorDepth(Rectangle(0, 0, 800, 600),
      TargetTex, loClear, Vector4(0, 0, 0, 1), nil, loDontCare, 1.0);
    Cmd.BeginRendering(TargetPassInfo);

    { Exercise all 6 TShapeType variants in both Outline (thin) and OutlineThick modes }
    RHIPrimitive2DResetStats;
    PrimDrawsBefore := RHIPrimitive2DDrawCallCount;
    for ST := Low(TShapeType) to High(TShapeType) do
    begin
      ShapeCtrl.ShapeType := ST;
      ShapeCtrl.Filled := True;
      ShapeCtrl.Outline := True;
      ShapeCtrl.OutlineThick := False;
      Container.RenderControl(ShapeCtrl, Rectangle(0, 0, 800, 600));

      ShapeCtrl.OutlineThick := True;
      Container.RenderControl(ShapeCtrl, Rectangle(0, 0, 800, 600));
    end;
    AssertTrue('Rendering all 6 TCastleShape types (thin + thick outline) must issue RHI 2D primitive draws',
      RHIPrimitive2DDrawCallCount >= PrimDrawsBefore + 24);

    { Exercise Crosshair, ScrollView, FloatSlider, and IntegerSlider }
    Batch2D := EnsureBatch2DRenderer(Device);
    QuadsBefore := Batch2D.TotalQuadsDrawn;
    Crosshair.Shape := csCross;
    Container.RenderControl(Crosshair, Rectangle(0, 0, 800, 600));
    Crosshair.Shape := csCrossRect;
    Container.RenderControl(Crosshair, Rectangle(0, 0, 800, 600));
    Container.RenderControl(ScrollView, Rectangle(0, 0, 800, 600));
    Container.RenderControl(FloatSlider, Rectangle(0, 0, 800, 600));
    Container.RenderControl(IntSlider, Rectangle(0, 0, 800, 600));
    TDrawableImage.BatchingFlush;
    AssertTrue('Rendering Crosshair, ScrollView, FloatSlider, and IntegerSlider must issue RHI 2D quad draws',
      Batch2D.TotalQuadsDrawn > QuadsBefore);

    Cmd.EndRendering;
    Device.EndFrameAndPresent;
  finally
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    FreeAndNil(IntSlider);
    FreeAndNil(FloatSlider);
    FreeAndNil(ScrollView);
    FreeAndNil(Crosshair);
    FreeAndNil(ShapeCtrl);
    FreeAndNil(Viewport);
    FreeAndNil(Scene);
    FreeAndNil(Container);
    FreeAndNil(TargetTex);
    FreeGlobalBatch2DRenderer;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(Device);
  end;
end;

procedure TTestCastleVulkanRHI.TestWireframeEffectsAndDualSlotShaderCacheRHI;
var
  Device: TVulkanRHIDevice;
  Cmd: TVulkanRHICommandList;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  SavedForceWireframe: TWireframeEffect;
  TargetTex, DepthTex: TRHITexture;
  TexDesc: TRHITextureDesc;
  PassInfo: TRHIRenderingInfo;
  Container: TTestHeadlessVulkanContainer;
  Viewport: TCastleViewport;
  Scene1: TCastleScene;
  Ref2: TCastleTransformReference;
  AltOptions: TCastleRenderOptions;
  Root: TX3DRootNode;
  ShapeNode: TShapeNode;
  AppNode: TAppearanceNode;
  BoxNode: TBoxNode;
  MatNode: TMaterialNode;
  PixTexNode: TPixelTextureNode;
  PixImg: TRGBImage;
  Light: TCastleDirectionalLight;
  Shape1: TX3DRendererShape;
  CompilesAfterSolidWireframe1, CompilesAfterSolidWireframe2: Cardinal;
  CompilesAfterSilhouette1, CompilesAfterSilhouette2: Cardinal;
  DrawCountBefore: Cardinal;
  ShadingModel: TCastleShadingModelRHI;
begin
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;
  SavedForceWireframe := InternalForceWireframe;

  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($1014)));
  TargetTex := nil;
  DepthTex := nil;
  Container := nil;
  Viewport := nil;
  Scene1 := nil;
  Ref2 := nil;
  AltOptions := nil;
  Light := nil;
  try
    SetRHIDevice(Device);
    ApplicationProperties.RenderBackend := backendVulkan;
    GLFeatures := nil;

    TexDesc := TRHITextureDesc.Create2D(256, 256, pfBGRA8_UNorm, [tuColorAttachment, tuTransferSrc]);
    TargetTex := Device.CreateTexture(TexDesc);
    TexDesc := TRHITextureDesc.Create2D(256, 256, pfD24_UNorm_S8_UInt, [tuDepthStencil]);
    DepthTex := Device.CreateTexture(TexDesc);

    Container := TTestHeadlessVulkanContainer.Create(nil);
    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := False;
    Viewport.Width := 256;
    Viewport.Height := 256;
    Container.Controls.InsertFront(Viewport);

    Light := TCastleDirectionalLight.Create(nil);
    Light.Direction := Vector3(0, 0, -1);
    Viewport.Items.Add(Light);

    { Build a textured Phong-shaded scene so Pass 0 (rmFull, textured + Phong)
      and Pass 1 (rmSolidColor, unlit + untextured) have distinct RHI shader permutation masks }
    Root := TX3DRootNode.Create;
    ShapeNode := TShapeNode.Create;
    BoxNode := TBoxNode.Create;
    ShapeNode.Geometry := BoxNode;
    AppNode := TAppearanceNode.Create;
    MatNode := TMaterialNode.Create;
    MatNode.DiffuseColor := Vector3(0.8, 0.4, 0.2);
    MatNode.SpecularColor := Vector3(0.5, 0.5, 0.5);
    AppNode.Material := MatNode;
    PixTexNode := TPixelTextureNode.Create;
    PixImg := TRGBImage.Create(2, 2);
    PixImg.Clear(Vector4Byte(255, 128, 64, 255));
    PixTexNode.FdImage.Value := PixImg;
    AppNode.Texture := PixTexNode;
    ShapeNode.Appearance := AppNode;
    Root.AddChildren(ShapeNode);

    Scene1 := TCastleScene.Create(nil);
    Scene1.Load(Root, True);
    Scene1.Translation := Vector3(0, 0, -6);
    Viewport.Items.Add(Scene1);

    { Reference Scene1 via TCastleTransformReference so both instances share Scene1's TShapeCache }
    Ref2 := TCastleTransformReference.Create(nil);
    Ref2.Reference := Scene1;
    Ref2.Translation := Vector3(0, 0.5, -5);
    Viewport.Items.Add(Ref2);

    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 256, 256);

    Cmd := Device.BeginFrame as TVulkanRHICommandList;
    SetActiveCommandList(Cmd);
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 256, 256),
      TargetTex, loClear, Vector4(0, 0, 0, 1),
      DepthTex, loClear, 1.0);
    Cmd.BeginRendering(PassInfo);

    { 1. Verify TShapeCache.RenderOptions synchronization across alternate TCastleRenderOptions }
    Scene1.RenderOptions.Mode := rmFull;
    DrawCountBefore := Cmd.PushConstantCallCount;
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    AssertEquals('Scene1 + Ref2 must record 2 shape push-constant draws',
      DrawCountBefore + 2, Cmd.PushConstantCallCount);

    Shape1 := TX3DRendererShape(Scene1.Shapes.TraverseList(True)[0]);
    AssertTrue('Shape1.Cache must be allocated', Shape1.Cache <> nil);

    AltOptions := TCastleRenderOptions.Create(nil);
    AltOptions.Mode := rmSolidColor;
    AltOptions.SolidColor := Vector3(0.1, 0.9, 0.2);
    Shape1.Cache.RHIRenderOptions := AltOptions;
    Shape1.UploadRHIMaterialToCache(ShadingModel);
    AssertVectorEquals(Vector3(0.1, 0.9, 0.2), Shape1.Cache.RHIMaterialBlock.BaseColor.XYZ, 1e-4);
    Shape1.Cache.RHIRenderOptions := Scene1.RenderOptions;

    { 2. Remove Ref2 to test Scene1 wireframe modes and 2-slot shader cache }
    Viewport.Items.Remove(Ref2);
    Scene1.RenderOptions.Mode := rmFull;
    Scene1.RenderOptions.WireframeColor := Vector3(1.0, 1.0, 0.0);

    { 2a. weWireframeOnly }
    Scene1.RenderOptions.WireframeEffect := weWireframeOnly;
    DrawCountBefore := Cmd.PipelineBindCount;
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    AssertEquals('weWireframeOnly must bind 1 shape pipeline',
      DrawCountBefore + 1, Cmd.PipelineBindCount);

    { 2b. weSolidWireframe (2 passes per frame: Pass 0 fill + Pass 1 wireframe line) }
    Scene1.RenderOptions.WireframeEffect := weSolidWireframe;
    Scene1.RenderOptions.LineWidth := 2.0;
    DrawCountBefore := Cmd.PipelineBindCount;
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    AssertEquals('weSolidWireframe must bind 2 shape pipelines (Pass 0 solid + Pass 1 wireframe)',
      DrawCountBefore + 2, Cmd.PipelineBindCount);
    CompilesAfterSolidWireframe1 := Shape1.Cache.RHIShaderCompileCount;

    { Render a second frame of weSolidWireframe -> dual-slot shader cache must hit in O(1) with 0 new shader compilations! }
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    CompilesAfterSolidWireframe2 := Shape1.Cache.RHIShaderCompileCount;
    AssertEquals('Dual-slot TShapeCache shader cache must avoid any shader recompilation on subsequent weSolidWireframe frames',
      CompilesAfterSolidWireframe1, CompilesAfterSolidWireframe2);

    { 2c. weSilhouette (2 passes per frame) }
    Scene1.RenderOptions.WireframeEffect := weSilhouette;
    Scene1.RenderOptions.SilhouetteScale := 5.0;
    Scene1.RenderOptions.SilhouetteBias := 2.0;
    DrawCountBefore := Cmd.PipelineBindCount;
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    AssertEquals('weSilhouette must bind 2 shape pipelines (Pass 0 solid + Pass 1 silhouette)',
      DrawCountBefore + 2, Cmd.PipelineBindCount);
    CompilesAfterSilhouette1 := Shape1.Cache.RHIShaderCompileCount;

    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    CompilesAfterSilhouette2 := Shape1.Cache.RHIShaderCompileCount;
    AssertEquals('Dual-slot TShapeCache shader cache must avoid any shader recompilation on subsequent weSilhouette frames',
      CompilesAfterSilhouette1, CompilesAfterSilhouette2);

    { 2d. InternalForceWireframe }
    Scene1.RenderOptions.WireframeEffect := weNormal;
    InternalForceWireframe := weWireframeOnly;
    DrawCountBefore := Cmd.PipelineBindCount;
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    AssertEquals('InternalForceWireframe must render wireframe in 1 pass',
      DrawCountBefore + 1, Cmd.PipelineBindCount);
    InternalForceWireframe := weNormal;

    Cmd.EndRendering;
    Device.EndFrameAndPresent;
  finally
    InternalForceWireframe := SavedForceWireframe;
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    FreeAndNil(AltOptions);
    FreeAndNil(Ref2);
    FreeAndNil(Scene1);
    FreeAndNil(Light);
    FreeAndNil(Viewport);
    FreeAndNil(Container);
    FreeAndNil(DepthTex);
    FreeAndNil(TargetTex);
    FreeGlobalBatch2DRenderer;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(Device);
  end;
end;

procedure TTestCastleVulkanRHI.TestPointSizeScalingAndLinePropertiesStippleRHI;
var
  Device: TVulkanRHIDevice;
  Cmd: TVulkanRHICommandList;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  TargetTex, DepthTex: TRHITexture;
  TexDesc: TRHITextureDesc;
  PassInfo: TRHIRenderingInfo;
  Container: TTestHeadlessVulkanContainer;
  Viewport: TCastleViewport;
  PointScene, LineScene: TCastleScene;
  PointRoot, LineRoot: TX3DRootNode;
  PointShapeNode, LineShapeNode: TShapeNode;
  PointSet: TPointSetNode;
  PointCoord, LineCoord: TCoordinateNode;
  PointApp, LineApp: TAppearanceNode;
  PP: TPointPropertiesNode;
  LP: TLinePropertiesNode;
  LineSet: TLineSetNode;
  PointRendererShape, LineRendererShape: TX3DRendererShape;
  ExtractedPointSize: Single;
  ExtractedLineType: TLineType;
  ExtractedStipple: Word;
  LineTypeUpdatesBefore: Cardinal;
begin
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;

  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($1015)));
  TargetTex := nil;
  DepthTex := nil;
  Container := nil;
  Viewport := nil;
  PointScene := nil;
  LineScene := nil;
  try
    SetRHIDevice(Device);
    ApplicationProperties.RenderBackend := backendVulkan;
    GLFeatures := nil;

    TexDesc := TRHITextureDesc.Create2D(256, 256, pfBGRA8_UNorm, [tuColorAttachment, tuTransferSrc]);
    TargetTex := Device.CreateTexture(TexDesc);
    TexDesc := TRHITextureDesc.Create2D(256, 256, pfD24_UNorm_S8_UInt, [tuDepthStencil]);
    DepthTex := Device.CreateTexture(TexDesc);

    Container := TTestHeadlessVulkanContainer.Create(nil);
    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := False;
    Viewport.Width := 256;
    Viewport.Height := 256;
    Container.Controls.InsertFront(Viewport);

    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 256, 256);

    { 1. Verify TRenderContext.LineType & LineTypeToStipplePattern }
    AssertEquals('ltSolid stipple pattern', $FFFF, TRenderContext.LineTypeToStipplePattern(ltSolid));
    AssertEquals('ltDashed stipple pattern', $00FF, TRenderContext.LineTypeToStipplePattern(ltDashed));
    AssertEquals('ltDotted stipple pattern', $CCCC, TRenderContext.LineTypeToStipplePattern(ltDotted));
    AssertEquals('ltDashedDotted stipple pattern', $FFCC, TRenderContext.LineTypeToStipplePattern(ltDashedDotted));
    AssertEquals('ltDashDotDot stipple pattern', $FCCC, TRenderContext.LineTypeToStipplePattern(ltDashDotDot));

    LineTypeUpdatesBefore := RenderContext.RHILineTypeUpdateCount;
    RenderContext.LineType := ltDashed;
    AssertEquals('RenderContext.RHILastLineType must update to ltDashed', Ord(ltDashed), Ord(RenderContext.RHILastLineType));
    AssertEquals('RenderContext.RHILastLineStipplePattern must update to $00FF', $00FF, RenderContext.RHILastLineStipplePattern);
    AssertEquals('RenderContext.RHILineTypeUpdateCount must increment', LineTypeUpdatesBefore + 1, RenderContext.RHILineTypeUpdateCount);
    RenderContext.LineType := ltSolid;

    { 2. PointSet scene with RenderOptions.PointSize * TPointPropertiesNode }
    PointRoot := TX3DRootNode.Create;
    PointShapeNode := TShapeNode.Create;
    PointSet := TPointSetNode.Create;
    PointCoord := TCoordinateNode.Create;
    PointCoord.SetPoint([Vector3(0, 0, 0), Vector3(1, 0, 0), Vector3(0, 1, 0)]);
    PointSet.Coord := PointCoord;
    PointShapeNode.Geometry := PointSet;
    PointApp := TAppearanceNode.Create;
    PP := TPointPropertiesNode.Create;
    PP.PointSizeScaleFactor := 2.5;
    PP.PointSizeMinValue := 1.0;
    PP.PointSizeMaxValue := 5.0;
    PointApp.PointProperties := PP;
    PointShapeNode.Appearance := PointApp;
    PointRoot.AddChildren(PointShapeNode);

    PointScene := TCastleScene.Create(nil);
    PointScene.Load(PointRoot, True);
    PointScene.RenderOptions.PointSize := 4.0;
    PointScene.Translation := Vector3(0, 0, -5);
    Viewport.Items.Add(PointScene);

    { 3. LineSet scene with TLinePropertiesNode (LineType = ltDashed -> ltDotted -> ltDashedDotted -> ltDashDotDot) }
    LineRoot := TX3DRootNode.Create;
    LineShapeNode := TShapeNode.Create;
    LineSet := TLineSetNode.Create;
    LineCoord := TCoordinateNode.Create;
    LineCoord.SetPoint([Vector3(-1, 0, 0), Vector3(1, 0, 0)]);
    LineSet.Coord := LineCoord;
    LineSet.SetVertexCount([2]);
    LineShapeNode.Geometry := LineSet;
    LineApp := TAppearanceNode.Create;
    LP := TLinePropertiesNode.Create;
    LP.Applied := True;
    LP.LinewidthScaleFactor := 3.0;
    LP.LineType := ltDashed;
    LineApp.LineProperties := LP;
    LineShapeNode.Appearance := LineApp;
    LineRoot.AddChildren(LineShapeNode);

    LineScene := TCastleScene.Create(nil);
    LineScene.Load(LineRoot, True);
    LineScene.Translation := Vector3(0, -1, -5);
    Viewport.Items.Add(LineScene);

    Cmd := Device.BeginFrame as TVulkanRHICommandList;
    SetActiveCommandList(Cmd);
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 256, 256),
      TargetTex, loClear, Vector4(0, 0, 0, 1),
      DepthTex, loClear, 1.0);
    Cmd.BeginRendering(PassInfo);

    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));

    PointRendererShape := TX3DRendererShape(PointScene.Shapes.TraverseList(True)[0]);
    AssertTrue('ExtractRHIPointSize must return True when combined point size > 1.0',
      PointRendererShape.ExtractRHIPointSize(ExtractedPointSize));
    AssertSameValue(10.0, ExtractedPointSize, 1e-4);
    AssertSameValue(10.0, PointRendererShape.Cache.RHIPointSize, 1e-4);
    AssertTrue('Generated vertex shader must set gl_PointSize = 10.0;',
      Pos('gl_PointSize = 10.0;', PointRendererShape.Cache.RHIVertexShaderSource) > 0);

    LineRendererShape := TX3DRendererShape(LineScene.Shapes.TraverseList(True)[0]);
    AssertTrue('ExtractRHILineType must return True for ltDashed',
      LineRendererShape.ExtractRHILineType(ExtractedLineType, ExtractedStipple));
    AssertEquals('ExtractedLineType must be ltDashed', Ord(ltDashed), Ord(ExtractedLineType));
    AssertEquals('ExtractedStipple must be $00FF (255)', $00FF, ExtractedStipple);
    AssertEquals('LineRendererShape.Cache.RHILineType must be ltDashed',
      Ord(ltDashed), Ord(LineRendererShape.Cache.RHILineType));
    AssertTrue('Generated fragment shader for ltDashed must contain 255u stipple discard',
      Pos('255u >> (uint(floor(gl_FragCoord.x + gl_FragCoord.y)) & 15u)', LineRendererShape.Cache.RHIFragmentShaderSource) > 0);

    { Switch LineType to ltDotted ($CCCC = 52428) and re-render }
    LP.LineType := ltDotted;
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    AssertEquals('LineRendererShape.Cache.RHILineStipplePattern must be $CCCC (52428)',
      $CCCC, LineRendererShape.Cache.RHILineStipplePattern);
    AssertTrue('Generated fragment shader for ltDotted must contain 52428u stipple discard',
      Pos('52428u >> (uint(floor(gl_FragCoord.x + gl_FragCoord.y)) & 15u)', LineRendererShape.Cache.RHIFragmentShaderSource) > 0);

    { Switch LineType to ltDashedDotted ($FFCC = 65484) and re-render }
    LP.LineType := ltDashedDotted;
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    AssertTrue('Generated fragment shader for ltDashedDotted must contain 65484u stipple discard',
      Pos('65484u >> (uint(floor(gl_FragCoord.x + gl_FragCoord.y)) & 15u)', LineRendererShape.Cache.RHIFragmentShaderSource) > 0);

    { Switch LineType to ltDashDotDot ($FCCC = 64716) and re-render }
    LP.LineType := ltDashDotDot;
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    AssertTrue('Generated fragment shader for ltDashDotDot must contain 64716u stipple discard',
      Pos('64716u >> (uint(floor(gl_FragCoord.x + gl_FragCoord.y)) & 15u)', LineRendererShape.Cache.RHIFragmentShaderSource) > 0);

    Cmd.EndRendering;
    Device.EndFrameAndPresent;
  finally
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    FreeAndNil(LineScene);
    FreeAndNil(PointScene);
    FreeAndNil(Viewport);
    FreeAndNil(Container);
    FreeAndNil(DepthTex);
    FreeAndNil(TargetTex);
    FreeGlobalBatch2DRenderer;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(Device);
  end;
end;

procedure TTestCastleVulkanRHI.TestTransformManipulateDebugGizmosAndColliderWireframeRHI;
var
  Device: TVulkanRHIDevice;
  Cmd: TVulkanRHICommandList;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  SavedAppMode: TCastleApplicationMode;
  TargetTex, DepthTex: TRHITexture;
  TexDesc: TRHITextureDesc;
  PassInfo: TRHIRenderingInfo;
  Container: TTestHeadlessVulkanContainer;
  Viewport: TCastleViewport;
  Box: TCastleBox;
  Collider: TCastleBoxCollider;
  Hover: TCastleTransformHover;
  Manipulate: TCastleTransformManipulate;
  DebugTrans: TDebugTransform;
  HingeJoint: TCastleHingeJoint;
  PointLight: TCastlePointLight;
  DrawsBefore, ViewportUpdatesBefore: Cardinal;
begin
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;
  SavedAppMode := InternalCastleApplicationMode;

  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($1016)));
  TargetTex := nil;
  DepthTex := nil;
  Container := nil;
  Viewport := nil;
  Box := nil;
  Collider := nil;
  Hover := nil;
  Manipulate := nil;
  DebugTrans := nil;
  HingeJoint := nil;
  PointLight := nil;
  try
    SetRHIDevice(Device);
    ApplicationProperties.RenderBackend := backendVulkan;
    GLFeatures := nil;

    TexDesc := TRHITextureDesc.Create2D(256, 256, pfBGRA8_UNorm, [tuColorAttachment, tuTransferSrc]);
    TargetTex := Device.CreateTexture(TexDesc);
    TexDesc := TRHITextureDesc.Create2D(256, 256, pfD24_UNorm_S8_UInt, [tuDepthStencil]);
    DepthTex := Device.CreateTexture(TexDesc);

    InternalCastleApplicationMode := appDesign;

    Container := TTestHeadlessVulkanContainer.Create(nil);
    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := False;
    Viewport.Width := 256;
    Viewport.Height := 256;
    Container.Controls.InsertFront(Viewport);

    Box := TCastleBox.Create(nil);
    Box.Translation := Vector3(0, 0, -5);
    Viewport.Items.Add(Box);

    { Attach TCastleBoxCollider and activate design-time wireframe collider visualization }
    Collider := TCastleBoxCollider.Create(nil);
    Collider.AutoSize := False;
    Collider.Size := Vector3(2, 2, 2);
    Box.AddBehavior(Collider);
    Collider.InternalDesigningBegin;

    { Attach TDebugTransform (bounding box + middle axis + sphere + direction arrow) }
    DebugTrans := TDebugTransform.Create(nil);
    DebugTrans.Parent := Box;
    DebugTrans.Exists := True;

    { Attach TCastleTransformHover }
    Hover := TCastleTransformHover.Create(nil);
    Hover.Current := Box;

    { Attach TCastleHingeJoint and create its TCastleJointTool (rlFront sphere gizmo) }
    HingeJoint := TCastleHingeJoint.Create(nil);
    HingeJoint.Anchor := Vector3(0.5, 0.5, 0);
    Box.AddBehavior(HingeJoint);
    HingeJoint.InternalCreateGizmos;

    { Attach TCastlePointLight in CastleDesignMode (creates TInternalCastleEditorGizmo with billboard icon + lines) }
    PointLight := TCastlePointLight.Create(nil);
    PointLight.Translation := Vector3(-1, 1, -4);
    Viewport.Items.Add(PointLight);

    { Create TCastleTransformManipulate and select Box }
    Manipulate := TCastleTransformManipulate.Create(nil);
    Manipulate.SetSelected([Box]);

    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 256, 256);

    Cmd := Device.BeginFrame as TVulkanRHICommandList;
    SetActiveCommandList(Cmd);
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 256, 256),
      TargetTex, loClear, Vector4(0, 0, 0, 1),
      DepthTex, loClear, 1.0);
    Cmd.BeginRendering(PassInfo);

    { 1. Render with mmSelect }
    Manipulate.Mode := mmSelect;
    DrawsBefore := Cmd.PushConstantCallCount;
    ViewportUpdatesBefore := RenderContext.RHIViewportUpdateCount;
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    AssertTrue('Rendering Box + Collider wireframe + TDebugTransform + Hover + JointTool + PointLight gizmo must record RHI shape draws',
      Cmd.PushConstantCallCount >= DrawsBefore + 6);
    AssertTrue('rlFront gizmos must trigger RenderContext DepthRange (drNear -> drFull) RHI viewport updates',
      RenderContext.RHIViewportUpdateCount > ViewportUpdatesBefore);

    { 2. Render with mmTranslate gizmo }
    Manipulate.Mode := mmTranslate;
    DrawsBefore := Cmd.PushConstantCallCount;
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    AssertTrue('Manipulate.Mode = mmTranslate must record gizmo RHI shape draws',
      Cmd.PushConstantCallCount > DrawsBefore + 6);

    { 3. Render with mmRotate gizmo }
    Manipulate.Mode := mmRotate;
    DrawsBefore := Cmd.PushConstantCallCount;
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    AssertTrue('Manipulate.Mode = mmRotate must record gizmo RHI shape draws',
      Cmd.PushConstantCallCount > DrawsBefore + 6);

    { 4. Render with mmScale gizmo }
    Manipulate.Mode := mmScale;
    DrawsBefore := Cmd.PushConstantCallCount;
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    AssertTrue('Manipulate.Mode = mmScale must record gizmo RHI shape draws',
      Cmd.PushConstantCallCount > DrawsBefore + 6);

    HingeJoint.InternalDestroyGizmos;
    Collider.InternalDesigningEnd;
    Manipulate.SetSelected([]);
    Hover.Current := nil;

    Cmd.EndRendering;
    Device.EndFrameAndPresent;
  finally
    InternalCastleApplicationMode := SavedAppMode;
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    FreeAndNil(Manipulate);
    FreeAndNil(Hover);
    FreeAndNil(DebugTrans);
    FreeAndNil(PointLight);
    FreeAndNil(HingeJoint);
    FreeAndNil(Collider);
    FreeAndNil(Box);
    FreeAndNil(Viewport);
    FreeAndNil(Container);
    FreeAndNil(DepthTex);
    FreeAndNil(TargetTex);
    FreeGlobalBatch2DRenderer;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(Device);
  end;
end;

procedure TTestCastleVulkanRHI.TestConstantBlendFactorsAndBlendConstantsDynamicStateRHI;
var
  Device: TVulkanRHIDevice;
  SavedBackend: TRenderBackend;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  Cmd: TVulkanRHICommandList;
  TargetTex, DepthTex: TRHITexture;
  PassInfo: TRHIRenderingInfo;
  Container: TTestHeadlessVulkanContainer;
  Viewport: TCastleViewport;
  Scene: TCastleScene;
  Root: TX3DRootNode;
  ShapeNode: TShapeNode;
  AppNode: TAppearanceNode;
  MatNode: TMaterialNode;
  BlendNode: TBlendModeNode;
  BoxNode: TBoxNode;
  DrawImg: TDrawableImage;
  SrcImage: TRGBAlphaImage;
  UpdatesBefore: Cardinal;
begin
  { 1. Verify TRenderContext.MapBlendSourceFactorToRHI and MapBlendDestFactorToRHI }
  AssertEquals('bsConstantColor -> bfConstantColor',
    Ord(bfConstantColor), Ord(TRenderContext.MapBlendSourceFactorToRHI(bsConstantColor)));
  AssertEquals('bsOneMinusConstantColor -> bfOneMinusConstantColor',
    Ord(bfOneMinusConstantColor), Ord(TRenderContext.MapBlendSourceFactorToRHI(bsOneMinusConstantColor)));
  AssertEquals('bsConstantAlpha -> bfConstantAlpha',
    Ord(bfConstantAlpha), Ord(TRenderContext.MapBlendSourceFactorToRHI(bsConstantAlpha)));
  AssertEquals('bsOneMinusConstantAlpha -> bfOneMinusConstantAlpha',
    Ord(bfOneMinusConstantAlpha), Ord(TRenderContext.MapBlendSourceFactorToRHI(bsOneMinusConstantAlpha)));
  AssertEquals('bsSrcAlphaSaturate -> bfSrcAlphaSaturate',
    Ord(bfSrcAlphaSaturate), Ord(TRenderContext.MapBlendSourceFactorToRHI(bsSrcAlphaSaturate)));

  AssertEquals('bdConstantColor -> bfConstantColor',
    Ord(bfConstantColor), Ord(TRenderContext.MapBlendDestFactorToRHI(bdConstantColor)));
  AssertEquals('bdOneMinusConstantColor -> bfOneMinusConstantColor',
    Ord(bfOneMinusConstantColor), Ord(TRenderContext.MapBlendDestFactorToRHI(bdOneMinusConstantColor)));
  AssertEquals('bdConstantAlpha -> bfConstantAlpha',
    Ord(bfConstantAlpha), Ord(TRenderContext.MapBlendDestFactorToRHI(bdConstantAlpha)));
  AssertEquals('bdOneMinusConstantAlpha -> bfOneMinusConstantAlpha',
    Ord(bfOneMinusConstantAlpha), Ord(TRenderContext.MapBlendDestFactorToRHI(bdOneMinusConstantAlpha)));

  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($1017)));
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;
  TargetTex := nil;
  DepthTex := nil;
  Container := nil;
  Viewport := nil;
  Scene := nil;
  DrawImg := nil;
  try
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(Device);
    GLFeatures := nil;

    TargetTex := Device.CreateTexture(TRHITextureDesc.Create2D(256, 256, pfRGBA8_UNorm, [tuColorAttachment, tuSampled]));
    DepthTex := Device.CreateTexture(TRHITextureDesc.Create2D(256, 256, pfD24_UNorm_S8_UInt, [tuDepthStencil]));

    Container := TTestHeadlessVulkanContainer.Create(nil);
    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 256, 256);

    Cmd := Device.BeginFrame as TVulkanRHICommandList;
    SetActiveCommandList(Cmd);
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 256, 256),
      TargetTex, loClear, Vector4(0, 0, 0, 1),
      DepthTex, loClear, 1.0);
    Cmd.BeginRendering(PassInfo);

    { 2. Verify RenderContext.BlendingConstantColor dynamic state propagation }
    UpdatesBefore := Cmd.BlendConstantsUpdateCount;
    RenderContext.BlendingConstantColor := Vector4(0.2, 0.4, 0.6, 0.8);
    AssertEquals('BlendingConstantColor must increment Cmd.BlendConstantsUpdateCount',
      UpdatesBefore + 1, Cmd.BlendConstantsUpdateCount);
    AssertVectorEquals(Vector4(0.2, 0.4, 0.6, 0.8), Cmd.DynamicBlendConstants, 0.0001);
    AssertVectorEquals(Vector4(0.2, 0.4, 0.6, 0.8), RenderContext.RHILastBlendConstantColor, 0.0001);

    { 3. Verify TBlendModeNode constant color/transparency in TCastleScene }
    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := False;
    Viewport.Width := 256;
    Viewport.Height := 256;
    Container.Controls.InsertFront(Viewport);
    Viewport.Camera.SetView(Vector3(0, 0, 5), Vector3(0, 0, -1), Vector3(0, 1, 0));

    Root := TX3DRootNode.Create;
    ShapeNode := TShapeNode.Create;
    AppNode := TAppearanceNode.Create;
    MatNode := TMaterialNode.Create;
    MatNode.DiffuseColor := Vector3(1, 1, 1);
    MatNode.Transparency := 0.3;
    AppNode.Material := MatNode;

    BlendNode := TBlendModeNode.Create;
    BlendNode.SrcFactor := bsConstantColor;
    BlendNode.DestFactor := bdOneMinusConstantAlpha;
    BlendNode.FdColor.Value := Vector3(0.25, 0.5, 0.75);
    BlendNode.FdColorTransparency.Value := 0.2;
    AppNode.BlendMode := BlendNode;

    ShapeNode.Appearance := AppNode;
    BoxNode := TBoxNode.Create;
    ShapeNode.Geometry := BoxNode;
    Root.AddChildren(ShapeNode);

    Scene := TCastleScene.Create(nil);
    Scene.Load(Root, True);
    Viewport.Items.Add(Scene);

    UpdatesBefore := Cmd.BlendConstantsUpdateCount;
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    AssertTrue('TBlendModeNode rendering must update VkCmd.BlendConstantsUpdateCount',
      Cmd.BlendConstantsUpdateCount > UpdatesBefore);
    AssertVectorEquals(Vector4(0.25, 0.5, 0.75, 0.8), Cmd.DynamicBlendConstants, 0.0001);

    { 4. Verify TDrawableImage with constant blend factors and BlendingConstantColor }
    SrcImage := TRGBAlphaImage.Create(16, 16);
    SrcImage.Clear(Vector4Byte(255, 128, 64, 200));
    DrawImg := TDrawableImage.Create(SrcImage, True, True);
    DrawImg.Alpha := acBlending;
    DrawImg.BlendingSourceFactor := bsConstantAlpha;
    DrawImg.BlendingDestinationFactor := bdOneMinusConstantAlpha;
    DrawImg.BlendingConstantColor := Vector4(0.1, 0.3, 0.5, 0.7);

    UpdatesBefore := Cmd.BlendConstantsUpdateCount;
    DrawImg.Draw(10, 10);
    AssertTrue('TDrawableImage with constant blend factor must update VkCmd.BlendConstantsUpdateCount',
      Cmd.BlendConstantsUpdateCount > UpdatesBefore);
    AssertVectorEquals(Vector4(0.1, 0.3, 0.5, 0.7), Cmd.DynamicBlendConstants, 0.0001);

    Cmd.EndRendering;
    Device.EndFrameAndPresent;
  finally
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    FreeAndNil(DrawImg);
    FreeAndNil(Scene);
    FreeAndNil(Viewport);
    FreeAndNil(Container);
    FreeAndNil(DepthTex);
    FreeAndNil(TargetTex);
    FreeGlobalBatch2DRenderer;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(Device);
  end;
end;

procedure TTestCastleVulkanRHI.TestInputOnlyShaderEventsAndLiveRouteUniformsRHI;
var
  Device: TVulkanRHIDevice;
  SavedBackend: TRenderBackend;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  Cmd: TVulkanRHICommandList;
  TargetTex, DepthTex: TRHITexture;
  PassInfo: TRHIRenderingInfo;
  Container: TTestHeadlessVulkanContainer;
  Viewport: TCastleViewport;
  Scene: TCastleScene;
  Root: TX3DRootNode;
  ShapeNode: TShapeNode;
  AppNode: TAppearanceNode;
  MatNode: TMaterialNode;
  EffectNode: TEffectNode;
  EffectPart: TEffectPartNode;
  IDeclFloat: TX3DInterfaceDeclaration;
  IDeclVec3: TX3DInterfaceDeclaration;
  EventFloat: TSFFloatEvent;
  EventVec3: TSFVec3fEvent;
  ScalarInterp: TScalarInterpolatorNode;
  PosInterp: TPositionInterpolatorNode;
  RouteFloat, RouteVec3: TX3DRoute;
  GLSLShape: TX3DRendererShape;
  MappedPtr: Pointer;
  FloatPtr: PSingle;
const
  NL = LineEnding;
begin
  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($1018)));
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;
  TargetTex := nil;
  DepthTex := nil;
  Container := nil;
  Viewport := nil;
  Scene := nil;
  try
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(Device);
    GLFeatures := nil;

    TargetTex := Device.CreateTexture(TRHITextureDesc.Create2D(256, 256, pfRGBA8_UNorm, [tuColorAttachment, tuSampled]));
    DepthTex := Device.CreateTexture(TRHITextureDesc.Create2D(256, 256, pfD24_UNorm_S8_UInt, [tuDepthStencil]));

    Container := TTestHeadlessVulkanContainer.Create(nil);
    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := False;
    Viewport.Width := 256;
    Viewport.Height := 256;
    Container.Controls.InsertFront(Viewport);
    Viewport.Camera.SetView(Vector3(0, 0, 5), Vector3(0, 0, -1), Vector3(0, 1, 0));

    Root := TX3DRootNode.Create;

    { Create TEffectNode with two inputOnly (eventIn) interface declarations:
      inputOnly SFFloat u_pulse
      inputOnly SFVec3f u_tint }
    EffectNode := TEffectNode.Create;
    EffectNode.Language := slGLSL;

    IDeclFloat := TX3DInterfaceDeclaration.Create(EffectNode);
    EventFloat := TSFFloatEvent.Create(EffectNode, 'u_pulse', True);
    IDeclFloat.FieldOrEvent := EventFloat;
    EffectNode.InterfaceDeclarations.Add(IDeclFloat);
    IDeclFloat.AddFieldOrEvent(EffectNode);

    IDeclVec3 := TX3DInterfaceDeclaration.Create(EffectNode);
    EventVec3 := TSFVec3fEvent.Create(EffectNode, 'u_tint', True);
    IDeclVec3.FieldOrEvent := EventVec3;
    EffectNode.InterfaceDeclarations.Add(IDeclVec3);
    IDeclVec3.AddFieldOrEvent(EffectNode);

    EffectPart := TEffectPartNode.Create;
    EffectPart.ShaderType := stFragment;
    EffectPart.Contents :=
      'uniform float u_pulse;' + NL +
      'uniform vec3 u_tint;' + NL +
      'void PLUG_fragment_modify(inout vec4 fragment_color) {' + NL +
      '  fragment_color.rgb = fragment_color.rgb * u_tint + vec3(u_pulse);' + NL +
      '}';
    EffectNode.FdParts.Add(EffectPart);

    { Verify inputOnly TX3DEvent.SendNeeded is True in headless RHI mode (GLFeatures = nil) }
    AssertTrue('inputOnly shader interface event must report SendNeeded = True even when GLFeatures = nil',
      EventFloat.SendNeeded);
    AssertTrue('IDeclFloat.FieldOrLastEventValue must return default TSFFloat before any event arrives',
      IDeclFloat.FieldOrLastEventValue is TSFFloat);
    AssertSameValue(0.0, (IDeclFloat.FieldOrLastEventValue as TSFFloat).Value, 0.0001);

    { Set up X3D ROUTEs from ScalarInterpolator and ColorInterpolator into inputOnly shader events }
    ScalarInterp := TScalarInterpolatorNode.Create;
    ScalarInterp.FdKey.Items.AddRange([0.0, 1.0]);
    ScalarInterp.FdKeyValue.Items.AddRange([0.0, 0.8]);
    Root.AddChildren(ScalarInterp);

    PosInterp := TPositionInterpolatorNode.Create;
    PosInterp.FdKey.Items.AddRange([0.0, 1.0]);
    PosInterp.FdKeyValue.Items.AddRange([Vector3(0.0, 0.0, 0.0), Vector3(0.2, 0.6, 1.0)]);
    Root.AddChildren(PosInterp);

    ShapeNode := TShapeNode.Create;
    AppNode := TAppearanceNode.Create;
    MatNode := TMaterialNode.Create;
    MatNode.DiffuseColor := Vector3(1, 1, 1);
    AppNode.Material := MatNode;
    AppNode.FdEffects.Add(EffectNode);
    ShapeNode.Appearance := AppNode;
    ShapeNode.Geometry := TBoxNode.Create;
    Root.AddChildren(ShapeNode);

    RouteFloat := TX3DRoute.Create;
    RouteFloat.SetSourceDirectly(ScalarInterp.EventValue_Changed);
    RouteFloat.SetDestinationDirectly(EventFloat);
    Root.AddRoute(RouteFloat);

    RouteVec3 := TX3DRoute.Create;
    RouteVec3.SetSourceDirectly(PosInterp.EventValue_Changed);
    RouteVec3.SetDestinationDirectly(EventVec3);
    Root.AddRoute(RouteVec3);

    Scene := TCastleScene.Create(nil);
    Scene.Load(Root, True);
    Scene.ProcessEvents := True;
    Viewport.Items.Add(Scene);

    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 256, 256);

    Cmd := Device.BeginFrame as TVulkanRHICommandList;
    SetActiveCommandList(Cmd);
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 256, 256),
      TargetTex, loClear, Vector4(0, 0, 0, 1),
      DepthTex, loClear, 1.0);
    Cmd.BeginRendering(PassInfo);

    { 1. Render initial frame (default inputOnly values = 0.0 and (0, 0, 0)) }
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    GLSLShape := TX3DRendererShape(Scene.Shapes.TraverseList(True)[0]);
    AssertTrue('Shape must allocate RHIUserEffectBuffer for inputOnly shader uniforms',
      GLSLShape.Cache.RHIUserEffectBuffer <> nil);

    { 2. Trigger X3D ROUTE at fraction = 0.5 -> u_pulse = 0.4, u_tint = (0.1, 0.3, 0.5) }
    ScalarInterp.EventSet_Fraction.Send(0.5, Scene.NextEventTime);
    PosInterp.EventSet_Fraction.Send(0.5, Scene.NextEventTime);

    AssertSameValue(0.4, (IDeclFloat.FieldOrLastEventValue as TSFFloat).Value, 0.0001);
    AssertVectorEquals(Vector3(0.1, 0.3, 0.5), (IDeclVec3.FieldOrLastEventValue as TSFVec3f).Value, 0.0001);

    { 3. Render second frame and verify mapped RHIUserEffectBuffer std140 contents }
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    MappedPtr := GLSLShape.Cache.RHIUserEffectBuffer.Map;
    try
      { std140 layout:
        float u_pulse at offset 0 (4 bytes)
        padding at 4..15
        vec3 u_tint at offset 16 (12 bytes) }
      FloatPtr := PSingle(MappedPtr);
      AssertSameValue(0.4, FloatPtr^, 0.0001);
      FloatPtr := PSingle(PtrUInt(MappedPtr) + 16);
      AssertSameValue(0.1, FloatPtr^, 0.0001);
      Inc(FloatPtr);
      AssertSameValue(0.3, FloatPtr^, 0.0001);
      Inc(FloatPtr);
      AssertSameValue(0.5, FloatPtr^, 0.0001);
    finally
      GLSLShape.Cache.RHIUserEffectBuffer.Unmap;
    end;

    Cmd.EndRendering;
    Device.EndFrameAndPresent;
  finally
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    FreeAndNil(Scene);
    FreeAndNil(Viewport);
    FreeAndNil(Container);
    FreeAndNil(DepthTex);
    FreeAndNil(TargetTex);
    FreeGlobalBatch2DRenderer;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(Device);
  end;
end;

procedure TTestCastleVulkanRHI.TestLitPointSetLineSetWithNormalsAndDynamicUnlitEmissiveRHI;
var
  Device: TVulkanRHIDevice;
  SavedBackend: TRenderBackend;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  Cmd: TVulkanRHICommandList;
  TargetTex, DepthTex: TRHITexture;
  PassInfo: TRHIRenderingInfo;
  Container: TTestHeadlessVulkanContainer;
  Viewport: TCastleViewport;
  Scene: TCastleScene;
  Root: TX3DRootNode;
  ShapePointsLit, ShapeLinesLit, ShapeLinesUnlit: TShapeNode;
  AppPointsLit, AppLinesLit, AppLinesUnlit: TAppearanceNode;
  MatPointsLit, MatLinesUnlit: TMaterialNode;
  PhysMatLinesLit: TPhysicalMaterialNode;
  PointSetLit: TPointSetNode;
  LineSetLit, LineSetUnlit: TLineSetNode;
  CoordPoints, CoordLines1, CoordLines2: TCoordinateNode;
  NormPoints, NormLines: TNormalNode;
  ShapesList: TShapeList;
  GLSLPointsLit, GLSLLinesLit, GLSLLinesUnlit: TX3DRendererShape;
  MappedMat: PCastleMaterialUniformBlock;
  MatBlock: TCastleMaterialUniformBlock;
  ShadingModel: TCastleShadingModelRHI;
  ArraysPoints: TGeometryArrays;
begin
  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($1019)));
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;
  TargetTex := nil;
  DepthTex := nil;
  Container := nil;
  Viewport := nil;
  Scene := nil;
  try
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(Device);
    GLFeatures := nil;

    TargetTex := Device.CreateTexture(TRHITextureDesc.Create2D(256, 256, pfRGBA8_UNorm, [tuColorAttachment, tuSampled]));
    DepthTex := Device.CreateTexture(TRHITextureDesc.Create2D(256, 256, pfD24_UNorm_S8_UInt, [tuDepthStencil]));

    Container := TTestHeadlessVulkanContainer.Create(nil);
    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := False;
    Viewport.Width := 256;
    Viewport.Height := 256;
    Container.Controls.InsertFront(Viewport);
    Viewport.Camera.SetView(Vector3(0, 0, 5), Vector3(0, 0, -1), Vector3(0, 1, 0));

    Root := TX3DRootNode.Create;

    { 1. Lit TPointSetNode with explicit TNormalNode and TMaterialNode (Phong) }
    ShapePointsLit := TShapeNode.Create;
    AppPointsLit := TAppearanceNode.Create;
    MatPointsLit := TMaterialNode.Create;
    MatPointsLit.DiffuseColor := Vector3(0.2, 0.6, 0.9);
    AppPointsLit.Material := MatPointsLit;
    ShapePointsLit.Appearance := AppPointsLit;

    PointSetLit := TPointSetNode.Create;
    CoordPoints := TCoordinateNode.Create;
    CoordPoints.SetPoint([Vector3(-1, 0, 0), Vector3(1, 0, 0)]);
    PointSetLit.Coord := CoordPoints;
    NormPoints := TNormalNode.Create;
    NormPoints.SetVector([Vector3(0, 0, 1), Vector3(0, 1, 0)]);
    PointSetLit.Normal := NormPoints;
    ShapePointsLit.Geometry := PointSetLit;
    Root.AddChildren(ShapePointsLit);

    { 2. Lit TLineSetNode with explicit TNormalNode and TPhysicalMaterialNode (PBR) }
    ShapeLinesLit := TShapeNode.Create;
    AppLinesLit := TAppearanceNode.Create;
    PhysMatLinesLit := TPhysicalMaterialNode.Create;
    PhysMatLinesLit.BaseColor := Vector3(0.8, 0.4, 0.1);
    AppLinesLit.Material := PhysMatLinesLit;
    ShapeLinesLit.Appearance := AppLinesLit;

    LineSetLit := TLineSetNode.Create;
    CoordLines1 := TCoordinateNode.Create;
    CoordLines1.SetPoint([Vector3(-1, 1, 0), Vector3(1, 1, 0)]);
    LineSetLit.Coord := CoordLines1;
    LineSetLit.SetVertexCount([2]);
    NormLines := TNormalNode.Create;
    NormLines.SetVector([Vector3(0, 0, 1), Vector3(0, 0, 1)]);
    LineSetLit.Normal := NormLines;
    ShapeLinesLit.Geometry := LineSetLit;
    Root.AddChildren(ShapeLinesLit);

    { 3. Unlit TLineSetNode (no Normal node) with TMaterialNode whose EmissiveColor changes dynamically }
    ShapeLinesUnlit := TShapeNode.Create;
    AppLinesUnlit := TAppearanceNode.Create;
    MatLinesUnlit := TMaterialNode.Create;
    MatLinesUnlit.EmissiveColor := Vector3(1.0, 0.0, 0.0);
    MatLinesUnlit.Transparency := 0.0;
    AppLinesUnlit.Material := MatLinesUnlit;
    ShapeLinesUnlit.Appearance := AppLinesUnlit;

    LineSetUnlit := TLineSetNode.Create;
    CoordLines2 := TCoordinateNode.Create;
    CoordLines2.SetPoint([Vector3(-1, -1, 0), Vector3(1, -1, 0)]);
    LineSetUnlit.Coord := CoordLines2;
    LineSetUnlit.SetVertexCount([2]);
    ShapeLinesUnlit.Geometry := LineSetUnlit;
    Root.AddChildren(ShapeLinesUnlit);

    Scene := TCastleScene.Create(nil);
    Scene.Load(Root, True);
    Viewport.Items.Add(Scene);

    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 256, 256);

    Cmd := Device.BeginFrame as TVulkanRHICommandList;
    SetActiveCommandList(Cmd);
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 256, 256),
      TargetTex, loClear, Vector4(0, 0, 0, 1),
      DepthTex, loClear, 1.0);
    Cmd.BeginRendering(PassInfo);

    { Render Frame 1 }
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));

    ShapesList := Scene.Shapes.TraverseList(True);
    AssertEquals('Scene must have 3 active shapes', 3, ShapesList.Count);
    GLSLPointsLit := TX3DRendererShape(ShapesList[0]);
    GLSLLinesLit := TX3DRendererShape(ShapesList[1]);
    GLSLLinesUnlit := TX3DRendererShape(ShapesList[2]);

    { Verify Shape 0: Lit PointSet with explicit normals }
    AssertTrue('PointSet with explicit Normal node must have Lit = True',
      GLSLPointsLit.Node.Geometry.Lit(GLSLPointsLit.State));
    GLSLPointsLit.ExtractRHIMaterialBlock(MatBlock, ShadingModel);
    AssertEquals('PointSet with explicit Normal node and Material must use smPhong (not smUnlit)',
      Ord(smPhong), Ord(ShadingModel));
    ArraysPoints := GLSLPointsLit.GeometryArrays;
    try
      AssertFalse('PointSet with explicit Normal node must have ForceUnlit = False',
        ArraysPoints.ForceUnlit);
      AssertVectorEquals(Vector3(0, 0, 1), ArraysPoints.Normal(0)^, 0.0001);
      AssertVectorEquals(Vector3(0, 1, 0), ArraysPoints.Normal(1)^, 0.0001);
    finally
      FreeAndNil(ArraysPoints);
    end;
    MappedMat := PCastleMaterialUniformBlock(GLSLPointsLit.Cache.RHIMaterialBuffer.Map);
    try
      AssertVectorEquals(Vector4(0.2, 0.6, 0.9, 1.0), MappedMat^.BaseColor, 0.0001);
    finally
      GLSLPointsLit.Cache.RHIMaterialBuffer.Unmap;
    end;

    { Verify Shape 1: Lit LineSet with explicit normals and PhysicalMaterial }
    AssertTrue('LineSet with explicit Normal node must have Lit = True',
      GLSLLinesLit.Node.Geometry.Lit(GLSLLinesLit.State));
    GLSLLinesLit.ExtractRHIMaterialBlock(MatBlock, ShadingModel);
    AssertEquals('LineSet with explicit Normal node and PhysicalMaterial must use smPBRMetallicRoughness (not smUnlit)',
      Ord(smPBRMetallicRoughness), Ord(ShadingModel));
    MappedMat := PCastleMaterialUniformBlock(GLSLLinesLit.Cache.RHIMaterialBuffer.Map);
    try
      AssertVectorEquals(Vector4(0.8, 0.4, 0.1, 1.0), MappedMat^.BaseColor, 0.0001);
    finally
      GLSLLinesLit.Cache.RHIMaterialBuffer.Unmap;
    end;

    { Verify Shape 2: Unlit LineSet initial ForcedUnlitColor = (1, 0, 0, 1) }
    AssertFalse('LineSet without Normal node must have Lit = False',
      GLSLLinesUnlit.Node.Geometry.Lit(GLSLLinesUnlit.State));
    GLSLLinesUnlit.ExtractRHIMaterialBlock(MatBlock, ShadingModel);
    AssertEquals('LineSet without Normal node must use smUnlit',
      Ord(smUnlit), Ord(ShadingModel));
    MappedMat := PCastleMaterialUniformBlock(GLSLLinesUnlit.Cache.RHIMaterialBuffer.Map);
    try
      AssertVectorEquals(Vector4(1.0, 0.0, 0.0, 1.0), MappedMat^.BaseColor, 0.0001);
    finally
      GLSLLinesUnlit.Cache.RHIMaterialBuffer.Unmap;
    end;

    { Dynamically mutate MatLinesUnlit.EmissiveColor and Transparency without regenerating arrays }
    MatLinesUnlit.EmissiveColor := Vector3(0.0, 1.0, 0.0);
    MatLinesUnlit.Transparency := 0.4;
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));

    MappedMat := PCastleMaterialUniformBlock(GLSLLinesUnlit.Cache.RHIMaterialBuffer.Map);
    try
      AssertVectorEquals(Vector4(0.0, 1.0, 0.0, 0.6), MappedMat^.BaseColor, 0.0001);
    finally
      GLSLLinesUnlit.Cache.RHIMaterialBuffer.Unmap;
    end;

    Cmd.EndRendering;
    Device.EndFrameAndPresent;
  finally
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    FreeAndNil(Scene);
    FreeAndNil(Viewport);
    FreeAndNil(Container);
    FreeAndNil(DepthTex);
    FreeAndNil(TargetTex);
    FreeGlobalBatch2DRenderer;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(Device);
  end;
end;

procedure TTestCastleVulkanRHI.TestViewportShadowVolumesMultiPassSet0SlotsAndRealLavapipeStencilRHI;
const
  // Valid SPIR-V 1.0 Vertex Shader: layout(location = 0) in vec4 inPos -> gl_Position = inPos
  MinimalVertSPIRV: array[0..92] of Cardinal = (
    $07230203, $00010000, $00000000, $00000011, $00000000,
    $00020011, 1,
    $0003000E, 0, 1,
    $0007000F, 0, 1, $6E69616D, $00000000, 8, 11,
    $00050048, 6, 0, 11, 0,
    $00030047, 6, 2,
    $00040047, 11, 30, 0,
    $00020013, 2,
    $00030021, 3, 2,
    $00030016, 4, 32,
    $00040017, 5, 4, 4,
    $0003001E, 6, 5,
    $00040020, 7, 3, 6,
    $0004003B, 7, 8, 3,
    $00040015, 9, 32, 1,
    $0004002B, 9, 10, 0,
    $00040020, 12, 1, 5,
    $0004003B, 12, 11, 1,
    $00040020, 13, 3, 5,
    $00050036, 2, 1, 0, 3,
    $000200F8, 14,
    $0004003D, 5, 15, 11,
    $00050041, 13, 16, 8, 10,
    $0003003E, 16, 15,
    $000100FD,
    $00010038
  );
  // Valid SPIR-V 1.0 Fragment Shader: PushConstant vec4 color -> location 0 out vec4 outColor
  MinimalPushColorFragSPIRV: array[0..94] of Cardinal = (
    $07230203, $00010000, $00000000, $00000011, $00000000,
    $00020011, 1,
    $0003000E, 0, 1,
    $0006000F, 4, 1, $6E69616D, $00000000, 7,
    $00030010, 1, 7,
    $00040047, 7, 30, 0,
    $00050048, 8, 0, 35, 0,
    $00030047, 8, 2,
    $00020013, 2,
    $00030021, 3, 2,
    $00030016, 4, 32,
    $00040017, 5, 4, 4,
    $00040020, 6, 3, 5,
    $0004003B, 6, 7, 3,
    $0003001E, 8, 5,
    $00040020, 9, 9, 8,
    $0004003B, 9, 10, 9,
    $00040015, 11, 32, 1,
    $0004002B, 11, 12, 0,
    $00040020, 13, 9, 5,
    $00050036, 2, 1, 0, 3,
    $000200F8, 14,
    $00050041, 13, 15, 10, 12,
    $0004003D, 5, 16, 15,
    $0003003E, 7, 16,
    $000100FD,
    $00010038
  );
var
  Device, RealDev: TVulkanRHIDevice;
  SavedRHI: TRHIDevice;
  SavedBackend: TRenderBackend;
  SavedCmd, Cmd, RealCmd: TRHICommandList;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  Container: TTestHeadlessVulkanContainer;
  Viewport: TCastleViewport;
  PointLight: TCastlePointLight;
  CasterScene, ReceiverScene: TCastleScene;
  CasterRoot, ReceiverRoot: TX3DRootNode;
  CasterShape, ReceiverShape: TShapeNode;
  CasterApp, ReceiverApp: TAppearanceNode;
  CasterMat, ReceiverMat: TMaterialNode;
  TargetTex, DepthTex, RealColorTex, RealDepthStencilTex: TRHITexture;
  TexDesc: TRHITextureDesc;
  RenderInfo: TRHIRenderingInfo;
  Renderer: TRenderer;
  HasLitSlot, HasShadowAmbientSlot: Boolean;
  SlotIdx: Cardinal;
  SlotBlock: TCastleSceneUniformBlock;
  FullQuadVerts, LeftShadowQuadVerts: array[0..5] of TVector4;
  FullVBO, LeftVBO: TRHIBuffer;
  VBODesc: TRHIBufferDesc;
  VertMod, FragMod: TRHIShaderModule;
  BasePipeDesc, StencilVolPipeDesc, LitPipeDesc: TRHIGraphicsPipelineDesc;
  BasePipe, StencilVolPipe, LitPipe: TRHIPipeline;
  PushColor: TVector4;
  ReadImg: TRGBAlphaImage;
  ShadowPix, LitPix, ScissorPix: TVector4Byte;
begin
  { Part 1: Headless viewport Stencil Shadow Volumes multi-pass Set 0 UBO slot preservation }
  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($A104)), True, True);
  SavedRHI := RHIDevice;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedCmd := ActiveCommandList;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;
  Container := nil;
  Viewport := nil;
  PointLight := nil;
  CasterScene := nil;
  ReceiverScene := nil;
  TargetTex := nil;
  DepthTex := nil;
  try
    GLFeatures := nil;
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(Device);

    FillChar(TexDesc, SizeOf(TexDesc), 0);
    TexDesc.Dimension := td2D;
    TexDesc.Width := 256;
    TexDesc.Height := 256;
    TexDesc.DepthOrArrayLayers := 1;
    TexDesc.MipLevels := 1;
    TexDesc.SampleCount := 1;
    TexDesc.Format := pfRGBA8_UNorm;
    TexDesc.Usage := [tuColorAttachment, tuSampled, tuTransferSrc];
    TargetTex := Device.CreateTexture(TexDesc);

    TexDesc.Format := pfD24_UNorm_S8_UInt;
    TexDesc.Usage := [tuDepthStencil];
    DepthTex := Device.CreateTexture(TexDesc);

    Container := TTestHeadlessVulkanContainer.Create(nil);
    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 256, 256);

    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := False;
    Viewport.Width := 256;
    Viewport.Height := 256;
    Viewport.ShadowVolumes := True;
    Viewport.ShadowVolumesRender := True;
    Viewport.Camera.SetView(
      Vector3(0.0, 2.0, 8.0),
      Vector3(0.0, -0.2, -1.0).Normalize,
      Vector3(0.0, 1.0, 0.0));
    Container.Controls.InsertFront(Viewport);

    PointLight := TCastlePointLight.Create(Viewport);
    PointLight.Translation := Vector3(0.0, 6.0, 2.0);
    PointLight.Shadows := True;
    Viewport.Items.Add(PointLight);

    CasterRoot := TX3DRootNode.Create;
    CasterApp := TAppearanceNode.Create;
    CasterMat := TMaterialNode.Create;
    CasterMat.DiffuseColor := Vector3(0.8, 0.2, 0.2);
    CasterApp.Material := CasterMat;
    CasterShape := TShapeNode.Create;
    CasterShape.Appearance := CasterApp;
    CasterShape.Geometry := TBoxNode.Create;
    TBoxNode(CasterShape.Geometry).Size := Vector3(1.5, 1.5, 1.5);
    CasterRoot.AddChildren(CasterShape);

    CasterScene := TCastleScene.Create(Viewport);
    CasterScene.Load(CasterRoot, True);
    CasterScene.Translation := Vector3(0.0, 1.5, 0.0);
    CasterScene.CastShadows := True;
    CasterScene.ReceiveShadowVolumes := False;
    Viewport.Items.Add(CasterScene);

    ReceiverRoot := TX3DRootNode.Create;
    ReceiverApp := TAppearanceNode.Create;
    ReceiverMat := TMaterialNode.Create;
    ReceiverMat.DiffuseColor := Vector3(0.7, 0.7, 0.7);
    ReceiverApp.Material := ReceiverMat;
    ReceiverShape := TShapeNode.Create;
    ReceiverShape.Appearance := ReceiverApp;
    ReceiverShape.Geometry := TBoxNode.Create;
    TBoxNode(ReceiverShape.Geometry).Size := Vector3(8.0, 0.5, 8.0);
    ReceiverRoot.AddChildren(ReceiverShape);

    ReceiverScene := TCastleScene.Create(Viewport);
    ReceiverScene.Load(ReceiverRoot, True);
    ReceiverScene.Translation := Vector3(0.0, -1.0, 0.0);
    ReceiverScene.CastShadows := False;
    ReceiverScene.ReceiveShadowVolumes := True;
    Viewport.Items.Add(ReceiverScene);

    Cmd := Device.BeginFrame;
    SetActiveCommandList(Cmd);

    RenderInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 256, 256),
      TargetTex, loClear, Vector4(0.0, 0.0, 0.0, 1.0),
      DepthTex, loClear, 1.0);
    RenderInfo.DepthAttachment.ClearStencil := 0;
    Cmd.BeginRendering(RenderInfo);

    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));

    Cmd.EndRendering;
    Device.EndFrameAndPresent;

    AssertEquals('ShadowVolumes + ShadowVolumesRender must execute all 6 shadow-volume stages (Pass 1, Pass 2, Pass 3, Pass 4, Debug Pass, Pass 5)',
      6, Integer(Viewport.InternalShadowVolumeRenderer.RHIRenderPassCount));
    AssertTrue('Pass 3 stencil depth state must keep StencilTestEnable = True even when ShadowVolumesRender (DebugRender) = True',
      Viewport.InternalShadowVolumeRenderer.RHIStencilDepthState.StencilTestEnable);
    AssertEquals('Pass 4 lit pass stencil compare op must be coEqual against stencil == 0',
      Ord(coEqual), Ord(Viewport.InternalShadowVolumeRenderer.RHILitPassStencilDepthState.FrontStencil.CompareOp));
    AssertEquals('Pass 4 lit pass depth compare op must be coLessOrEqual',
      Ord(coLessOrEqual), Ord(Viewport.InternalShadowVolumeRenderer.RHILitPassStencilDepthState.DepthCompareOp));
    AssertTrue('ShadowVolumeRenderer debug mesh must initialize yellow 0.3 alpha color in PrepareRenderingResources',
      SameValue(Viewport.InternalShadowVolumeRenderer.Mesh.Color.W, 0.3, 1e-4));

    Renderer := Viewport.InternalShapesRenderer.Renderer;
    AssertTrue('Multi-pass shadow volume rendering must allocate at least 2 distinct Set 0 UBO slots so Pass 2 (LightCount=0) is not clobbered by Pass 4 (LightCount=1)',
      Renderer.RHISceneSlotCount >= 2);
    HasLitSlot := False;
    HasShadowAmbientSlot := False;
    for SlotIdx := 0 to Renderer.RHISceneSlotCount - 1 do
    begin
      SlotBlock := Renderer.GetRHISceneSlotSceneBlock(SlotIdx);
      if SlotBlock.LightCount = 0 then
        HasShadowAmbientSlot := True
      else if SlotBlock.LightCount >= 1 then
        HasLitSlot := True;
    end;
    AssertTrue('Set 0 slot pool must preserve Pass 2 dark ambient UBO (LightCount = 0)', HasShadowAmbientSlot);
    AssertTrue('Set 0 slot pool must preserve Pass 1/Pass 4 lit UBO (LightCount >= 1)', HasLitSlot);
  finally
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    FreeAndNil(ReceiverScene);
    FreeAndNil(CasterScene);
    FreeAndNil(PointLight);
    FreeAndNil(Viewport);
    FreeAndNil(Container);
    FreeAndNil(DepthTex);
    FreeAndNil(TargetTex);
    FreeGlobalBatch2DRenderer;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(Device);
  end;

  { Part 2: Real Offscreen Vulkan GPU Execution (Mesa Lavapipe / Hardware ICD) }
  if TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
  begin
    RealColorTex := nil;
    RealDepthStencilTex := nil;
    FullVBO := nil;
    LeftVBO := nil;
    VertMod := nil;
    FragMod := nil;
    ReadImg := nil;
    try
      FillChar(TexDesc, SizeOf(TexDesc), 0);
      TexDesc.Dimension := td2D;
      TexDesc.Width := 64;
      TexDesc.Height := 64;
      TexDesc.DepthOrArrayLayers := 1;
      TexDesc.MipLevels := 1;
      TexDesc.SampleCount := 1;
      TexDesc.Format := pfRGBA8_UNorm;
      TexDesc.Usage := [tuColorAttachment, tuTransferSrc, tuSampled];
      RealColorTex := RealDev.CreateTexture(TexDesc);

      TexDesc.Format := pfD24_UNorm_S8_UInt;
      TexDesc.Usage := [tuDepthStencil];
      RealDepthStencilTex := RealDev.CreateTexture(TexDesc);

      { Fullscreen CCW quad at Z = 0.5 }
      FullQuadVerts[0] := Vector4(-1.0, -1.0, 0.5, 1.0);
      FullQuadVerts[1] := Vector4( 1.0, -1.0, 0.5, 1.0);
      FullQuadVerts[2] := Vector4( 1.0,  1.0, 0.5, 1.0);
      FullQuadVerts[3] := Vector4(-1.0, -1.0, 0.5, 1.0);
      FullQuadVerts[4] := Vector4( 1.0,  1.0, 0.5, 1.0);
      FullQuadVerts[5] := Vector4(-1.0,  1.0, 0.5, 1.0);
      VBODesc := TRHIBufferDesc.Create(SizeOf(FullQuadVerts), [buVertex], muCpuToGpu, 'FullQuadVBO');
      FullVBO := RealDev.CreateBuffer(VBODesc, @FullQuadVerts[0]);

      { Left-half CCW shadow volume front cap at Z = 0.25 (passes depth < 0.5, increments stencil on X in [-1..0]) }
      LeftShadowQuadVerts[0] := Vector4(-1.0, -1.0, 0.25, 1.0);
      LeftShadowQuadVerts[1] := Vector4( 0.0, -1.0, 0.25, 1.0);
      LeftShadowQuadVerts[2] := Vector4( 0.0,  1.0, 0.25, 1.0);
      LeftShadowQuadVerts[3] := Vector4(-1.0, -1.0, 0.25, 1.0);
      LeftShadowQuadVerts[4] := Vector4( 0.0,  1.0, 0.25, 1.0);
      LeftShadowQuadVerts[5] := Vector4(-1.0,  1.0, 0.25, 1.0);
      VBODesc := TRHIBufferDesc.Create(SizeOf(LeftShadowQuadVerts), [buVertex], muCpuToGpu, 'LeftShadowVBO');
      LeftVBO := RealDev.CreateBuffer(VBODesc, @LeftShadowQuadVerts[0]);

      VertMod := RealDev.CreateShaderModuleFromSPIRV(
        ssVertex, @MinimalVertSPIRV[0], SizeOf(MinimalVertSPIRV), 'StencilTestVert');
      FragMod := RealDev.CreateShaderModuleFromSPIRV(
        ssFragment, @MinimalPushColorFragSPIRV[0], SizeOf(MinimalPushColorFragSPIRV), 'StencilTestFrag');

      FillChar(BasePipeDesc, SizeOf(BasePipeDesc), 0);
      BasePipeDesc.VertexShader := VertMod;
      BasePipeDesc.FragmentShader := FragMod;
      BasePipeDesc.Topology := ptTriangleList;
      SetLength(BasePipeDesc.VertexInput.Bindings, 1);
      BasePipeDesc.VertexInput.Bindings[0].Binding := 0;
      BasePipeDesc.VertexInput.Bindings[0].Stride := SizeOf(TVector4);
      SetLength(BasePipeDesc.VertexInput.Attributes, 1);
      BasePipeDesc.VertexInput.Attributes[0].Location := 0;
      BasePipeDesc.VertexInput.Attributes[0].Binding := 0;
      BasePipeDesc.VertexInput.Attributes[0].Format := vafVector4;
      BasePipeDesc.VertexInput.Attributes[0].Offset := 0;
      BasePipeDesc.Rasterizer := TRHIRasterizerStateDesc.DefaultCullBack;
      BasePipeDesc.Rasterizer.CullMode := cmNone;
      BasePipeDesc.DepthStencil := TRHIDepthStencilStateDesc.DefaultDepthTestWrite;
      BasePipeDesc.BlendState := TRHIBlendStateDesc.DefaultOpaque;
      BasePipeDesc.PushConstantSize := SizeOf(TVector4);
      BasePipeDesc.PushConstantStages := [ssFragment];
      SetLength(BasePipeDesc.ColorAttachmentFormats, 1);
      BasePipeDesc.ColorAttachmentFormats[0] := pfRGBA8_UNorm;
      BasePipeDesc.DepthAttachmentFormat := pfD24_UNorm_S8_UInt;
      BasePipeDesc.SampleCount := 1;
      BasePipe := RealDev.GetOrCreatePipeline(BasePipeDesc);

      StencilVolPipeDesc := BasePipeDesc;
      StencilVolPipeDesc.DepthStencil := TRHIDepthStencilStateDesc.DefaultStencilShadowVolumeZPass;
      StencilVolPipeDesc.BlendState := TRHIBlendStateDesc.DefaultColorMaskNone;
      StencilVolPipe := RealDev.GetOrCreatePipeline(StencilVolPipeDesc);

      LitPipeDesc := BasePipeDesc;
      LitPipeDesc.DepthStencil := TRHIDepthStencilStateDesc.DefaultStencilLitPass(0, $FF);
      LitPipe := RealDev.GetOrCreatePipeline(LitPipeDesc);

      RealCmd := RealDev.BeginFrame;
      RenderInfo := TRHIRenderingInfo.CreateColorDepth(
        Rectangle(0, 0, 64, 64),
        RealColorTex, loClear, Vector4(0.0, 0.0, 0.0, 1.0),
        RealDepthStencilTex, loClear, 1.0);
      RenderInfo.DepthAttachment.ClearStencil := 0;
      RealCmd.BeginRendering(RenderInfo);
      RealCmd.SetViewport(FloatRectangle(0, 0, 64, 64), 0.0, 1.0);
      RealCmd.SetScissor(Rectangle(0, 0, 64, 64));

      { Stage 1 (Pass 2 Ambient): Draw full receiver quad in dark gray (0.2, 0.2, 0.2, 1.0) at Z = 0.5 }
      RealCmd.BindPipeline(BasePipe);
      PushColor := Vector4(0.2, 0.2, 0.2, 1.0);
      RealCmd.PushConstants([ssFragment], 0, SizeOf(PushColor), PushColor);
      RealCmd.BindVertexBuffers(0, [FullVBO], [0]);
      RealCmd.Draw(6, 1, 0, 0);

      { Stage 2 (Pass 3 Stencil Volume): Increment stencil on left half (X in [0..31]) with color writes disabled }
      RealCmd.BindPipeline(StencilVolPipe);
      RealCmd.BindVertexBuffers(0, [LeftVBO], [0]);
      RealCmd.Draw(6, 1, 0, 0);

      { Stage 3 (Pass 4 Lit Pass): Overdraw bright green (0, 1, 0, 1) where stencil == 0 and depth <= 0.5 }
      RealCmd.BindPipeline(LitPipe);
      PushColor := Vector4(0.0, 1.0, 0.0, 1.0);
      RealCmd.PushConstants([ssFragment], 0, SizeOf(PushColor), PushColor);
      RealCmd.BindVertexBuffers(0, [FullVBO], [0]);
      RealCmd.Draw(6, 1, 0, 0);

      { Stage 4: Sub-rect vkCmdClearAttachments on columns [48..63] to pure blue (0, 0, 1, 1) }
      RealCmd.SetScissor(Rectangle(48, 0, 16, 64));
      RealCmd.ClearAttachments(True, Vector4(0.0, 0.0, 1.0, 1.0), False, 1.0, False, 0);

      RealCmd.EndRendering;
      RealDev.EndFrameAndPresent;

      AssertEquals('ClearAttachments must invoke vkCmdClearAttachments once',
        1, Integer((RealCmd as TVulkanRHICommandList).ClearAttachmentCallCount));

      ReadImg := RealDev.GrabTextureImage(RealColorTex, Rectangle(0, 0, 64, 64));
      AssertTrue('GrabTextureImage on real Vulkan offscreen device must return non-nil image', ReadImg <> nil);

      ShadowPix := ReadImg.PixelPtr(16, 32)^;
      LitPix := ReadImg.PixelPtr(40, 32)^;
      ScissorPix := ReadImg.PixelPtr(56, 32)^;

      { Left half (X=16): stencil incremented to 1 -> Pass 4 rejected -> remains dark gray (~51, 51, 51, 255) }
      AssertTrue('Shadowed left-half pixel must retain dark ambient R (~51)', Abs(Integer(ShadowPix.X) - 51) <= 2);
      AssertTrue('Shadowed left-half pixel must retain dark ambient G (~51)', Abs(Integer(ShadowPix.Y) - 51) <= 2);
      AssertTrue('Shadowed left-half pixel must retain dark ambient B (~51)', Abs(Integer(ShadowPix.Z) - 51) <= 2);

      { Middle-right zone (X=40): stencil == 0 -> Pass 4 lit green (0, 255, 0, 255) }
      AssertEquals('Lit unshadowed pixel R must be 0', 0, Integer(LitPix.X));
      AssertEquals('Lit unshadowed pixel G must be 255', 255, Integer(LitPix.Y));
      AssertEquals('Lit unshadowed pixel B must be 0', 0, Integer(LitPix.Z));

      { Far-right zone (X=56): cleared by vkCmdClearAttachments to blue (0, 0, 255, 255) }
      AssertEquals('Scissor ClearAttachments pixel R must be 0', 0, Integer(ScissorPix.X));
      AssertEquals('Scissor ClearAttachments pixel G must be 0', 0, Integer(ScissorPix.Y));
      AssertEquals('Scissor ClearAttachments pixel B must be 255', 255, Integer(ScissorPix.Z));
    finally
      FreeAndNil(ReadImg);
      FreeAndNil(FragMod);
      FreeAndNil(VertMod);
      FreeAndNil(LeftVBO);
      FreeAndNil(FullVBO);
      FreeAndNil(RealDepthStencilTex);
      FreeAndNil(RealColorTex);
      FreeAndNil(RealDev);
    end;
  end;
end;

procedure TTestCastleVulkanRHI.TestViewportOcclusionCullingInPassHostQueryResetRHI;
const
  MinimalVertSPIRV: array[0..92] of Cardinal = (
    $07230203, $00010000, $00000000, $00000011, $00000000,
    $00020011, 1,
    $0003000E, 0, 1,
    $0007000F, 0, 1, $6E69616D, $00000000, 8, 11,
    $00050048, 6, 0, 11, 0,
    $00030047, 6, 2,
    $00040047, 11, 30, 0,
    $00020013, 2,
    $00030021, 3, 2,
    $00030016, 4, 32,
    $00040017, 5, 4, 4,
    $0003001E, 6, 5,
    $00040020, 7, 3, 6,
    $0004003B, 7, 8, 3,
    $00040015, 9, 32, 1,
    $0004002B, 9, 10, 0,
    $00040020, 12, 1, 5,
    $0004003B, 12, 11, 1,
    $00040020, 13, 3, 5,
    $00050036, 2, 1, 0, 3,
    $000200F8, 14,
    $0004003D, 5, 15, 11,
    $00050041, 13, 16, 8, 10,
    $0003003E, 16, 15,
    $000100FD,
    $00010038
  );
  MinimalPushColorFragSPIRV: array[0..94] of Cardinal = (
    $07230203, $00010000, $00000000, $00000011, $00000000,
    $00020011, 1,
    $0003000E, 0, 1,
    $0006000F, 4, 1, $6E69616D, $00000000, 7,
    $00030010, 1, 7,
    $00040047, 7, 30, 0,
    $00050048, 8, 0, 35, 0,
    $00030047, 8, 2,
    $00020013, 2,
    $00030021, 3, 2,
    $00030016, 4, 32,
    $00040017, 5, 4, 4,
    $00040020, 6, 3, 5,
    $0004003B, 6, 7, 3,
    $0003001E, 8, 5,
    $00040020, 9, 9, 8,
    $0004003B, 9, 10, 9,
    $00040015, 11, 32, 1,
    $0004002B, 11, 12, 0,
    $00040020, 13, 9, 5,
    $00050036, 2, 1, 0, 3,
    $000200F8, 14,
    $00050041, 13, 15, 10, 12,
    $0004003D, 5, 16, 15,
    $0003003E, 7, 16,
    $000100FD,
    $00010038
  );
var
  Device, RealDev: TVulkanRHIDevice;
  SavedRHI: TRHIDevice;
  SavedBackend: TRenderBackend;
  SavedCmd, Cmd, RealCmd: TRHICommandList;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  Container: TTestHeadlessVulkanContainer;
  Viewport: TCastleViewport;
  FrontScene, BackScene: TCastleScene;
  FrontRoot, BackRoot: TX3DRootNode;
  FrontShape, BackShape: TShapeNode;
  TargetTex, DepthTex, RealColorTex, RealDepthTex: TRHITexture;
  TexDesc: TRHITextureDesc;
  RenderInfo: TRHIRenderingInfo;
  QueryPool: TRHIQueryPool;
  VkQueryPool: TVulkanRHIQueryPool;
  OccluderVerts, VisibleVerts, OccludedVerts: array[0..5] of TVector4;
  OccluderVBO, VisibleVBO, OccludedVBO: TRHIBuffer;
  VBODesc: TRHIBufferDesc;
  VertMod, FragMod: TRHIShaderModule;
  PipeDesc: TRHIGraphicsPipelineDesc;
  Pipe: TRHIPipeline;
  PushColor: TVector4;
  Samples: array[0..1] of UInt64;
begin
  { Part 1: Headless viewport OcclusionCulling across 2 active-pass frames uses HostResetCount (never illegal vkCmdResetQueryPool inside render pass) }
  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($A105)), True, True);
  SavedRHI := RHIDevice;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedCmd := ActiveCommandList;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;
  Container := nil;
  Viewport := nil;
  FrontScene := nil;
  BackScene := nil;
  TargetTex := nil;
  DepthTex := nil;
  try
    GLFeatures := nil;
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(Device);

    FillChar(TexDesc, SizeOf(TexDesc), 0);
    TexDesc.Dimension := td2D;
    TexDesc.Width := 256;
    TexDesc.Height := 256;
    TexDesc.DepthOrArrayLayers := 1;
    TexDesc.MipLevels := 1;
    TexDesc.SampleCount := 1;
    TexDesc.Format := pfRGBA8_UNorm;
    TexDesc.Usage := [tuColorAttachment, tuSampled];
    TargetTex := Device.CreateTexture(TexDesc);

    TexDesc.Format := pfD32_Float;
    TexDesc.Usage := [tuDepthStencil];
    DepthTex := Device.CreateTexture(TexDesc);

    Container := TTestHeadlessVulkanContainer.Create(nil);
    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 256, 256);

    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := False;
    Viewport.Width := 256;
    Viewport.Height := 256;
    Viewport.OcclusionCulling := True;
    Viewport.Camera.SetView(
      Vector3(0.0, 0.0, 8.0),
      Vector3(0.0, 0.0, -1.0),
      Vector3(0.0, 1.0, 0.0));
    Container.Controls.InsertFront(Viewport);

    FrontRoot := TX3DRootNode.Create;
    FrontShape := TShapeNode.Create;
    FrontShape.Geometry := TBoxNode.Create;
    TBoxNode(FrontShape.Geometry).Size := Vector3(3.0, 3.0, 1.0);
    FrontRoot.AddChildren(FrontShape);
    FrontScene := TCastleScene.Create(Viewport);
    FrontScene.Load(FrontRoot, True);
    FrontScene.Translation := Vector3(0.0, 0.0, 2.0);
    Viewport.Items.Add(FrontScene);

    BackRoot := TX3DRootNode.Create;
    BackShape := TShapeNode.Create;
    BackShape.Geometry := TBoxNode.Create;
    TBoxNode(BackShape.Geometry).Size := Vector3(1.0, 1.0, 1.0);
    BackRoot.AddChildren(BackShape);
    BackScene := TCastleScene.Create(Viewport);
    BackScene.Load(BackRoot, True);
    BackScene.Translation := Vector3(0.0, 0.0, -3.0);
    Viewport.Items.Add(BackScene);

    { Frame 1 inside active render pass }
    Cmd := Device.BeginFrame;
    SetActiveCommandList(Cmd);
    RenderInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 256, 256),
      TargetTex, loClear, Vector4(0.0, 0.0, 0.0, 1.0),
      DepthTex, loClear, 1.0);
    Cmd.BeginRendering(RenderInfo);
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    Cmd.EndRendering;
    Device.EndFrameAndPresent;

    { Frame 2 inside active render pass }
    Cmd := Device.BeginFrame;
    SetActiveCommandList(Cmd);
    Cmd.BeginRendering(RenderInfo);
    Container.RenderControl(Viewport, Rectangle(0, 0, 256, 256));
    Cmd.EndRendering;
    Device.EndFrameAndPresent;

    AssertTrue('Headless TVulkanRHIDevice must enable SupportsHostQueryReset',
      Device.SupportsHostQueryReset);
  finally
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    FreeAndNil(BackScene);
    FreeAndNil(FrontScene);
    FreeAndNil(Viewport);
    FreeAndNil(Container);
    FreeAndNil(DepthTex);
    FreeAndNil(TargetTex);
    FreeGlobalBatch2DRenderer;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(Device);
  end;

  { Part 2: Real Offscreen Vulkan GPU Hardware Occlusion Queries + In-Pass Host Query Reset (Mesa Lavapipe) }
  if TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
  begin
    RealColorTex := nil;
    RealDepthTex := nil;
    QueryPool := nil;
    OccluderVBO := nil;
    VisibleVBO := nil;
    OccludedVBO := nil;
    VertMod := nil;
    FragMod := nil;
    try
      AssertTrue('Real offscreen Vulkan device must support hostQueryReset on Vulkan 1.2+ / VK_EXT_host_query_reset',
        RealDev.SupportsHostQueryReset);

      FillChar(TexDesc, SizeOf(TexDesc), 0);
      TexDesc.Dimension := td2D;
      TexDesc.Width := 64;
      TexDesc.Height := 64;
      TexDesc.DepthOrArrayLayers := 1;
      TexDesc.MipLevels := 1;
      TexDesc.SampleCount := 1;
      TexDesc.Format := pfRGBA8_UNorm;
      TexDesc.Usage := [tuColorAttachment];
      RealColorTex := RealDev.CreateTexture(TexDesc);

      TexDesc.Format := pfD32_Float;
      TexDesc.Usage := [tuDepthStencil];
      RealDepthTex := RealDev.CreateTexture(TexDesc);

      QueryPool := RealDev.CreateQueryPool(TRHIQueryPoolDesc.Create(qtOcclusion, 2, 'TestOcclusionPool'));
      VkQueryPool := QueryPool as TVulkanRHIQueryPool;

      { Occluder quad covering [-1..1]x[-1..1] at Z = 0.25 }
      OccluderVerts[0] := Vector4(-1.0, -1.0, 0.25, 1.0);
      OccluderVerts[1] := Vector4( 1.0, -1.0, 0.25, 1.0);
      OccluderVerts[2] := Vector4( 1.0,  1.0, 0.25, 1.0);
      OccluderVerts[3] := Vector4(-1.0, -1.0, 0.25, 1.0);
      OccluderVerts[4] := Vector4( 1.0,  1.0, 0.25, 1.0);
      OccluderVerts[5] := Vector4(-1.0,  1.0, 0.25, 1.0);
      VBODesc := TRHIBufferDesc.Create(SizeOf(OccluderVerts), [buVertex], muCpuToGpu, 'OccluderVBO');
      OccluderVBO := RealDev.CreateBuffer(VBODesc, @OccluderVerts[0]);

      { Visible quad in front of occluder covering [-0.5..0.5]x[-0.5..0.5] (32x32 = 1024 px) at Z = 0.10 }
      VisibleVerts[0] := Vector4(-0.5, -0.5, 0.10, 1.0);
      VisibleVerts[1] := Vector4( 0.5, -0.5, 0.10, 1.0);
      VisibleVerts[2] := Vector4( 0.5,  0.5, 0.10, 1.0);
      VisibleVerts[3] := Vector4(-0.5, -0.5, 0.10, 1.0);
      VisibleVerts[4] := Vector4( 0.5,  0.5, 0.10, 1.0);
      VisibleVerts[5] := Vector4(-0.5,  0.5, 0.10, 1.0);
      VBODesc := TRHIBufferDesc.Create(SizeOf(VisibleVerts), [buVertex], muCpuToGpu, 'VisibleVBO');
      VisibleVBO := RealDev.CreateBuffer(VBODesc, @VisibleVerts[0]);

      { Occluded quad behind occluder at Z = 0.75 (fails coLess against 0.25) }
      OccludedVerts[0] := Vector4(-0.5, -0.5, 0.75, 1.0);
      OccludedVerts[1] := Vector4( 0.5, -0.5, 0.75, 1.0);
      OccludedVerts[2] := Vector4( 0.5,  0.5, 0.75, 1.0);
      OccludedVerts[3] := Vector4(-0.5, -0.5, 0.75, 1.0);
      OccludedVerts[4] := Vector4( 0.5,  0.5, 0.75, 1.0);
      OccludedVerts[5] := Vector4(-0.5,  0.5, 0.75, 1.0);
      VBODesc := TRHIBufferDesc.Create(SizeOf(OccludedVerts), [buVertex], muCpuToGpu, 'OccludedVBO');
      OccludedVBO := RealDev.CreateBuffer(VBODesc, @OccludedVerts[0]);

      VertMod := RealDev.CreateShaderModuleFromSPIRV(
        ssVertex, @MinimalVertSPIRV[0], SizeOf(MinimalVertSPIRV), 'OccVert');
      FragMod := RealDev.CreateShaderModuleFromSPIRV(
        ssFragment, @MinimalPushColorFragSPIRV[0], SizeOf(MinimalPushColorFragSPIRV), 'OccFrag');

      FillChar(PipeDesc, SizeOf(PipeDesc), 0);
      PipeDesc.VertexShader := VertMod;
      PipeDesc.FragmentShader := FragMod;
      PipeDesc.Topology := ptTriangleList;
      SetLength(PipeDesc.VertexInput.Bindings, 1);
      PipeDesc.VertexInput.Bindings[0].Binding := 0;
      PipeDesc.VertexInput.Bindings[0].Stride := SizeOf(TVector4);
      SetLength(PipeDesc.VertexInput.Attributes, 1);
      PipeDesc.VertexInput.Attributes[0].Location := 0;
      PipeDesc.VertexInput.Attributes[0].Binding := 0;
      PipeDesc.VertexInput.Attributes[0].Format := vafVector4;
      PipeDesc.VertexInput.Attributes[0].Offset := 0;
      PipeDesc.Rasterizer := TRHIRasterizerStateDesc.DefaultCullBack;
      PipeDesc.Rasterizer.CullMode := cmNone;
      PipeDesc.DepthStencil := TRHIDepthStencilStateDesc.DefaultDepthTestWrite;
      PipeDesc.BlendState := TRHIBlendStateDesc.DefaultOpaque;
      PipeDesc.PushConstantSize := SizeOf(TVector4);
      PipeDesc.PushConstantStages := [ssFragment];
      SetLength(PipeDesc.ColorAttachmentFormats, 1);
      PipeDesc.ColorAttachmentFormats[0] := pfRGBA8_UNorm;
      PipeDesc.DepthAttachmentFormat := pfD32_Float;
      PipeDesc.SampleCount := 1;
      Pipe := RealDev.GetOrCreatePipeline(PipeDesc);

      RealCmd := RealDev.BeginFrame;
      RenderInfo := TRHIRenderingInfo.CreateColorDepth(
        Rectangle(0, 0, 64, 64),
        RealColorTex, loClear, Vector4(0.0, 0.0, 0.0, 1.0),
        RealDepthTex, loClear, 1.0);
      RealCmd.BeginRendering(RenderInfo);
      RealCmd.SetViewport(FloatRectangle(0, 0, 64, 64), 0.0, 1.0);
      RealCmd.SetScissor(Rectangle(0, 0, 64, 64));

      { Reset queries WHILE inside active render pass using vkResetQueryPool! }
      RealCmd.ResetQueryPool(QueryPool, 0, 2);
      AssertTrue('ResetQueryPool inside active render pass must use vkResetQueryPool (HostResetCount >= 1)',
        VkQueryPool.HostResetCount >= 1);

      RealCmd.BindPipeline(Pipe);
      PushColor := Vector4(1.0, 1.0, 1.0, 1.0);
      RealCmd.PushConstants([ssFragment], 0, SizeOf(PushColor), PushColor);

      { 1. Draw occluder at Z = 0.25 }
      RealCmd.BindVertexBuffers(0, [OccluderVBO], [0]);
      RealCmd.Draw(6, 1, 0, 0);

      { 2. Query 0: Visible geometry at Z = 0.10 }
      RealCmd.BeginQuery(QueryPool, 0, True);
      RealCmd.BindVertexBuffers(0, [VisibleVBO], [0]);
      RealCmd.Draw(6, 1, 0, 0);
      RealCmd.EndQuery(QueryPool, 0);

      { 3. Query 1: Depth-occluded geometry at Z = 0.75 }
      RealCmd.BeginQuery(QueryPool, 1, True);
      RealCmd.BindVertexBuffers(0, [OccludedVBO], [0]);
      RealCmd.Draw(6, 1, 0, 0);
      RealCmd.EndQuery(QueryPool, 1);

      RealCmd.EndRendering;
      RealDev.EndFrameAndPresent;

      Samples[0] := 0;
      Samples[1] := High(UInt64);
      AssertTrue('GetResults with Wait=True must succeed on real Vulkan occlusion query pool',
        QueryPool.GetResults(0, 2, Samples, True));
      if RealDev.SupportsOcclusionQueryPrecise then
        AssertEquals('Visible 32x32 quad precise occlusion query must report 1024 passed samples',
          1024, Integer(Samples[0]))
      else
        AssertTrue('Visible 32x32 quad boolean occlusion query must report >= 1 passed sample',
          Samples[0] >= 1);
      AssertEquals('Depth-occluded quad behind occluder must report 0 passed samples',
        0, Integer(Samples[1]));
    finally
      FreeAndNil(FragMod);
      FreeAndNil(VertMod);
      FreeAndNil(OccludedVBO);
      FreeAndNil(VisibleVBO);
      FreeAndNil(OccluderVBO);
      FreeAndNil(QueryPool);
      FreeAndNil(RealDepthTex);
      FreeAndNil(RealColorTex);
      FreeAndNil(RealDev);
    end;
  end;
end;

procedure TTestCastleVulkanRHI.TestGPUCompressedImageDecompressDXT1DXT3DXT5AndFlipVerticalRHI;
var
  Device: TVulkanRHIDevice;
  SavedRHI: TRHIDevice;
  SavedBackend: TRenderBackend;
  SavedKnown: Boolean;
  SavedCompression: TTextureCompressions;
  CompImg: TGPUCompressedImage;
  DecompImg, FlippedDecompImg: TCastleImage;
  RGBImg: TRGBImage;
  RGBAImg, FlippedRGBAImg: TRGBAlphaImage;
  BlockBytes: PByte;
  TexDesc: TRHITextureDesc;
  FallbackTex: TRHITexture;
begin
  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($A106)), True, True);
  SavedRHI := RHIDevice;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedKnown := SupportedTextureCompressionKnown;
  SavedCompression := SupportedTextureCompression;
  CompImg := nil;
  DecompImg := nil;
  FlippedDecompImg := nil;
  FallbackTex := nil;
  try
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(Device);

    AssertTrue('SetRHIDevice must populate SupportedTextureCompressionKnown = True',
      SupportedTextureCompressionKnown);
    AssertTrue('Headless Vulkan BC capability must populate tcDxt1_RGB..tcDxt5 in SupportedTextureCompression',
      (tcDxt1_RGB in SupportedTextureCompression) and
      (tcDxt1_RGBA in SupportedTextureCompression) and
      (tcDxt3 in SupportedTextureCompression) and
      (tcDxt5 in SupportedTextureCompression));
    AssertTrue('SetRHIDevice must register DecompressTexture handler via CastleGLImages',
      Assigned(DecompressTexture));

    { 1. DXT1_RGB (4x4): Color0 = Pure Red ($F800) > Color1 = Pure Green ($07E0) }
    CompImg := TGPUCompressedImage.Create(4, 4, 1, tcDxt1_RGB);
    BlockBytes := PByte(CompImg.RawPixels);
    FillChar(BlockBytes^, CompImg.Size, 0);
    BlockBytes[0] := $00; BlockBytes[1] := $F8; { Color0 = $F800 -> (255, 0, 0) }
    BlockBytes[2] := $E0; BlockBytes[3] := $07; { Color1 = $07E0 -> (0, 255, 0) }
    BlockBytes[4] := $00; { Row 0: all idx 0 -> Red }
    BlockBytes[5] := $55; { Row 1: all idx 1 -> Green }
    BlockBytes[6] := $AA; { Row 2: all idx 2 -> 2/3 Red + 1/3 Green = (170, 85, 0) }
    BlockBytes[7] := $FF; { Row 3: all idx 3 -> 1/3 Red + 2/3 Green = (85, 170, 0) }

    DecompImg := CompImg.Decompress;
    AssertTrue('tcDxt1_RGB Decompress must return TRGBImage', DecompImg is TRGBImage);
    RGBImg := DecompImg as TRGBImage;
    AssertEquals(255, Integer(RGBImg.PixelPtr(0, 0)^.X));
    AssertEquals(0,   Integer(RGBImg.PixelPtr(0, 0)^.Y));
    AssertEquals(0,   Integer(RGBImg.PixelPtr(1, 1)^.X));
    AssertEquals(255, Integer(RGBImg.PixelPtr(1, 1)^.Y));
    AssertEquals(170, Integer(RGBImg.PixelPtr(2, 2)^.X));
    AssertEquals(85,  Integer(RGBImg.PixelPtr(2, 2)^.Y));
    AssertEquals(85,  Integer(RGBImg.PixelPtr(3, 3)^.X));
    AssertEquals(170, Integer(RGBImg.PixelPtr(3, 3)^.Y));
    FreeAndNil(DecompImg);
    FreeAndNil(CompImg);

    { 2. DXT1_RGBA (4x4) with 1-bit transparency: Color0 = Blue ($001F) <= Color1 = Red ($F800) -> idx 3 = (0,0,0,0) }
    CompImg := TGPUCompressedImage.Create(4, 4, 1, tcDxt1_RGBA);
    BlockBytes := PByte(CompImg.RawPixels);
    FillChar(BlockBytes^, CompImg.Size, 0);
    BlockBytes[0] := $1F; BlockBytes[1] := $00; { Color0 = $001F -> (0, 0, 255) }
    BlockBytes[2] := $00; BlockBytes[3] := $F8; { Color1 = $F800 -> (255, 0, 0) }
    BlockBytes[4] := $00; { Row 0: idx 0 -> (0, 0, 255, 255) }
    BlockBytes[5] := $AA; { Row 1: idx 2 -> 1/2 (Blue + Red) = (127, 0, 127, 255) }
    BlockBytes[6] := $FF; { Row 2: idx 3 -> transparent black (0, 0, 0, 0) }
    BlockBytes[7] := $55; { Row 3: idx 1 -> (255, 0, 0, 255) }

    DecompImg := CompImg.Decompress;
    AssertTrue('tcDxt1_RGBA Decompress must return TRGBAlphaImage', DecompImg is TRGBAlphaImage);
    RGBAImg := DecompImg as TRGBAlphaImage;
    AssertEquals(255, Integer(RGBAImg.PixelPtr(0, 0)^.Z));
    AssertEquals(255, Integer(RGBAImg.PixelPtr(0, 0)^.W));
    AssertEquals(127, Integer(RGBAImg.PixelPtr(0, 1)^.X));
    AssertEquals(127, Integer(RGBAImg.PixelPtr(0, 1)^.Z));
    AssertEquals(255, Integer(RGBAImg.PixelPtr(0, 1)^.W));
    AssertEquals(0,   Integer(RGBAImg.PixelPtr(0, 2)^.X));
    AssertEquals(0,   Integer(RGBAImg.PixelPtr(0, 2)^.W));
    AssertEquals(255, Integer(RGBAImg.PixelPtr(0, 3)^.X));
    AssertEquals(255, Integer(RGBAImg.PixelPtr(0, 3)^.W));
    FreeAndNil(DecompImg);
    FreeAndNil(CompImg);

    { 3. DXT3 (4x4): 4-bit explicit alpha + FlipVertical agreement }
    CompImg := TGPUCompressedImage.Create(4, 4, 1, tcDxt3);
    BlockBytes := PByte(CompImg.RawPixels);
    FillChar(BlockBytes^, CompImg.Size, 0);
    { Alpha Row 0 = $0000 (alpha 0), Row 1 = $5555 (alpha 85), Row 2 = $AAAA (alpha 170), Row 3 = $FFFF (alpha 255) }
    BlockBytes[0] := $00; BlockBytes[1] := $00;
    BlockBytes[2] := $55; BlockBytes[3] := $55;
    BlockBytes[4] := $AA; BlockBytes[5] := $AA;
    BlockBytes[6] := $FF; BlockBytes[7] := $FF;
    { Note Color0 ($001F) < Color1 ($F800): DXT3 MUST still use 4-color mode (never transparent black)! }
    BlockBytes[8]  := $1F; BlockBytes[9]  := $00;
    BlockBytes[10] := $00; BlockBytes[11] := $F8;
    BlockBytes[12] := $00; { Row 0: Blue }
    BlockBytes[13] := $55; { Row 1: Red }
    BlockBytes[14] := $AA; { Row 2: 2/3 Blue + 1/3 Red = (85, 0, 170) }
    BlockBytes[15] := $FF; { Row 3: 1/3 Blue + 2/3 Red = (170, 0, 85) }

    DecompImg := CompImg.Decompress;
    RGBAImg := DecompImg as TRGBAlphaImage;
    AssertEquals(0,   Integer(RGBAImg.PixelPtr(0, 0)^.W));
    AssertEquals(85,  Integer(RGBAImg.PixelPtr(0, 1)^.W));
    AssertEquals(170, Integer(RGBAImg.PixelPtr(0, 2)^.W));
    AssertEquals(255, Integer(RGBAImg.PixelPtr(0, 3)^.W));
    AssertEquals(170, Integer(RGBAImg.PixelPtr(0, 3)^.X));
    AssertEquals(85,  Integer(RGBAImg.PixelPtr(0, 3)^.Z));

    CompImg.FlipVertical;
    FlippedDecompImg := CompImg.Decompress;
    FlippedRGBAImg := FlippedDecompImg as TRGBAlphaImage;
    AssertEquals('DXT3 FlipVertical must move Row 3 alpha 255 to Row 0',
      255, Integer(FlippedRGBAImg.PixelPtr(0, 0)^.W));
    AssertEquals('DXT3 FlipVertical must move Row 0 alpha 0 to Row 3',
      0, Integer(FlippedRGBAImg.PixelPtr(0, 3)^.W));
    FreeAndNil(FlippedDecompImg);
    FreeAndNil(DecompImg);
    FreeAndNil(CompImg);

    { 4. DXT5 (4x4): Interpolated 3-bit alpha + FlipVertical agreement + UploadImage RGBA8 fallback }
    CompImg := TGPUCompressedImage.Create(4, 4, 1, tcDxt5);
    BlockBytes := PByte(CompImg.RawPixels);
    FillChar(BlockBytes^, CompImg.Size, 0);
    BlockBytes[0] := 200; { Alpha0 }
    BlockBytes[1] := 60;  { Alpha1 -> Alpha0 > Alpha1: idx 0 = 200, idx 1 = 60, idx 2 = (1200+60+3) div 7 = 180 }
    { Row 0 (bits 0..11): all idx 0 (000) -> 0
      Row 1 (bits 12..23): all idx 1 (001_001_001_001 = $249)
      Row 2 (bits 24..35): all idx 2 (010_010_010_010 = $492)
      Row 3 (bits 36..47): all idx 1 ($249) -> 48-bit = $249492249000 }
    BlockBytes[2] := $00;
    BlockBytes[3] := $90;
    BlockBytes[4] := $24;
    BlockBytes[5] := $92;
    BlockBytes[6] := $94;
    BlockBytes[7] := $24;
    BlockBytes[8]  := $FF; BlockBytes[9]  := $FF; { White }
    BlockBytes[10] := $00; BlockBytes[11] := $00; { Black }
    BlockBytes[12] := $00;
    BlockBytes[13] := $00;
    BlockBytes[14] := $00;
    BlockBytes[15] := $00;

    DecompImg := CompImg.Decompress;
    RGBAImg := DecompImg as TRGBAlphaImage;
    AssertEquals(200, Integer(RGBAImg.PixelPtr(0, 0)^.W));
    AssertEquals(60,  Integer(RGBAImg.PixelPtr(0, 1)^.W));
    AssertEquals(180, Integer(RGBAImg.PixelPtr(0, 2)^.W));
    AssertEquals(60,  Integer(RGBAImg.PixelPtr(0, 3)^.W));

    CompImg.FlipVertical;
    FlippedDecompImg := CompImg.Decompress;
    FlippedRGBAImg := FlippedDecompImg as TRGBAlphaImage;
    AssertEquals('DXT5 FlipVertical must move Row 3 (alpha 60) to Row 0',
      60, Integer(FlippedRGBAImg.PixelPtr(0, 0)^.W));
    AssertEquals('DXT5 FlipVertical must move Row 2 (alpha 180) to Row 1',
      180, Integer(FlippedRGBAImg.PixelPtr(0, 1)^.W));
    AssertEquals('DXT5 FlipVertical must move Row 0 (alpha 200) to Row 3',
      200, Integer(FlippedRGBAImg.PixelPtr(0, 3)^.W));

    { Verify TVulkanRHITexture.UploadImage fallback decompression into pfRGBA8_UNorm texture }
    FillChar(TexDesc, SizeOf(TexDesc), 0);
    TexDesc.Dimension := td2D;
    TexDesc.Width := 4;
    TexDesc.Height := 4;
    TexDesc.DepthOrArrayLayers := 1;
    TexDesc.MipLevels := 1;
    TexDesc.SampleCount := 1;
    TexDesc.Format := pfRGBA8_UNorm;
    TexDesc.Usage := [tuSampled, tuTransferDst];
    FallbackTex := Device.CreateTexture(TexDesc);
    FallbackTex.UploadImage(CompImg, 0, 0);
    AssertEquals('UploadImage on pfRGBA8_UNorm texture must decompress DXT5 block via DecompressTexture',
      1, Integer((FallbackTex as TVulkanRHITexture).TotalSubresourceUploads));

    SetRHIDevice(nil);
    AssertFalse('SetRHIDevice(nil) without open GL context must clear DecompressTexture back to nil',
      Assigned(DecompressTexture));
  finally
    FreeAndNil(FallbackTex);
    FreeAndNil(FlippedDecompImg);
    FreeAndNil(DecompImg);
    FreeAndNil(CompImg);
    SetRHIDevice(SavedRHI);
    SupportedTextureCompressionKnown := SavedKnown;
    SupportedTextureCompression := SavedCompression;
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(Device);
  end;
end;

type
  TTestSizedVulkanContainer = class(TTestHeadlessVulkanContainer)
  public
    TestWidth: Integer;
    TestHeight: Integer;
    function PixelsWidth: Integer; override;
    function PixelsHeight: Integer; override;
  end;

  TLavapipeScissorClearUIControl = class(TCastleUserInterface)
  public
    ClearRect: TRectangle;
    ClearColor: TCastleColor;
    procedure Render; override;
  end;

function TTestSizedVulkanContainer.PixelsWidth: Integer;
begin
  Result := Max(1, TestWidth);
end;

function TTestSizedVulkanContainer.PixelsHeight: Integer;
begin
  Result := Max(1, TestHeight);
end;

procedure TLavapipeScissorClearUIControl.Render;
begin
  inherited;
  if (ActiveCommandList <> nil) and ActiveCommandList.IsRendering then
  begin
    ActiveCommandList.SetScissor(ClearRect);
    ActiveCommandList.ClearAttachments(True, ClearColor, False, 1.0, False, 0);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipeSubViewportScissorClearAndBottomUpGrabTextureRHI;
const
  MinimalVertSPIRV: array[0..92] of Cardinal = (
    $07230203, $00010000, $00000000, $00000011, $00000000,
    $00020011, 1,
    $0003000E, 0, 1,
    $0007000F, 0, 1, $6E69616D, $00000000, 8, 11,
    $00050048, 6, 0, 11, 0,
    $00030047, 6, 2,
    $00040047, 11, 30, 0,
    $00020013, 2,
    $00030021, 3, 2,
    $00030016, 4, 32,
    $00040017, 5, 4, 4,
    $0003001E, 6, 5,
    $00040020, 7, 3, 6,
    $0004003B, 7, 8, 3,
    $00040015, 9, 32, 1,
    $0004002B, 9, 10, 0,
    $00040020, 12, 1, 5,
    $0004003B, 12, 11, 1,
    $00040020, 13, 3, 5,
    $00050036, 2, 1, 0, 3,
    $000200F8, 14,
    $0004003D, 5, 15, 11,
    $00050041, 13, 16, 8, 10,
    $0003003E, 16, 15,
    $000100FD,
    $00010038
  );
  MinimalPushColorFragSPIRV: array[0..94] of Cardinal = (
    $07230203, $00010000, $00000000, $00000011, $00000000,
    $00020011, 1,
    $0003000E, 0, 1,
    $0006000F, 4, 1, $6E69616D, $00000000, 7,
    $00030010, 1, 7,
    $00040047, 7, 30, 0,
    $00050048, 8, 0, 35, 0,
    $00030047, 8, 2,
    $00020013, 2,
    $00030021, 3, 2,
    $00030016, 4, 32,
    $00040017, 5, 4, 4,
    $00040020, 6, 3, 5,
    $0004003B, 6, 7, 3,
    $0003001E, 8, 5,
    $00040020, 9, 9, 8,
    $0004003B, 9, 10, 9,
    $00040015, 11, 32, 1,
    $0004002B, 11, 12, 0,
    $00040020, 13, 9, 5,
    $00050036, 2, 1, 0, 3,
    $000200F8, 14,
    $00050041, 13, 15, 10, 12,
    $0004003D, 5, 16, 15,
    $0003003E, 7, 16,
    $000100FD,
    $00010038
  );
var
  HeadlessDev, RealDev: TVulkanRHIDevice;
  HeadlessCmd, RealCmd: TVulkanRHICommandList;
  TexDesc: TRHITextureDesc;
  HeadlessTex, RealColorTex, RealDepthTex, CpuUploadTex: TRHITexture;
  RenderInfo: TRHIRenderingInfo;
  FullQuadZ25, FullQuadZ50, UpperHalfQuadZ15: array[0..5] of TVector4;
  VBOZ25, VBOZ50, VBOUpperHalf: TRHIBuffer;
  VBODesc: TRHIBufferDesc;
  VertMod, FragMod: TRHIShaderModule;
  PipeDesc: TRHIGraphicsPipelineDesc;
  Pipe: TRHIPipeline;
  PushColor: TVector4;
  HeadlessReadback, FullColorImg, SubBottomLeftImg, SubTopRightImg, FullDepthImg,
    CpuSrcImg, CpuReadbackImg: TRGBAlphaImage;
  X: Integer;
begin
  { Part 1: Headless deferred viewport/scissor reapply + bottom-up ClearAttachments rect }
  HeadlessDev := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($A107)), True, True);
  HeadlessTex := nil;
  HeadlessReadback := nil;
  try
    TexDesc := TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm, [tuColorAttachment, tuTransferSrc]);
    HeadlessTex := HeadlessDev.CreateTexture(TexDesc);

    HeadlessCmd := HeadlessDev.BeginFrame as TVulkanRHICommandList;
    { Call SetViewport and SetScissor BEFORE BeginRendering: must defer and reapply with 64px height! }
    HeadlessCmd.SetViewport(FloatRectangle(0, 0, 32, 16), 0.0, 1.0);
    HeadlessCmd.SetScissor(Rectangle(0, 0, 32, 16));

    RenderInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 64, 64), HeadlessTex, loClear, Vector4(0.0, 0.0, 0.0, 1.0),
      nil, loDontCare, 1.0);
    HeadlessCmd.BeginRendering(RenderInfo);
    AssertEquals('ActiveRenderingWidth must be 64', 64, Integer(HeadlessCmd.ActiveRenderingWidth));
    AssertEquals('ActiveRenderingHeight must be 64', 64, Integer(HeadlessCmd.ActiveRenderingHeight));
    AssertSameValue(64.0, HeadlessCmd.LastVkViewportY, 0.001);
    AssertEquals('Bottom-left 32x16 scissor in 64x64 pass must map to top-down offset.y = 48',
      48, HeadlessCmd.LastVkScissorOffsetY);

    HeadlessCmd.ClearAttachments(True, Vector4(0.0, 1.0, 0.0, 1.0), False, 1.0, False, 0);
    HeadlessCmd.EndRendering;
    HeadlessDev.EndFrameAndPresent;

    HeadlessReadback := HeadlessDev.GrabTextureImage(HeadlessTex, Rectangle(0, 0, 64, 64));
    AssertEquals('Headless bottom-left (8,8) must be cleared to Green',
      255, Integer(HeadlessReadback.PixelPtr(8, 8)^.Y));
    AssertEquals('Headless top-left (8,56) outside scissor must remain 0',
      0, Integer(HeadlessReadback.PixelPtr(8, 56)^.Y));
    AssertEquals('Headless bottom-right (48,8) outside scissor must remain 0',
      0, Integer(HeadlessReadback.PixelPtr(48, 8)^.Y));
  finally
    FreeAndNil(HeadlessReadback);
    FreeAndNil(HeadlessTex);
    FreeAndNil(HeadlessDev);
  end;

  { Part 2: Live Offscreen Vulkan GPU (Mesa Lavapipe) sub-viewport, sub-scissor, ClearAttachments & GrabTextureImage }
  if TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
  begin
    RealColorTex := nil;
    RealDepthTex := nil;
    CpuUploadTex := nil;
    VBOZ25 := nil;
    VBOZ50 := nil;
    VBOUpperHalf := nil;
    VertMod := nil;
    FragMod := nil;
    FullColorImg := nil;
    SubBottomLeftImg := nil;
    SubTopRightImg := nil;
    FullDepthImg := nil;
    CpuSrcImg := nil;
    CpuReadbackImg := nil;
    try
      TexDesc := TRHITextureDesc.Create2D(64, 64, pfBGRA8_UNorm,
        [tuColorAttachment, tuTransferSrc, tuTransferDst]);
      RealColorTex := RealDev.CreateTexture(TexDesc);

      TexDesc := TRHITextureDesc.Create2D(64, 64, RealDev.SwapchainDepthFormat,
        [tuDepthStencil, tuTransferSrc]);
      RealDepthTex := RealDev.CreateTexture(TexDesc);

      FullQuadZ25[0] := Vector4(-1.0, -1.0, 0.25, 1.0);
      FullQuadZ25[1] := Vector4( 1.0, -1.0, 0.25, 1.0);
      FullQuadZ25[2] := Vector4( 1.0,  1.0, 0.25, 1.0);
      FullQuadZ25[3] := Vector4(-1.0, -1.0, 0.25, 1.0);
      FullQuadZ25[4] := Vector4( 1.0,  1.0, 0.25, 1.0);
      FullQuadZ25[5] := Vector4(-1.0,  1.0, 0.25, 1.0);
      VBODesc := TRHIBufferDesc.Create(SizeOf(FullQuadZ25), [buVertex], muCpuToGpu, 'FullQuadZ25');
      VBOZ25 := RealDev.CreateBuffer(VBODesc, @FullQuadZ25[0]);

      FullQuadZ50[0] := Vector4(-1.0, -1.0, 0.50, 1.0);
      FullQuadZ50[1] := Vector4( 1.0, -1.0, 0.50, 1.0);
      FullQuadZ50[2] := Vector4( 1.0,  1.0, 0.50, 1.0);
      FullQuadZ50[3] := Vector4(-1.0, -1.0, 0.50, 1.0);
      FullQuadZ50[4] := Vector4( 1.0,  1.0, 0.50, 1.0);
      FullQuadZ50[5] := Vector4(-1.0,  1.0, 0.50, 1.0);
      VBODesc := TRHIBufferDesc.Create(SizeOf(FullQuadZ50), [buVertex], muCpuToGpu, 'FullQuadZ50');
      VBOZ50 := RealDev.CreateBuffer(VBODesc, @FullQuadZ50[0]);

      { Asymmetric NDC quad covering only Y in [0..1] (upper half of viewport!) }
      UpperHalfQuadZ15[0] := Vector4(-1.0, 0.0, 0.15, 1.0);
      UpperHalfQuadZ15[1] := Vector4( 1.0, 0.0, 0.15, 1.0);
      UpperHalfQuadZ15[2] := Vector4( 1.0, 1.0, 0.15, 1.0);
      UpperHalfQuadZ15[3] := Vector4(-1.0, 0.0, 0.15, 1.0);
      UpperHalfQuadZ15[4] := Vector4( 1.0, 1.0, 0.15, 1.0);
      UpperHalfQuadZ15[5] := Vector4(-1.0, 1.0, 0.15, 1.0);
      VBODesc := TRHIBufferDesc.Create(SizeOf(UpperHalfQuadZ15), [buVertex], muCpuToGpu, 'UpperHalfQuadZ15');
      VBOUpperHalf := RealDev.CreateBuffer(VBODesc, @UpperHalfQuadZ15[0]);

      VertMod := RealDev.CreateShaderModuleFromSPIRV(
        ssVertex, @MinimalVertSPIRV[0], SizeOf(MinimalVertSPIRV), 'SubVpVert');
      FragMod := RealDev.CreateShaderModuleFromSPIRV(
        ssFragment, @MinimalPushColorFragSPIRV[0], SizeOf(MinimalPushColorFragSPIRV), 'SubVpFrag');

      FillChar(PipeDesc, SizeOf(PipeDesc), 0);
      PipeDesc.VertexShader := VertMod;
      PipeDesc.FragmentShader := FragMod;
      PipeDesc.Topology := ptTriangleList;
      SetLength(PipeDesc.VertexInput.Bindings, 1);
      PipeDesc.VertexInput.Bindings[0].Binding := 0;
      PipeDesc.VertexInput.Bindings[0].Stride := SizeOf(TVector4);
      SetLength(PipeDesc.VertexInput.Attributes, 1);
      PipeDesc.VertexInput.Attributes[0].Location := 0;
      PipeDesc.VertexInput.Attributes[0].Binding := 0;
      PipeDesc.VertexInput.Attributes[0].Format := vafVector4;
      PipeDesc.VertexInput.Attributes[0].Offset := 0;
      PipeDesc.Rasterizer := TRHIRasterizerStateDesc.DefaultCullBack;
      PipeDesc.Rasterizer.CullMode := cmNone;
      PipeDesc.DepthStencil := TRHIDepthStencilStateDesc.DefaultDepthTestWrite;
      PipeDesc.BlendState := TRHIBlendStateDesc.DefaultOpaque;
      PipeDesc.PushConstantSize := SizeOf(TVector4);
      PipeDesc.PushConstantStages := [ssFragment];
      SetLength(PipeDesc.ColorAttachmentFormats, 1);
      PipeDesc.ColorAttachmentFormats[0] := pfBGRA8_UNorm;
      PipeDesc.DepthAttachmentFormat := RealDepthTex.Desc.Format;
      PipeDesc.SampleCount := 1;
      Pipe := RealDev.GetOrCreatePipeline(PipeDesc);

      RealCmd := RealDev.BeginFrame as TVulkanRHICommandList;
      RenderInfo := TRHIRenderingInfo.CreateColorDepth(
        Rectangle(0, 0, 64, 64),
        RealColorTex, loClear, Vector4(0.0, 0.0, 0.5, 1.0),
        RealDepthTex, loClear, 1.0);
      RealCmd.BeginRendering(RenderInfo);
      RealCmd.BindPipeline(Pipe);

      { 1. Bottom-left sub-viewport (0, 0, 32, 16) -> Red at Z = 0.25 }
      RealCmd.SetViewport(FloatRectangle(0, 0, 32, 16), 0.0, 1.0);
      RealCmd.SetScissor(Rectangle(0, 0, 32, 16));
      PushColor := Vector4(1.0, 0.0, 0.0, 1.0);
      RealCmd.PushConstants([ssFragment], 0, SizeOf(PushColor), PushColor);
      RealCmd.BindVertexBuffers(0, [VBOZ25], [0]);
      RealCmd.Draw(6, 1, 0, 0);

      { 2. Top-right sub-viewport (32, 48, 32, 16) -> Green at Z = 0.50 }
      RealCmd.SetViewport(FloatRectangle(32, 48, 32, 16), 0.0, 1.0);
      RealCmd.SetScissor(Rectangle(32, 48, 32, 16));
      PushColor := Vector4(0.0, 1.0, 0.0, 1.0);
      RealCmd.PushConstants([ssFragment], 0, SizeOf(PushColor), PushColor);
      RealCmd.BindVertexBuffers(0, [VBOZ50], [0]);
      RealCmd.Draw(6, 1, 0, 0);

      { 3. Top-left sub-viewport (0, 32, 32, 32) upper NDC half Y in [0..1] -> Yellow in CGE rows 48..63 }
      RealCmd.SetViewport(FloatRectangle(0, 32, 32, 32), 0.0, 1.0);
      RealCmd.SetScissor(Rectangle(0, 32, 32, 32));
      PushColor := Vector4(1.0, 1.0, 0.0, 1.0);
      RealCmd.PushConstants([ssFragment], 0, SizeOf(PushColor), PushColor);
      RealCmd.BindVertexBuffers(0, [VBOUpperHalf], [0]);
      RealCmd.Draw(6, 1, 0, 0);

      { 4. Bottom-right sub-scissor (32, 0, 32, 16) ClearAttachments -> Cyan + Depth 0.75 }
      RealCmd.SetScissor(Rectangle(32, 0, 32, 16));
      RealCmd.ClearAttachments(True, Vector4(0.0, 1.0, 1.0, 1.0), True, 0.75, False, 0);

      RealCmd.EndRendering;
      RealDev.EndFrameAndPresent;

      { Verify full 64x64 bottom-up BGRA8 color readback }
      FullColorImg := RealDev.GrabTextureImage(RealColorTex, Rectangle(0, 0, 64, 64));
      AssertEquals('Bottom-left (8,8) R must be 255 (Red)', 255, Integer(FullColorImg.PixelPtr(8, 8)^.X));
      AssertEquals('Bottom-left (8,8) G must be 0',           0, Integer(FullColorImg.PixelPtr(8, 8)^.Y));
      AssertEquals('Bottom-left (8,8) B must be 0',           0, Integer(FullColorImg.PixelPtr(8, 8)^.Z));

      AssertEquals('Top-right (48,56) R must be 0',           0, Integer(FullColorImg.PixelPtr(48, 56)^.X));
      AssertEquals('Top-right (48,56) G must be 255 (Green)', 255, Integer(FullColorImg.PixelPtr(48, 56)^.Y));
      AssertEquals('Top-right (48,56) B must be 0',           0, Integer(FullColorImg.PixelPtr(48, 56)^.Z));

      AssertEquals('Bottom-right (48,8) R must be 0',          0, Integer(FullColorImg.PixelPtr(48, 8)^.X));
      AssertEquals('Bottom-right (48,8) G must be 255 (Cyan)', 255, Integer(FullColorImg.PixelPtr(48, 8)^.Y));
      AssertEquals('Bottom-right (48,8) B must be 255 (Cyan)', 255, Integer(FullColorImg.PixelPtr(48, 8)^.Z));

      AssertEquals('Top-left upper half (8,56) R must be 255 (Yellow)', 255, Integer(FullColorImg.PixelPtr(8, 56)^.X));
      AssertEquals('Top-left upper half (8,56) G must be 255 (Yellow)', 255, Integer(FullColorImg.PixelPtr(8, 56)^.Y));
      AssertEquals('Top-left lower half (8,40) R must remain 0 (Dark Blue)', 0, Integer(FullColorImg.PixelPtr(8, 40)^.X));
      AssertTrue('Top-left lower half (8,40) B must remain ~128 (Dark Blue)',
        Abs(Integer(FullColorImg.PixelPtr(8, 40)^.Z) - 128) <= 2);

      { Verify sub-rectangle GrabTextureImage in CGE bottom-up coordinates }
      SubBottomLeftImg := RealDev.GrabTextureImage(RealColorTex, Rectangle(0, 0, 32, 16));
      AssertEquals('Sub-rect bottom-left (4,4) must be Red', 255, Integer(SubBottomLeftImg.PixelPtr(4, 4)^.X));
      AssertEquals('Sub-rect bottom-left (4,4) G must be 0',   0, Integer(SubBottomLeftImg.PixelPtr(4, 4)^.Y));

      SubTopRightImg := RealDev.GrabTextureImage(RealColorTex, Rectangle(32, 48, 32, 16));
      AssertEquals('Sub-rect top-right (4,4) must be Green', 255, Integer(SubTopRightImg.PixelPtr(4, 4)^.Y));
      AssertEquals('Sub-rect top-right (4,4) R must be 0',     0, Integer(SubTopRightImg.PixelPtr(4, 4)^.X));

      { Verify D24S8 / depth bottom-up GrabTextureImage }
      FullDepthImg := RealDev.GrabTextureImage(RealDepthTex, Rectangle(0, 0, 64, 64));
      AssertTrue('Bottom-left depth (Z=0.25) must unpack to ~64',
        Abs(Integer(FullDepthImg.PixelPtr(8, 8)^.X) - 64) <= 2);
      AssertTrue('Top-right depth (Z=0.50) must unpack to ~128',
        Abs(Integer(FullDepthImg.PixelPtr(48, 56)^.X) - 128) <= 2);
      AssertTrue('Bottom-right cleared depth (Z=0.75) must unpack to ~191',
        Abs(Integer(FullDepthImg.PixelPtr(48, 8)^.X) - 191) <= 2);
      AssertEquals('Untouched depth (Z=1.0) must unpack to 255',
        255, Integer(FullDepthImg.PixelPtr(8, 40)^.X));

      { Verify CPU-uploaded texture (RenderedLayerMask = 0) round-trips WITHOUT vertical flip }
      CpuSrcImg := TRGBAlphaImage.Create(4, 4);
      CpuSrcImg.Clear(Vector4Byte(0, 255, 0, 255));
      for X := 0 to 3 do
      begin
        CpuSrcImg.PixelPtr(X, 0)^ := Vector4Byte(255, 0, 0, 255); { Row 0 = Red }
        CpuSrcImg.PixelPtr(X, 3)^ := Vector4Byte(0, 0, 255, 255); { Row 3 = Blue }
      end;
      TexDesc := TRHITextureDesc.Create2D(4, 4, pfRGBA8_UNorm, [tuSampled, tuTransferSrc, tuTransferDst]);
      CpuUploadTex := RealDev.CreateTexture(TexDesc);
      CpuUploadTex.UploadImage(CpuSrcImg, 0, 0);
      AssertEquals('CPU-uploaded texture must have RenderedLayerMask = 0',
        0, Integer((CpuUploadTex as TVulkanRHITexture).RenderedLayerMask));
      CpuReadbackImg := RealDev.GrabTextureImage(CpuUploadTex, Rectangle(0, 0, 4, 4));
      AssertEquals('CPU-uploaded Row 0 must remain Red after GrabTextureImage',
        255, Integer(CpuReadbackImg.PixelPtr(1, 0)^.X));
      AssertEquals('CPU-uploaded Row 3 must remain Blue after GrabTextureImage',
        255, Integer(CpuReadbackImg.PixelPtr(1, 3)^.Z));
    finally
      FreeAndNil(CpuReadbackImg);
      FreeAndNil(CpuSrcImg);
      FreeAndNil(FullDepthImg);
      FreeAndNil(SubTopRightImg);
      FreeAndNil(SubBottomLeftImg);
      FreeAndNil(FullColorImg);
      FreeAndNil(FragMod);
      FreeAndNil(VertMod);
      FreeAndNil(VBOUpperHalf);
      FreeAndNil(VBOZ50);
      FreeAndNil(VBOZ25);
      FreeAndNil(CpuUploadTex);
      FreeAndNil(RealDepthTex);
      FreeAndNil(RealColorTex);
      FreeAndNil(RealDev);
    end;
  end;
end;

procedure TTestCastleVulkanRHI.TestCastleWindowVulkanSwapchainPassSurfaceNegotiationAndStencilDepthRHI;
var
  Formats: array of VkSurfaceFormatKHR;
  Modes: array of VkPresentModeKHR;
  ChosenSurfFmt: VkSurfaceFormatKHR;
  ChosenRHIFmt: TRHIPixelFormat;
  Device: TVulkanRHIDevice;
  Window: TCastleWindow;
  OffscreenFBOTex: TRHITexture;
  OffscreenPassInfo: TRHIRenderingInfo;
  Tex0, Tex1: TRHITexture;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
begin
  { 1. Surface format & present mode negotiation helpers }
  SetLength(Formats, 2);
  Formats[0].format := VK_FORMAT_R16G16B16A16_SFLOAT;
  Formats[0].colorSpace := VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
  Formats[1].format := VK_FORMAT_B8G8R8A8_UNORM;
  Formats[1].colorSpace := VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
  ChosenSurfFmt := SelectVulkanSurfaceFormat(Formats, ChosenRHIFmt);
  AssertEquals('SelectVulkanSurfaceFormat must prefer VK_FORMAT_B8G8R8A8_UNORM',
    Ord(VK_FORMAT_B8G8R8A8_UNORM), Ord(ChosenSurfFmt.format));
  AssertEquals('ChosenRHIFmt must map to pfBGRA8_UNorm', Ord(pfBGRA8_UNorm), Ord(ChosenRHIFmt));

  SetLength(Formats, 1);
  Formats[0].format := VK_FORMAT_R8G8B8A8_UNORM;
  Formats[0].colorSpace := VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
  ChosenSurfFmt := SelectVulkanSurfaceFormat(Formats, ChosenRHIFmt);
  AssertEquals('SelectVulkanSurfaceFormat must fall back to VK_FORMAT_R8G8B8A8_UNORM when BGRA8 unavailable',
    Ord(VK_FORMAT_R8G8B8A8_UNORM), Ord(ChosenSurfFmt.format));
  AssertEquals('ChosenRHIFmt must map to pfRGBA8_UNorm', Ord(pfRGBA8_UNorm), Ord(ChosenRHIFmt));

  Formats[0].format := VK_FORMAT_UNDEFINED;
  ChosenSurfFmt := SelectVulkanSurfaceFormat(Formats, ChosenRHIFmt);
  AssertEquals('VK_FORMAT_UNDEFINED wildcard must select pfBGRA8_UNorm', Ord(pfBGRA8_UNorm), Ord(ChosenRHIFmt));

  SetLength(Modes, 2);
  Modes[0] := VK_PRESENT_MODE_FIFO_KHR;
  Modes[1] := VK_PRESENT_MODE_MAILBOX_KHR;
  AssertEquals('SelectVulkanPresentMode(APreferLowLatencyNoTear=False) must select FIFO',
    Ord(VK_PRESENT_MODE_FIFO_KHR), Ord(SelectVulkanPresentMode(Modes, False)));
  AssertEquals('SelectVulkanPresentMode(APreferLowLatencyNoTear=True) must prefer MAILBOX',
    Ord(VK_PRESENT_MODE_MAILBOX_KHR), Ord(SelectVulkanPresentMode(Modes, True)));

  { 2. TCastleWindow swapchain pass lifecycle, multi-image cycling, active FBO override & 4x MSAA resolve }
  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($A108)), True, True);
  Window := TCastleWindow.Create(nil);
  OffscreenFBOTex := nil;
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  try
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(Device);
    Device.SimulateSwapchainForTesting(160, 120, 2, pfBGRA8_UNorm, pfD24_UNorm_S8_UInt);
    Window.Width := 160;
    Window.Height := 120;

    OffscreenFBOTex := Device.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm, [tuColorAttachment, tuSampled]));

    { Frame 0: image index 0, swapchain pass automatically opened with D24S8 depth-stencil }
    AssertTrue('BeginVulkanFrameIfNeeded must start Frame 0', Window.BeginVulkanFrameIfNeeded);
    AssertEquals('Frame 0 must acquire swapchain image 0', 0, Integer(Device.CurrentSwapchainImageIndex));
    AssertTrue('BeginVulkanFrameIfNeeded must open active swapchain rendering pass',
      (ActiveCommandList <> nil) and ActiveCommandList.IsRendering);
    AssertTrue('Swapchain rendering pass must have HasDepthAttachment = True',
      ActiveCommandList.ActiveRenderingHasDepth);
    AssertEquals('Swapchain depth attachment format must be pfD24_UNorm_S8_UInt',
      Ord(pfD24_UNorm_S8_UInt), Ord(ActiveCommandList.ActiveRenderingDepthFormat));

    Tex0 := Device.GetSwapchainColorTexture;
    AssertTrue('Swapchain image 0 must be non-nil', Tex0 <> nil);

    { Simulate inner offscreen FBO pass mid-frame: GetSwapchainColorTexture must reflect active pass format! }
    ActiveCommandList.EndRendering;
    OffscreenPassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 64, 64), OffscreenFBOTex, loClear, Vector4(0, 0, 0, 1),
      nil, loDontCare, 1.0);
    ActiveCommandList.BeginRendering(OffscreenPassInfo);
    AssertTrue('During offscreen FBO pass, GetSwapchainColorTexture must return OffscreenFBOTex',
      Device.GetSwapchainColorTexture = OffscreenFBOTex);
    ActiveCommandList.EndRendering;
    AssertTrue('After offscreen FBO pass ends, GetSwapchainColorTexture must return swapchain image 0 again',
      Device.GetSwapchainColorTexture = Tex0);

    Window.EndVulkanFrameIfNeeded;
    AssertEquals('Frame 0 must transition swapchain image 0 to rsPresent',
      Ord(rsPresent), Ord(Tex0.CurrentState));
    AssertEquals('VulkanFramesRenderedCount must be 1', 1, Integer(Window.VulkanFramesRenderedCount));

    { Frame 1: must cycle to swapchain image 1 (NOT stale image 0!) }
    AssertTrue('BeginVulkanFrameIfNeeded must start Frame 1', Window.BeginVulkanFrameIfNeeded);
    AssertEquals('Frame 1 must acquire swapchain image 1', 1, Integer(Device.CurrentSwapchainImageIndex));
    Tex1 := Device.GetSwapchainColorTexture;
    AssertTrue('Swapchain image 1 must be distinct from image 0', (Tex1 <> nil) and (Tex1 <> Tex0));
    Window.EndVulkanFrameIfNeeded;
    AssertEquals('Frame 1 must transition swapchain image 1 to rsPresent',
      Ord(rsPresent), Ord(Tex1.CurrentState));
    AssertEquals('VulkanFramesRenderedCount must be 2', 2, Integer(Window.VulkanFramesRenderedCount));

    { Frame 2 with Window.AntiAliasing := aa4SamplesFaster -> 4x MSAA resolve into image 0 }
    Window.AntiAliasing := aa4SamplesFaster;
    AssertTrue('BeginVulkanFrameIfNeeded must start Frame 2 with 4x MSAA', Window.BeginVulkanFrameIfNeeded);
    AssertEquals('Device.SampleCount must sync to 4', 4, Integer(Device.SampleCount));
    AssertTrue('SwapchainMSAAColorTexture must be allocated', Device.SwapchainMSAAColorTexture <> nil);
    AssertTrue('SwapchainMSAADepthTexture must be allocated', Device.SwapchainMSAADepthTexture <> nil);
    AssertEquals('SwapchainMSAADepthTexture format must match SwapchainDepthFormat (pfD24_UNorm_S8_UInt)',
      Ord(pfD24_UNorm_S8_UInt), Ord(Device.SwapchainMSAADepthTexture.Desc.Format));
    AssertEquals('MSAAResolvePassCount must be 1', 1, Integer(Device.MSAAResolvePassCount));
    AssertTrue('GetSwapchainColorTexture must return 1x ResolveTexture (Tex0)',
      Device.GetSwapchainColorTexture = Tex0);
    Window.EndVulkanFrameIfNeeded;
    AssertEquals('Resolved swapchain image 0 must transition to rsPresent',
      Ord(rsPresent), Ord(Tex0.CurrentState));
  finally
    FreeAndNil(OffscreenFBOTex);
    FreeGlobalBatch2DRenderer;
    FreeAndNil(Window);
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(Device);
  end;
end;

procedure TTestCastleVulkanRHI.TestContainerSaveScreenAndSaveScreenRgbaOutOfFrameRealLavapipeRHI;
var
  HeadlessDev, RealDev: TVulkanRHIDevice;
  Container: TTestSizedVulkanContainer;
  RectCtrl: TCastleRectangleControl;
  LavapipeCtrl: TLavapipeScissorClearUIControl;
  RGBImg: TRGBImage;
  RGBAImg: TRGBAlphaImage;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedCtx: TRenderContext;
begin
  { Part 1: Headless out-of-frame SaveScreen / SaveScreenRgba must not disturb simulated swapchain state }
  HeadlessDev := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($A109)), True, True);
  Container := TTestSizedVulkanContainer.Create(nil);
  RGBImg := nil;
  RGBAImg := nil;
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedCtx := RenderContext;
  try
    Container.TestWidth := 128;
    Container.TestHeight := 96;
    Container.BackgroundEnable := True;
    Container.BackgroundColor := Vector4(0.0, 0.0, 1.0, 1.0);
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(HeadlessDev);
    SetActiveCommandList(nil);
    HeadlessDev.SimulateSwapchainForTesting(128, 96, 2);

    RectCtrl := TCastleRectangleControl.Create(Container);
    RectCtrl.Width := 64;
    RectCtrl.Height := 48;
    RectCtrl.Color := Vector4(1.0, 0.0, 0.0, 1.0);
    Container.Controls.InsertFront(RectCtrl);

    RGBImg := Container.SaveScreen;
    AssertTrue('ActiveCommandList must return to nil after out-of-frame SaveScreen',
      ActiveCommandList = nil);
    AssertEquals('SaveScreen must match Container.PixelsWidth', 128, Integer(RGBImg.Width));
    AssertEquals('SaveScreen must match Container.PixelsHeight', 96, Integer(RGBImg.Height));
    AssertEquals('BeginOffscreenFrame must not advance CurrentSwapchainImageIndex',
      0, Integer(HeadlessDev.CurrentSwapchainImageIndex));

    RGBAImg := Container.SaveScreenRgba(Rectangle(0, 0, 64, 48));
    AssertEquals('SaveScreenRgba sub-rect width must be 64', 64, Integer(RGBAImg.Width));
    AssertEquals('SaveScreenRgba sub-rect height must be 48', 48, Integer(RGBAImg.Height));
  finally
    FreeAndNil(RGBAImg);
    FreeAndNil(RGBImg);
    FreeGlobalBatch2DRenderer;
    FreeAndNil(Container);
    RenderContext := SavedCtx;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(HeadlessDev);
  end;

  { Part 2: Live Offscreen Vulkan GPU (Mesa Lavapipe) out-of-frame Container.SaveScreen & SaveScreenRgba }
  if TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
  begin
    Container := TTestSizedVulkanContainer.Create(nil);
    RGBImg := nil;
    RGBAImg := nil;
    SavedRHI := RHIDevice;
    SavedCmd := ActiveCommandList;
    SavedBackend := ApplicationProperties.RenderBackend;
    SavedCtx := RenderContext;
    try
      Container.TestWidth := 64;
      Container.TestHeight := 48;
      Container.BackgroundEnable := True;
      Container.BackgroundColor := Vector4(0.0, 0.5, 1.0, 1.0); { Sky Blue }
      ApplicationProperties.RenderBackend := backendVulkan;
      SetRHIDevice(RealDev);
      SetActiveCommandList(nil);

      LavapipeCtrl := TLavapipeScissorClearUIControl.Create(Container);
      LavapipeCtrl.ClearRect := Rectangle(0, 0, 32, 24); { Bottom-left quadrant }
      LavapipeCtrl.ClearColor := Vector4(1.0, 0.25, 0.0, 0.5); { Orange with Alpha = 0.5 }
      Container.Controls.InsertFront(LavapipeCtrl);

      RGBImg := Container.SaveScreen;
      AssertEquals(64, Integer(RGBImg.Width));
      AssertEquals(48, Integer(RGBImg.Height));
      { Bottom-left (8,8) = Orange (255, ~64, 0) }
      AssertEquals('Lavapipe SaveScreen bottom-left (8,8) R must be 255',
        255, Integer(RGBImg.PixelPtr(8, 8)^.X));
      AssertTrue('Lavapipe SaveScreen bottom-left (8,8) G must be ~64',
        Abs(Integer(RGBImg.PixelPtr(8, 8)^.Y) - 64) <= 2);
      AssertEquals('Lavapipe SaveScreen bottom-left (8,8) B must be 0',
        0, Integer(RGBImg.PixelPtr(8, 8)^.Z));
      { Top-right (48,36) = Sky Blue (0, ~128, 255) }
      AssertEquals('Lavapipe SaveScreen top-right (48,36) R must be 0',
        0, Integer(RGBImg.PixelPtr(48, 36)^.X));
      AssertTrue('Lavapipe SaveScreen top-right (48,36) G must be ~128',
        Abs(Integer(RGBImg.PixelPtr(48, 36)^.Y) - 128) <= 2);
      AssertEquals('Lavapipe SaveScreen top-right (48,36) B must be 255',
        255, Integer(RGBImg.PixelPtr(48, 36)^.Z));

      RGBAImg := Container.SaveScreenRgba(Rectangle(0, 0, 32, 24));
      AssertEquals(32, Integer(RGBAImg.Width));
      AssertEquals(24, Integer(RGBAImg.Height));
      AssertEquals('Lavapipe SaveScreenRgba (8,8) R must be 255',
        255, Integer(RGBAImg.PixelPtr(8, 8)^.X));
      AssertTrue('Lavapipe SaveScreenRgba (8,8) A must preserve rendered alpha ~128',
        Abs(Integer(RGBAImg.PixelPtr(8, 8)^.W) - 128) <= 2);
    finally
      FreeAndNil(RGBAImg);
      FreeAndNil(RGBImg);
      FreeGlobalBatch2DRenderer;
      FreeAndNil(Container);
      RenderContext := SavedCtx;
      SetActiveCommandList(SavedCmd);
      SetRHIDevice(SavedRHI);
      ApplicationProperties.RenderBackend := SavedBackend;
      FreeAndNil(RealDev);
    end;
  end;
end;

procedure TTestCastleVulkanRHI.TestBuiltInSPIRVCoreShadersAndRealLavapipeDrawPrimitive2DRHI;
var
  SPIRV: TSPIRVBytecode;
  Refl: TSPIRVReflectionInfo;
  FoundBinding: TSPIRVReflectedBinding;
  FoundIO: TSPIRVReflectedStageIO;
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  Container: TTestSizedVulkanContainer;
  RectCtrl: TCastleRectangleControl;
  ColorTex: TRHITexture;
  PassInfo: TRHIRenderingInfo;
  Readback: TRGBAlphaImage;
begin
  { Part 1: Verify built-in SPIR-V 1.0 core shaders & pure-Pascal SPIR-V reflection }
  AssertTrue('TryGetBuiltInSPIRV must resolve Primitive2D_VS',
    TCastleShaderCompiler.Instance.TryGetBuiltInSPIRV(ssVertex, '', 'Primitive2D_VS', SPIRV));
  AssertTrue('InspectSPIRVBytecode must validate Primitive2D_VS',
    InspectSPIRVBytecode(SPIRV, Refl) and Refl.IsValid);
  AssertEquals(Ord(ssVertex), Ord(Refl.Stage));
  AssertTrue(Refl.HasPushConstants);
  AssertEquals('Primitive2D_VS push constants size must be 32 bytes', 32, Integer(Refl.PushConstantSize));
  AssertTrue('Primitive2D_VS must declare location 0 input vec2',
    Refl.FindStageInput(0, FoundIO) and (FoundIO.ComponentCount = 2));

  AssertTrue('TryGetBuiltInSPIRV must resolve Primitive2D_FS',
    TCastleShaderCompiler.Instance.TryGetBuiltInSPIRV(ssFragment, '', 'Primitive2D_FS', SPIRV));
  AssertTrue('InspectSPIRVBytecode must validate Primitive2D_FS',
    InspectSPIRVBytecode(SPIRV, Refl) and Refl.IsValid);
  AssertEquals(Ord(ssFragment), Ord(Refl.Stage));
  AssertTrue(Refl.HasPushConstants);
  AssertEquals('Primitive2D_FS push constants size must be 32 bytes', 32, Integer(Refl.PushConstantSize));
  AssertTrue('Primitive2D_FS must declare location 0 output vec4',
    Refl.FindStageOutput(0, FoundIO) and (FoundIO.ComponentCount = 4));

  AssertTrue('TryGetBuiltInSPIRV must resolve UnlitMesh_VS',
    TCastleShaderCompiler.Instance.TryGetBuiltInSPIRV(ssVertex, '', 'UnlitMesh_VS', SPIRV));
  AssertTrue('InspectSPIRVBytecode must validate UnlitMesh_VS',
    InspectSPIRVBytecode(SPIRV, Refl) and Refl.IsValid);
  AssertEquals('UnlitMesh_VS push constants size must be 80 bytes (mat4 + vec4)',
    80, Integer(Refl.PushConstantSize));
  AssertTrue('UnlitMesh_VS must declare location 0 input vec4',
    Refl.FindStageInput(0, FoundIO) and (FoundIO.ComponentCount = 4));

  AssertTrue('TryGetBuiltInSPIRV must resolve UnlitMesh_FS',
    TCastleShaderCompiler.Instance.TryGetBuiltInSPIRV(ssFragment, '', 'UnlitMesh_FS', SPIRV));
  AssertTrue('InspectSPIRVBytecode must validate UnlitMesh_FS',
    InspectSPIRVBytecode(SPIRV, Refl) and Refl.IsValid);
  AssertEquals('UnlitMesh_FS push constants size must be 80 bytes',
    80, Integer(Refl.PushConstantSize));

  AssertTrue('TryGetBuiltInSPIRV must resolve CastleBatch2D.vert',
    TCastleShaderCompiler.Instance.TryGetBuiltInSPIRV(ssVertex, '', 'CastleBatch2D.vert', SPIRV));
  AssertTrue('InspectSPIRVBytecode must validate CastleBatch2D.vert',
    InspectSPIRVBytecode(SPIRV, Refl) and Refl.IsValid);
  AssertEquals('CastleBatch2D.vert push constants size must be 64 bytes (4 x vec4)',
    64, Integer(Refl.PushConstantSize));
  AssertTrue('CastleBatch2D.vert must declare location 0, 2, 4 inputs',
    Refl.FindStageInput(0, FoundIO) and
    Refl.FindStageInput(2, FoundIO) and
    Refl.FindStageInput(4, FoundIO));

  AssertTrue('TryGetBuiltInSPIRV must resolve CastleBatch2D.frag',
    TCastleShaderCompiler.Instance.TryGetBuiltInSPIRV(ssFragment, '', 'CastleBatch2D.frag', SPIRV));
  AssertTrue('InspectSPIRVBytecode must validate CastleBatch2D.frag',
    InspectSPIRVBytecode(SPIRV, Refl) and Refl.IsValid);
  AssertEquals('CastleBatch2D.frag push constants size must be 64 bytes',
    64, Integer(Refl.PushConstantSize));
  AssertTrue('CastleBatch2D.frag must declare set=0, binding=0 dtCombinedImageSampler',
    Refl.FindBinding(0, 0, FoundBinding) and
    (FoundBinding.DescriptorType = dtCombinedImageSampler));

  { Also verify GetMinimalValidSPIRVFallback for all 4 shader stages }
  SPIRV := TCastleShaderCompiler.Instance.GetMinimalValidSPIRVFallback(ssVertex);
  AssertTrue(InspectSPIRVBytecode(SPIRV, Refl) and (Refl.Stage = ssVertex));
  SPIRV := TCastleShaderCompiler.Instance.GetMinimalValidSPIRVFallback(ssFragment);
  AssertTrue(InspectSPIRVBytecode(SPIRV, Refl) and (Refl.Stage = ssFragment));
  SPIRV := TCastleShaderCompiler.Instance.GetMinimalValidSPIRVFallback(ssGeometry);
  AssertTrue(InspectSPIRVBytecode(SPIRV, Refl) and (Refl.Stage = ssGeometry));
  SPIRV := TCastleShaderCompiler.Instance.GetMinimalValidSPIRVFallback(ssCompute);
  AssertTrue(InspectSPIRVBytecode(SPIRV, Refl) and (Refl.Stage = ssCompute));

  { Part 2: Live Offscreen Vulkan GPU (Mesa Lavapipe) multi-draw in-frame DrawPrimitive2D,
    DrawRectangle, DrawCircle, and TCastleRectangleControl execution }
  if TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
  begin
    SavedRHI := RHIDevice;
    SavedCmd := ActiveCommandList;
    SavedBackend := ApplicationProperties.RenderBackend;
    SavedCtx := RenderContext;
    SavedGLFeatures := GLFeatures;
    Container := TTestSizedVulkanContainer.Create(nil);
    RectCtrl := nil;
    ColorTex := nil;
    Readback := nil;
    try
      GLFeatures := nil;
      ApplicationProperties.RenderBackend := backendVulkan;
      SetRHIDevice(RealDev);
      RHIPrimitive2DResetStats;

      Container.TestWidth := 64;
      Container.TestHeight := 64;
      RenderContext := Container.Context;
      RenderContext.Viewport := Rectangle(0, 0, 64, 64);

      ColorTex := RealDev.CreateTexture(TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm,
        [tuColorAttachment, tuTransferSrc]));
      RealCmd := RealDev.BeginFrame as TVulkanRHICommandList;
      SetActiveCommandList(RealCmd);

      PassInfo := TRHIRenderingInfo.CreateColorDepth(
        Rectangle(0, 0, 64, 64),
        ColorTex, loClear, Vector4(0.0, 0.0, 0.0, 1.0),
        nil, loDontCare, 1.0);
      RealCmd.BeginRendering(PassInfo);

      { Draw 1: Opaque Red rectangle at bottom-left [4..28] x [4..28] }
      DrawRectangle(Rectangle(4, 4, 24, 24), Vector4(1.0, 0.0, 0.0, 1.0));

      { Draw 2: Opaque Green rectangle at bottom-right [36..60] x [4..28]
        (Tests that in-frame multi-draw vertex streaming in DrawPrimitive2D does NOT overwrite Draw 1!) }
      DrawRectangle(Rectangle(36, 4, 24, 24), Vector4(0.0, 1.0, 0.0, 1.0));

      { Draw 3: Alpha-blended 50% Blue rectangle over the right half of Green [48..60] x [4..28] }
      DrawRectangle(Rectangle(48, 4, 12, 24), Vector4(0.0, 0.0, 1.0, 0.5));

      { Draw 4: Filled Yellow circle centered at (16, 48) with radius 10 }
      DrawCircle(Vector2Integer(16, 48), 10, 10, Vector4(1.0, 1.0, 0.0, 1.0));

      { Draw 5: TCastleRectangleControl at top-right [36..60] x [36..60] with Magenta fill }
      RectCtrl := TCastleRectangleControl.Create(nil);
      RectCtrl.Translation := Vector2(36, 36);
      RectCtrl.Width := 24;
      RectCtrl.Height := 24;
      RectCtrl.Color := Vector4(1.0, 0.0, 1.0, 1.0);
      Container.Controls.InsertFront(RectCtrl);
      Container.RenderControl(RectCtrl, Rectangle(0, 0, 64, 64));

      RealCmd.EndRendering;
      RealDev.EndFrameAndPresent;

      Readback := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 64, 64));

      { Verify Draw 1 (bottom-left Red at (16, 16)) was NOT overwritten by subsequent draws }
      AssertEquals('Draw 1 Red (16,16) R must be 255', 255, Integer(Readback.PixelPtr(16, 16)^.X));
      AssertEquals('Draw 1 Red (16,16) G must be 0', 0, Integer(Readback.PixelPtr(16, 16)^.Y));
      AssertEquals('Draw 1 Red (16,16) B must be 0', 0, Integer(Readback.PixelPtr(16, 16)^.Z));

      { Verify Draw 2 (unblended Green at (42, 16)) }
      AssertEquals('Draw 2 Green (42,16) R must be 0', 0, Integer(Readback.PixelPtr(42, 16)^.X));
      AssertEquals('Draw 2 Green (42,16) G must be 255', 255, Integer(Readback.PixelPtr(42, 16)^.Y));
      AssertEquals('Draw 2 Green (42,16) B must be 0', 0, Integer(Readback.PixelPtr(42, 16)^.Z));

      { Verify Draw 3 (50% Blue blended over Green at (54, 16) -> (0, ~127, ~128)) }
      AssertEquals('Draw 3 Blended (54,16) R must be 0', 0, Integer(Readback.PixelPtr(54, 16)^.X));
      AssertTrue('Draw 3 Blended (54,16) G must be ~127', Abs(Integer(Readback.PixelPtr(54, 16)^.Y) - 127) <= 3);
      AssertTrue('Draw 3 Blended (54,16) B must be ~128', Abs(Integer(Readback.PixelPtr(54, 16)^.Z) - 128) <= 3);

      { Verify Draw 4 (Yellow Circle center at (16, 48)) }
      AssertEquals('Draw 4 Yellow Circle (16,48) R must be 255', 255, Integer(Readback.PixelPtr(16, 48)^.X));
      AssertEquals('Draw 4 Yellow Circle (16,48) G must be 255', 255, Integer(Readback.PixelPtr(16, 48)^.Y));
      AssertEquals('Draw 4 Yellow Circle (16,48) B must be 0', 0, Integer(Readback.PixelPtr(16, 48)^.Z));

      { Verify Draw 5 (TCastleRectangleControl Magenta at (48, 48)) }
      AssertEquals('Draw 5 TCastleRectangleControl (48,48) R must be 255', 255, Integer(Readback.PixelPtr(48, 48)^.X));
      AssertEquals('Draw 5 TCastleRectangleControl (48,48) G must be 0', 0, Integer(Readback.PixelPtr(48, 48)^.Y));
      AssertEquals('Draw 5 TCastleRectangleControl (48,48) B must be 255', 255, Integer(Readback.PixelPtr(48, 48)^.Z));
    finally
      RHIPrimitive2DResetStats;
      FreeAndNil(Readback);
      FreeAndNil(ColorTex);
      FreeAndNil(RectCtrl);
      FreeAndNil(Container);
      GLFeatures := SavedGLFeatures;
      RenderContext := SavedCtx;
      SetActiveCommandList(SavedCmd);
      SetRHIDevice(SavedRHI);
      ApplicationProperties.RenderBackend := SavedBackend;
      FreeAndNil(RealDev);
    end;
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipeBatch2DDrawableImageFontAlphaClipAndMultiPassRHI;
var
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  Container: TTestSizedVulkanContainer;
  ColorTex: TRHITexture;
  PassInfo: TRHIRenderingInfo;
  SrcImg, FontAlphaImg, Readback: TRGBAlphaImage;
  DrawImg, FontDrawImg: TDrawableImage;
  Batch2D: TCastleBatch2DRenderer;
  SR, IR: TFloatRectangle;
  X, Y: Integer;
begin
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
    Exit;

  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;
  Container := TTestSizedVulkanContainer.Create(nil);
  ColorTex := nil;
  DrawImg := nil;
  FontDrawImg := nil;
  Readback := nil;
  try
    GLFeatures := nil;
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(RealDev);
    FreeGlobalBatch2DRenderer;

    Container.TestWidth := 64;
    Container.TestHeight := 64;
    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 64, 64);

    { Create 16x16 sprite image:
      - Left half (X < 8): Opaque Red (255, 0, 0, 255)
      - Right half (X >= 8): Low-alpha Green (0, 255, 0, 64) }
    SrcImg := TRGBAlphaImage.Create(16, 16);
    for Y := 0 to 15 do
      for X := 0 to 15 do
        if X < 8 then
          SrcImg.PixelPtr(X, Y)^ := Vector4Byte(255, 0, 0, 255)
        else
          SrcImg.PixelPtr(X, Y)^ := Vector4Byte(0, 255, 0, 64);
    DrawImg := TDrawableImage.Create(SrcImg, False, True);

    { Create 16x16 font-glyph alpha image:
      - Left half (X < 8): Alpha = 255 (RGB = 0 to prove TextureHasOnlyAlpha uses vertex RGB!)
      - Right half (X >= 8): Alpha = 0 }
    FontAlphaImg := TRGBAlphaImage.Create(16, 16);
    for Y := 0 to 15 do
      for X := 0 to 15 do
        if X < 8 then
          FontAlphaImg.PixelPtr(X, Y)^ := Vector4Byte(0, 0, 0, 255)
        else
          FontAlphaImg.PixelPtr(X, Y)^ := Vector4Byte(0, 0, 0, 0);
    FontDrawImg := TDrawableImage.Create(FontAlphaImg, False, True);

    ColorTex := RealDev.CreateTexture(TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm,
      [tuColorAttachment, tuTransferSrc]));
    RealCmd := RealDev.BeginFrame as TVulkanRHICommandList;
    SetActiveCommandList(RealCmd);

    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 64, 64),
      ColorTex, loClear, Vector4(0.0, 0.0, 0.5, 1.0), { Clear to Navy Blue (0, 0, 128) }
      nil, loDontCare, 1.0);
    RealCmd.BeginRendering(PassInfo);

    { Pass 1 (standalone DrawNoBatch -> Begin2DPass..End2DPass #1 at FFramePassBaseQuad = 0):
      Opaque sprite at (4, 4, 16, 16) with Alpha = acNone -> Left = Red (255,0,0), Right = Green (0,255,0) }
    DrawImg.Alpha := acNone;
    DrawImg.Color := Vector4(1.0, 1.0, 1.0, 1.0);
    DrawImg.Clip := False;
    DrawImg.Draw(4, 4, 16, 16, 0, 0, 16, 16);

    { Pass 2 (standalone DrawNoBatch -> Begin2DPass..End2DPass #2 at FFramePassBaseQuad = 1):
      Alpha-tested sprite at (24, 4, 16, 16) with Alpha = acTest (cutoff = 0.5):
      Left half (alpha = 1.0 >= 0.5) draws Red; Right half (alpha = 64/255 < 0.5) is discarded (remains Navy Blue)! }
    DrawImg.Alpha := acTest;
    DrawImg.Draw(24, 4, 16, 16, 0, 0, 16, 16);

    { Pass 3 (standalone DrawNoBatch -> Begin2DPass..End2DPass #3 at FFramePassBaseQuad = 2):
      Clipped sprite at (44, 4, 16, 16) with Clip = True and ClipLine = (1.0, 0.0, -0.5):
      dot((1,0), UV) - 0.5 = U - 0.5 < 0 is discarded -> Left half (U < 0.5) is discarded (Navy Blue),
      Right half (U > 0.5) is kept (Green)! }
    DrawImg.Alpha := acNone;
    DrawImg.Clip := True;
    DrawImg.ClipLine := Vector3(1.0, 0.0, -0.5);
    DrawImg.Draw(44, 4, 16, 16, 0, 0, 16, 16);
    DrawImg.Clip := False;

    { Pass 4 (explicit Begin2DPass..End2DPass #4 at FFramePassBaseQuad = 3):
      Font glyph mode (ATextureHasOnlyAlpha = True) at (4, 28, 16, 16) with Yellow ColorTint (1, 1, 0, 1):
      Even though FontAlphaImg has RGB=(0,0,0), TextureHasOnlyAlpha outputs vec4(ColorTint.rgb, ColorTint.a * tex.a)! }
    FontDrawImg.PrepareResources;
    Batch2D := EnsureBatch2DRenderer(RealDev);
    AssertEquals('After 3 single-quad 2D passes in same frame, FrameWriteQuadOffset must be 3',
      3, Integer(Batch2D.FrameWriteQuadOffset));
    Batch2D.Begin2DPass(RealCmd, 64, 64);
    SR := FloatRectangle(4, 28, 16, 16);
    IR := FloatRectangle(0, 0, 16, 16);
    Batch2D.DrawQuads(
      FontDrawImg.RHITexture, FontDrawImg.RHIDescriptorSet,
      @SR, @IR, 1,
      Vector4(1.0, 1.0, 0.0, 1.0),
      CastleInternalBatch2DRHI.bmAlphaBlend,
      False,
      Rectangle(0, 0, 64, 64),
      0.0, TVector2.Zero, False,
      False, TVector3.Zero, 0.0,
      False, bfSrcAlpha, bfOneMinusSrcAlpha,
      True, nil, TVector4.Zero);
    Batch2D.End2DPass;

    RealCmd.EndRendering;
    RealDev.EndFrameAndPresent;

    Readback := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 64, 64));

    { 1. Verify Pass 1 at (4..20, 4..20): Left (6,10) = Red, Right (16,10) = Green }
    AssertEquals('Pass 1 Left (6,10) R must be 255', 255, Integer(Readback.PixelPtr(6, 10)^.X));
    AssertEquals('Pass 1 Left (6,10) G must be 0', 0, Integer(Readback.PixelPtr(6, 10)^.Y));
    AssertEquals('Pass 1 Right (16,10) R must be 0', 0, Integer(Readback.PixelPtr(16, 10)^.X));
    AssertEquals('Pass 1 Right (16,10) G must be 255', 255, Integer(Readback.PixelPtr(16, 10)^.Y));

    { 2. Verify Pass 2 (AlphaTest) at (24..40, 4..20): Left (26,10) = Red, Right (36,10) = Discarded (Navy Blue) }
    AssertEquals('Pass 2 AlphaTest Left (26,10) R must be 255', 255, Integer(Readback.PixelPtr(26, 10)^.X));
    AssertEquals('Pass 2 AlphaTest Right (36,10) G must be 0 (discarded)', 0, Integer(Readback.PixelPtr(36, 10)^.Y));
    AssertTrue('Pass 2 AlphaTest Right (36,10) B must remain Navy ~128',
      Abs(Integer(Readback.PixelPtr(36, 10)^.Z) - 128) <= 2);

    { 3. Verify Pass 3 (ClipLine U >= 0.5) at (44..60, 4..20): Left (46,10) = Discarded (Navy), Right (56,10) = Green }
    AssertEquals('Pass 3 ClipLine Left (46,10) R must be 0 (discarded)', 0, Integer(Readback.PixelPtr(46, 10)^.X));
    AssertTrue('Pass 3 ClipLine Left (46,10) B must remain Navy ~128',
      Abs(Integer(Readback.PixelPtr(46, 10)^.Z) - 128) <= 2);
    AssertEquals('Pass 3 ClipLine Right (56,10) G must be 255 (kept)', 255, Integer(Readback.PixelPtr(56, 10)^.Y));

    { 4. Verify Pass 4 (Font TextureHasOnlyAlpha) at (4..20, 28..44): Left (6,34) = Yellow (255,255,0), Right (16,34) = Navy }
    AssertEquals('Pass 4 Font Glyph Left (6,34) R must be 255', 255, Integer(Readback.PixelPtr(6, 34)^.X));
    AssertEquals('Pass 4 Font Glyph Left (6,34) G must be 255', 255, Integer(Readback.PixelPtr(6, 34)^.Y));
    AssertEquals('Pass 4 Font Glyph Left (6,34) B must be 0', 0, Integer(Readback.PixelPtr(6, 34)^.Z));
    AssertEquals('Pass 4 Font Glyph Right (16,34) R must be 0 (alpha 0)', 0, Integer(Readback.PixelPtr(16, 34)^.X));
    AssertTrue('Pass 4 Font Glyph Right (16,34) B must remain Navy ~128',
      Abs(Integer(Readback.PixelPtr(16, 34)^.Z) - 128) <= 2);
  finally
    FreeAndNil(Readback);
    FreeAndNil(FontDrawImg);
    FreeAndNil(DrawImg);
    FreeAndNil(ColorTex);
    FreeGlobalBatch2DRenderer;
    FreeAndNil(Container);
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipeRenderUnlitMeshDepthAndOcclusionCullingRHI;
var
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  Container: TTestSizedVulkanContainer;
  ColorTex, DepthTex: TRHITexture;
  PassInfo: TRHIRenderingInfo;
  UnlitMesh: TCastleRenderUnlitMesh;
  OccUtils: TOcclusionCullingUtilsRenderer;
  QueryPool: TRHIQueryPool;
  Samples: array[0..1] of UInt64;
  OrthoMVP: TMatrix4;
  Readback: TRGBAlphaImage;
begin
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
    Exit;

  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;
  Container := TTestSizedVulkanContainer.Create(nil);
  ColorTex := nil;
  DepthTex := nil;
  UnlitMesh := nil;
  OccUtils := nil;
  QueryPool := nil;
  Readback := nil;
  try
    GLFeatures := nil;
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(RealDev);

    Container.TestWidth := 64;
    Container.TestHeight := 64;
    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 64, 64);
    RenderContext.DepthTest := True;

    ColorTex := RealDev.CreateTexture(TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm,
      [tuColorAttachment, tuTransferSrc]));
    DepthTex := RealDev.CreateTexture(TRHITextureDesc.Create2D(64, 64, pfD32_Float,
      [tuDepthStencil]));
    QueryPool := RealDev.CreateQueryPool(TRHIQueryPoolDesc.Create(qtOcclusion, 2, 'UnlitOccPool'));

    OrthoMVP := OrthoProjection(FloatRectangle(0, 0, 64, 64), -10.0, 10.0);

    UnlitMesh := TCastleRenderUnlitMesh.Create(True);
    UnlitMesh.ModelViewProjection := OrthoMVP;
    UnlitMesh.SetIndexes([0, 1, 2, 0, 2, 3]);

    OccUtils := TOcclusionCullingUtilsRenderer.Create;
    OccUtils.ProjectionMatrix := OrthoMVP;
    OccUtils.CameraMatrix := TMatrix4.Identity;
    OccUtils.SceneMatrix := TMatrix4.Identity;

    RealCmd := RealDev.BeginFrame as TVulkanRHICommandList;
    SetActiveCommandList(RealCmd);

    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 64, 64),
      ColorTex, loClear, Vector4(0.0, 0.0, 0.0, 1.0),
      DepthTex, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);
    RealCmd.ResetQueryPool(QueryPool, 0, 2);

    { Draw 1 on UnlitMesh: Near Red quad at Z = -2.0 covering [8..40] x [8..40] }
    UnlitMesh.Color := Vector4(1.0, 0.0, 0.0, 1.0);
    UnlitMesh.SetVertexes([
      Vector4( 8,  8, -2.0, 1.0),
      Vector4(40,  8, -2.0, 1.0),
      Vector4(40, 40, -2.0, 1.0),
      Vector4( 8, 40, -2.0, 1.0)
    ], True);
    UnlitMesh.Render(pmTriangles);

    { Draw 2 on the SAME UnlitMesh in the SAME frame: Far Green quad at Z = -5.0 covering [24..56] x [8..40]
      - Proves dynamic vertex streaming on TCastleRenderUnlitMesh does NOT overwrite Draw 1's vertices!
      - Proves 3D depth test (with Vulkan [0,1] depth remap): overlap [24..40] stays Red, [40..56] is Green! }
    UnlitMesh.Color := Vector4(0.0, 1.0, 0.0, 1.0);
    UnlitMesh.SetVertexes([
      Vector4(24,  8, -5.0, 1.0),
      Vector4(56,  8, -5.0, 1.0),
      Vector4(56, 40, -5.0, 1.0),
      Vector4(24, 40, -5.0, 1.0)
    ], True);
    UnlitMesh.Render(pmTriangles);

    { Occlusion Query 0: Quad in front of Red quad (Z = -1.0 > -2.0, closer to camera) -> visible (Samples[0] > 0) }
    RenderContext.ColorChannels := [];
    RenderContext.DepthBufferUpdate := False;
    RealCmd.BeginQuery(QueryPool, 0, True);
    UnlitMesh.SetVertexes([
      Vector4(12, 12, -1.0, 1.0),
      Vector4(28, 12, -1.0, 1.0),
      Vector4(28, 28, -1.0, 1.0),
      Vector4(12, 28, -1.0, 1.0)
    ], True);
    UnlitMesh.Render(pmTriangles);
    RealCmd.EndQuery(QueryPool, 0);

    { Occlusion Query 1: Quad behind Red quad (Z = -8.0 < -2.0, further from camera) -> occluded (Samples[1] = 0) }
    RealCmd.BeginQuery(QueryPool, 1, True);
    UnlitMesh.SetVertexes([
      Vector4(12, 12, -8.0, 1.0),
      Vector4(28, 12, -8.0, 1.0),
      Vector4(28, 28, -8.0, 1.0),
      Vector4(12, 28, -8.0, 1.0)
    ], True);
    UnlitMesh.Render(pmTriangles);
    RealCmd.EndQuery(QueryPool, 1);

    RenderContext.ColorChannels := [0..3];
    RenderContext.DepthBufferUpdate := True;

    RealCmd.EndRendering;
    RealDev.EndFrameAndPresent;

    Samples[0] := 0;
    Samples[1] := High(UInt64);
    AssertTrue('Occlusion query GetResults must succeed',
      QueryPool.GetResults(0, 2, Samples, True));
    if RealDev.SupportsOcclusionQueryPrecise then
      AssertEquals('Front 16x16 unlit mesh precise occlusion query must pass 256 samples',
        256, Integer(Samples[0]))
    else
      AssertTrue('Front 16x16 unlit mesh boolean occlusion query must pass >= 1 sample',
        Samples[0] >= 1);
    AssertEquals('Occluded 16x16 unlit mesh behind Z=-2.0 quad must pass 0 samples',
      0, Integer(Samples[1]));

    Readback := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 64, 64));

    { Non-overlapping left part of Red quad (16, 24) -> Red (255, 0, 0) }
    AssertEquals('Left Red quad (16,24) R must be 255', 255, Integer(Readback.PixelPtr(16, 24)^.X));
    AssertEquals('Left Red quad (16,24) G must be 0', 0, Integer(Readback.PixelPtr(16, 24)^.Y));

    { Overlapping region [24..40] at (32, 24): Near Red (Z=-2) must occlude Far Green (Z=-5)! }
    AssertEquals('Overlap (32,24) R must remain 255 (Near Red occludes Far Green)',
      255, Integer(Readback.PixelPtr(32, 24)^.X));
    AssertEquals('Overlap (32,24) G must be 0',
      0, Integer(Readback.PixelPtr(32, 24)^.Y));

    { Non-overlapping right part of Green quad (48, 24) -> Green (0, 255, 0) }
    AssertEquals('Right Green quad (48,24) R must be 0', 0, Integer(Readback.PixelPtr(48, 24)^.X));
    AssertEquals('Right Green quad (48,24) G must be 255', 255, Integer(Readback.PixelPtr(48, 24)^.Y));
  finally
    FreeAndNil(Readback);
    FreeAndNil(OccUtils);
    FreeAndNil(UnlitMesh);
    FreeAndNil(QueryPool);
    FreeAndNil(DepthTex);
    FreeAndNil(ColorTex);
    FreeAndNil(Container);
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipe3DViewportUnlitAndLitMeshSceneRHI;
var
  Compiler: TCastleShaderCompiler;
  Spv3DVS, Spv3DFS, Spv3DTexFS, SpvVSMFS, SpvScreenVS, SpvScreenFS, SpvScreenInvFS: TSPIRVBytecode;
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  Container: TTestSizedVulkanContainer;
  ColorTex, DepthTex: TRHITexture;
  PassInfo: TRHIRenderingInfo;
  Viewport: TCastleViewport;
  SceneNearUnlit, SceneFarLit: TCastleScene;
  RootNear, RootFar: TX3DRootNode;
  TransNear, TransFar: TTransformNode;
  ShapeNear, ShapeFar: TShapeNode;
  BoxNear, BoxFar: TBoxNode;
  AppNear, AppFar: TAppearanceNode;
  UnlitMat: TUnlitMaterialNode;
  PhysMat: TPhysicalMaterialNode;
  DirLight: TDirectionalLightNode;
  Readback: TRGBAlphaImage;
begin
  { 1. Verify built-in SPIR-V compilation for 3D forward, textured, VSM & screen-effect shaders }
  Compiler := TCastleShaderCompiler.Create;
  try
    AssertTrue('TryGetBuiltInSPIRV CastleDefault3DVert',
      Compiler.TryGetBuiltInSPIRV(ssVertex, 'uniform CastleSceneBlock { mat4 u_ProjectionMatrix; };', 'CastleDefault3DVert', Spv3DVS));
    AssertTrue('TryGetBuiltInSPIRV CastleDefault3DFrag',
      Compiler.TryGetBuiltInSPIRV(ssFragment, 'uniform CastleMaterialBlock { vec4 u_BaseColor; };', 'CastleDefault3DFrag', Spv3DFS));
    AssertTrue('TryGetBuiltInSPIRV CastleShapeFrag_1 textured',
      Compiler.TryGetBuiltInSPIRV(ssFragment,
        'uniform CastleMaterialBlock { vec4 u_BaseColor; }; void main() { vec4 c = texture(castle_base_color_texture, uv); }',
        'CastleShapeFrag_1', Spv3DTexFS));
    AssertTrue('TryGetBuiltInSPIRV CastleVSMCasterFrag',
      Compiler.TryGetBuiltInSPIRV(ssFragment, 'void main() { out_Moments = vec4(depth, moment2, 0.0, 1.0); }', 'CastleVSMCasterFrag', SpvVSMFS));
    AssertTrue('TryGetBuiltInSPIRV ScreenDefaultVS',
      Compiler.TryGetBuiltInSPIRV(ssVertex, 'void main() { v_tex_coord = tex_coord; }', 'ScreenDefaultVS', SpvScreenVS));
    AssertTrue('TryGetBuiltInSPIRV ScreenDefaultFS',
      Compiler.TryGetBuiltInSPIRV(ssFragment, 'uniform sampler2D screen;', 'ScreenDefaultFS', SpvScreenFS));
    AssertTrue('TryGetBuiltInSPIRV ScreenEffectFS invert',
      Compiler.TryGetBuiltInSPIRV(ssFragment, 'uniform sampler2D screen; void main() { c = 1.0 - c; }', 'ScreenEffectFS', SpvScreenInvFS));

    AssertTrue('BuiltIn3DPosNormUVVertSPIRV must be > 400 bytes', Length(Spv3DVS) > 400);
    AssertTrue('BuiltIn3DForwardFragSPIRV must be > 500 bytes', Length(Spv3DFS) > 500);
    AssertTrue('BuiltIn3DForwardTexturedFragSPIRV must be > 500 bytes', Length(Spv3DTexFS) > 500);
    AssertTrue('BuiltInVSMCasterFragSPIRV must be > 80 bytes', Length(SpvVSMFS) > 80);
    AssertTrue('BuiltInScreenEffectVertSPIRV must be > 100 bytes', Length(SpvScreenVS) > 100);
    AssertTrue('BuiltInScreenEffectPassthroughFragSPIRV must be > 100 bytes', Length(SpvScreenFS) > 100);
    AssertTrue('BuiltInScreenEffectInvertFragSPIRV must be > 120 bytes', Length(SpvScreenInvFS) > 120);
  finally
    FreeAndNil(Compiler);
  end;

  { 2. Live 3D TCastleViewport / TCastleScene execution on Mesa Lavapipe }
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
    Exit;

  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;

  Container := TTestSizedVulkanContainer.Create(nil);
  ColorTex := nil;
  DepthTex := nil;
  Viewport := nil;
  SceneNearUnlit := nil;
  SceneFarLit := nil;
  Readback := nil;
  try
    GLFeatures := nil;
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(RealDev);

    Container.TestWidth := 64;
    Container.TestHeight := 64;
    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 64, 64);

    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := True;
    Viewport.Transparent := True;
    Viewport.Camera.ProjectionType := ptOrthographic;
    Viewport.Camera.Orthographic.Width := 4.0;
    Viewport.Camera.Orthographic.Height := 4.0;
    Viewport.Camera.Orthographic.Origin := Vector2(0.5, 0.5);
    Viewport.Camera.SetView(
      Vector3(0.0, 0.0, 5.0),
      Vector3(0.0, 0.0, -1.0),
      Vector3(0.0, 1.0, 0.0));
    Container.Controls.InsertFront(Viewport);

    { Scene 1: Near Unlit Red Box at X = -0.6, Z = 0.0 (covers X in [-1.35, +0.15]) }
    RootNear := TX3DRootNode.Create;
    TransNear := TTransformNode.Create;
    TransNear.Translation := Vector3(-0.6, 0.0, 0.0);
    ShapeNear := TShapeNode.Create;
    BoxNear := TBoxNode.Create;
    BoxNear.Size := Vector3(1.5, 1.5, 0.2);
    ShapeNear.Geometry := BoxNear;
    AppNear := TAppearanceNode.Create;
    UnlitMat := TUnlitMaterialNode.Create;
    UnlitMat.EmissiveColor := Vector3(1.0, 0.0, 0.0);
    AppNear.Material := UnlitMat;
    ShapeNear.Appearance := AppNear;
    TransNear.AddChildren(ShapeNear);
    RootNear.AddChildren(TransNear);
    SceneNearUnlit := TCastleScene.Create(nil);
    SceneNearUnlit.Load(RootNear, True);
    Viewport.Items.Add(SceneNearUnlit);

    { Scene 2: Far Lit Green Box at X = +0.6, Z = -2.0 (covers X in [-0.15, +1.35]) + DirectionalLight }
    RootFar := TX3DRootNode.Create;
    DirLight := TDirectionalLightNode.Create;
    DirLight.Direction := Vector3(0.0, 0.0, -1.0);
    DirLight.Color := Vector3(1.0, 1.0, 1.0);
    DirLight.Intensity := 1.0;
    DirLight.Global := True;
    RootFar.AddChildren(DirLight);

    TransFar := TTransformNode.Create;
    TransFar.Translation := Vector3(0.6, 0.0, -2.0);
    ShapeFar := TShapeNode.Create;
    BoxFar := TBoxNode.Create;
    BoxFar.Size := Vector3(1.5, 1.5, 0.2);
    ShapeFar.Geometry := BoxFar;
    AppFar := TAppearanceNode.Create;
    PhysMat := TPhysicalMaterialNode.Create;
    PhysMat.BaseColor := Vector3(0.0, 1.0, 0.0);
    AppFar.Material := PhysMat;
    ShapeFar.Appearance := AppFar;
    TransFar.AddChildren(ShapeFar);
    RootFar.AddChildren(TransFar);
    SceneFarLit := TCastleScene.Create(nil);
    SceneFarLit.Load(RootFar, True);
    {$warnings off}
    Viewport.Items.MainScene := SceneFarLit;
    {$warnings on}
    Viewport.Items.Add(SceneFarLit);

    ColorTex := RealDev.CreateTexture(TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm,
      [tuColorAttachment, tuSampled, tuTransferSrc]));
    DepthTex := RealDev.CreateTexture(TRHITextureDesc.Create2D(64, 64, pfD32_Float,
      [tuDepthStencil]));

    RealCmd := RealDev.BeginFrame as TVulkanRHICommandList;
    SetActiveCommandList(RealCmd);

    Viewport.BeforeRender;

    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 64, 64),
      ColorTex, loClear, Vector4(10 / 255.0, 20 / 255.0, 30 / 255.0, 1.0),
      DepthTex, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);

    Viewport.Render;
    Viewport.RenderOverChildren;

    RealCmd.EndRendering;
    RealDev.EndFrameAndPresent;

    Readback := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 64, 64));

    { Corner (2, 2): Cleared background (10, 20, 30, 255) }
    AssertEquals('Corner (2,2) R must be 10', 10, Integer(Readback.PixelPtr(2, 2)^.X));
    AssertEquals('Corner (2,2) G must be 20', 20, Integer(Readback.PixelPtr(2, 2)^.Y));
    AssertEquals('Corner (2,2) B must be 30', 30, Integer(Readback.PixelPtr(2, 2)^.Z));

    { Left box (16, 32): Near Unlit Red box (255, 0, 0) }
    AssertEquals('Left Near Unlit Box (16,32) R must be 255', 255, Integer(Readback.PixelPtr(16, 32)^.X));
    AssertEquals('Left Near Unlit Box (16,32) G must be 0', 0, Integer(Readback.PixelPtr(16, 32)^.Y));
    AssertEquals('Left Near Unlit Box (16,32) B must be 0', 0, Integer(Readback.PixelPtr(16, 32)^.Z));

    { Center overlap (32, 32): Near Red box (Z=0) occludes Far Green box (Z=-2) via hardware depth buffer }
    AssertEquals('Center Overlap (32,32) R must be 255 (Near Red occludes Far Green)',
      255, Integer(Readback.PixelPtr(32, 32)^.X));
    AssertEquals('Center Overlap (32,32) G must be 0',
      0, Integer(Readback.PixelPtr(32, 32)^.Y));

    { Right box (48, 32): Far Lit Green PBR box illuminated by DirectionalLight (default Metallic=1, Roughness=1 GGX conductor: R=0, G>70, B=0) }
    AssertEquals('Right Far Lit Box (48,32) R must be 0', 0, Integer(Readback.PixelPtr(48, 32)^.X));
    AssertTrue('Right Far Lit PBR Box (48,32) G must be > 70', Readback.PixelPtr(48, 32)^.Y > 70);
    AssertEquals('Right Far Lit Box (48,32) B must be 0', 0, Integer(Readback.PixelPtr(48, 32)^.Z));
  finally
    FreeAndNil(Readback);
    FreeAndNil(SceneFarLit);
    FreeAndNil(SceneNearUnlit);
    FreeAndNil(Viewport);
    FreeAndNil(DepthTex);
    FreeAndNil(ColorTex);
    FreeAndNil(Container);
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipe3DViewportTexturedMeshAndAlphaCutoffRHI;
var
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  Container: TTestSizedVulkanContainer;
  ColorTex, DepthTex: TRHITexture;
  PassInfo: TRHIRenderingInfo;
  Viewport: TCastleViewport;
  SceneBackBlue, SceneFrontMask: TCastleScene;
  RootBack, RootFront: TX3DRootNode;
  TransBack, TransFront: TTransformNode;
  ShapeBack, ShapeFront: TShapeNode;
  BoxBack, BoxFront: TBoxNode;
  AppBack, AppFront: TAppearanceNode;
  MatBack, MatFront: TUnlitMaterialNode;
  PixTex: TPixelTextureNode;
  TexImg: TRGBAlphaImage;
  X, Y: Integer;
  Readback: TRGBAlphaImage;
begin
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
    Exit;

  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;

  Container := TTestSizedVulkanContainer.Create(nil);
  ColorTex := nil;
  DepthTex := nil;
  Viewport := nil;
  SceneBackBlue := nil;
  SceneFrontMask := nil;
  Readback := nil;
  try
    GLFeatures := nil;
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(RealDev);

    Container.TestWidth := 64;
    Container.TestHeight := 64;
    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 64, 64);

    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := True;
    Viewport.Transparent := True;
    Viewport.Camera.ProjectionType := ptOrthographic;
    Viewport.Camera.Orthographic.Width := 4.0;
    Viewport.Camera.Orthographic.Height := 4.0;
    Viewport.Camera.Orthographic.Origin := Vector2(0.5, 0.5);
    Viewport.Camera.SetView(
      Vector3(0.0, 0.0, 5.0),
      Vector3(0.0, 0.0, -1.0),
      Vector3(0.0, 1.0, 0.0));
    Container.Controls.InsertFront(Viewport);

    { Far background scene at Z = -2.0: Solid Blue box }
    RootBack := TX3DRootNode.Create;
    TransBack := TTransformNode.Create;
    TransBack.Translation := Vector3(0.0, 0.0, -2.0);
    ShapeBack := TShapeNode.Create;
    BoxBack := TBoxNode.Create;
    BoxBack.Size := Vector3(3.0, 3.0, 0.2);
    ShapeBack.Geometry := BoxBack;
    AppBack := TAppearanceNode.Create;
    MatBack := TUnlitMaterialNode.Create;
    MatBack.EmissiveColor := Vector3(0.0, 0.0, 1.0);
    AppBack.Material := MatBack;
    ShapeBack.Appearance := AppBack;
    TransBack.AddChildren(ShapeBack);
    RootBack.AddChildren(TransBack);
    SceneBackBlue := TCastleScene.Create(nil);
    SceneBackBlue.Load(RootBack, True);
    Viewport.Items.Add(SceneBackBlue);

    { Near foreground scene at Z = 0.0: Textured Alpha-Cutoff box (left half opaque yellow, right half alpha=0) }
    RootFront := TX3DRootNode.Create;
    TransFront := TTransformNode.Create;
    TransFront.Translation := Vector3(0.0, 0.0, 0.0);
    ShapeFront := TShapeNode.Create;
    BoxFront := TBoxNode.Create;
    BoxFront.Size := Vector3(2.0, 2.0, 0.2);
    ShapeFront.Geometry := BoxFront;
    AppFront := TAppearanceNode.Create;
    AppFront.AlphaMode := amMask;
    AppFront.AlphaCutoff := 0.5;
    MatFront := TUnlitMaterialNode.Create;
    MatFront.EmissiveColor := Vector3(1.0, 1.0, 1.0);

    PixTex := TPixelTextureNode.Create;
    PixTex.RepeatS := False;
    PixTex.RepeatT := False;
    TexImg := TRGBAlphaImage.Create(64, 64);
    for Y := 0 to 63 do
      for X := 0 to 63 do
        if X < 32 then
          TexImg.PixelPtr(X, Y)^ := Vector4Byte(255, 255, 0, 255) { Opaque Yellow }
        else
          TexImg.PixelPtr(X, Y)^ := Vector4Byte(255, 0, 255, 0);  { Transparent (Alpha=0 < 0.5 -> OpKill) }
    PixTex.FdImage.Value := TexImg;
    MatFront.EmissiveTexture := PixTex;
    AppFront.Material := MatFront;
    ShapeFront.Appearance := AppFront;
    TransFront.AddChildren(ShapeFront);
    RootFront.AddChildren(TransFront);
    SceneFrontMask := TCastleScene.Create(nil);
    SceneFrontMask.Load(RootFront, True);
    Viewport.Items.Add(SceneFrontMask);

    ColorTex := RealDev.CreateTexture(TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm,
      [tuColorAttachment, tuSampled, tuTransferSrc]));
    DepthTex := RealDev.CreateTexture(TRHITextureDesc.Create2D(64, 64, pfD32_Float,
      [tuDepthStencil]));

    RealCmd := RealDev.BeginFrame as TVulkanRHICommandList;
    SetActiveCommandList(RealCmd);

    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 64, 64),
      ColorTex, loClear, Vector4(0.0, 0.0, 0.0, 1.0),
      DepthTex, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);

    Viewport.Render;

    RealCmd.EndRendering;
    RealDev.EndFrameAndPresent;

    Readback := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 64, 64));

    { Left half of front box at (24, 32): Opaque Yellow from texture (255, 255, 0) }
    AssertEquals('Left textured box (24,32) R must be 255', 255, Integer(Readback.PixelPtr(24, 32)^.X));
    AssertEquals('Left textured box (24,32) G must be 255', 255, Integer(Readback.PixelPtr(24, 32)^.Y));
    AssertEquals('Left textured box (24,32) B must be 0', 0, Integer(Readback.PixelPtr(24, 32)^.Z));

    { Right half of front box at (40, 32): Discarded by OpKill (alpha=0 < 0.5), revealing Far Blue box (0, 0, 255) }
    AssertEquals('Right alpha-discarded region (40,32) R must be 0', 0, Integer(Readback.PixelPtr(40, 32)^.X));
    AssertEquals('Right alpha-discarded region (40,32) G must be 0', 0, Integer(Readback.PixelPtr(40, 32)^.Y));
    AssertEquals('Right alpha-discarded region (40,32) B must be 255 (Far Blue box visible)',
      255, Integer(Readback.PixelPtr(40, 32)^.Z));
  finally
    FreeAndNil(Readback);
    FreeAndNil(SceneFrontMask);
    FreeAndNil(SceneBackBlue);
    FreeAndNil(Viewport);
    FreeAndNil(DepthTex);
    FreeAndNil(ColorTex);
    FreeAndNil(Container);
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipeViewportScreenEffectPostProcessingRHI;
var
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  Container: TTestSizedVulkanContainer;
  ColorTex, DepthTex: TRHITexture;
  PassInfo: TRHIRenderingInfo;
  Viewport: TCastleViewport;
  Scene: TCastleScene;
  Root: TX3DRootNode;
  Shape: TShapeNode;
  Box: TBoxNode;
  App: TAppearanceNode;
  Mat: TUnlitMaterialNode;
  ScreenEffect: TScreenEffectNode;
  CompShader: TComposedShaderNode;
  FragPart: TShaderPartNode;
  DirectColorTex: TRHITexture;
  Readback, SrcReadback, DirectReadback: TRGBAlphaImage;
  DiagExtra: String;
begin
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
    Exit;

  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;

  Container := TTestSizedVulkanContainer.Create(nil);
  ColorTex := nil;
  DepthTex := nil;
  DirectColorTex := nil;
  Viewport := nil;
  Scene := nil;
  Readback := nil;
  SrcReadback := nil;
  DirectReadback := nil;
  try
    GLFeatures := nil;
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(RealDev);

    Container.TestWidth := 64;
    Container.TestHeight := 64;
    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 64, 64);

    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := True;
    Viewport.BackgroundColor := Vector4(1.0, 0.0, 0.0, 1.0); { Red background -> inverted to Cyan (0, 255, 255) }
    Viewport.Camera.ProjectionType := ptOrthographic;
    Viewport.Camera.Orthographic.Width := 4.0;
    Viewport.Camera.Orthographic.Height := 4.0;
    Viewport.Camera.Orthographic.Origin := Vector2(0.5, 0.5);
    Viewport.Camera.SetView(
      Vector3(0.0, 0.0, 5.0),
      Vector3(0.0, 0.0, -1.0),
      Vector3(0.0, 1.0, 0.0));
    Container.Controls.InsertFront(Viewport);

    { Scene with Blue Unlit Box in center (inverted to Yellow (255, 255, 0)) + TScreenEffectNode color inversion }
    Root := TX3DRootNode.Create;
    Shape := TShapeNode.Create;
    Box := TBoxNode.Create;
    Box.Size := Vector3(2.0, 2.0, 0.2);
    Shape.Geometry := Box;
    App := TAppearanceNode.Create;
    Mat := TUnlitMaterialNode.Create;
    Mat.EmissiveColor := Vector3(0.0, 0.0, 1.0); { Blue -> inverted to Yellow (255, 255, 0) }
    App.Material := Mat;
    Shape.Appearance := App;
    Root.AddChildren(Shape);

    ScreenEffect := TScreenEffectNode.Create;
    CompShader := TComposedShaderNode.Create;
    FragPart := TShaderPartNode.Create;
    FragPart.ShaderType := stFragment;
    FragPart.Contents := 'void main() { gl_FragColor = vec4(1.0 - screen_get_color(screen_position()).rgb, 1.0); }';
    CompShader.SetParts([FragPart]);
    ScreenEffect.SetShaders([CompShader]);
    Root.AddChildren(ScreenEffect);

    Scene := TCastleScene.Create(nil);
    Scene.Load(Root, True);
    {$warnings off}
    Viewport.Items.MainScene := Scene;
    {$warnings on}
    Viewport.Items.Add(Scene);

    ColorTex := RealDev.CreateTexture(TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm,
      [tuColorAttachment, tuSampled, tuTransferSrc]));
    DepthTex := RealDev.CreateTexture(TRHITextureDesc.Create2D(64, 64, pfD32_Float,
      [tuDepthStencil]));

    RealCmd := RealDev.BeginFrame as TVulkanRHICommandList;
    SetActiveCommandList(RealCmd);

    Viewport.BeforeRender;

    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 64, 64),
      ColorTex, loClear, Vector4(0.2, 0.0, 0.2, 1.0),
      DepthTex, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);

    Viewport.Render;
    Viewport.RenderOverChildren;

    RealCmd.EndRendering;
    RealDev.EndFrameAndPresent;

    AssertEquals('ScreenEffect must execute 1 RHI post-processing pass',
      1, Integer(Viewport.RHIScreenPassCount));
    AssertTrue('Viewport.RHIScreenTextureSrc must be allocated',
      Viewport.RHIScreenTextureSrc <> nil);
    SrcReadback := RealDev.GrabTextureImage(Viewport.RHIScreenTextureSrc, Rectangle(0, 0, 64, 64));
    Readback := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 64, 64));

    { Offscreen pre-effect SrcReadback: Red background (255,0,0) at (4,4), Blue box (0,0,255) at (32,32) }
    AssertEquals(Format('Offscreen ScreenEffect Src (4,4) R must be 255 [src=(%d,%d,%d,%d), srcCenter=(%d,%d,%d,%d)]', [
      SrcReadback.PixelPtr(4, 4)^.X, SrcReadback.PixelPtr(4, 4)^.Y, SrcReadback.PixelPtr(4, 4)^.Z, SrcReadback.PixelPtr(4, 4)^.W,
      SrcReadback.PixelPtr(32, 32)^.X, SrcReadback.PixelPtr(32, 32)^.Y, SrcReadback.PixelPtr(32, 32)^.Z, SrcReadback.PixelPtr(32, 32)^.W]),
      255, Integer(SrcReadback.PixelPtr(4, 4)^.X));
    AssertEquals('Offscreen ScreenEffect Src (32,32) B must be 255',
      255, Integer(SrcReadback.PixelPtr(32, 32)^.Z));

    DiagExtra := '';
    if Readback.PixelPtr(4, 4)^.Y <> 255 then
    begin
      DirectColorTex := RealDev.CreateTexture(TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm,
        [tuColorAttachment, tuSampled, tuTransferSrc]));
      RealCmd := RealDev.BeginFrame as TVulkanRHICommandList;
      SetActiveCommandList(RealCmd);
      Viewport.ExecuteRHIScreenEffectPasses(
        [Viewport.GetScreenEffectRHIPipeline(0)], 64, 64, False, DirectColorTex, 0.1, 100.0);
      RealDev.EndFrameAndPresent;
      DirectReadback := RealDev.GrabTextureImage(DirectColorTex, Rectangle(0, 0, 64, 64));
      DiagExtra := Format(', direct=(%d,%d,%d,%d), pipeOk=%d', [
        DirectReadback.PixelPtr(4, 4)^.X, DirectReadback.PixelPtr(4, 4)^.Y,
        DirectReadback.PixelPtr(4, 4)^.Z, DirectReadback.PixelPtr(4, 4)^.W,
        Ord(Viewport.GetScreenEffectRHIPipeline(0) <> nil)]);
      FreeAndNil(DirectReadback);
      RealCmd := RealDev.BeginFrame as TVulkanRHICommandList;
      SetActiveCommandList(RealCmd);
      Viewport.ExecuteRHIScreenEffectPasses(
        [nil], 64, 64, False, DirectColorTex, 0.1, 100.0);
      RealDev.EndFrameAndPresent;
      DirectReadback := RealDev.GrabTextureImage(DirectColorTex, Rectangle(0, 0, 64, 64));
      DiagExtra := DiagExtra + Format(', defBuiltin=(%d,%d,%d,%d)', [
        DirectReadback.PixelPtr(4, 4)^.X, DirectReadback.PixelPtr(4, 4)^.Y,
        DirectReadback.PixelPtr(4, 4)^.Z, DirectReadback.PixelPtr(4, 4)^.W]);
    end;

    { Corner (4, 4): Viewport Red background (1, 0, 0) inverted by TScreenEffectNode -> Cyan (0, 255, 255) }
    AssertEquals(Format('Inverted background (4,4) R must be 0 [got RGBA=(%d,%d,%d,%d), center=(%d,%d,%d,%d), src=(%d,%d,%d,%d)%s]', [
      Readback.PixelPtr(4, 4)^.X, Readback.PixelPtr(4, 4)^.Y, Readback.PixelPtr(4, 4)^.Z, Readback.PixelPtr(4, 4)^.W,
      Readback.PixelPtr(32, 32)^.X, Readback.PixelPtr(32, 32)^.Y, Readback.PixelPtr(32, 32)^.Z, Readback.PixelPtr(32, 32)^.W,
      SrcReadback.PixelPtr(4, 4)^.X, SrcReadback.PixelPtr(4, 4)^.Y, SrcReadback.PixelPtr(4, 4)^.Z, SrcReadback.PixelPtr(4, 4)^.W,
      DiagExtra]),
      0, Integer(Readback.PixelPtr(4, 4)^.X));
    AssertEquals(Format('Inverted background (4,4) G must be 255 [got RGBA=(%d,%d,%d,%d), center=(%d,%d,%d,%d), src=(%d,%d,%d,%d)%s]', [
      Readback.PixelPtr(4, 4)^.X, Readback.PixelPtr(4, 4)^.Y, Readback.PixelPtr(4, 4)^.Z, Readback.PixelPtr(4, 4)^.W,
      Readback.PixelPtr(32, 32)^.X, Readback.PixelPtr(32, 32)^.Y, Readback.PixelPtr(32, 32)^.Z, Readback.PixelPtr(32, 32)^.W,
      SrcReadback.PixelPtr(4, 4)^.X, SrcReadback.PixelPtr(4, 4)^.Y, SrcReadback.PixelPtr(4, 4)^.Z, SrcReadback.PixelPtr(4, 4)^.W,
      DiagExtra]),
      255, Integer(Readback.PixelPtr(4, 4)^.Y));
    AssertEquals('Inverted background (4,4) B must be 255', 255, Integer(Readback.PixelPtr(4, 4)^.Z));

    { Center (32, 32): Blue 3D box (0, 0, 1) inverted by TScreenEffectNode -> Yellow (255, 255, 0) }
    AssertEquals('Inverted 3D Blue box (32,32) R must be 255', 255, Integer(Readback.PixelPtr(32, 32)^.X));
    AssertEquals('Inverted 3D Blue box (32,32) G must be 255', 255, Integer(Readback.PixelPtr(32, 32)^.Y));
    AssertEquals('Inverted 3D Blue box (32,32) B must be 0', 0, Integer(Readback.PixelPtr(32, 32)^.Z));
  finally
    FreeAndNil(DirectReadback);
    FreeAndNil(DirectColorTex);
    FreeAndNil(SrcReadback);
    FreeAndNil(Readback);
    FreeAndNil(Scene);
    FreeAndNil(Viewport);
    FreeAndNil(DepthTex);
    FreeAndNil(ColorTex);
    FreeAndNil(Container);
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(RealDev);
  end;
end;

function TTestCastleVulkanRHI.CreateHeadlessSurfaceForTest(const AInstance: VkInstance): VkSurfaceKHR;
begin
  Result := CreateVulkanHeadlessSurface(AInstance);
end;

procedure TTestCastleVulkanRHI.TestVulkanSwapchainCompositeAlphaAndWSIExtensionDiscoveryRHI;
var
  HeadlessDesc: TVulkanNativeSurfaceDesc;
  HeadlessExts, FilteredExts: TAnsiStringArray;
  EnablePortability: Boolean;
  Dev: TVulkanRHIDevice;
  Cmd: TRHICommandList;
begin
  { 1. SelectVulkanCompositeAlpha preference chain }
  AssertEquals('Empty mask defaults to OPAQUE_BIT_KHR',
    VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR,
    SelectVulkanCompositeAlpha(0));
  AssertEquals('OPAQUE + INHERIT prefers OPAQUE_BIT_KHR',
    VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR,
    SelectVulkanCompositeAlpha(VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR or VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR));
  AssertEquals('PRE_MULTIPLIED + INHERIT prefers PRE_MULTIPLIED_BIT_KHR',
    VK_COMPOSITE_ALPHA_PRE_MULTIPLIED_BIT_KHR,
    SelectVulkanCompositeAlpha(VK_COMPOSITE_ALPHA_PRE_MULTIPLIED_BIT_KHR or VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR));
  AssertEquals('POST_MULTIPLIED + INHERIT prefers POST_MULTIPLIED_BIT_KHR',
    VK_COMPOSITE_ALPHA_POST_MULTIPLIED_BIT_KHR,
    SelectVulkanCompositeAlpha(VK_COMPOSITE_ALPHA_POST_MULTIPLIED_BIT_KHR or VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR));
  AssertEquals('INHERIT-only surface (e.g. Android/Wayland) selects INHERIT_BIT_KHR',
    VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR,
    SelectVulkanCompositeAlpha(VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR));

  { 2. VK_EXT_headless_surface descriptor & extension table }
  HeadlessDesc := TVulkanNativeSurfaceDesc.CreateHeadless;
  AssertEquals('Headless WSI platform enum', Ord(vwsiHeadless), Ord(HeadlessDesc.Platform));
  AssertTrue('Headless surface descriptor must validate without OS window handles',
    ValidateVulkanNativeSurfaceDesc(HeadlessDesc));
  HeadlessExts := GetRequiredVulkanInstanceExtensionsForPlatform(vwsiHeadless);
  AssertEquals('vwsiHeadless requires 2 instance extensions', 2, Length(HeadlessExts));
  AssertEquals('vwsiHeadless ext[0] = VK_KHR_surface',
    String(VK_KHR_SURFACE_EXTENSION_NAME), String(HeadlessExts[0]));
  AssertEquals('vwsiHeadless ext[1] = VK_EXT_headless_surface',
    String(VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME), String(HeadlessExts[1]));

  { 3. Loader-aware WSI extension filtering + VK_KHR_portability_enumeration }
  FilteredExts := BuildAvailableVulkanWSIInstanceExtensions(
    ['VK_KHR_surface', 'VK_EXT_headless_surface', 'VK_KHR_xlib_surface', 'VK_EXT_debug_utils'],
    EnablePortability);
  AssertFalse('Linux/Windows WSI list without portability extension keeps EnablePortability=False',
    EnablePortability);
  AssertEquals('Filtered WSI extensions count', 3, Length(FilteredExts));
  AssertEquals('FilteredExts[0]', 'VK_KHR_surface', String(FilteredExts[0]));
  AssertEquals('FilteredExts[1]', 'VK_KHR_xlib_surface', String(FilteredExts[1]));
  AssertEquals('FilteredExts[2]', 'VK_EXT_headless_surface', String(FilteredExts[2]));

  FilteredExts := BuildAvailableVulkanWSIInstanceExtensions(
    ['VK_KHR_surface', 'VK_EXT_metal_surface', 'VK_KHR_portability_enumeration'],
    EnablePortability);
  AssertTrue('MoltenVK portability enumeration enables VK_INSTANCE_CREATE_ENUMERATE_PORTABILITY_BIT_KHR',
    EnablePortability);
  AssertEquals('MoltenVK filtered WSI extensions count', 3, Length(FilteredExts));

  FilteredExts := BuildAvailableVulkanWSIInstanceExtensions(
    ['VK_EXT_debug_utils'],
    EnablePortability);
  AssertFalse('Non-WSI loader keeps EnablePortability=False', EnablePortability);
  AssertEquals('Non-WSI loader returns 0 WSI extensions', 0, Length(FilteredExts));

  { 4. Minimized (0x0) swapchain lifecycle pause and unminimize recovery }
  Dev := TVulkanRHIDevice.CreateHeadless(nil);
  try
    Dev.SimulateSwapchainForTesting(128, 96, 3, pfBGRA8_UNorm, pfD24_UNorm_S8_UInt);
    AssertEquals('Initial simulated swapchain image count = 3', Cardinal(3), Dev.SwapchainImageCount);
    AssertFalse('Initial swapchain is not minimized', Dev.SwapchainMinimized);

    Dev.ResizeSwapchain(0, 0);
    AssertTrue('ResizeSwapchain(0, 0) marks swapchain minimized', Dev.SwapchainMinimized);
    Cmd := Dev.BeginFrame;
    AssertTrue('BeginFrame returns nil cleanly while swapchain is minimized', Cmd = nil);
    AssertFalse('Minimized BeginFrame leaves DeferResourceDestruction=False', Dev.DeferResourceDestruction);

    Dev.ResizeSwapchain(160, 120);
    AssertFalse('ResizeSwapchain(160, 120) clears minimized state', Dev.SwapchainMinimized);
    AssertEquals('Unminimized swapchain width', Cardinal(160), Dev.SwapchainExtent.width);
    AssertEquals('Unminimized swapchain height', Cardinal(120), Dev.SwapchainExtent.height);
    Cmd := Dev.BeginFrame;
    AssertTrue('BeginFrame succeeds after unminimize', Cmd <> nil);
    Dev.EndFrameAndPresent;
  finally
    FreeAndNil(Dev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealVulkanHeadlessSurfaceLiveSwapchainPresentAndResizeRHI;
var
  RealDev: TVulkanRHIDevice;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  Container: TTestSizedVulkanContainer;
  Viewport: TCastleViewport;
  Scene: TCastleScene;
  Root: TX3DRootNode;
  Shape: TShapeNode;
  Box: TBoxNode;
  App: TAppearanceNode;
  Mat: TUnlitMaterialNode;
  RealCmd: TVulkanRHICommandList;
  ColorTex, DepthTex: TRHITexture;
  PassInfo: TRHIRenderingInfo;
  Readback1, Readback2: TRGBAlphaImage;
  FrameIdx: Integer;
begin
  try
    LoadVulkan;
  except
    on Exception do
      Exit;
  end;
  if not IsVulkanInstanceExtensionSupported(VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME) then
    Exit;

  RealDev := nil;
  try
    RealDev := TVulkanRHIDevice.Create(
      {$ifdef FPC}@{$endif}CreateHeadlessSurfaceForTest, 128, 96, False);
  except
    on Exception do
    begin
      FreeAndNil(RealDev);
      Exit;
    end;
  end;

  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;
  Container := nil;
  Viewport := nil;
  Scene := nil;
  Readback1 := nil;
  Readback2 := nil;
  try
    AssertTrue('Live VK_EXT_headless_surface handle must be non-null',
      RealDev.SurfaceHandle <> VK_NULL_HANDLE);
    AssertTrue('Live VkSwapchainKHR handle must be non-null',
      RealDev.SwapchainHandle <> VK_NULL_HANDLE);
    AssertTrue('Live VkSwapchainKHR must allocate >= 2 swapchain images',
      RealDev.SwapchainImageCount >= 2);
    AssertEquals('Initial live swapchain width = 128', Cardinal(128), RealDev.SwapchainExtent.width);
    AssertEquals('Initial live swapchain height = 96', Cardinal(96), RealDev.SwapchainExtent.height);

    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(RealDev);
    GLFeatures := nil;

    Container := TTestSizedVulkanContainer.Create(nil);
    Container.TestWidth := 128;
    Container.TestHeight := 96;
    RenderContext := Container.Context;

    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := True;
    Viewport.BackgroundColor := Vector4(0.0, 0.0, 0.5, 1.0);
    Container.Controls.InsertFront(Viewport);
    Viewport.Camera.SetWorldView(
      Vector3(0.0, 0.0, 5.0),
      Vector3(0.0, 0.0, -1.0),
      Vector3(0.0, 1.0, 0.0));

    Root := TX3DRootNode.Create;
    Shape := TShapeNode.Create;
    Box := TBoxNode.Create;
    Box.Size := Vector3(2.5, 2.5, 0.5);
    Shape.Geometry := Box;
    App := TAppearanceNode.Create;
    Mat := TUnlitMaterialNode.Create;
    Mat.EmissiveColor := Vector3(0.0, 1.0, 0.0);
    App.Material := Mat;
    Shape.Appearance := App;
    Root.AddChildren(Shape);

    Scene := TCastleScene.Create(nil);
    Scene.Load(Root, True);
    {$warnings off}
    Viewport.Items.MainScene := Scene;
    {$warnings on}
    Viewport.Items.Add(Scene);

    { Present 4 consecutive frames (exceeding MaxFramesInFlight=2 and cycling per-image semaphores) }
    for FrameIdx := 0 to 3 do
    begin
      RealCmd := RealDev.BeginFrame as TVulkanRHICommandList;
      AssertTrue('BeginFrame must acquire live swapchain image', RealCmd <> nil);
      SetActiveCommandList(RealCmd);

      Viewport.BeforeRender;
      ColorTex := RealDev.GetSwapchainColorTexture;
      DepthTex := RealDev.GetSwapchainDepthTexture;
      AssertTrue('Swapchain color texture must be non-nil', ColorTex <> nil);
      AssertTrue('Swapchain depth texture must be non-nil', DepthTex <> nil);

      PassInfo := RealDev.BuildSwapchainRenderingInfo(
        Rectangle(0, 0, 128, 96), ColorTex, DepthTex,
        Vector4(0.0, 0.0, 0.5, 1.0), loClear, loClear, 1.0);
      RealCmd.BeginRendering(PassInfo);
      RealCmd.SetViewport(FloatRectangle(0, 0, 128, 96), 0.0, 1.0);
      RealCmd.SetScissor(Rectangle(0, 0, 128, 96));

      Viewport.Render;
      Viewport.RenderOverChildren;
      RealCmd.EndRendering;

      if FrameIdx = 2 then
      begin
        { Read back frame 2 swapchain image before EndFrameAndPresent transitions it to PRESENT_SRC_KHR }
        RealDev.EndFrameAndPresent;
        Readback1 := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 128, 96));
      end else
        RealDev.EndFrameAndPresent;
    end;

    AssertEquals('4 frames presented before resize', Cardinal(4), RealDev.TotalFramesPresented);
    AssertTrue('Swapchain readback1 must succeed', Readback1 <> nil);
    AssertTrue('Center (64,48) green 3D box G > 200', Readback1.PixelPtr(64, 48)^.Y > 200);
    AssertEquals('Center (64,48) green 3D box R = 0', 0, Integer(Readback1.PixelPtr(64, 48)^.X));
    AssertTrue('Corner (4,4) navy background B > 100', Readback1.PixelPtr(4, 4)^.Z > 100);
    AssertEquals('Corner (4,4) navy background G = 0', 0, Integer(Readback1.PixelPtr(4, 4)^.Y));

    { Live swapchain resize (128x96 -> 192x144) exercising CreateInfo.oldSwapchain handoff }
    RealDev.ResizeSwapchain(192, 144);
    Container.TestWidth := 192;
    Container.TestHeight := 144;
    AssertTrue('Resized SwapchainHandle must remain valid', RealDev.SwapchainHandle <> VK_NULL_HANDLE);
    AssertEquals('Resized swapchain width = 192', Cardinal(192), RealDev.SwapchainExtent.width);
    AssertEquals('Resized swapchain height = 144', Cardinal(144), RealDev.SwapchainExtent.height);

    for FrameIdx := 0 to 1 do
    begin
      RealCmd := RealDev.BeginFrame as TVulkanRHICommandList;
      AssertTrue('Post-resize BeginFrame must acquire swapchain image', RealCmd <> nil);
      SetActiveCommandList(RealCmd);

      Viewport.BeforeRender;
      ColorTex := RealDev.GetSwapchainColorTexture;
      DepthTex := RealDev.GetSwapchainDepthTexture;
      PassInfo := RealDev.BuildSwapchainRenderingInfo(
        Rectangle(0, 0, 192, 144), ColorTex, DepthTex,
        Vector4(0.0, 0.0, 0.5, 1.0), loClear, loClear, 1.0);
      RealCmd.BeginRendering(PassInfo);
      RealCmd.SetViewport(FloatRectangle(0, 0, 192, 144), 0.0, 1.0);
      RealCmd.SetScissor(Rectangle(0, 0, 192, 144));

      Viewport.Render;
      Viewport.RenderOverChildren;
      RealCmd.EndRendering;
      RealDev.EndFrameAndPresent;
      if FrameIdx = 1 then
        Readback2 := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 192, 144));
    end;

    AssertEquals('6 total frames presented after resize', Cardinal(6), RealDev.TotalFramesPresented);
    AssertTrue('Post-resize readback2 must succeed', Readback2 <> nil);
    AssertEquals('Post-resize readback2 width = 192', 192, Readback2.Width);
    AssertEquals('Post-resize readback2 height = 144', 144, Readback2.Height);
    AssertTrue('Post-resize center (96,72) green 3D box G > 200', Readback2.PixelPtr(96, 72)^.Y > 200);
    AssertTrue('Post-resize corner (8,8) navy background B > 100', Readback2.PixelPtr(8, 8)^.Z > 100);
  finally
    FreeAndNil(Readback2);
    FreeAndNil(Readback1);
    FreeAndNil(Scene);
    FreeAndNil(Viewport);
    FreeAndNil(Container);
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealCastleWindowPureVulkanOpenRenderResizeSaveScreenRHI;
var
  Window: TCastleWindow;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedOnInit: TProcedure;
  Viewport: TCastleViewport;
  Scene: TCastleScene;
  Root: TX3DRootNode;
  Shape: TShapeNode;
  Box: TBoxNode;
  App: TAppearanceNode;
  Mat: TPhysicalMaterialNode;
  DirLight: TDirectionalLightNode;
  VkDev: TVulkanRHIDevice;
  ShotRgb: TRGBImage;
  ShotRgba, ShotResized: TRGBAlphaImage;
  { defined(UNIX) and not defined(DARWIN) and not defined(ANDROID)}
  HasDisplay: Boolean;
  {}
  I: Integer;
begin
  if not CanCreateWindowForTest then
  begin
    AbortTest;
    Exit;
  end;

  {$if defined(UNIX) and not defined(DARWIN) and not defined(ANDROID)}
  HasDisplay := (GetEnvironmentVariable('DISPLAY') <> '') or
                (GetEnvironmentVariable('WAYLAND_DISPLAY') <> '');
  if not HasDisplay then
    Exit;
  {$endif}

  try
    LoadVulkan;
  except
    on Exception do
      Exit;
  end;

  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedOnInit := Application.OnInitialize;
  Window := nil;
  ShotRgb := nil;
  ShotRgba := nil;
  ShotResized := nil;
  try
    SetActiveCommandList(nil);
    SetRHIDevice(nil);
    ApplicationProperties.RenderBackend := backendVulkan;
    Application.OnInitialize := nil;
    Application.Initialize;

    Window := CreateWindowForTest;
    Window.ResizeAllowed := raAllowed;
    Window.Width := 160;
    Window.Height := 120;

    Viewport := TCastleViewport.Create(Window);
    Viewport.FullSize := True;
    Viewport.BackgroundColor := Vector4(0.0, 0.0, 0.6, 1.0);
    Window.Controls.InsertFront(Viewport);
    Viewport.Camera.SetWorldView(
      Vector3(0.0, 0.0, 4.5),
      Vector3(0.0, 0.0, -1.0),
      Vector3(0.0, 1.0, 0.0));

    Root := TX3DRootNode.Create;
    DirLight := TDirectionalLightNode.Create;
    DirLight.Direction := Vector3(0.0, 0.0, -1.0);
    DirLight.Intensity := 2.0;
    Root.AddChildren(DirLight);

    Shape := TShapeNode.Create;
    Box := TBoxNode.Create;
    Box.Size := Vector3(2.2, 2.2, 0.5);
    Shape.Geometry := Box;
    App := TAppearanceNode.Create;
    Mat := TPhysicalMaterialNode.Create;
    Mat.BaseColor := Vector3(1.0, 0.25, 0.0);
    Mat.Roughness := 0.5;
    Mat.Metallic := 0.0;
    App.Material := Mat;
    Shape.Appearance := App;
    Root.AddChildren(Shape);

    Scene := TCastleScene.Create(Window);
    Scene.Load(Root, True);
    {$warnings off}
    Viewport.Items.MainScene := Scene;
    {$warnings on}
    Viewport.Items.Add(Scene);

    Window.Open;
    if not (RHIDevice is TVulkanRHIDevice) then
    begin
      Window.Close(False);
      Exit;
    end;

    VkDev := TVulkanRHIDevice(RHIDevice);
    AssertTrue('Pure-Vulkan TCastleWindow must NOT initialize GLFeatures', GLFeatures = nil);
    AssertTrue('Pure-Vulkan TCastleWindow must NOT initialize GLVersion', GLVersion = nil);
    AssertTrue('Window.VulkanSurfaceHandle must be non-null',
      Window.VulkanSurfaceHandle <> VK_NULL_HANDLE);
    AssertTrue('TVulkanRHIDevice.SwapchainHandle must be non-null',
      VkDev.SwapchainHandle <> VK_NULL_HANDLE);

    for I := 0 to 2 do
    begin
      Window.Invalidate;
      Application.ProcessAllMessages;
    end;
    AssertTrue('Window must render >= 2 Vulkan frames (loading + ProcessAllMessages)',
      Window.VulkanFramesRenderedCount >= 2);

    { Test both TWindowContainer.SaveScreen (TRGBImage) and SaveScreenRgba }
    ShotRgb := Window.SaveScreen;
    AssertTrue('Window.SaveScreen must return non-nil TRGBImage', ShotRgb <> nil);
    AssertTrue('Center lit PBR box R channel must dominate B channel in Window.SaveScreen',
      ShotRgb.PixelPtr(ShotRgb.Width div 2, ShotRgb.Height div 2)^.X >
      ShotRgb.PixelPtr(ShotRgb.Width div 2, ShotRgb.Height div 2)^.Z + 50);
    AssertTrue('Corner (4,4) blue viewport background B > 80 in Window.SaveScreen',
      ShotRgb.PixelPtr(4, 4)^.Z > 80);

    ShotRgba := Window.Container.SaveScreenRgba;
    AssertTrue('Container.SaveScreenRgba must return non-nil TRGBAlphaImage', ShotRgba <> nil);
    AssertTrue('Center lit PBR box R > 120 in SaveScreenRgba',
      ShotRgba.PixelPtr(ShotRgba.Width div 2, ShotRgba.Height div 2)^.X > 120);

    { Trigger live swapchain resize + ProcessAllMessages redraw + SaveScreenRgba }
    VkDev.ResizeSwapchain(200, 150);
    Window.Invalidate;
    Application.ProcessAllMessages;
    ShotResized := Window.Container.SaveScreenRgba;
    AssertTrue('Post-resize SaveScreenRgba must succeed', ShotResized <> nil);
    AssertTrue('Post-resize center lit PBR box R > 120',
      ShotResized.PixelPtr(ShotResized.Width div 2, ShotResized.Height div 2)^.X > 120);

    Window.Close(False);
    AssertTrue('Window.Close must release owned TVulkanRHIDevice', RHIDevice = nil);
    AssertTrue('Window.Close must clear VulkanSurfaceHandle',
      Window.VulkanSurfaceHandle = VK_NULL_HANDLE);
  finally
    FreeAndNil(ShotResized);
    FreeAndNil(ShotRgba);
    FreeAndNil(ShotRgb);
    if Window <> nil then
    begin
      if not Window.Closed then
        Window.Close(False);
      DestroyWindowForTest(Window);
    end;
    Application.OnInitialize := SavedOnInit;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
  end;
end;

procedure TTestCastleVulkanRHI.ParallelQuadWorkerCallback(
  const AWorkerIndex: Cardinal; const ACommandList: TVulkanRHICommandList);
type
  TTestPrim2DPush = packed record
    ViewportSize: TVector2;
    PointSize: Single;
    Padding: Single;
    Color: TVector4;
  end;
var
  PushData: TTestPrim2DPush;
begin
  if ACommandList = nil then
    Exit;
  ACommandList.BeginSecondaryRecording(
    FParallelTestPassInfo,
    FloatRectangle(0, 0, 64, 64),
    Rectangle(0, 0, 64, 64),
    0.0, 1.0);
  if FParallelTestPipeline <> nil then
    ACommandList.BindPipeline(FParallelTestPipeline);
  if not FParallelTestHeadlessMode then
  begin
    if (AWorkerIndex <= High(FParallelTestQuadVBOs)) and
       (FParallelTestQuadVBOs[AWorkerIndex] <> nil) then
      ACommandList.BindVertexBuffers(0, [FParallelTestQuadVBOs[AWorkerIndex]], [0]);
    PushData.ViewportSize := Vector2(64.0, 64.0);
    PushData.PointSize := 1.0;
    PushData.Padding := 0.0;
    case AWorkerIndex of
      0: PushData.Color := Vector4(1.0, 0.0, 0.0, 1.0); { Bottom-Left: Red }
      1: PushData.Color := Vector4(0.0, 1.0, 0.0, 1.0); { Bottom-Right: Green }
      2: PushData.Color := Vector4(0.0, 0.0, 1.0, 1.0); { Top-Left: Blue }
    else
      PushData.Color := Vector4(1.0, 1.0, 0.0, 1.0);    { Top-Right: Yellow }
    end;
    ACommandList.PushConstants([ssVertex, ssFragment], 0, SizeOf(PushData), PushData);
    ACommandList.Draw(6, 1, 0, 0);
  end else
    ACommandList.Draw(3, 1, 0, 0);
  ACommandList.EndRecording;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipeSecondaryCommandBuffersAndWorkerCommandPoolParallelDrawRHI;
type
  TTestPrim2DPush = packed record
    ViewportSize: TVector2;
    PointSize: Single;
    Padding: Single;
    Color: TVector4;
  end;
var
  HeadlessDev, RealDev: TVulkanRHIDevice;
  HeadlessCmd, RealCmd, ReusedSec0: TVulkanRHICommandList;
  HeadlessColor, HeadlessDepth: TRHITexture;
  ColorTex, DepthTex: TRHITexture;
  SecLists: TVulkanCommandListArray;
  VertSPIRV, FragSPIRV: TSPIRVBytecode;
  VS, FS: TRHIShaderModule;
  PipeDesc: TRHIGraphicsPipelineDesc;
  QuadVerts: array[0..5] of TVector2;
  CenterVBO: TRHIBuffer;
  CenterPush: TTestPrim2DPush;
  PassInfo: TRHIRenderingInfo;
  Readback: TRGBAlphaImage;
  DispatchedCount: Cardinal;
  MainTid: TThreadID;
  W: Integer;

  procedure FillQuadVerts(const X0, Y0, X1, Y1: Single);
  begin
    QuadVerts[0] := Vector2(X0, Y0);
    QuadVerts[1] := Vector2(X1, Y0);
    QuadVerts[2] := Vector2(X1, Y1);
    QuadVerts[3] := Vector2(X0, Y0);
    QuadVerts[4] := Vector2(X1, Y1);
    QuadVerts[5] := Vector2(X0, Y1);
  end;

begin
  { Part 1: Headless per-worker VkCommandPool manager & secondary command list lifecycle }
  HeadlessDev := TVulkanRHIDevice.CreateHeadless(nil);
  HeadlessDev.SimulateSwapchainForTesting(64, 64, 2, pfBGRA8_UNorm, pfD24_UNorm_S8_UInt);
  HeadlessColor := nil;
  HeadlessDepth := nil;
  FParallelTestPipeline := nil;
  for W := 0 to 3 do
    FParallelTestQuadVBOs[W] := nil;
  try
    HeadlessDev.WorkerCommandPoolManager.WorkerCount := 4;
    AssertEquals('WorkerCount must be 4', 4, Integer(HeadlessDev.WorkerCommandPoolManager.WorkerCount));

    HeadlessColor := HeadlessDev.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm, [tuColorAttachment]));
    HeadlessDepth := HeadlessDev.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfD32_Float, [tuDepthStencil]));

    HeadlessCmd := HeadlessDev.BeginFrame as TVulkanRHICommandList;
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 64, 64),
      HeadlessColor, loClear, Vector4(0.1, 0.1, 0.1, 1.0),
      HeadlessDepth, loClear, 1.0);
    HeadlessCmd.BeginRendering(PassInfo);

    FParallelTestPassInfo := PassInfo;
    FParallelTestPassInfo.ColorAttachments := Copy(PassInfo.ColorAttachments);
    FParallelTestPassInfo.ColorAttachments[0].LoadOp := loLoad;
    FParallelTestPassInfo.DepthAttachment.LoadOp := loLoad;
    FParallelTestPassInfo.ContentsSecondaryCommandBuffers := True;
    FParallelTestHeadlessMode := True;

    DispatchedCount := HeadlessDev.WorkerCommandPoolManager.ExecuteParallelRecording(
      4, @ParallelQuadWorkerCallback, SecLists);
    AssertEquals('ExecuteParallelRecording must return 4 secondary command lists',
      4, Integer(DispatchedCount));
    AssertEquals('Length(SecLists) must be 4', 4, Length(SecLists));
    for W := 0 to 3 do
    begin
      AssertTrue('Secondary list must be non-nil', SecLists[W] <> nil);
      AssertEquals('Secondary list level must be cllSecondary',
        Ord(cllSecondary), Ord(SecLists[W].Level));
    end;
    ReusedSec0 := SecLists[0] as TVulkanRHICommandList;

    HeadlessCmd.ExecuteSecondaryCommandsInPass(SecLists);
    AssertEquals('Primary SecondaryExecuteCount must be 4',
      4, Integer(HeadlessCmd.SecondaryExecuteCount));
    AssertTrue('Primary command list must resume active rendering pass after ExecuteSecondaryCommandsInPass',
      HeadlessCmd.IsRendering);
    HeadlessCmd.EndRendering;
    HeadlessDev.EndFrameAndPresent;

    { Cycle 1 intermediate frame (slot 1), then begin frame on slot 0 to verify O(1) pool reset reuse }
    HeadlessCmd := HeadlessDev.BeginFrame as TVulkanRHICommandList;
    HeadlessDev.EndFrameAndPresent;
    HeadlessCmd := HeadlessDev.BeginFrame as TVulkanRHICommandList;
    AssertEquals('Wrapped back to FrameIndex 0', 0, Integer(HeadlessDev.FrameIndex));
    AssertTrue('WorkerCommandPoolManager.TotalPoolResets must advance on BeginFrame',
      HeadlessDev.WorkerCommandPoolManager.TotalPoolResets >= 2);
    AssertTrue('Frame slot 0 secondary command list instance must be recycled without reallocation',
      HeadlessDev.WorkerCommandPoolManager.AcquireWorkerSecondaryCommandList(0) = ReusedSec0);
    HeadlessDev.EndFrameAndPresent;
  finally
    FreeAndNil(HeadlessDepth);
    FreeAndNil(HeadlessColor);
    FreeAndNil(HeadlessDev);
  end;

  { Part 2: Live Mesa Lavapipe Vulkan 1.4 multi-threaded secondary command buffer recording }
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
    Exit;

  ColorTex := nil;
  DepthTex := nil;
  VS := nil;
  FS := nil;
  FParallelTestPipeline := nil;
  CenterVBO := nil;
  Readback := nil;
  for W := 0 to 3 do
    FParallelTestQuadVBOs[W] := nil;
  try
    AssertTrue('TryGetBuiltInSPIRV Primitive2D_VS',
      TCastleShaderCompiler.Instance.TryGetBuiltInSPIRV(ssVertex, '', 'Primitive2D_VS', VertSPIRV));
    AssertTrue('TryGetBuiltInSPIRV Primitive2D_FS',
      TCastleShaderCompiler.Instance.TryGetBuiltInSPIRV(ssFragment, '', 'Primitive2D_FS', FragSPIRV));

    VS := RealDev.CreateShaderModuleFromSPIRV(ssVertex, @VertSPIRV[0], Length(VertSPIRV), 'SecPrimVS');
    FS := RealDev.CreateShaderModuleFromSPIRV(ssFragment, @FragSPIRV[0], Length(FragSPIRV), 'SecPrimFS');

    FillChar(PipeDesc, SizeOf(PipeDesc), 0);
    PipeDesc.VertexShader := VS;
    PipeDesc.FragmentShader := FS;
    PipeDesc.Topology := ptTriangleList;
    SetLength(PipeDesc.VertexInput.Bindings, 1);
    PipeDesc.VertexInput.Bindings[0].Binding := 0;
    PipeDesc.VertexInput.Bindings[0].Stride := SizeOf(TVector2);
    PipeDesc.VertexInput.Bindings[0].PerInstance := False;
    SetLength(PipeDesc.VertexInput.Attributes, 1);
    PipeDesc.VertexInput.Attributes[0].Location := 0;
    PipeDesc.VertexInput.Attributes[0].Binding := 0;
    PipeDesc.VertexInput.Attributes[0].Format := vafVector2;
    PipeDesc.VertexInput.Attributes[0].Offset := 0;
    PipeDesc.Rasterizer := TRHIRasterizerStateDesc.DefaultCullBack;
    PipeDesc.Rasterizer.CullMode := cmNone;
    PipeDesc.DepthStencil := TRHIDepthStencilStateDesc.DefaultDepthTestWrite;
    PipeDesc.BlendState := TRHIBlendStateDesc.DefaultOpaque;
    PipeDesc.PushConstantSize := SizeOf(TTestPrim2DPush);
    PipeDesc.PushConstantStages := [ssVertex, ssFragment];
    SetLength(PipeDesc.ColorAttachmentFormats, 1);
    PipeDesc.ColorAttachmentFormats[0] := pfRGBA8_UNorm;
    PipeDesc.DepthAttachmentFormat := pfD32_Float;
    PipeDesc.SampleCount := 1;
    PipeDesc.DebugName := 'SecondaryWorkerQuadPSO';
    FParallelTestPipeline := RealDev.GetOrCreatePipeline(PipeDesc);

    { Allocate 4 quadrant VBOs + 1 center post-pass VBO }
    FillQuadVerts(4, 4, 28, 28);
    FParallelTestQuadVBOs[0] := RealDev.CreateBuffer(
      TRHIBufferDesc.Create(SizeOf(QuadVerts), [buVertex], muCpuToGpu, 'QuadBL'), @QuadVerts[0]);
    FillQuadVerts(36, 4, 60, 28);
    FParallelTestQuadVBOs[1] := RealDev.CreateBuffer(
      TRHIBufferDesc.Create(SizeOf(QuadVerts), [buVertex], muCpuToGpu, 'QuadBR'), @QuadVerts[0]);
    FillQuadVerts(4, 36, 28, 60);
    FParallelTestQuadVBOs[2] := RealDev.CreateBuffer(
      TRHIBufferDesc.Create(SizeOf(QuadVerts), [buVertex], muCpuToGpu, 'QuadTL'), @QuadVerts[0]);
    FillQuadVerts(36, 36, 60, 60);
    FParallelTestQuadVBOs[3] := RealDev.CreateBuffer(
      TRHIBufferDesc.Create(SizeOf(QuadVerts), [buVertex], muCpuToGpu, 'QuadTR'), @QuadVerts[0]);
    FillQuadVerts(28, 28, 36, 36);
    CenterVBO := RealDev.CreateBuffer(
      TRHIBufferDesc.Create(SizeOf(QuadVerts), [buVertex], muCpuToGpu, 'QuadCenter'), @QuadVerts[0]);

    ColorTex := RealDev.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm, [tuColorAttachment, tuTransferSrc]));
    DepthTex := RealDev.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfD32_Float, [tuDepthStencil]));

    RealDev.WorkerCommandPoolManager.WorkerCount := 4;
    RealDev.WorkerCommandPoolManager.UseWorkerThreads := True;
    MainTid := GetCurrentThreadId;

    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 64, 64),
      ColorTex, loClear, Vector4(0.1, 0.1, 0.1, 1.0),
      DepthTex, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);

    FParallelTestPassInfo := PassInfo;
    FParallelTestPassInfo.ColorAttachments := Copy(PassInfo.ColorAttachments);
    FParallelTestPassInfo.ColorAttachments[0].LoadOp := loLoad;
    FParallelTestPassInfo.DepthAttachment.LoadOp := loLoad;
    FParallelTestPassInfo.ContentsSecondaryCommandBuffers := True;
    FParallelTestHeadlessMode := False;

    DispatchedCount := RealDev.WorkerCommandPoolManager.ExecuteParallelRecording(
      4, @ParallelQuadWorkerCallback, SecLists);
    AssertEquals('Real Lavapipe ExecuteParallelRecording must record 4 secondary lists',
      4, Integer(DispatchedCount));

    for W := 0 to 3 do
    begin
      AssertTrue('Each worker must own a non-null VkCommandPool',
        RealDev.WorkerCommandPoolManager.GetWorkerCommandPool(Cardinal(W), RealDev.FrameIndex) <> VK_NULL_HANDLE);
      if W > 0 then
        AssertTrue('Each worker must own a distinct VkCommandPool from worker 0',
          RealDev.WorkerCommandPoolManager.GetWorkerCommandPool(Cardinal(W), RealDev.FrameIndex) <>
          RealDev.WorkerCommandPoolManager.GetWorkerCommandPool(0, RealDev.FrameIndex));
      {$ifndef CASTLE_DISABLE_THREADS}
      if RealDev.WorkerCommandPoolManager.ThreadsSpawned then
        AssertTrue('Worker secondary command buffer must be recorded on OS worker thread <> MainThread',
          RealDev.WorkerCommandPoolManager.GetWorkerLastThreadId(Cardinal(W)) <> MainTid);
      {$endif}
    end;

    { Execute all 4 secondary command buffers inside VK_RENDERING_CONTENTS_SECONDARY_COMMAND_BUFFERS_BIT }
    RealCmd.ExecuteSecondaryCommandsInPass(SecLists);

    { Draw a small White quad inline in the resumed primary rendering pass }
    RealCmd.BindPipeline(FParallelTestPipeline);
    RealCmd.BindVertexBuffers(0, [CenterVBO], [0]);
    CenterPush.ViewportSize := Vector2(64.0, 64.0);
    CenterPush.PointSize := 1.0;
    CenterPush.Padding := 0.0;
    CenterPush.Color := Vector4(1.0, 1.0, 1.0, 1.0);
    RealCmd.PushConstants([ssVertex, ssFragment], 0, SizeOf(CenterPush), CenterPush);
    RealCmd.Draw(6, 1, 0, 0);

    RealCmd.EndRendering;
    RealDev.EndOffscreenFrame;

    Readback := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 64, 64));

    { Worker 0 Bottom-Left (16, 16) = Red (255, 0, 0) }
    AssertEquals('Worker 0 BL (16,16) R', 255, Integer(Readback.PixelPtr(16, 16)^.X));
    AssertEquals('Worker 0 BL (16,16) G', 0, Integer(Readback.PixelPtr(16, 16)^.Y));
    AssertEquals('Worker 0 BL (16,16) B', 0, Integer(Readback.PixelPtr(16, 16)^.Z));

    { Worker 1 Bottom-Right (48, 16) = Green (0, 255, 0) }
    AssertEquals('Worker 1 BR (48,16) R', 0, Integer(Readback.PixelPtr(48, 16)^.X));
    AssertEquals('Worker 1 BR (48,16) G', 255, Integer(Readback.PixelPtr(48, 16)^.Y));
    AssertEquals('Worker 1 BR (48,16) B', 0, Integer(Readback.PixelPtr(48, 16)^.Z));

    { Worker 2 Top-Left (16, 48) = Blue (0, 0, 255) }
    AssertEquals('Worker 2 TL (16,48) R', 0, Integer(Readback.PixelPtr(16, 48)^.X));
    AssertEquals('Worker 2 TL (16,48) G', 0, Integer(Readback.PixelPtr(16, 48)^.Y));
    AssertEquals('Worker 2 TL (16,48) B', 255, Integer(Readback.PixelPtr(16, 48)^.Z));

    { Worker 3 Top-Right (48, 48) = Yellow (255, 255, 0) }
    AssertEquals('Worker 3 TR (48,48) R', 255, Integer(Readback.PixelPtr(48, 48)^.X));
    AssertEquals('Worker 3 TR (48,48) G', 255, Integer(Readback.PixelPtr(48, 48)^.Y));
    AssertEquals('Worker 3 TR (48,48) B', 0, Integer(Readback.PixelPtr(48, 48)^.Z));

    { Resumed Primary Inline Center (32, 32) = White (255, 255, 255) }
    AssertEquals('Resumed inline center (32,32) R', 255, Integer(Readback.PixelPtr(32, 32)^.X));
    AssertEquals('Resumed inline center (32,32) G', 255, Integer(Readback.PixelPtr(32, 32)^.Y));
    AssertEquals('Resumed inline center (32,32) B', 255, Integer(Readback.PixelPtr(32, 32)^.Z));

    { Preserved initial clear background at (2, 32) ~ (25, 25, 25) }
    AssertTrue('Initial clear background (2,32) must remain dark gray',
      (Readback.PixelPtr(2, 32)^.X >= 20) and (Readback.PixelPtr(2, 32)^.X <= 30) and
      (Readback.PixelPtr(2, 32)^.Y >= 20) and (Readback.PixelPtr(2, 32)^.Y <= 30));
  finally
    FreeAndNil(Readback);
    FreeAndNil(DepthTex);
    FreeAndNil(ColorTex);
    FreeAndNil(CenterVBO);
    for W := 0 to 3 do
      FreeAndNil(FParallelTestQuadVBOs[W]);
    FParallelTestPipeline := nil;
    FreeAndNil(FS);
    FreeAndNil(VS);
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipeViewportParallelCommandRecording3DSceneParityRHI;
var
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  Container: TTestSizedVulkanContainer;
  ColorTexSerial, DepthTexSerial: TRHITexture;
  ColorTexParallel, DepthTexParallel: TRHITexture;
  PassInfo: TRHIRenderingInfo;
  Viewport: TCastleViewport;
  Scene: TCastleScene;
  Root: TX3DRootNode;
  DirLight: TDirectionalLightNode;
  Trans: TTransformNode;
  Shape: TShapeNode;
  Box: TBoxNode;
  Sphere: TSphereNode;
  App: TAppearanceNode;
  PhysMat: TPhysicalMaterialNode;
  UnlitMat: TUnlitMaterialNode;
  ImgSerial, ImgParallel: TRGBAlphaImage;
  DiffRMSE: Single;
  I, FrameIter: Integer;
begin
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
    Exit;

  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;

  Container := TTestSizedVulkanContainer.Create(nil);
  ColorTexSerial := nil;
  DepthTexSerial := nil;
  ColorTexParallel := nil;
  DepthTexParallel := nil;
  Viewport := nil;
  Scene := nil;
  ImgSerial := nil;
  ImgParallel := nil;
  try
    GLFeatures := nil;
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(RealDev);

    Container.TestWidth := 128;
    Container.TestHeight := 128;
    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 128, 128);

    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := True;
    Viewport.BackgroundColor := Vector4(0.05, 0.08, 0.16, 1.0);
    Viewport.Camera.ProjectionType := ptPerspective;
    Viewport.Camera.Perspective.FieldOfView := Pi / 3.0;
    Viewport.Camera.SetView(
      Vector3(0.0, 0.0, 9.5),
      Vector3(0.0, 0.0, -1.0),
      Vector3(0.0, 1.0, 0.0));
    Container.Controls.InsertFront(Viewport);

    { Build a 3D scene with 12 distinct shapes (4x3 grid of lit PBR boxes & spheres + unlit accents) }
    Root := TX3DRootNode.Create;
    DirLight := TDirectionalLightNode.Create;
    DirLight.Direction := Vector3(-0.35, -0.5, -0.8).Normalize;
    DirLight.Intensity := 1.4;
    DirLight.Global := True;
    Root.AddChildren(DirLight);

    for I := 0 to 11 do
    begin
      Trans := TTransformNode.Create;
      Trans.Translation := Vector3(
        ((I mod 4) - 1.5) * 2.1,
        ((I div 4) - 1.0) * 2.1,
        -0.3 * Single(I mod 3));
      Shape := TShapeNode.Create;
      if (I mod 2) = 0 then
      begin
        Box := TBoxNode.Create;
        Box.Size := Vector3(1.3, 1.3, 1.3);
        Shape.Geometry := Box;
      end else
      begin
        Sphere := TSphereNode.Create;
        Sphere.Radius := 0.72;
        Shape.Geometry := Sphere;
      end;

      App := TAppearanceNode.Create;
      if (I mod 4) = 3 then
      begin
        UnlitMat := TUnlitMaterialNode.Create;
        UnlitMat.EmissiveColor := Vector3(
          0.2 + 0.06 * Single(I),
          0.85 - 0.05 * Single(I),
          0.4 + 0.04 * Single(I));
        App.Material := UnlitMat;
      end else
      begin
        PhysMat := TPhysicalMaterialNode.Create;
        PhysMat.BaseColor := Vector3(
          0.15 + 0.07 * Single(I),
          0.25 + 0.05 * Single(11 - I),
          0.35 + 0.05 * Single((I * 3) mod 11));
        PhysMat.Roughness := 0.35 + 0.04 * Single(I mod 5);
        PhysMat.Metallic := 0.1 * Single(I mod 3);
        App.Material := PhysMat;
      end;
      Shape.Appearance := App;
      Trans.AddChildren(Shape);
      Root.AddChildren(Trans);
    end;

    Scene := TCastleScene.Create(nil);
    Scene.Load(Root, True);
    {$warnings off}
    Viewport.Items.MainScene := Scene;
    {$warnings on}
    Viewport.Items.Add(Scene);

    ColorTexSerial := RealDev.CreateTexture(TRHITextureDesc.Create2D(128, 128, pfRGBA8_UNorm,
      [tuColorAttachment, tuTransferSrc]));
    DepthTexSerial := RealDev.CreateTexture(TRHITextureDesc.Create2D(128, 128, pfD32_Float,
      [tuDepthStencil]));
    ColorTexParallel := RealDev.CreateTexture(TRHITextureDesc.Create2D(128, 128, pfRGBA8_UNorm,
      [tuColorAttachment, tuTransferSrc]));
    DepthTexParallel := RealDev.CreateTexture(TRHITextureDesc.Create2D(128, 128, pfD32_Float,
      [tuDepthStencil]));

    { 1. Render Serial Baseline (ParallelCommandRecording = False) }
    Viewport.ParallelCommandRecording := False;
    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    SetActiveCommandList(RealCmd);
    Viewport.BeforeRender;
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 128, 128),
      ColorTexSerial, loClear, Viewport.BackgroundColor,
      DepthTexSerial, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);
    Viewport.Render;
    Viewport.RenderOverChildren;
    RealCmd.EndRendering;
    RealDev.EndOffscreenFrame;

    AssertEquals('Serial render must have TotalParallelPassCount = 0',
      0, Integer(Viewport.InternalShapesRenderer.TotalParallelPassCount));
    ImgSerial := RealDev.GrabTextureImage(ColorTexSerial, Rectangle(0, 0, 128, 128));

    { 2. Render Multi-Threaded Parallel Secondary Command Recording across 4 workers (2 frames for slot wrap) }
    Viewport.ParallelCommandRecording := True;
    Viewport.ParallelCommandRecordingMinShapes := 4;
    Viewport.ParallelCommandRecordingWorkerCount := 4;

    for FrameIter := 0 to 1 do
    begin
      RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
      SetActiveCommandList(RealCmd);
      Viewport.BeforeRender;
      PassInfo := TRHIRenderingInfo.CreateColorDepth(
        Rectangle(0, 0, 128, 128),
        ColorTexParallel, loClear, Viewport.BackgroundColor,
        DepthTexParallel, loClear, 1.0);
      RealCmd.BeginRendering(PassInfo);
      Viewport.Render;
      Viewport.RenderOverChildren;
      RealCmd.EndRendering;
      RealDev.EndOffscreenFrame;
    end;

    AssertTrue('TotalParallelPassCount must be >= 2 after 2 parallel frames',
      Viewport.InternalShapesRenderer.TotalParallelPassCount >= 2);
    AssertEquals('LastParallelRecordedShapes must equal 12 collected shapes',
      12, Integer(Viewport.InternalShapesRenderer.LastParallelRecordedShapes));
    AssertEquals('LastParallelWorkerCount must equal 4 workers',
      4, Integer(Viewport.InternalShapesRenderer.LastParallelWorkerCount));

    ImgParallel := RealDev.GrabTextureImage(ColorTexParallel, Rectangle(0, 0, 128, 128));
    AssertTrue('Parallel 4-worker secondary command buffer 3D scene render must match serial render (RMSE <= 0.001)',
      CompareImagesPerceptualDiff(ImgSerial, ImgParallel, 0.001, DiffRMSE));
  finally
    FreeAndNil(ImgParallel);
    FreeAndNil(ImgSerial);
    FreeAndNil(DepthTexParallel);
    FreeAndNil(ColorTexParallel);
    FreeAndNil(DepthTexSerial);
    FreeAndNil(ColorTexSerial);
    FreeAndNil(Scene);
    FreeAndNil(Viewport);
    FreeAndNil(Container);
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    RenderContext := SavedCtx;
    GLFeatures := SavedGLFeatures;
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipeAsyncTransferQueueTimelineSemaphoreUploadAndRenderRHI;
var
  HeadlessDev, RealDev: TVulkanRHIDevice;
  HeadlessCmd, RealCmd: TVulkanRHICommandList;
  HeadlessBuf: TVulkanRHIBuffer;
  HeadlessTex: TVulkanRHITexture;
  DummyVerts: array[0..5] of TVector2;
  DummyPixels: array[0..15] of TVector4Byte;
  SubmittedVal: UInt64;
  GpuVBO: TVulkanRHIBuffer;
  GpuTex: TVulkanRHITexture;
  ColorTex, DepthTex: TRHITexture;
  Sampler: TRHISampler;
  SamplerDesc: TRHISamplerDesc;
  VertSPIRV, FragSPIRV: TSPIRVBytecode;
  VS, FS: TRHIShaderModule;
  SetLayout: TRHIDescriptorSetLayout;
  BindingDesc: TRHIDescriptorBindingDesc;
  DescSet: TRHIDescriptorSet;
  PipeDesc: TRHIGraphicsPipelineDesc;
  Pipe: TRHIPipeline;
  Quad2DVerts: array[0..5] of TCastle2DVertex;
  Push2D: TCastle2DPushConstants;
  PassInfo: TRHIRenderingInfo;
  SrcPixels: array[0 .. 32 * 32 - 1] of TVector4Byte;
  Readback: TRGBAlphaImage;
  I: Integer;
begin
  { Part 1: Headless dedicated DMA transfer queue ownership release + graphics acquire accounting }
  HeadlessDev := TVulkanRHIDevice.CreateHeadless(nil);
  HeadlessDev.SimulateSwapchainForTesting(64, 64, 2, pfBGRA8_UNorm, pfD24_UNorm_S8_UInt);
  HeadlessBuf := nil;
  HeadlessTex := nil;
  try
    HeadlessDev.StagingUploader.ConfigureTransferQueue(0, 2, True);
    AssertTrue('UseDedicatedTransferQueue must be True',
      HeadlessDev.StagingUploader.UseDedicatedTransferQueue);

    for I := 0 to High(DummyVerts) do
      DummyVerts[I] := Vector2(Single(I), Single(I * 2));
    for I := 0 to High(DummyPixels) do
      DummyPixels[I] := Vector4Byte(0, 220, 80, 255);

    HeadlessBuf := HeadlessDev.CreateBuffer(
      TRHIBufferDesc.Create(SizeOf(DummyVerts), [buVertex, buTransferDst], muGpuOnly, 'AsyncBuf')) as TVulkanRHIBuffer;
    HeadlessTex := HeadlessDev.CreateTexture(
      TRHITextureDesc.Create2D(4, 4, pfRGBA8_UNorm, [tuSampled, tuTransferDst])) as TVulkanRHITexture;

    HeadlessDev.StagingUploader.EnqueueBufferUpload(HeadlessBuf, DummyVerts[0], SizeOf(DummyVerts), 0);
    HeadlessDev.StagingUploader.EnqueueImageUpload(HeadlessTex, @DummyPixels[0], SizeOf(DummyPixels), 4, 4, 0, 0, False);
    AssertEquals('PendingBufferCopyCount must be 1', 1, Integer(HeadlessDev.StagingUploader.PendingBufferCopyCount));
    AssertEquals('PendingImageCopyCount must be 1', 1, Integer(HeadlessDev.StagingUploader.PendingImageCopyCount));

    SubmittedVal := HeadlessDev.StagingUploader.SubmitAsyncUploads;
    AssertEquals('First SubmitAsyncUploads must signal timeline value 1', Int64(1), Int64(SubmittedVal));
    AssertEquals('TotalAsyncSubmissions must be 1', 1, Integer(HeadlessDev.StagingUploader.TotalAsyncSubmissions));
    AssertEquals('PendingGraphicsWaitTimelineValue must be 1',
      Int64(1), Int64(HeadlessDev.StagingUploader.PendingGraphicsWaitTimelineValue));
    AssertEquals('Release barriers on dedicated transfer queue must increment QueueOwnershipTransferCount by 2',
      2, Integer(HeadlessDev.StagingUploader.QueueOwnershipTransferCount));

    HeadlessCmd := HeadlessDev.BeginFrame as TVulkanRHICommandList;
    AssertTrue('BeginFrame must automatically record the 2 pending acquire barriers onto HeadlessCmd',
      HeadlessCmd.BarrierCount >= 2);
    AssertEquals('BeginFrame acquire barriers must increment QueueOwnershipTransferCount from 2 to 4',
      4, Integer(HeadlessDev.StagingUploader.QueueOwnershipTransferCount));
    AssertEquals('Subsequent ApplyPendingGraphicsAcquireBarriers must apply 0 duplicate barriers',
      0, Integer(HeadlessDev.StagingUploader.ApplyPendingGraphicsAcquireBarriers(HeadlessCmd)));
    HeadlessDev.EndFrameAndPresent;
    AssertEquals('EndFrameAndPresent must consume PendingGraphicsWaitTimelineValue',
      Int64(0), Int64(HeadlessDev.StagingUploader.PendingGraphicsWaitTimelineValue));
  finally
    FreeAndNil(HeadlessTex);
    FreeAndNil(HeadlessBuf);
    FreeAndNil(HeadlessDev);
  end;

  { Part 2: Live Mesa Lavapipe Vulkan 1.4 async TransferQueue submit + VkTimelineSemaphoreSubmitInfo graphics wait }
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
    Exit;

  GpuVBO := nil;
  GpuTex := nil;
  ColorTex := nil;
  DepthTex := nil;
  Sampler := nil;
  VS := nil;
  FS := nil;
  SetLayout := nil;
  DescSet := nil;
  Readback := nil;
  try
    { Prepare emerald green (16, 224, 96, 255) 32x32 texture & full-screen NDC+UV quad }
    for I := 0 to High(SrcPixels) do
      SrcPixels[I] := Vector4Byte(16, 224, 96, 255);

    Quad2DVerts[0].Position := Vector2(8.0, 8.0);   Quad2DVerts[0].TexCoord := Vector2(0.0, 0.0); Quad2DVerts[0].ColorRgba8 := $FFFFFFFF;
    Quad2DVerts[1].Position := Vector2(56.0, 8.0);  Quad2DVerts[1].TexCoord := Vector2(1.0, 0.0); Quad2DVerts[1].ColorRgba8 := $FFFFFFFF;
    Quad2DVerts[2].Position := Vector2(56.0, 56.0); Quad2DVerts[2].TexCoord := Vector2(1.0, 1.0); Quad2DVerts[2].ColorRgba8 := $FFFFFFFF;
    Quad2DVerts[3].Position := Vector2(8.0, 8.0);   Quad2DVerts[3].TexCoord := Vector2(0.0, 0.0); Quad2DVerts[3].ColorRgba8 := $FFFFFFFF;
    Quad2DVerts[4].Position := Vector2(56.0, 56.0); Quad2DVerts[4].TexCoord := Vector2(1.0, 1.0); Quad2DVerts[4].ColorRgba8 := $FFFFFFFF;
    Quad2DVerts[5].Position := Vector2(8.0, 56.0);  Quad2DVerts[5].TexCoord := Vector2(0.0, 1.0); Quad2DVerts[5].ColorRgba8 := $FFFFFFFF;

    { Allocate uninitialized muGpuOnly buffer & texture }
    GpuVBO := RealDev.CreateBuffer(
      TRHIBufferDesc.Create(SizeOf(Quad2DVerts), [buVertex, buTransferDst], muGpuOnly, 'LiveAsyncVBO')) as TVulkanRHIBuffer;
    GpuTex := RealDev.CreateTexture(
      TRHITextureDesc.Create2D(32, 32, pfRGBA8_UNorm, [tuSampled, tuTransferDst])) as TVulkanRHITexture;

    { Build zero-dependency built-in CastleBatch2D SPIR-V textured quad pipeline to sample GpuTex using GpuVBO }
    AssertTrue('TryGetBuiltInSPIRV CastleBatch2D.vert',
      TCastleShaderCompiler.Instance.TryGetBuiltInSPIRV(ssVertex, '', 'CastleBatch2D.vert', VertSPIRV));
    AssertTrue('TryGetBuiltInSPIRV CastleBatch2D.frag',
      TCastleShaderCompiler.Instance.TryGetBuiltInSPIRV(ssFragment, '', 'CastleBatch2D.frag', FragSPIRV));
    VS := RealDev.CreateShaderModuleFromSPIRV(ssVertex, @VertSPIRV[0], Length(VertSPIRV), 'CastleBatch2D.vert');
    FS := RealDev.CreateShaderModuleFromSPIRV(ssFragment, @FragSPIRV[0], Length(FragSPIRV), 'CastleBatch2D.frag');

    FillChar(BindingDesc, SizeOf(BindingDesc), 0);
    BindingDesc.Binding := 0;
    BindingDesc.DescriptorType := dtCombinedImageSampler;
    BindingDesc.Count := 1;
    BindingDesc.StageFlags := [ssFragment];
    SetLayout := RealDev.CreateDescriptorSetLayout([BindingDesc]);

    FillChar(SamplerDesc, SizeOf(SamplerDesc), 0);
    SamplerDesc.MinFilter := sfLinear;
    SamplerDesc.MagFilter := sfLinear;
    SamplerDesc.MipFilter := sfNearest;
    SamplerDesc.AddressModeU := amClampToEdge;
    SamplerDesc.AddressModeV := amClampToEdge;
    SamplerDesc.AddressModeW := amClampToEdge;
    SamplerDesc.MaxLod := 1000.0;
    Sampler := RealDev.CreateSampler(SamplerDesc);

    DescSet := RealDev.CreateDescriptorSet(SetLayout);
    DescSet.BindTexture(0, GpuTex, Sampler);
    DescSet.Update;

    FillChar(PipeDesc, SizeOf(PipeDesc), 0);
    PipeDesc.VertexShader := VS;
    PipeDesc.FragmentShader := FS;
    PipeDesc.Topology := ptTriangleList;
    SetLength(PipeDesc.VertexInput.Bindings, 1);
    PipeDesc.VertexInput.Bindings[0].Binding := 0;
    PipeDesc.VertexInput.Bindings[0].Stride := SizeOf(TCastle2DVertex);
    PipeDesc.VertexInput.Bindings[0].PerInstance := False;
    SetLength(PipeDesc.VertexInput.Attributes, 3);
    PipeDesc.VertexInput.Attributes[0].Location := 0;
    PipeDesc.VertexInput.Attributes[0].Binding := 0;
    PipeDesc.VertexInput.Attributes[0].Format := vafVector2;
    PipeDesc.VertexInput.Attributes[0].Offset := 0;
    PipeDesc.VertexInput.Attributes[1].Location := 2;
    PipeDesc.VertexInput.Attributes[1].Binding := 0;
    PipeDesc.VertexInput.Attributes[1].Format := vafVector2;
    PipeDesc.VertexInput.Attributes[1].Offset := 8;
    PipeDesc.VertexInput.Attributes[2].Location := 4;
    PipeDesc.VertexInput.Attributes[2].Binding := 0;
    PipeDesc.VertexInput.Attributes[2].Format := vafUByte4Normalized;
    PipeDesc.VertexInput.Attributes[2].Offset := 16;
    PipeDesc.Rasterizer := TRHIRasterizerStateDesc.DefaultCullBack;
    PipeDesc.Rasterizer.CullMode := cmNone;
    PipeDesc.DepthStencil := TRHIDepthStencilStateDesc.DefaultDisabled;
    PipeDesc.BlendState := TRHIBlendStateDesc.DefaultOpaque;
    SetLength(PipeDesc.DescriptorSetLayouts, 1);
    PipeDesc.DescriptorSetLayouts[0] := SetLayout;
    PipeDesc.PushConstantSize := SizeOf(TCastle2DPushConstants);
    PipeDesc.PushConstantStages := [ssVertex, ssFragment];
    SetLength(PipeDesc.ColorAttachmentFormats, 1);
    PipeDesc.ColorAttachmentFormats[0] := pfRGBA8_UNorm;
    PipeDesc.DepthAttachmentFormat := pfD32_Float;
    PipeDesc.SampleCount := 1;
    PipeDesc.DebugName := 'AsyncTexQuadPSO';
    Pipe := RealDev.GetOrCreatePipeline(PipeDesc);

    ColorTex := RealDev.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm, [tuColorAttachment, tuTransferSrc]));
    DepthTex := RealDev.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfD32_Float, [tuDepthStencil]));

    { Begin offscreen frame, then stage & submit async TransferQueue uploads concurrently with CPU command recording }
    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;

    RealDev.StagingUploader.EnqueueBufferUpload(GpuVBO, Quad2DVerts[0], SizeOf(Quad2DVerts), 0);
    RealDev.StagingUploader.EnqueueImageUpload(GpuTex, @SrcPixels[0], SizeOf(SrcPixels), 32, 32, 0, 0, False);

    SubmittedVal := RealDev.StagingUploader.SubmitAsyncUploads;
    AssertTrue('Live SubmitAsyncUploads must return timeline value >= 1', SubmittedVal >= 1);
    AssertEquals('TotalAsyncSubmissions must be 1', 1, Integer(RealDev.StagingUploader.TotalAsyncSubmissions));
    if RealDev.StagingUploader.TransferTimelineSemaphore.Handle <> VK_NULL_HANDLE then
      AssertEquals('PendingGraphicsWaitTimelineValue must equal SubmittedVal before graphics submit',
        Int64(SubmittedVal), Int64(RealDev.StagingUploader.PendingGraphicsWaitTimelineValue));

    { Record & submit Graphics frame immediately — EndOffscreenFrame synchronizes on GPU via VkTimelineSemaphoreSubmitInfo }
    RealDev.StagingUploader.ApplyPendingGraphicsAcquireBarriers(RealCmd);
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 64, 64),
      ColorTex, loClear, Vector4(0.2, 0.0, 0.0, 1.0),
      DepthTex, loClear, 1.0);
    FillChar(Push2D, SizeOf(Push2D), 0);
    Push2D.ViewportScaleBias := Vector4(2.0 / 64.0, 2.0 / 64.0, -1.0, -1.0);
    RealCmd.BeginRendering(PassInfo);
    RealCmd.BindPipeline(Pipe);
    RealCmd.BindDescriptorSet(0, DescSet, []);
    RealCmd.PushConstants([ssVertex, ssFragment], 0, SizeOf(Push2D), Push2D);
    RealCmd.BindVertexBuffers(0, [GpuVBO], [0]);
    RealCmd.Draw(6, 1, 0, 0);
    RealCmd.EndRendering;
    RealDev.EndOffscreenFrame;

    AssertEquals('EndOffscreenFrame must consume PendingGraphicsWaitTimelineValue via VkTimelineSemaphoreSubmitInfo',
      Int64(0), Int64(RealDev.StagingUploader.PendingGraphicsWaitTimelineValue));

    RealDev.StagingUploader.WaitForAsyncUploads;
    AssertTrue('Timeline semaphore counter must reach >= SubmittedVal',
      RealDev.StagingUploader.TransferTimelineSemaphore.GetCounterValue >= SubmittedVal);

    Readback := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 64, 64));
    { Center (32, 32): Async-uploaded emerald green texture (16, 224, 96) }
    AssertTrue('Center (32,32) R must match emerald green (~16)',
      Abs(Integer(Readback.PixelPtr(32, 32)^.X) - 16) <= 4);
    AssertTrue('Center (32,32) G must match emerald green (~224)',
      Abs(Integer(Readback.PixelPtr(32, 32)^.Y) - 224) <= 4);
    AssertTrue('Center (32,32) B must match emerald green (~96)',
      Abs(Integer(Readback.PixelPtr(32, 32)^.Z) - 96) <= 4);
    { Corner (2, 2): Dark red clear background (~51, 0, 0) }
    AssertTrue('Corner (2,2) must retain dark red clear background',
      (Readback.PixelPtr(2, 2)^.X >= 45) and (Readback.PixelPtr(2, 2)^.Y <= 5));
  finally
    FreeAndNil(Readback);
    FreeAndNil(DepthTex);
    FreeAndNil(ColorTex);
    FreeAndNil(DescSet);
    FreeAndNil(Sampler);
    FreeAndNil(SetLayout);
    FreeAndNil(FS);
    FreeAndNil(VS);
    FreeAndNil(GpuTex);
    FreeAndNil(GpuVBO);
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipeBindlessTextureAndMaterialSSBOMultiDrawRHI;
var
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  BindlessMgr: TCastleVulkanBindlessTextureManager;
  Batch: TCastleVulkanBindlessIndirectBatch;
  SamplerDesc: TRHISamplerDesc;
  Sampler: TRHISampler;
  TexRed, TexGreen, TexBlue, TexAlphaMask, TempTex: TRHITexture;
  ImgRed, ImgGreen, ImgBlue, ImgAlphaMask, Readback: TRGBAlphaImage;
  ColorTex, DepthTex: TRHITexture;
  SlotRed, SlotRedDup, SlotTemp, SlotGreen, SlotBlue, SlotAlpha: Cardinal;
  Mat0, Mat1, Mat2, Mat3: TCastleBindlessMaterialEntry;
  MatIdx0, MatIdx1, MatIdx2, MatIdx3: Cardinal;
  Already0, Already1, Already2, Already3: Boolean;
  QuadVerts: array[0..3] of TCastleBindlessIndirectVertex;
  QuadIndices: array[0..5] of UInt32;
  Insts: array[0..3] of TCastleBindlessIndirectInstanceDesc;
  PassInfo: TRHIRenderingInfo;
  DrawnCount: Cardinal;
  X, Y: Integer;
begin
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
    Exit;

  Sampler := nil;
  TexRed := nil;
  TexGreen := nil;
  TexBlue := nil;
  TexAlphaMask := nil;
  TempTex := nil;
  ImgRed := nil;
  ImgGreen := nil;
  ImgBlue := nil;
  ImgAlphaMask := nil;
  ColorTex := nil;
  DepthTex := nil;
  Readback := nil;
  try
    if not RealDev.SupportsBindlessTextures then
      Exit;

    BindlessMgr := RealDev.BindlessTextureManager;
    Batch := RealDev.BindlessIndirectBatch;
    AssertTrue('BindlessTextureManager must exist on live Vulkan device', BindlessMgr <> nil);
    AssertTrue('BindlessIndirectBatch must exist on live Vulkan device', Batch <> nil);

    FillChar(SamplerDesc, SizeOf(SamplerDesc), 0);
    SamplerDesc.MinFilter := sfNearest;
    SamplerDesc.MagFilter := sfNearest;
    SamplerDesc.MipFilter := sfNearest;
    SamplerDesc.AddressModeU := amClampToEdge;
    SamplerDesc.AddressModeV := amClampToEdge;
    SamplerDesc.AddressModeW := amClampToEdge;
    SamplerDesc.MaxAnisotropy := 1.0;
    SamplerDesc.MaxLod := 1000.0;
    Sampler := RealDev.CreateSampler(SamplerDesc);

    ImgRed := TRGBAlphaImage.Create(4, 4);
    ImgRed.Clear(Vector4Byte(255, 255, 255, 255));
    for Y := 0 to 3 do
      for X := 0 to 3 do
        ImgRed.PixelPtr(X, Y)^ := Vector4Byte(255, 128, 255, 255);

    ImgGreen := TRGBAlphaImage.Create(4, 4);
    ImgGreen.Clear(Vector4Byte(0, 255, 0, 255));

    ImgBlue := TRGBAlphaImage.Create(4, 4);
    ImgBlue.Clear(Vector4Byte(32, 64, 255, 255));

    ImgAlphaMask := TRGBAlphaImage.Create(4, 4);
    for Y := 0 to 3 do
      for X := 0 to 3 do
        if X < 2 then
          ImgAlphaMask.PixelPtr(X, Y)^ := Vector4Byte(0, 220, 220, 255)
        else
          ImgAlphaMask.PixelPtr(X, Y)^ := Vector4Byte(0, 220, 220, 0);

    TexRed := RealDev.CreateTexture(TRHITextureDesc.Create2D(4, 4, pfRGBA8_UNorm, [tuSampled, tuTransferDst]));
    TexRed.UploadImage(ImgRed);
    TexGreen := RealDev.CreateTexture(TRHITextureDesc.Create2D(4, 4, pfRGBA8_UNorm, [tuSampled, tuTransferDst]));
    TexGreen.UploadImage(ImgGreen);
    TexBlue := RealDev.CreateTexture(TRHITextureDesc.Create2D(4, 4, pfRGBA8_UNorm, [tuSampled, tuTransferDst]));
    TexBlue.UploadImage(ImgBlue);
    TexAlphaMask := RealDev.CreateTexture(TRHITextureDesc.Create2D(4, 4, pfRGBA8_UNorm, [tuSampled, tuTransferDst]));
    TexAlphaMask.UploadImage(ImgAlphaMask);
    TempTex := RealDev.CreateTexture(TRHITextureDesc.Create2D(4, 4, pfRGBA8_UNorm, [tuSampled, tuTransferDst]));
    TempTex.UploadImage(ImgGreen);

    { Verify deduplication and O(1) slot recycling on live bindless VkDescriptorPool }
    SlotRed := BindlessMgr.RegisterTexture(TexRed, Sampler);
    SlotRedDup := BindlessMgr.RegisterTexture(TexRed, Sampler);
    AssertEquals('Duplicate bindless registration must return identical slot',
      Integer(SlotRed), Integer(SlotRedDup));
    SlotTemp := BindlessMgr.RegisterTexture(TempTex, Sampler);
    BindlessMgr.UnregisterSlot(SlotTemp);
    SlotGreen := BindlessMgr.RegisterTexture(TexGreen, Sampler);
    AssertEquals('Recycled bindless slot must be reused immediately',
      Integer(SlotTemp), Integer(SlotGreen));
    SlotBlue := BindlessMgr.RegisterTexture(TexBlue, Sampler);
    SlotAlpha := BindlessMgr.RegisterTexture(TexAlphaMask, Sampler);

    { Register 4 distinct materials in Set 1 Binding 1 Material SSBO:
      - Mat 0 (top-left): TexRed (255, 128, 255) * BaseColor (1.0, 1.0, 0.25, 1.0) -> (255, 128, 64)
      - Mat 1 (top-right): TexGreen (0, 255, 0) + Emissive (0.0, 0.0, 0.5, 0.0) -> (0, 255, 128)
      - Mat 2 (bottom-left): TexBlue (32, 64, 255) * BaseColor (1,1,1,1) -> (32, 64, 255)
      - Mat 3 (bottom-right): TexAlphaMask left half (0, 220, 220, 255) kept, right half alpha=0 OpKill discarded }
    FillChar(Mat0, SizeOf(Mat0), 0);
    Mat0.BaseColor := Vector4(1.0, 1.0, 0.25, 1.0);
    Mat0.PBRParams := Vector4(0.5, 1.0, 1.0, 0.0);
    Mat0.BaseColorTexIndex := SlotRed;
    MatIdx0 := 0;
    Already0 := False;
    BindlessMgr.RegisterOrUpdateMaterial(MatIdx0, Already0, Mat0);

    FillChar(Mat1, SizeOf(Mat1), 0);
    Mat1.BaseColor := Vector4(1.0, 1.0, 1.0, 1.0);
    Mat1.EmissiveColor := Vector4(0.0, 0.0, 0.5, 0.0);
    Mat1.PBRParams := Vector4(0.5, 1.0, 1.0, 0.0);
    Mat1.BaseColorTexIndex := SlotGreen;
    MatIdx1 := 0;
    Already1 := False;
    BindlessMgr.RegisterOrUpdateMaterial(MatIdx1, Already1, Mat1);

    FillChar(Mat2, SizeOf(Mat2), 0);
    Mat2.BaseColor := Vector4(1.0, 1.0, 1.0, 1.0);
    Mat2.PBRParams := Vector4(0.5, 1.0, 1.0, 0.0);
    Mat2.BaseColorTexIndex := SlotBlue;
    MatIdx2 := 0;
    Already2 := False;
    BindlessMgr.RegisterOrUpdateMaterial(MatIdx2, Already2, Mat2);

    FillChar(Mat3, SizeOf(Mat3), 0);
    Mat3.BaseColor := Vector4(1.0, 1.0, 1.0, 1.0);
    Mat3.PBRParams := Vector4(0.5, 1.0, 1.0, 0.5); { AlphaCutoff = 0.5 }
    Mat3.BaseColorTexIndex := SlotAlpha;
    MatIdx3 := 0;
    Already3 := False;
    BindlessMgr.RegisterOrUpdateMaterial(MatIdx3, Already3, Mat3);

    { Upload shared unit quad [-0.35..+0.35]^2 in XY plane }
    QuadVerts[0].Position := Vector3(-0.35, -0.35, 0.0);
    QuadVerts[0].Normal := Vector3(0.0, 0.0, 1.0);
    QuadVerts[0].TexCoord := Vector2(0.0, 0.0);
    QuadVerts[1].Position := Vector3( 0.35, -0.35, 0.0);
    QuadVerts[1].Normal := Vector3(0.0, 0.0, 1.0);
    QuadVerts[1].TexCoord := Vector2(1.0, 0.0);
    QuadVerts[2].Position := Vector3( 0.35,  0.35, 0.0);
    QuadVerts[2].Normal := Vector3(0.0, 0.0, 1.0);
    QuadVerts[2].TexCoord := Vector2(1.0, 1.0);
    QuadVerts[3].Position := Vector3(-0.35,  0.35, 0.0);
    QuadVerts[3].Normal := Vector3(0.0, 0.0, 1.0);
    QuadVerts[3].TexCoord := Vector2(0.0, 1.0);
    QuadIndices[0] := 0; QuadIndices[1] := 1; QuadIndices[2] := 2;
    QuadIndices[3] := 0; QuadIndices[4] := 2; QuadIndices[5] := 3;
    Batch.UploadSharedMesh(QuadVerts, QuadIndices);
    Batch.SetCamera(TMatrix4.Identity, Vector3(0.0, 0.0, 1.0), 0.25);

    { Place 4 instances in the 4 NDC quadrants:
      (-0.5, +0.5) top-left, (+0.5, +0.5) top-right, (-0.5, -0.5) bottom-left, (+0.5, -0.5) bottom-right }
    Insts[0] := TCastleBindlessIndirectInstanceDesc.CreateSimple(
      TranslationMatrix(-0.5, 0.5, 0.0), Vector4(-0.5, 0.5, 0.0, 0.6),
      MatIdx0, BINDLESS_INSTANCE_FLAG_TEXTURED, 6);
    Insts[1] := TCastleBindlessIndirectInstanceDesc.CreateSimple(
      TranslationMatrix(0.5, 0.5, 0.0), Vector4(0.5, 0.5, 0.0, 0.6),
      MatIdx1, BINDLESS_INSTANCE_FLAG_TEXTURED, 6);
    Insts[2] := TCastleBindlessIndirectInstanceDesc.CreateSimple(
      TranslationMatrix(-0.5, -0.5, 0.0), Vector4(-0.5, -0.5, 0.0, 0.6),
      MatIdx2, BINDLESS_INSTANCE_FLAG_TEXTURED, 6);
    Insts[3] := TCastleBindlessIndirectInstanceDesc.CreateSimple(
      TranslationMatrix(0.5, -0.5, 0.0), Vector4(0.5, -0.5, 0.0, 0.6),
      MatIdx3, BINDLESS_INSTANCE_FLAG_TEXTURED or BINDLESS_INSTANCE_FLAG_ALPHA_CUTOFF, 6);
    Batch.UploadInstances(Insts, False);

    ColorTex := RealDev.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm, [tuColorAttachment, tuTransferSrc]));
    DepthTex := RealDev.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfD32_Float, [tuDepthStencil]));

    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    AssertTrue('Dedicated BindlessPool must be allocated on live Vulkan device',
      BindlessMgr.BindlessPool <> VK_NULL_HANDLE);

    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 64, 64),
      ColorTex, loClear, Vector4(20.0 / 255.0, 20.0 / 255.0, 30.0 / 255.0, 1.0),
      DepthTex, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);
    DrawnCount := Batch.RecordBindlessIndirectDraws(RealCmd, pfRGBA8_UNorm, pfD32_Float, 1, False);
    RealCmd.EndRendering;
    RealDev.EndOffscreenFrame;

    AssertEquals('Single multi-draw indirect batch must issue 4 sub-draws', 4, Integer(DrawnCount));
    AssertEquals('RealCmd.IndirectDrawCallCount must be 1 (zero per-object descriptor rebinds)',
      1, Integer(RealCmd.IndirectDrawCallCount));

    Readback := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 64, 64));

    { Top-left (16, 48) -> Mat0: (255, 128, 64) }
    AssertTrue('Top-left R (~255)', Abs(Integer(Readback.PixelPtr(16, 48)^.X) - 255) <= 4);
    AssertTrue('Top-left G (~128)', Abs(Integer(Readback.PixelPtr(16, 48)^.Y) - 128) <= 4);
    AssertTrue('Top-left B (~64)',  Abs(Integer(Readback.PixelPtr(16, 48)^.Z) - 64) <= 4);

    { Top-right (48, 48) -> Mat1: (0, 255, 128) }
    AssertTrue('Top-right R (~0)',   Abs(Integer(Readback.PixelPtr(48, 48)^.X) - 0) <= 4);
    AssertTrue('Top-right G (~255)', Abs(Integer(Readback.PixelPtr(48, 48)^.Y) - 255) <= 4);
    AssertTrue('Top-right B (~128)', Abs(Integer(Readback.PixelPtr(48, 48)^.Z) - 128) <= 4);

    { Bottom-left (16, 16) -> Mat2: (32, 64, 255) }
    AssertTrue('Bottom-left R (~32)',  Abs(Integer(Readback.PixelPtr(16, 16)^.X) - 32) <= 4);
    AssertTrue('Bottom-left G (~64)',  Abs(Integer(Readback.PixelPtr(16, 16)^.Y) - 64) <= 4);
    AssertTrue('Bottom-left B (~255)', Abs(Integer(Readback.PixelPtr(16, 16)^.Z) - 255) <= 4);

    { Bottom-right left half (40, 16) -> Mat3 opaque cyan (0, 220, 220) }
    AssertTrue('Bottom-right kept half R (~0)',   Abs(Integer(Readback.PixelPtr(40, 16)^.X) - 0) <= 4);
    AssertTrue('Bottom-right kept half G (~220)', Abs(Integer(Readback.PixelPtr(40, 16)^.Y) - 220) <= 4);
    AssertTrue('Bottom-right kept half B (~220)', Abs(Integer(Readback.PixelPtr(40, 16)^.Z) - 220) <= 4);

    { Bottom-right right half (55, 16) -> Mat3 alpha=0 OpKill discarded, preserving clear (20, 20, 30) }
    AssertTrue('Bottom-right discarded half R (~20)', Abs(Integer(Readback.PixelPtr(55, 16)^.X) - 20) <= 4);
    AssertTrue('Bottom-right discarded half G (~20)', Abs(Integer(Readback.PixelPtr(55, 16)^.Y) - 20) <= 4);
    AssertTrue('Bottom-right discarded half B (~30)', Abs(Integer(Readback.PixelPtr(55, 16)^.Z) - 30) <= 4);
  finally
    FreeAndNil(Readback);
    FreeAndNil(DepthTex);
    FreeAndNil(ColorTex);
    FreeAndNil(ImgAlphaMask);
    FreeAndNil(ImgBlue);
    FreeAndNil(ImgGreen);
    FreeAndNil(ImgRed);
    FreeAndNil(TempTex);
    FreeAndNil(TexAlphaMask);
    FreeAndNil(TexBlue);
    FreeAndNil(TexGreen);
    FreeAndNil(TexRed);
    FreeAndNil(Sampler);
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipeComputeCullerAndDrawIndexedIndirectCountRHI;
var
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  BindlessMgr: TCastleVulkanBindlessTextureManager;
  Batch: TCastleVulkanBindlessIndirectBatch;
  ColorTex, DepthTex: TRHITexture;
  Readback: TRGBAlphaImage;
  OrthoViewProj: TMatrix4;
  Planes: array[0..5] of TVector4;
  Mats: array[0..4] of TCastleBindlessMaterialEntry;
  MatIdxs: array[0..4] of Cardinal;
  AlreadyReg: Boolean;
  QuadVerts: array[0..3] of TCastleBindlessIndirectVertex;
  QuadIndices: array[0..5] of UInt32;
  Insts: array[0..7] of TCastleBindlessIndirectInstanceDesc;
  PassInfo: TRHIRenderingInfo;
  CmdOut: TRHIDrawIndexedIndirectCommand;
  SeenMask: Cardinal;
  I: Integer;
begin
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
    Exit;

  ColorTex := nil;
  DepthTex := nil;
  Readback := nil;
  try
    if not RealDev.SupportsBindlessTextures then
      Exit;

    if (RealDev.VendorKind = vvMesa) and (RealDev.DeviceApiVersion >= VK_API_VERSION_1_4) then
    begin
      AssertTrue('Mesa Lavapipe Vulkan 1.4 must support MultiDrawIndirect',
        RealDev.Capabilities.SupportsMultiDrawIndirect);
      AssertTrue('Mesa Lavapipe Vulkan 1.4 must support DrawIndirectCount (Vulkan 1.2 feature)',
        RealDev.Capabilities.SupportsDrawIndirectCount);
    end;

    BindlessMgr := RealDev.BindlessTextureManager;
    Batch := RealDev.BindlessIndirectBatch;

    { Register 5 solid bindless materials:
      0: Coral Red (240, 64, 48)
      1: Lime Green (64, 240, 80)
      2: Sky Blue (48, 144, 250)
      3: Gold Yellow (250, 208, 32)
      4: Sentinel Magenta (255, 0, 255) — assigned ONLY to culled instances! }
    for I := 0 to 4 do
      FillChar(Mats[I], SizeOf(TCastleBindlessMaterialEntry), 0);
    Mats[0].BaseColor := Vector4(240.0 / 255.0, 64.0 / 255.0, 48.0 / 255.0, 1.0);
    Mats[1].BaseColor := Vector4(64.0 / 255.0, 240.0 / 255.0, 80.0 / 255.0, 1.0);
    Mats[2].BaseColor := Vector4(48.0 / 255.0, 144.0 / 255.0, 250.0 / 255.0, 1.0);
    Mats[3].BaseColor := Vector4(250.0 / 255.0, 208.0 / 255.0, 32.0 / 255.0, 1.0);
    Mats[4].BaseColor := Vector4(1.0, 0.0, 1.0, 1.0);

    for I := 0 to 4 do
    begin
      MatIdxs[I] := 0;
      AlreadyReg := False;
      BindlessMgr.RegisterOrUpdateMaterial(MatIdxs[I], AlreadyReg, Mats[I]);
    end;

    { Unit quad of half-size 3.0 in world space (within [-10..10] ortho frustum) }
    QuadVerts[0].Position := Vector3(-3.0, -3.0, 0.0);
    QuadVerts[0].Normal := Vector3(0.0, 0.0, 1.0);
    QuadVerts[0].TexCoord := Vector2(0.0, 0.0);
    QuadVerts[1].Position := Vector3( 3.0, -3.0, 0.0);
    QuadVerts[1].Normal := Vector3(0.0, 0.0, 1.0);
    QuadVerts[1].TexCoord := Vector2(1.0, 0.0);
    QuadVerts[2].Position := Vector3( 3.0,  3.0, 0.0);
    QuadVerts[2].Normal := Vector3(0.0, 0.0, 1.0);
    QuadVerts[2].TexCoord := Vector2(1.0, 1.0);
    QuadVerts[3].Position := Vector3(-3.0,  3.0, 0.0);
    QuadVerts[3].Normal := Vector3(0.0, 0.0, 1.0);
    QuadVerts[3].TexCoord := Vector2(0.0, 1.0);
    QuadIndices[0] := 0; QuadIndices[1] := 1; QuadIndices[2] := 2;
    QuadIndices[3] := 0; QuadIndices[4] := 2; QuadIndices[5] := 3;
    Batch.UploadSharedMesh(QuadVerts, QuadIndices);

    { Orthographic frustum [-10..10] x [-10..10], ZNear=1, ZFar=50 looking down -Z }
    OrthoViewProj := OrthoProjectionMatrix(FloatRectangle(-10.0, -10.0, 20.0, 20.0), 1.0, 50.0);
    Batch.SetCamera(OrthoViewProj, Vector3(0.0, 0.0, 1.0), 0.25);

    Planes[0] := Vector4( 1.0,  0.0,  0.0, 10.0); { x >= -10 }
    Planes[1] := Vector4(-1.0,  0.0,  0.0, 10.0); { x <= +10 }
    Planes[2] := Vector4( 0.0,  1.0,  0.0, 10.0); { y >= -10 }
    Planes[3] := Vector4( 0.0, -1.0,  0.0, 10.0); { y <= +10 }
    Planes[4] := Vector4( 0.0,  0.0, -1.0, -1.0); { z <= -1 }
    Planes[5] := Vector4( 0.0,  0.0,  1.0, 50.0); { z >= -50 }
    { MaxDistance = 30.0: culls objects beyond distance 30 even if inside ZFar=50! }
    RealDev.ComputeCuller.SetFrustumPlanes(Planes, Vector3(0.0, 0.0, 0.0), 30.0);

    { 8 candidate instances:
      - Even indices 0, 2, 4, 6: VISIBLE in the 4 quadrants at Z = -10 (dist ~12.2 <= 30)
      - Indices 1, 3: OUTSIDE frustum X/Y (X = -45, Y = +45) with Sentinel Magenta
      - Indices 5, 7: INSIDE frustum X/Y/Z at screen center (0, 0, -42), Z in [-50..-1],
        rejected EXCLUSIVELY by GPU distance culling (42 - 4.5 = 37.5 > 30.0)! }
    Insts[0] := TCastleBindlessIndirectInstanceDesc.CreateSimple(
      TranslationMatrix(-5.5,  5.5, -10.0), Vector4(-5.5,  5.5, -10.0, 4.5), MatIdxs[0], 0, 6);
    Insts[1] := TCastleBindlessIndirectInstanceDesc.CreateSimple(
      TranslationMatrix(-45.0, 0.0, -10.0), Vector4(-45.0, 0.0, -10.0, 4.5), MatIdxs[4], 0, 6);
    Insts[2] := TCastleBindlessIndirectInstanceDesc.CreateSimple(
      TranslationMatrix( 5.5,  5.5, -10.0), Vector4( 5.5,  5.5, -10.0, 4.5), MatIdxs[1], 0, 6);
    Insts[3] := TCastleBindlessIndirectInstanceDesc.CreateSimple(
      TranslationMatrix( 0.0, 45.0, -10.0), Vector4( 0.0, 45.0, -10.0, 4.5), MatIdxs[4], 0, 6);
    Insts[4] := TCastleBindlessIndirectInstanceDesc.CreateSimple(
      TranslationMatrix(-5.5, -5.5, -10.0), Vector4(-5.5, -5.5, -10.0, 4.5), MatIdxs[2], 0, 6);
    Insts[5] := TCastleBindlessIndirectInstanceDesc.CreateSimple(
      TranslationMatrix( 0.0,  0.0, -42.0), Vector4( 0.0,  0.0, -42.0, 4.5), MatIdxs[4], 0, 6);
    Insts[6] := TCastleBindlessIndirectInstanceDesc.CreateSimple(
      TranslationMatrix( 5.5, -5.5, -10.0), Vector4( 5.5, -5.5, -10.0, 4.5), MatIdxs[3], 0, 6);
    Insts[7] := TCastleBindlessIndirectInstanceDesc.CreateSimple(
      TranslationMatrix( 0.0,  0.0, -44.0), Vector4( 0.0,  0.0, -44.0, 4.5), MatIdxs[4], 0, 6);
    Batch.UploadInstances(Insts, True);

    ColorTex := RealDev.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm, [tuColorAttachment, tuTransferSrc]));
    DepthTex := RealDev.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfD32_Float, [tuDepthStencil]));

    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    { 1. Dispatch GpuCullingCS on GPU + emit rsUnorderedAccess -> rsIndirectRead barriers }
    Batch.RecordComputeCullingPass(RealCmd, True);

    { 2. Render compacted survivors via single vkCmdDrawIndexedIndirectCount }
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 64, 64),
      ColorTex, loClear, Vector4(12.0 / 255.0, 16.0 / 255.0, 24.0 / 255.0, 1.0),
      DepthTex, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);
    Batch.RecordBindlessIndirectDraws(RealCmd, pfRGBA8_UNorm, pfD32_Float, 1, True);
    RealCmd.EndRendering;
    RealDev.EndOffscreenFrame;

    AssertEquals('vkCmdDrawIndexedIndirectCount must be recorded once',
      1, Integer(RealCmd.IndirectCountDrawCallCount));

    { Verify GPU-written atomic counter, per-instance visibility flags, and compacted indirect commands }
    AssertEquals('GPU GpuCullingCS OpAtomicIAdd visible count must be 4',
      4, Integer(RealDev.ComputeCuller.ReadBackVisibleCount));
    for I := 0 to 7 do
      if (I mod 2) = 0 then
        AssertEquals(Format('Instance %d visibility flag must be 1', [I]),
          1, Integer(RealDev.ComputeCuller.ReadBackVisibilityFlag(Cardinal(I))))
      else
        AssertEquals(Format('Instance %d visibility flag must be 0 (culled on GPU)', [I]),
          0, Integer(RealDev.ComputeCuller.ReadBackVisibilityFlag(Cardinal(I))));

    SeenMask := 0;
    for I := 0 to 3 do
    begin
      CmdOut := RealDev.ComputeCuller.ReadBackIndirectCommand(Cardinal(I));
      AssertEquals('Compacted command IndexCount must be 6', 6, Integer(CmdOut.IndexCount));
      AssertEquals('Compacted command InstanceCount must be 1', 1, Integer(CmdOut.InstanceCount));
      AssertTrue('Compacted FirstInstance must be in {0, 2, 4, 6}',
        (CmdOut.FirstInstance <= 6) and ((CmdOut.FirstInstance mod 2) = 0));
      SeenMask := SeenMask or (Cardinal(1) shl CmdOut.FirstInstance);
    end;
    AssertEquals('Compacted indirect stream must contain exact set {0, 2, 4, 6}',
      Integer((1 shl 0) or (1 shl 2) or (1 shl 4) or (1 shl 6)), Integer(SeenMask));

    { Verify rendered pixels: 4 quadrants match visible materials and center (32, 32) is untouched clear color! }
    Readback := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 64, 64));

    { Top-left (-5.5, +5.5) -> pixel (14, 50): Coral Red (240, 64, 48) }
    AssertTrue('Top-left Coral Red R', Abs(Integer(Readback.PixelPtr(14, 50)^.X) - 240) <= 5);
    AssertTrue('Top-left Coral Red G', Abs(Integer(Readback.PixelPtr(14, 50)^.Y) - 64) <= 5);
    AssertTrue('Top-left Coral Red B', Abs(Integer(Readback.PixelPtr(14, 50)^.Z) - 48) <= 5);

    { Top-right (+5.5, +5.5) -> pixel (50, 50): Lime Green (64, 240, 80) }
    AssertTrue('Top-right Lime Green R', Abs(Integer(Readback.PixelPtr(50, 50)^.X) - 64) <= 5);
    AssertTrue('Top-right Lime Green G', Abs(Integer(Readback.PixelPtr(50, 50)^.Y) - 240) <= 5);
    AssertTrue('Top-right Lime Green B', Abs(Integer(Readback.PixelPtr(50, 50)^.Z) - 80) <= 5);

    { Bottom-left (-5.5, -5.5) -> pixel (14, 14): Sky Blue (48, 144, 250) }
    AssertTrue('Bottom-left Sky Blue R', Abs(Integer(Readback.PixelPtr(14, 14)^.X) - 48) <= 5);
    AssertTrue('Bottom-left Sky Blue G', Abs(Integer(Readback.PixelPtr(14, 14)^.Y) - 144) <= 5);
    AssertTrue('Bottom-left Sky Blue B', Abs(Integer(Readback.PixelPtr(14, 14)^.Z) - 250) <= 5);

    { Bottom-right (+5.5, -5.5) -> pixel (50, 14): Gold Yellow (250, 208, 32) }
    AssertTrue('Bottom-right Gold Yellow R', Abs(Integer(Readback.PixelPtr(50, 14)^.X) - 250) <= 5);
    AssertTrue('Bottom-right Gold Yellow G', Abs(Integer(Readback.PixelPtr(50, 14)^.Y) - 208) <= 5);
    AssertTrue('Bottom-right Gold Yellow B', Abs(Integer(Readback.PixelPtr(50, 14)^.Z) - 32) <= 5);

    { Center (32, 32): Distance-culled Sentinel Magenta instances 5 & 7 must NOT be drawn! }
    AssertTrue('Center R must remain dark clear (~12), not Magenta (255)',
      Abs(Integer(Readback.PixelPtr(32, 32)^.X) - 12) <= 4);
    AssertTrue('Center G must remain dark clear (~16)',
      Abs(Integer(Readback.PixelPtr(32, 32)^.Y) - 16) <= 4);
    AssertTrue('Center B must remain dark clear (~24), not Magenta (255)',
      Abs(Integer(Readback.PixelPtr(32, 32)^.Z) - 24) <= 4);
  finally
    FreeAndNil(Readback);
    FreeAndNil(DepthTex);
    FreeAndNil(ColorTex);
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipeMaterialBinnerAndBindlessGpuDrivenPipelineRHI;
const
  StreamMatIDs: array[0..15] of Cardinal = (
    3, 0, 2, 3, 1, 0, 3, 5, 2, 0, 7, 3, 1, 2, 0, 5
  );
var
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  Binner: TCastleVulkanMaterialBinner;
  BindlessMgr: TCastleVulkanBindlessTextureManager;
  Batch: TCastleVulkanBindlessIndirectBatch;
  SamplerDesc: TRHISamplerDesc;
  Sampler: TRHISampler;
  WhiteTex: TRHITexture;
  WhiteImg, Readback: TRGBAlphaImage;
  ColorTex, DepthTex: TRHITexture;
  CpuCounts, CpuOffsets, GpuCounts, GpuOffsets: TCardinalDynamicArray;
  SlotWhite, MatIdxLit: Cardinal;
  AlreadyReg: Boolean;
  MatLit: TCastleBindlessMaterialEntry;
  Verts: array[0..7] of TCastleBindlessIndirectVertex;
  Indices: array[0..11] of UInt32;
  Insts: array[0..1] of TCastleBindlessIndirectInstanceDesc;
  Planes: array[0..5] of TVector4;
  PassInfo: TRHIRenderingInfo;
  I: Integer;
begin
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
    Exit;

  Sampler := nil;
  WhiteTex := nil;
  WhiteImg := nil;
  ColorTex := nil;
  DepthTex := nil;
  Readback := nil;
  try
    if not RealDev.SupportsBindlessTextures then
      Exit;

    Binner := RealDev.MaterialBinner;
    BindlessMgr := RealDev.BindlessTextureManager;
    Batch := RealDev.BindlessIndirectBatch;

    { 1. Upload 16-element material ID stream to TCastleVulkanMaterialBinner }
    TCastleVulkanMaterialBinner.EvaluateMaterialBinRanges(StreamMatIDs, 8, CpuCounts, CpuOffsets);
    Binner.UploadMaterialIDs(StreamMatIDs);

    { 2. Setup directional-lit bindless GPU-driven batch with two sub-meshes in shared VB/IB:
         - Sub-mesh 0 (FirstIndex=0, VertexOffset=0): normal (0, 0, +1) facing light (0, 0, +1) -> shade = 1.0
         - Sub-mesh 1 (FirstIndex=6, VertexOffset=4): normal (0, +1, 0) perpendicular to light  -> shade = ambient (0.25) }
    FillChar(SamplerDesc, SizeOf(SamplerDesc), 0);
    SamplerDesc.MinFilter := sfNearest;
    SamplerDesc.MagFilter := sfNearest;
    SamplerDesc.MipFilter := sfNearest;
    SamplerDesc.AddressModeU := amClampToEdge;
    SamplerDesc.AddressModeV := amClampToEdge;
    SamplerDesc.AddressModeW := amClampToEdge;
    SamplerDesc.MaxAnisotropy := 1.0;
    SamplerDesc.MaxLod := 1000.0;
    Sampler := RealDev.CreateSampler(SamplerDesc);

    WhiteImg := TRGBAlphaImage.Create(4, 4);
    WhiteImg.Clear(Vector4Byte(200, 160, 80, 255));
    WhiteTex := RealDev.CreateTexture(TRHITextureDesc.Create2D(4, 4, pfRGBA8_UNorm, [tuSampled, tuTransferDst]));
    WhiteTex.UploadImage(WhiteImg);
    SlotWhite := BindlessMgr.RegisterTexture(WhiteTex, Sampler);

    FillChar(MatLit, SizeOf(MatLit), 0);
    MatLit.BaseColor := Vector4(1.0, 1.0, 1.0, 1.0);
    MatLit.PBRParams := Vector4(0.5, 1.0, 1.0, 0.0);
    MatLit.BaseColorTexIndex := SlotWhite;
    MatIdxLit := 0;
    AlreadyReg := False;
    BindlessMgr.RegisterOrUpdateMaterial(MatIdxLit, AlreadyReg, MatLit);

    { Sub-mesh 0: vertices 0..3 with Normal = (0, 0, 1) }
    Verts[0].Position := Vector3(-0.35, -0.6, 0.0); Verts[0].Normal := Vector3(0, 0, 1); Verts[0].TexCoord := Vector2(0, 0);
    Verts[1].Position := Vector3( 0.35, -0.6, 0.0); Verts[1].Normal := Vector3(0, 0, 1); Verts[1].TexCoord := Vector2(1, 0);
    Verts[2].Position := Vector3( 0.35,  0.6, 0.0); Verts[2].Normal := Vector3(0, 0, 1); Verts[2].TexCoord := Vector2(1, 1);
    Verts[3].Position := Vector3(-0.35,  0.6, 0.0); Verts[3].Normal := Vector3(0, 0, 1); Verts[3].TexCoord := Vector2(0, 1);
    { Sub-mesh 1: vertices 4..7 with Normal = (0, 1, 0) -> N dot L = 0 -> ambient = 0.25 }
    Verts[4].Position := Vector3(-0.35, -0.6, 0.0); Verts[4].Normal := Vector3(0, 1, 0); Verts[4].TexCoord := Vector2(0, 0);
    Verts[5].Position := Vector3( 0.35, -0.6, 0.0); Verts[5].Normal := Vector3(0, 1, 0); Verts[5].TexCoord := Vector2(1, 0);
    Verts[6].Position := Vector3( 0.35,  0.6, 0.0); Verts[6].Normal := Vector3(0, 1, 0); Verts[6].TexCoord := Vector2(1, 1);
    Verts[7].Position := Vector3(-0.35,  0.6, 0.0); Verts[7].Normal := Vector3(0, 1, 0); Verts[7].TexCoord := Vector2(0, 1);

    { Indices 0..5 local (0,1,2, 0,2,3) used with VertexOffset=0 and Indices 6..11 local (0,1,2, 0,2,3) used with VertexOffset=4 }
    Indices[0] := 0; Indices[1] := 1; Indices[2] := 2;
    Indices[3] := 0; Indices[4] := 2; Indices[5] := 3;
    Indices[6] := 0; Indices[7] := 1; Indices[8] := 2;
    Indices[9] := 0; Indices[10] := 2; Indices[11] := 3;

    Batch.UploadSharedMesh(Verts, Indices);
    Batch.SetCamera(TMatrix4.Identity, Vector3(0.0, 0.0, 1.0), 0.25);

    for I := 0 to 5 do
      Planes[I] := Vector4(0.0, 0.0, 0.0, 10.0);
    RealDev.ComputeCuller.SetFrustumPlanes(Planes, Vector3(0.0, 0.0, 0.0), 0.0);

    { Left half (-0.5, 0): fully lit (N dot L = 1.0 -> shade = 1.0 -> (200, 160, 80))
      Right half (+0.5, 0): ambient-only (N dot L = 0.0 -> shade = 0.25 -> (50, 40, 20)) }
    Insts[0] := TCastleBindlessIndirectInstanceDesc.CreateSimple(
      TranslationMatrix(-0.5, 0.0, 0.0), Vector4(-0.5, 0.0, 0.0, 1.0),
      MatIdxLit, BINDLESS_INSTANCE_FLAG_TEXTURED or BINDLESS_INSTANCE_FLAG_LIT, 6, 0, 0);
    Insts[1] := TCastleBindlessIndirectInstanceDesc.CreateSimple(
      TranslationMatrix( 0.5, 0.0, 0.0), Vector4( 0.5, 0.0, 0.0, 1.0),
      MatIdxLit, BINDLESS_INSTANCE_FLAG_TEXTURED or BINDLESS_INSTANCE_FLAG_LIT, 6, 6, 4);
    Batch.UploadInstances(Insts, True);

    ColorTex := RealDev.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm, [tuColorAttachment, tuTransferSrc]));
    DepthTex := RealDev.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfD32_Float, [tuDepthStencil]));

    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    { Execute GPU MaterialBinHistogramCS + UAV barrier + MaterialBinPrefixSumCS }
    AssertEquals('DispatchStreamBinning must return 8 bins',
      8, Integer(Binner.DispatchStreamBinning(RealCmd, 8)));
    { Execute GPU GpuCullingCS + bindless indirect lit multi-draw }
    Batch.RecordComputeCullingPass(RealCmd, True);

    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 64, 64),
      ColorTex, loClear, Vector4(0.0, 0.0, 0.0, 1.0),
      DepthTex, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);
    Batch.RecordBindlessIndirectDraws(RealCmd, pfRGBA8_UNorm, pfD32_Float, 1, True);
    RealCmd.EndRendering;
    RealDev.EndOffscreenFrame;

    { Verify GPU MaterialBinHistogramCS & MaterialBinPrefixSumCS output matches CPU reference }
    Binner.ReadBackBinRanges(8, GpuCounts, GpuOffsets);
    for I := 0 to 7 do
    begin
      AssertEquals(Format('GPU MaterialBin Count[%d] must match CPU reference', [I]),
        Integer(CpuCounts[I]), Integer(GpuCounts[I]));
      AssertEquals(Format('GPU MaterialBin ExclusiveOffset[%d] must match CPU reference', [I]),
        Integer(CpuOffsets[I]), Integer(GpuOffsets[I]));
    end;

    { Verify VertexOffset + directional Lambertian + ambient shading on rendered pixels }
    Readback := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 64, 64));

    { Left quad (16, 32): N=(0,0,1), L=(0,0,1) -> shade=1.0 -> (200, 160, 80) }
    AssertTrue('Fully-lit quad R (~200)', Abs(Integer(Readback.PixelPtr(16, 32)^.X) - 200) <= 5);
    AssertTrue('Fully-lit quad G (~160)', Abs(Integer(Readback.PixelPtr(16, 32)^.Y) - 160) <= 5);
    AssertTrue('Fully-lit quad B (~80)',  Abs(Integer(Readback.PixelPtr(16, 32)^.Z) - 80) <= 5);

    { Right quad (48, 32): N=(0,1,0), L=(0,0,1), VertexOffset=4 -> shade=0.25 -> (50, 40, 20) }
    AssertTrue('Ambient-shaded quad R (~50)', Abs(Integer(Readback.PixelPtr(48, 32)^.X) - 50) <= 5);
    AssertTrue('Ambient-shaded quad G (~40)', Abs(Integer(Readback.PixelPtr(48, 32)^.Y) - 40) <= 5);
    AssertTrue('Ambient-shaded quad B (~20)', Abs(Integer(Readback.PixelPtr(48, 32)^.Z) - 20) <= 5);
  finally
    FreeAndNil(Readback);
    FreeAndNil(DepthTex);
    FreeAndNil(ColorTex);
    FreeAndNil(WhiteImg);
    FreeAndNil(WhiteTex);
    FreeAndNil(Sampler);
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.Phase111AliasPass0Callback(
  const AGraph: TRHIRenderGraph; const APass: TRHIRenderGraphPass; const ACmd: TRHICommandList);
begin
  if (AGraph = nil) and (APass = nil) then ;
  Inc(FRenderGraphPassExecCount);
  if ACmd <> nil then
    ACmd.ClearAttachments(True, Vector4(0.8, 0.2, 0.1, 1.0), False, 1.0, False, 0);
end;

procedure TTestCastleVulkanRHI.Phase111AliasPass5Callback(
  const AGraph: TRHIRenderGraph; const APass: TRHIRenderGraphPass; const ACmd: TRHICommandList);
begin
  if (AGraph = nil) and (APass = nil) then ;
  Inc(FRenderGraphPassExecCount);
  if ACmd <> nil then
    ACmd.ClearAttachments(True, Vector4(0.25, 0.55, 0.85, 1.0), False, 1.0, False, 0);
end;

procedure TTestCastleVulkanRHI.Phase111ForwardSceneCallback(
  const AGraph: TRHIRenderGraph; const APass: TRHIRenderGraphPass; const ACmd: TRHICommandList);
begin
  if (AGraph = nil) and (APass = nil) then ;
  Inc(FPhase111ForwardSubPassCounter);
  if ACmd = nil then
    Exit;

  { Render deterministic HDR + Depth scene into the RenderGraph's active dynamic rendering pass:
    - Base clear already wrote background HDR=(0,0,0,1), Depth=1.0 (sky)
    - Left & center foreground surface [4..60 x 4..60]: mid-HDR (0.65, 0.50, 0.35), Depth = 0.50
    - Bright HDR emissive core [26..38 x 26..38]: HDR (6.0, 3.0, 1.2), Depth = 0.32 (creates depth crease + bloom!) }
  ACmd.SetScissor(Rectangle(4, 4, 56, 56));
  ACmd.ClearAttachments(True, Vector4(0.65, 0.50, 0.35, 1.0), True, 0.50, False, 0);

  ACmd.SetScissor(Rectangle(26, 26, 12, 12));
  ACmd.ClearAttachments(True, Vector4(6.0, 3.0, 1.2, 1.0), True, 0.32, False, 0);

  ACmd.SetScissor(Rectangle(0, 0, 64, 64));
end;

procedure TTestCastleVulkanRHI.TestRealLavapipeRenderGraphPhysicalMemoryAliasingAndDeadPassCullingRHI;
var
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  Graph: TRHIRenderGraph;
  FinalLDR: TRHITexture;
  DescT1, DescT2, DescT3, DescT4, DescDead, FinalDesc: TRHITextureDesc;
  HT1, HT2, HT3, HT4, HDead, HFinal: TRHIRenderGraphResourceHandle;
  P0, P1, P2, P3, P4, P5, PDead: TRHIRenderGraphPass;
  VkT1, VkT3, VkT4: TVulkanRHITexture;
  PoolCountFrame1: Integer;
  Readback, ExpectedImg: TRGBAlphaImage;
  RMSE: Single;
begin
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
    Exit;

  Graph := nil;
  FinalLDR := nil;
  Readback := nil;
  ExpectedImg := nil;
  try
    FinalDesc := TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm,
      [tuColorAttachment, tuSampled, tuTransferSrc], 1, 1);
    FinalDesc.DebugName := 'Phase111_AliasFinalLDR';
    FinalLDR := RealDev.CreateTexture(FinalDesc);

    DescT1 := TRHITextureDesc.Create2D(64, 64, pfRGBA16_Float,
      [tuColorAttachment, tuSampled], 1, 1);
    DescT2 := TRHITextureDesc.Create2D(64, 64, pfRGBA16_Float,
      [tuColorAttachment, tuSampled], 1, 1);
    { Heterogeneous format (pfR16_Float) + usage (tuStorage) non-overlapping with T1 }
    DescT3 := TRHITextureDesc.Create2D(64, 64, pfR16_Float,
      [tuSampled, tuStorage], 1, 1);
    { Heterogeneous resolution (32x32) + format (pfRGBA8_UNorm) non-overlapping with T3 }
    DescT4 := TRHITextureDesc.Create2D(32, 32, pfRGBA8_UNorm,
      [tuColorAttachment, tuSampled], 1, 1);
    DescDead := TRHITextureDesc.Create2D(128, 128, pfRGBA16_Float,
      [tuColorAttachment, tuSampled], 1, 1);

    Graph := TRHIRenderGraph.Create(RealDev);

    { Build Frame 1 }
    HT1 := Graph.DeclareTransientTexture('Alias_T1_HDR64', DescT1);
    HT2 := Graph.DeclareTransientTexture('Alias_T2_HDR64', DescT2);
    HT3 := Graph.DeclareTransientTexture('Alias_T3_R16F64', DescT3);
    HT4 := Graph.DeclareTransientTexture('Alias_T4_RGBA8_32', DescT4);
    HDead := Graph.DeclareTransientTexture('Alias_Dead_128', DescDead);
    HFinal := Graph.ImportExternalTexture('Alias_FinalLDR', FinalLDR, rsUndefined, rsShaderRead);

    FRenderGraphPassExecCount := 0;

    P0 := Graph.AddPass('Pass0_ProduceT1', rgptGraphics);
    P0.WriteColorAttachment(HT1, loClear, Vector4(0.8, 0.2, 0.1, 1.0), soStore);
    P0.OnExecute := @Phase111AliasPass0Callback;

    P1 := Graph.AddPass('Pass1_ConsumeT1_ProduceT2', rgptGraphics);
    P1.ReadTexture(HT1, rsShaderRead);
    P1.WriteColorAttachment(HT2, loClear, Vector4(0.1, 0.7, 0.3, 1.0), soStore);
    P1.OnExecute := @DummyRenderGraphPassCallback;

    { T1 lifetime ended at Pass1 (order 1); Pass2 reads T2 (forcing order 2 > 1) and produces T3 -> aliases T1's VkDeviceMemory! }
    P2 := Graph.AddPass('Pass2_ProduceT3Storage', rgptCompute);
    P2.ReadTexture(HT2, rsShaderRead);
    P2.WriteStorageTexture(HT3, rsUnorderedAccess);
    P2.OnExecute := @DummyRenderGraphPassCallback;

    { T2 lifetime ended at Pass2 (order 2); Pass3 reads T3 (forcing order 3 > 2) and produces T4 -> aliases T2's VkDeviceMemory! }
    P3 := Graph.AddPass('Pass3_ConsumeT3_ProduceT4', rgptGraphics);
    P3.ReadTexture(HT3, rsShaderRead);
    P3.WriteColorAttachment(HT4, loClear, Vector4(0.9, 0.8, 0.2, 1.0), soStore);
    P3.OnExecute := @DummyRenderGraphPassCallback;

    P4 := Graph.AddPass('Pass4_ConsumeT4', rgptCompute);
    P4.ReadTexture(HT4, rsShaderRead);
    P4.HasSideEffects := True;
    P4.OnExecute := @DummyRenderGraphPassCallback;

    P5 := Graph.AddPass('Pass5_CompositeFinal', rgptGraphics);
    P5.ReadTexture(HT4, rsShaderRead);
    P5.WriteColorAttachment(HFinal, loClear, Vector4(0.0, 0.0, 0.0, 1.0), soStore);
    P5.OnExecute := @Phase111AliasPass5Callback;

    PDead := Graph.AddPass('PassDead_Unreferenced', rgptGraphics);
    PDead.WriteColorAttachment(HDead, loClear, Vector4(1.0, 0.0, 1.0, 1.0), soStore);
    PDead.OnExecute := @DummyRenderGraphPassCallback;

    Graph.Compile;

    AssertEquals('Dead-pass culling must cull 1 pass', 1, Graph.CulledPassCount);
    AssertEquals('Compiled pass count must be 6', 6, Graph.CompiledPassCount);
    AssertTrue('Unreferenced dead transient texture must not allocate VRAM',
      Graph.ResolvePhysicalTexture(HDead) = nil);

    VkT1 := Graph.ResolvePhysicalTexture(HT1) as TVulkanRHITexture;
    VkT3 := Graph.ResolvePhysicalTexture(HT3) as TVulkanRHITexture;
    VkT4 := Graph.ResolvePhysicalTexture(HT4) as TVulkanRHITexture;
    AssertTrue('Resolved T1, T3, T4 must be non-nil', (VkT1 <> nil) and (VkT3 <> nil) and (VkT4 <> nil));

    { Verify distinct VkImage handles sharing the exact same physical VkDeviceMemory & MemoryOffset
      when the Vulkan driver permits non-dedicated sub-allocated optimal image aliasing! }
    AssertTrue('Cross-format T3 must have a distinct VkImage handle from T1',
      VkT3.Image <> VkT1.Image);
    if RealDev.VendorKind = vvMesa then
      AssertTrue('Mesa Lavapipe must support non-dedicated VkImage physical memory aliasing',
        VkT3.IsMemoryAliased);
    PoolCountFrame1 := Graph.PhysicalTransientTextureCount;
    if VkT3.IsMemoryAliased then
    begin
      AssertTrue('Cross-format aliased T3 must bind to the exact same VkDeviceMemory as carrier T1',
        VkT3.DeviceMemory = VkT1.DeviceMemory);
      AssertEquals('Cross-format aliased T3 must bind at the carrier MemoryOffset',
        Int64(VkT1.MemoryOffset), Int64(VkT3.MemoryOffset));
      AssertTrue('T3 must report IsMemoryAliased = True and not own the carrier allocation',
        VkT3.IsMemoryAliased and (not VkT3.OwnsAllocation));
      AssertTrue('Graph must report MemoryAliasedTextureCount >= 1', Graph.MemoryAliasedTextureCount >= 1);
      AssertTrue('Graph must report AliasedMemorySavedBytes > 0', Graph.AliasedMemorySavedBytes > 0);
      AssertTrue('Graph must hoist explicit aliasing barriers (>= 1)', Graph.AliasingBarrierCount >= 1);
      AssertEquals('4 live transients with non-overlapping chains must fit in 2 physical carrier slots',
        2, PoolCountFrame1);
    end else
      AssertTrue('Dedicated-allocation driver fallback must allocate <= 4 pooled transient textures',
        (PoolCountFrame1 >= 2) and (PoolCountFrame1 <= 4));

    { Execute Frame 1 on live GPU }
    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    Graph.Execute(RealCmd);
    if VkT3.IsMemoryAliased then
      AssertTrue('Command list must record explicit VkMemoryBarrier2 / VkMemoryBarrier aliasing barriers',
        RealCmd.AliasingBarrierCount >= 1);
    RealDev.EndOffscreenFrame;

    AssertEquals('All 6 live passes must execute (DeadPass skipped)', 6, FRenderGraphPassExecCount);

    { Verify Frame 2 Reset + Re-Compile reuses cached carrier & aliased VkImage wrappers with zero new slots }
    Graph.Reset;
    HT1 := Graph.DeclareTransientTexture('Alias_T1_HDR64', DescT1);
    HT3 := Graph.DeclareTransientTexture('Alias_T3_R16F64', DescT3);
    HFinal := Graph.ImportExternalTexture('Alias_FinalLDR', FinalLDR, rsShaderRead, rsShaderRead);

    P0 := Graph.AddPass('Frame2_P0', rgptGraphics);
    P0.WriteColorAttachment(HT1, loClear, Vector4(0.4, 0.4, 0.4, 1.0), soStore);
    P2 := Graph.AddPass('Frame2_P1', rgptCompute);
    P2.ReadTexture(HT1, rsShaderRead);
    P2.WriteStorageTexture(HT3, rsUnorderedAccess);
    P5 := Graph.AddPass('Frame2_P2', rgptGraphics);
    P5.ReadTexture(HT3, rsShaderRead);
    P5.WriteColorAttachment(HFinal, loClear, Vector4(0.0, 0.0, 0.0, 1.0), soStore);
    P5.OnExecute := @Phase111AliasPass5Callback;

    Graph.Compile;
    AssertEquals('Second frame must reuse pooled carrier slots without growing pool',
      PoolCountFrame1, Graph.PhysicalTransientTextureCount);

    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    Graph.Execute(RealCmd);
    RealDev.EndOffscreenFrame;

    Readback := RealDev.GrabTextureImage(FinalLDR, Rectangle(0, 0, 64, 64));
    ExpectedImg := TRGBAlphaImage.Create(64, 64);
    ExpectedImg.Clear(Vector4Byte(Round(0.25 * 255), Round(0.55 * 255), Round(0.85 * 255), 255));
    AssertTrue('Perceptual diff on FinalLDR after multi-frame aliased RenderGraph execution must match (< 0.01 RMSE)',
      CompareImagesPerceptualDiff(Readback, ExpectedImg, 0.01, RMSE));
  finally
    FreeAndNil(ExpectedImg);
    FreeAndNil(Readback);
    FreeAndNil(Graph);
    FreeAndNil(FinalLDR);
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipeHDRBloomLuminanceHistogramAndTonemapPerceptualDiffRHI;
var
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  HDRPost: TCastleVulkanHDRPostProcessor;
  LDRTarget: TRHITexture;
  HDRUpload, HDRReadback, BloomReadback: TRGBAlphaFloatImage;
  LDRReadbackACES, LDRReadbackAgX, LDRNoBloom, LDRWithBloom, RefImg: TRGBAlphaImage;
  GpuBins: array[0..CASTLE_LUMINANCE_HISTOGRAM_BINS - 1] of Cardinal;
  BinSum, ExpectedBin: Cardinal;
  Lum, LogLumNorm, RMSE: Single;
  ExpColor: TVector3;
  X, Y: Integer;
begin
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
    Exit;

  LDRTarget := nil;
  HDRUpload := nil;
  HDRReadback := nil;
  BloomReadback := nil;
  LDRReadbackACES := nil;
  LDRReadbackAgX := nil;
  LDRNoBloom := nil;
  LDRWithBloom := nil;
  RefImg := nil;
  try
    HDRPost := RealDev.HDRPostProcessor;
    HDRPost.EnsureHDRTargets(64, 64);
    LDRTarget := RealDev.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm, [tuColorAttachment, tuSampled, tuTransferSrc]));

    { 1. Upload linear HDR color (2.4, 0.8, 0.25, 1.0) into pfRGBA16_Float and verify float readback }
    HDRUpload := TRGBAlphaFloatImage.Create(64, 64);
    for Y := 0 to 63 do
      for X := 0 to 63 do
        HDRUpload.PixelPtr(X, Y)^ := Vector4(2.4, 0.8, 0.25, 1.0);
    HDRPost.HDRSceneTexture.UploadImage(HDRUpload);

    HDRReadback := RealDev.GrabTextureFloatImage(HDRPost.HDRSceneTexture, Rectangle(0, 0, 64, 64));
    AssertSameValue(2.4, HDRReadback.PixelPtr(32, 32)^.X, 0.01);
    AssertSameValue(0.8, HDRReadback.PixelPtr(32, 32)^.Y, 0.01);
    AssertSameValue(0.25, HDRReadback.PixelPtr(32, 32)^.Z, 0.01);

    { 2. Dispatch GPU LuminanceHistogramCS & verify atomic histogram bin counts on live Lavapipe }
    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    HDRPost.DispatchLuminanceHistogramOnGPU(RealCmd, HDRPost.HDRSceneTexture);
    RealDev.EndOffscreenFrame;

    BinSum := HDRPost.ReadBackGpuHistogramBins(GpuBins);
    AssertEquals('GPU LuminanceHistogramCS must count all 64*64 = 4096 texels', 4096, Integer(BinSum));

    Lum := 2.4 * 0.2126 + 0.8 * 0.7152 + 0.25 * 0.0722;
    LogLumNorm := EnsureRange((Log2(Lum) - (-8.0)) / 12.0, 0.0, 1.0);
    ExpectedBin := Cardinal(EnsureRange(Trunc(LogLumNorm * 254.0 + 1.0), 1, 255));
    AssertEquals('Uniform HDR scene must accumulate all 4096 texels in ExpectedBin',
      4096, Integer(GpuBins[ExpectedBin]));

    { 3. Verify ACES Filmic & AgX Fullscreen Composite on live GPU against CPU reference via Perceptual Diff }
    HDRPost.Exposure := 1.15;
    HDRPost.Gamma := 2.2;
    HDRPost.Saturation := 1.12;
    HDRPost.Contrast := 1.06;
    HDRPost.EnableBloom := False;
    HDRPost.EnableAutoExposure := False;

    HDRPost.TonemapOperator := tmoACESFilmic;
    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    HDRPost.ExecuteCompositePass(RealCmd, LDRTarget);
    RealDev.EndOffscreenFrame;
    LDRReadbackACES := RealDev.GrabTextureImage(LDRTarget, Rectangle(0, 0, 64, 64));

    ExpColor := HDRPost.EvaluateCompositeColor(Vector3(2.4, 0.8, 0.25), Vector3(0.0, 0.0, 0.0));
    RefImg := TRGBAlphaImage.Create(64, 64);
    RefImg.Clear(Vector4Byte(
      Byte(Round(ExpColor.X * 255.0)),
      Byte(Round(ExpColor.Y * 255.0)),
      Byte(Round(ExpColor.Z * 255.0)), 255));
    AssertTrue('GPU ACES Filmic + Color Grading + sRGB must match CPU reference (RMSE <= 0.015)',
      CompareImagesPerceptualDiff(LDRReadbackACES, RefImg, 0.015, RMSE));

    HDRPost.TonemapOperator := tmoAgX;
    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    HDRPost.ExecuteCompositePass(RealCmd, LDRTarget);
    RealDev.EndOffscreenFrame;
    LDRReadbackAgX := RealDev.GrabTextureImage(LDRTarget, Rectangle(0, 0, 64, 64));

    ExpColor := HDRPost.EvaluateCompositeColor(Vector3(2.4, 0.8, 0.25), Vector3(0.0, 0.0, 0.0));
    RefImg.Clear(Vector4Byte(
      Byte(Round(ExpColor.X * 255.0)),
      Byte(Round(ExpColor.Y * 255.0)),
      Byte(Round(ExpColor.Z * 255.0)), 255));
    AssertTrue('GPU AgX Filmic + Color Grading + sRGB must match CPU reference (RMSE <= 0.015)',
      CompareImagesPerceptualDiff(LDRReadbackAgX, RefImg, 0.015, RMSE));

    { 4. Verify live GPU 13-tap Karis Bloom Downsample + 9-tap Tent Upsample halo spread }
    for Y := 0 to 63 do
      for X := 0 to 63 do
        if (X >= 28) and (X < 36) and (Y >= 28) and (Y < 36) then
          HDRUpload.PixelPtr(X, Y)^ := Vector4(12.0, 6.0, 2.0, 1.0)
        else
          HDRUpload.PixelPtr(X, Y)^ := Vector4(0.05, 0.05, 0.05, 1.0);
    HDRPost.HDRSceneTexture.UploadImage(HDRUpload);

    HDRPost.TonemapOperator := tmoACESFilmic;
    HDRPost.Exposure := 1.0;
    HDRPost.Saturation := 1.0;
    HDRPost.Contrast := 1.0;
    HDRPost.BloomThreshold := 1.0;
    HDRPost.BloomKnee := 0.5;
    HDRPost.BloomIntensity := 0.45;

    HDRPost.EnableBloom := False;
    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    HDRPost.ExecuteCompositePass(RealCmd, LDRTarget);
    RealDev.EndOffscreenFrame;
    LDRNoBloom := RealDev.GrabTextureImage(LDRTarget, Rectangle(0, 0, 64, 64));

    HDRPost.EnableBloom := True;
    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    HDRPost.DispatchBloomPyramid(RealCmd);
    HDRPost.ExecuteCompositePass(RealCmd, LDRTarget);
    RealDev.EndOffscreenFrame;

    BloomReadback := RealDev.GrabTextureFloatImage(HDRPost.BloomMipTextures[0],
      Rectangle(0, 0, HDRPost.BloomMipTextures[0].Desc.Width, HDRPost.BloomMipTextures[0].Desc.Height));
    LDRWithBloom := RealDev.GrabTextureImage(LDRTarget, Rectangle(0, 0, 64, 64));

    { Center of half-res BloomMip0 (16, 16) must be bright; halo at (11, 16) > 0; far corner (1, 1) near 0 }
    AssertTrue(Format('BloomMip0 center (16,16)=%.4f, (15,15)=%.4f, (11,16)=%.4f must have strong HDR energy (> 1.0)',
      [BloomReadback.PixelPtr(16, 16)^.X, BloomReadback.PixelPtr(15, 15)^.X, BloomReadback.PixelPtr(11, 16)^.X]),
      BloomReadback.PixelPtr(16, 16)^.X > 1.0);
    AssertTrue(Format('BloomMip0 halo (11,16)=%.4f outside 4x4 half-res core must spread positive glow (> 0.02)',
      [BloomReadback.PixelPtr(11, 16)^.X]),
      BloomReadback.PixelPtr(11, 16)^.X > 0.02);
    AssertTrue(Format('BloomMip0 far corner (1,1)=%.4f must remain small (< 0.25)',
      [BloomReadback.PixelPtr(1, 1)^.X]),
      BloomReadback.PixelPtr(1, 1)^.X < 0.25);
    AssertTrue(Format('Composited LDR pixel at halo (22, 32) WithBloom=%d vs NoBloom=%d',
      [LDRWithBloom.PixelPtr(22, 32)^.X, LDRNoBloom.PixelPtr(22, 32)^.X]),
      LDRWithBloom.PixelPtr(22, 32)^.X > LDRNoBloom.PixelPtr(22, 32)^.X + 8);
  finally
    FreeAndNil(RefImg);
    FreeAndNil(LDRWithBloom);
    FreeAndNil(LDRNoBloom);
    FreeAndNil(LDRReadbackAgX);
    FreeAndNil(LDRReadbackACES);
    FreeAndNil(BloomReadback);
    FreeAndNil(HDRReadback);
    FreeAndNil(HDRUpload);
    FreeAndNil(LDRTarget);
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipeFullRenderGraphGTAOSSRAndPostProcessPipelineRHI;
var
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  HDRPost: TCastleVulkanHDRPostProcessor;
  Graph: TRHIRenderGraph;
  DepthTex, FinalLDRTex, RefLDRTex: TRHITexture;
  DepthUpload, GTAOReadback, LitHDRReadback, BloomMip0Readback: TRGBAlphaFloatImage;
  GraphLDRReadback, DirectRefReadback: TRGBAlphaImage;
  VkGTAORaw, VkSSR, VkHDRLit, VkBloomMip0: TVulkanRHITexture;
  GpuBins: array[0..CASTLE_LUMINANCE_HISTOGRAM_BINS - 1] of Cardinal;
  FlatAO, CreaseAO, SkyAO, RMSE: Single;
  X, Y: Integer;
begin
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
    Exit;

  Graph := nil;
  DepthTex := nil;
  FinalLDRTex := nil;
  RefLDRTex := nil;
  DepthUpload := nil;
  GTAOReadback := nil;
  LitHDRReadback := nil;
  BloomMip0Readback := nil;
  GraphLDRReadback := nil;
  DirectRefReadback := nil;
  try
    { Part A: Direct GPU GTAO Horizon + Cross-Bilateral Denoise verification on synthetic depth step }
    DepthTex := RealDev.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfD32_Float, [tuDepthStencil, tuSampled, tuTransferDst]));
    DepthUpload := TRGBAlphaFloatImage.Create(64, 64);
    for Y := 0 to 63 do
      for X := 0 to 63 do
      begin
        if Y >= 56 then
          DepthUpload.PixelPtr(X, Y)^ := Vector4(1.0, 0.0, 0.0, 1.0)   { Sky }
        else if (X >= 36) and (X <= 48) and (Y >= 16) and (Y <= 44) then
          DepthUpload.PixelPtr(X, Y)^ := Vector4(0.20, 0.0, 0.0, 1.0)  { Protruding occluder wall }
        else
          DepthUpload.PixelPtr(X, Y)^ := Vector4(0.50, 0.0, 0.0, 1.0); { Flat background plane }
      end;
    DepthTex.UploadImage(DepthUpload);

    RealDev.GTAO.ZNear := 0.1;
    RealDev.GTAO.ZFar := 10.0;
    RealDev.GTAO.EffectRadius := 1.5;
    RealDev.GTAO.Power := 1.5;
    RealDev.GTAO.EnsureGTAOTargets(64, 64, False);

    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    AssertEquals('DispatchGTAO must record 2 dispatches (Horizon + Denoise)',
      2, Integer(RealDev.GTAO.DispatchGTAO(RealCmd, DepthTex)));
    RealDev.EndOffscreenFrame;

    GTAOReadback := RealDev.GrabTextureFloatImage(RealDev.GTAO.DenoisedGTAOTexture, Rectangle(0, 0, 64, 64));
    SkyAO := GTAOReadback.PixelPtr(16, 60)^.X;
    FlatAO := GTAOReadback.PixelPtr(10, 30)^.X;
    CreaseAO := GTAOReadback.PixelPtr(34, 30)^.X; { Immediately adjacent to protruding z=0.20 wall }
    AssertSameValue(1.0, SkyAO, 0.01);
    AssertTrue(Format('Unoccluded flat plane FlatAO=%.4f must have high GTAO visibility (> 0.90)', [FlatAO]),
      FlatAO > 0.90);
    AssertTrue(Format('Depth crease CreaseAO=%.4f vs FlatAO=%.4f must exhibit GTAO darkening', [CreaseAO, FlatAO]),
      CreaseAO < FlatAO - 0.04);

    { Part B: Full 9-Pass BuildNextGenPostProcessRenderGraph Live Execution + Physical Aliasing + Perceptual Diff }
    FinalLDRTex := RealDev.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm, [tuColorAttachment, tuSampled, tuTransferSrc]));
    RefLDRTex := RealDev.CreateTexture(
      TRHITextureDesc.Create2D(64, 64, pfRGBA8_UNorm, [tuColorAttachment, tuSampled, tuTransferSrc]));

    HDRPost := RealDev.HDRPostProcessor;
    HDRPost.Exposure := 1.05;
    HDRPost.Gamma := 2.2;
    HDRPost.Saturation := 1.05;
    HDRPost.Contrast := 1.02;
    HDRPost.TonemapOperator := tmoACESFilmic;
    HDRPost.EnableBloom := True;
    HDRPost.BloomIntensity := 0.25;
    HDRPost.AOStrength := 1.0;
    HDRPost.SSRStrength := 0.8;

    RealDev.SSR.ZNear := 0.1;
    RealDev.SSR.ZFar := 10.0;
    RealDev.SSR.Thickness := 0.35;
    RealDev.SSR.Intensity := 1.0;

    Graph := TRHIRenderGraph.Create(RealDev);
    FPhase111ForwardSubPassCounter := 0;
    HDRPost.BuildNextGenPostProcessRenderGraph(
      Graph, 64, 64, FinalLDRTex, @Phase111ForwardSceneCallback, True { IncludeDeadDebugPass });
    Graph.Compile;

    AssertEquals('Next-Gen graph with dead debug pass must register 10 passes', 10, Graph.PassCount);
    AssertEquals('Dead-pass culling must cull the unreferenced debug pass', 1, Graph.CulledPassCount);
    AssertEquals('Compiled active pass count must be 9', 9, Graph.CompiledPassCount);
    AssertTrue('Next-Gen graph must alias transient physical memory (>= 2 aliased textures)',
      Graph.MemoryAliasedTextureCount >= 2);
    AssertTrue('Next-Gen graph must save transient VRAM bytes (> 0)',
      Graph.AliasedMemorySavedBytes > 0);
    AssertTrue('Next-Gen graph must hoist explicit memory aliasing barriers (>= 2)',
      Graph.AliasingBarrierCount >= 2);

    VkGTAORaw := Graph.ResolvePhysicalTexture(HDRPost.RGGTAORawHandle) as TVulkanRHITexture;
    VkSSR := Graph.ResolvePhysicalTexture(HDRPost.RGSSRReflectionHandle) as TVulkanRHITexture;
    VkHDRLit := Graph.ResolvePhysicalTexture(HDRPost.RGSceneHDRLitHandle) as TVulkanRHITexture;
    VkBloomMip0 := Graph.ResolvePhysicalTexture(HDRPost.RGBloomMip0Handle) as TVulkanRHITexture;
    AssertTrue('All active transient RenderGraph handles must resolve to physical textures',
      (VkGTAORaw <> nil) and (VkSSR <> nil) and (VkHDRLit <> nil) and (VkBloomMip0 <> nil));
    { GTAORaw (passes 2..3) and SSRReflection (passes 4..5) have non-overlapping lifetimes -> share VkDeviceMemory! }
    AssertTrue('GTAORaw and SSRReflection must have distinct VkImage handles',
      VkGTAORaw.Image <> VkSSR.Image);
    AssertTrue('Non-overlapping transient targets must share physical VkDeviceMemory',
      (VkGTAORaw.DeviceMemory = VkSSR.DeviceMemory) or
      (VkGTAORaw.DeviceMemory = VkHDRLit.DeviceMemory) or
      (VkSSR.DeviceMemory = VkBloomMip0.DeviceMemory));

    { Execute all 9 compiled passes on live Mesa Lavapipe! }
    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    Graph.Execute(RealCmd);
    RealDev.EndOffscreenFrame;

    AssertEquals('Forward3DHDRPass callback must execute once', 1, FPhase111ForwardSubPassCounter);
    AssertEquals('GPU LuminanceHistogramCS inside RenderGraph must count all 4096 pixels',
      4096, Integer(HDRPost.ReadBackGpuHistogramBins(GpuBins)));

    GraphLDRReadback := RealDev.GrabTextureImage(FinalLDRTex, Rectangle(0, 0, 64, 64));

    { Build independent reference composite from the resolved LitHDR + BloomMip0 textures and verify Perceptual Diff }
    LitHDRReadback := RealDev.GrabTextureFloatImage(VkHDRLit, Rectangle(0, 0, 64, 64));
    BloomMip0Readback := RealDev.GrabTextureFloatImage(VkBloomMip0, Rectangle(0, 0, 32, 32));
    AssertTrue('LitHDR center emissive core (32,32) must retain bright HDR radiance (> 4.0)',
      LitHDRReadback.PixelPtr(32, 32)^.X > 4.0);
    AssertTrue('BloomMip0 center (16,16) must contain downsampled/upsampled bloom energy (> 0.5)',
      BloomMip0Readback.PixelPtr(16, 16)^.X > 0.5);

    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    HDRPost.ExecuteCompositeFromTextures(RealCmd, VkHDRLit, VkBloomMip0, RefLDRTex, False);
    RealDev.EndOffscreenFrame;
    DirectRefReadback := RealDev.GrabTextureImage(RefLDRTex, Rectangle(0, 0, 64, 64));

    AssertTrue('RenderGraph TonemapCompositePass output must perceptually match reference composite (RMSE <= 0.01)',
      CompareImagesPerceptualDiff(GraphLDRReadback, DirectRefReadback, 0.01, RMSE));
    { Also verify spatial structure of final tonemapped LDR frame: sky border dark, mid plane lit, emissive core brightest }
    AssertTrue(Format('Sky border pixel (1,1)=%d must remain dark (< 75)', [GraphLDRReadback.PixelPtr(1, 1)^.X]),
      GraphLDRReadback.PixelPtr(1, 1)^.X < 75);
    AssertTrue(Format('Foreground lit surface (14,14)=%d must be much brighter than sky border (%d)',
      [GraphLDRReadback.PixelPtr(14, 14)^.X, GraphLDRReadback.PixelPtr(1, 1)^.X]),
      Integer(GraphLDRReadback.PixelPtr(14, 14)^.X) > Integer(GraphLDRReadback.PixelPtr(1, 1)^.X) + 80);
    AssertTrue(Format('Emissive core (32,32)=%d must be brightest (> 235)', [GraphLDRReadback.PixelPtr(32, 32)^.X]),
      GraphLDRReadback.PixelPtr(32, 32)^.X > 235);
  finally
    FreeAndNil(DirectRefReadback);
    FreeAndNil(GraphLDRReadback);
    FreeAndNil(BloomMip0Readback);
    FreeAndNil(LitHDRReadback);
    FreeAndNil(GTAOReadback);
    FreeAndNil(DepthUpload);
    FreeAndNil(RefLDRTex);
    FreeAndNil(FinalLDRTex);
    FreeAndNil(DepthTex);
    FreeAndNil(Graph);
    FreeAndNil(RealDev);
  end;
end;

type
  TPhase112VisualParity2DControl = class(TCastleUserInterface)
  private
    FSprite: TDrawableImage;
    procedure EnsureSprite;
  public
    destructor Destroy; override;
    procedure GLContextClose; override;
    procedure Render; override;
  end;

procedure TPhase112VisualParity2DControl.EnsureSprite;
var
  Img: TRGBAlphaImage;
  X, Y: Integer;
begin
  if FSprite <> nil then Exit;
  Img := TRGBAlphaImage.Create(32, 32);
  for Y := 0 to 31 do
    for X := 0 to 31 do
    begin
      if ((X div 8) + (Y div 8)) mod 2 = 0 then
        Img.PixelPtr(X, Y)^ := Vector4Byte(245, 210, 40, 255)
      else
        Img.PixelPtr(X, Y)^ := Vector4Byte(40, 185, 240, 255);
    end;
  FSprite := TDrawableImage.Create(Img, False { SmoothScaling }, True { OwnsImage });
end;

procedure TPhase112VisualParity2DControl.GLContextClose;
begin
  FreeAndNil(FSprite);
  inherited;
end;

destructor TPhase112VisualParity2DControl.Destroy;
begin
  FreeAndNil(FSprite);
  inherited;
end;

procedure TPhase112VisualParity2DControl.Render;
begin
  inherited;
  DrawRectangle(FloatRectangle(0, 0, 160, 120), Vector4(0.10, 0.12, 0.18, 1.0));
  DrawRectangle(FloatRectangle(12, 14, 62, 92), Vector4(0.88, 0.22, 0.20, 1.0));
  DrawRectangle(FloatRectangle(48, 28, 66, 64), Vector4(0.18, 0.76, 0.36, 1.0));
  EnsureSprite;
  FSprite.Draw(FloatRectangle(92, 28, 56, 56));
end;

procedure TTestCastleVulkanRHI.TestVulkanValidationLayerDebugMessengerAndZeroErrorGateRHI;
var
  Layers: TAnsiStringArray;
  HasDebugUtils: Boolean;
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  ColorTex: TRHITexture;
  Readback: TRGBAlphaImage;
  PassInfo: TRHIRenderingInfo;
  RoutedViaLoader, CaughtGateError: Boolean;
  GateErrMsg, ReportStr, InfoStr: String;
begin
  try
    if not LoadVulkan then
      Exit;
  except
    on Exception do
      Exit;
  end;

  Layers := QuerySupportedVulkanInstanceLayers;
  AssertTrue('vkEnumerateInstanceLayerProperties must be bound when Vulkan loader is present',
    Assigned(vkEnumerateInstanceLayerProperties));
  { Layers may be 0 or >= 1 depending on installed OS layers; verify IsVulkanInstanceLayerSupported consistency }
  if Length(Layers) > 0 then
    AssertTrue('First enumerated Vulkan layer must report supported',
      IsVulkanInstanceLayerSupported(Layers[0]));
  HasDebugUtils := IsVulkanInstanceExtensionSupported(VK_EXT_debug_utils);

  RealDev := nil;
  try
    RealDev := TVulkanRHIDevice.CreateOffscreen(True { EnableValidation });
  except
    on Exception do
    begin
      FreeAndNil(RealDev);
      Exit;
    end;
  end;

  ColorTex := nil;
  Readback := nil;
  try
    if HasDebugUtils then
    begin
      AssertTrue('DebugUtilsActive must be True when VK_EXT_debug_utils is supported and EnableValidation=True',
        RealDev.DebugUtilsActive);
      AssertTrue('FDebugMessenger handle must be created via vkCreateDebugUtilsMessengerEXT',
        RealDev.DebugMessengerHandle <> VK_NULL_HANDLE);
    end;

    { 1. Clean device startup must produce 0 validation errors }
    AssertEquals('Fresh TVulkanRHIDevice startup must emit 0 validation errors',
      0, Integer(RealDev.ValidationErrorCount));
    RealDev.AssertZeroValidationErrors('OffscreenDeviceStartup');

    InfoStr := RealDev.GetInformationString;
    AssertTrue('GetInformationString must report validation layer & messenger diagnostics',
      Pos('Validation layer (VK_LAYER_KHRONOS_validation):', InfoStr) > 0);

    { 2. Live round-trip through vkSubmitDebugUtilsMessageEXT -> Vulkan Loader -> C Callback -> TVulkanRHIDevice }
    RealDev.ResetValidationCounters;
    RealDev.StrictValidationGate := False;

    RoutedViaLoader := RealDev.SubmitDebugUtilsMessage(
      VK_DEBUG_UTILS_MESSAGE_SEVERITY_WARNING_BIT_EXT,
      VK_DEBUG_UTILS_MESSAGE_TYPE_PERFORMANCE_BIT_EXT,
      'VUID-CastleTest-PerfWarning-001',
      'Synthetic performance warning routed through debug messenger');
    if HasDebugUtils and (RealDev.DebugMessengerHandle <> VK_NULL_HANDLE) and
       Assigned(vkSubmitDebugUtilsMessageEXT) then
      AssertTrue('SubmitDebugUtilsMessage must route through live vkSubmitDebugUtilsMessageEXT',
        RoutedViaLoader);

    AssertEquals('ValidationWarningCount must increment to 1', 1, Integer(RealDev.ValidationWarningCount));
    AssertEquals('ValidationErrorCount must remain 0 on warning', 0, Integer(RealDev.ValidationErrorCount));
    { Non-strict gate allows warnings while blocking errors }
    RealDev.AssertZeroValidationErrors('NonStrictWarningAllowed');

    { Strict CI gate rejects warnings too }
    RealDev.StrictValidationGate := True;
    CaughtGateError := False;
    GateErrMsg := '';
    try
      RealDev.AssertZeroValidationErrors('StrictGateCheck');
    except
      on E: ERHIError do
      begin
        CaughtGateError := True;
        GateErrMsg := E.Message;
      end;
    end;
    AssertTrue('StrictValidationGate=True must raise ERHIError when ValidationWarningCount > 0', CaughtGateError);
    AssertTrue('Strict gate exception must include VUID identifier',
      Pos('VUID-CastleTest-PerfWarning-001', GateErrMsg) > 0);

    { 3. Validation error always trips AssertZeroValidationErrors even when StrictValidationGate=False }
    RealDev.StrictValidationGate := False;
    RealDev.SubmitDebugUtilsMessage(
      VK_DEBUG_UTILS_MESSAGE_SEVERITY_ERROR_BIT_EXT,
      VK_DEBUG_UTILS_MESSAGE_TYPE_VALIDATION_BIT_EXT,
      'VUID-vkCmdDraw-None-08600',
      'Synthetic validation error routed through debug messenger');
    AssertEquals('ValidationErrorCount must increment to 1', 1, Integer(RealDev.ValidationErrorCount));
    AssertEquals('ValidationMessageCount must equal 2', 2, RealDev.ValidationMessageCount);
    ReportStr := RealDev.GetValidationMessagesReport;
    AssertTrue('Validation report must include warning VUID',
      Pos('VUID-CastleTest-PerfWarning-001', ReportStr) > 0);
    AssertTrue('Validation report must include error VUID',
      Pos('VUID-vkCmdDraw-None-08600', ReportStr) > 0);

    CaughtGateError := False;
    try
      RealDev.AssertZeroValidationErrors('DefaultErrorGateCheck');
    except
      on E: ERHIError do
        CaughtGateError := True;
    end;
    AssertTrue('ValidationErrorCount > 0 must raise ERHIError in AssertZeroValidationErrors', CaughtGateError);

    { 4. Reset counters and execute a real Lavapipe render pass + image readback with 0 validation errors }
    RealDev.ResetValidationCounters;
    AssertEquals(0, Integer(RealDev.ValidationErrorCount));
    AssertEquals(0, Integer(RealDev.ValidationWarningCount));
    AssertEquals(0, RealDev.ValidationMessageCount);

    ColorTex := RealDev.CreateTexture(
      TRHITextureDesc.Create2D(32, 32, pfRGBA8_UNorm, [tuColorAttachment, tuTransferSrc]));
    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    RealCmd.TransitionTexture(ColorTex, rsColorAttachment);
    FillChar(PassInfo, SizeOf(PassInfo), 0);
    PassInfo.RenderArea := Rectangle(0, 0, 32, 32);
    SetLength(PassInfo.ColorAttachments, 1);
    PassInfo.ColorAttachments[0].Texture := ColorTex;
    PassInfo.ColorAttachments[0].LoadOp := loClear;
    PassInfo.ColorAttachments[0].StoreOp := soStore;
    PassInfo.ColorAttachments[0].ClearColor := Vector4(0.2, 0.6, 0.9, 1.0);
    RealCmd.BeginRendering(PassInfo);
    RealCmd.EndRendering;
    RealDev.EndOffscreenFrame;

    Readback := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 32, 32));
    AssertTrue('Cleared blue channel must read back > 200', Readback.PixelPtr(16, 16)^.Z > 200);
    RealDev.AssertZeroValidationErrors('LiveOffscreenRenderAndReadback');
  finally
    FreeAndNil(Readback);
    FreeAndNil(ColorTex);
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealOpenGLVsVulkanSideBySideVisualRegressionSuiteRHI;

  procedure Populate3DLitOccludedBoxesScene(const AWindow: TCastleWindow);
  var
    Viewport: TCastleViewport;
    Scene: TCastleScene;
    Root: TX3DRootNode;
    DirLight: TDirectionalLightNode;
    FrontTrans, BackTrans: TTransformNode;
    FrontShape, BackShape: TShapeNode;
    FrontBox, BackBox: TBoxNode;
    FrontApp, BackApp: TAppearanceNode;
    FrontMat, BackMat: TMaterialNode;
  begin
    Viewport := TCastleViewport.Create(AWindow);
    Viewport.FullSize := True;
    Viewport.BackgroundColor := Vector4(0.05, 0.07, 0.22, 1.0);
    AWindow.Controls.InsertFront(Viewport);
    Viewport.Camera.ProjectionType := ptPerspective;
    Viewport.Camera.SetWorldView(
      Vector3(0.0, 0.0, 4.5),
      Vector3(0.0, 0.0, -1.0),
      Vector3(0.0, 1.0, 0.0));

    Root := TX3DRootNode.Create;
    DirLight := TDirectionalLightNode.Create;
    DirLight.Direction := Vector3(-0.25, -0.35, -1.0).Normalize;
    DirLight.Intensity := 1.0;
    DirLight.AmbientIntensity := 0.2;
    Root.AddChildren(DirLight);

    { Rear box at Z = -1.2 shifted up-right — partially occluded by front box! }
    BackTrans := TTransformNode.Create;
    BackTrans.Translation := Vector3(0.85, 0.65, -1.2);
    BackShape := TShapeNode.Create;
    BackBox := TBoxNode.Create;
    BackBox.Size := Vector3(1.8, 1.5, 0.6);
    BackShape.Geometry := BackBox;
    BackApp := TAppearanceNode.Create;
    BackMat := TMaterialNode.Create;
    BackMat.DiffuseColor := Vector3(0.15, 0.85, 0.55);
    BackMat.AmbientIntensity := 0.25;
    BackMat.SpecularColor := Vector3(0.0, 0.0, 0.0);
    BackApp.Material := BackMat;
    BackShape.Appearance := BackApp;
    BackTrans.AddChildren(BackShape);
    Root.AddChildren(BackTrans);

    { Front occluder box at Z = 0.2 shifted down-left }
    FrontTrans := TTransformNode.Create;
    FrontTrans.Translation := Vector3(-0.35, -0.25, 0.2);
    FrontShape := TShapeNode.Create;
    FrontBox := TBoxNode.Create;
    FrontBox.Size := Vector3(1.7, 1.5, 0.6);
    FrontShape.Geometry := FrontBox;
    FrontApp := TAppearanceNode.Create;
    FrontMat := TMaterialNode.Create;
    FrontMat.DiffuseColor := Vector3(0.92, 0.30, 0.12);
    FrontMat.AmbientIntensity := 0.25;
    FrontMat.SpecularColor := Vector3(0.0, 0.0, 0.0);
    FrontApp.Material := FrontMat;
    FrontShape.Appearance := FrontApp;
    FrontTrans.AddChildren(FrontShape);
    Root.AddChildren(FrontTrans);

    Scene := TCastleScene.Create(AWindow);
    Scene.Load(Root, True);
    Viewport.Items.Add(Scene);
  end;

  procedure Populate3DTexturedAlphaMaskScene(const AWindow: TCastleWindow);
  var
    Viewport: TCastleViewport;
    Scene: TCastleScene;
    Root: TX3DRootNode;
    BackTrans, FrontTrans: TTransformNode;
    BackShape, FrontShape: TShapeNode;
    BackBox, FrontBox: TBoxNode;
    BackApp, FrontApp: TAppearanceNode;
    BackMat, FrontMat: TUnlitMaterialNode;
    PixTex: TPixelTextureNode;
    TexProps: TTexturePropertiesNode;
    MaskImg: TRGBAlphaImage;
    X, Y: Integer;
  begin
    Viewport := TCastleViewport.Create(AWindow);
    Viewport.FullSize := True;
    Viewport.BackgroundColor := Vector4(0.08, 0.08, 0.12, 1.0);
    AWindow.Controls.InsertFront(Viewport);
    Viewport.Camera.ProjectionType := ptPerspective;
    Viewport.Camera.SetWorldView(
      Vector3(0.0, 0.0, 4.0),
      Vector3(0.0, 0.0, -1.0),
      Vector3(0.0, 1.0, 0.0));

    Root := TX3DRootNode.Create;

    { Solid magenta/purple backdrop plate visible through alpha-masked cutout }
    BackTrans := TTransformNode.Create;
    BackTrans.Translation := Vector3(0.0, 0.0, -0.8);
    BackShape := TShapeNode.Create;
    BackBox := TBoxNode.Create;
    BackBox.Size := Vector3(2.8, 2.0, 0.2);
    BackShape.Geometry := BackBox;
    BackApp := TAppearanceNode.Create;
    BackMat := TUnlitMaterialNode.Create;
    BackMat.EmissiveColor := Vector3(0.75, 0.18, 0.68);
    BackApp.Material := BackMat;
    BackShape.Appearance := BackApp;
    BackTrans.AddChildren(BackShape);
    Root.AddChildren(BackTrans);

    { Foreground unlit textured plate with alpha-cutoff hole in center }
    FrontTrans := TTransformNode.Create;
    FrontTrans.Translation := Vector3(0.0, 0.0, 0.3);
    FrontShape := TShapeNode.Create;
    FrontBox := TBoxNode.Create;
    FrontBox.Size := Vector3(2.0, 1.6, 0.1);
    FrontShape.Geometry := FrontBox;
    FrontApp := TAppearanceNode.Create;
    BackApp.AlphaMode := amOpaque;
    FrontApp.AlphaMode := amMask;
    FrontApp.AlphaCutoff := 0.5;

    MaskImg := TRGBAlphaImage.Create(16, 16);
    for Y := 0 to 15 do
      for X := 0 to 15 do
      begin
        { Cutout window in center [5..10, 5..10] with alpha = 0 }
        if (X >= 5) and (X <= 10) and (Y >= 5) and (Y <= 10) then
          MaskImg.PixelPtr(X, Y)^ := Vector4Byte(0, 0, 0, 0)
        else if ((X div 4) + (Y div 4)) mod 2 = 0 then
          MaskImg.PixelPtr(X, Y)^ := Vector4Byte(240, 220, 50, 255)
        else
          MaskImg.PixelPtr(X, Y)^ := Vector4Byte(45, 205, 95, 255);
      end;

    PixTex := TPixelTextureNode.Create;
    PixTex.FdImage.Value := MaskImg;
    TexProps := TTexturePropertiesNode.Create;
    TexProps.MagnificationFilter := magNearest;
    TexProps.MinificationFilter := minNearest;
    PixTex.TextureProperties := TexProps;

    FrontMat := TUnlitMaterialNode.Create;
    FrontMat.EmissiveColor := Vector3(1.0, 1.0, 1.0);
    FrontMat.EmissiveTexture := PixTex;
    FrontApp.Material := FrontMat;
    FrontShape.Appearance := FrontApp;
    FrontTrans.AddChildren(FrontShape);
    Root.AddChildren(FrontTrans);

    Scene := TCastleScene.Create(AWindow);
    Scene.Load(Root, True);
    Viewport.Items.Add(Scene);
  end;

  function CaptureBackendScenarios(const ABackend: TRenderBackend;
    out AShot2D, AShot3DLit, AShot3DMask: TRGBAlphaImage;
    out AVkValidationErrors: Cardinal): Boolean;
  var
    Win: TCastleWindow;
    UI2D: TPhase112VisualParity2DControl;
    I: Integer;
  begin
    Result := False;
    AShot2D := nil;
    AShot3DLit := nil;
    AShot3DMask := nil;
    AVkValidationErrors := 0;

    SetActiveCommandList(nil);
    SetRHIDevice(nil);
    ApplicationProperties.RenderBackend := ABackend;
    Application.OnInitialize := nil;
    Application.Initialize;

    Win := CreateWindowForTest;
    try
      Win.Width := 160;
      Win.Height := 120;
      Win.AntiAliasing := aaNone;
      try
        Win.Open;
      except
        on Exception do
        begin
          if not Win.Closed then
            Win.Close(False);
          Exit(False);
        end;
      end;

      if ABackend = backendVulkan then
      begin
        if not (RHIDevice is TVulkanRHIDevice) then
        begin
          Win.Close(False);
          Exit(False);
        end;
        TVulkanRHIDevice(RHIDevice).ResetValidationCounters;
      end else
      begin
        if RHIDevice <> nil then
        begin
          Win.Close(False);
          Exit(False);
        end;
      end;

      { Scenario 1: 2D UI rectangles + textured sprite }
      UI2D := TPhase112VisualParity2DControl.Create(Win);
      UI2D.FullSize := True;
      Win.Controls.InsertFront(UI2D);
      for I := 0 to 1 do
      begin
        Win.Invalidate;
        Application.ProcessAllMessages;
      end;
      AShot2D := Win.Container.SaveScreenRgba;
      Win.Controls.Remove(UI2D);
      FreeAndNil(UI2D);

      { Scenario 2: 3D directional-lit depth-occluded boxes }
      Populate3DLitOccludedBoxesScene(Win);
      for I := 0 to 1 do
      begin
        Win.Invalidate;
        Application.ProcessAllMessages;
      end;
      AShot3DLit := Win.Container.SaveScreenRgba;
      while Win.Controls.Count > 0 do
        Win.Controls[0].Free;

      { Scenario 3: 3D unlit procedural texture + amMask alpha-cutoff hole }
      Populate3DTexturedAlphaMaskScene(Win);
      for I := 0 to 1 do
      begin
        Win.Invalidate;
        Application.ProcessAllMessages;
      end;
      AShot3DMask := Win.Container.SaveScreenRgba;
      while Win.Controls.Count > 0 do
        Win.Controls[0].Free;

      if (ABackend = backendVulkan) and (RHIDevice is TVulkanRHIDevice) then
        AVkValidationErrors := TVulkanRHIDevice(RHIDevice).ValidationErrorCount;

      Win.Close(False);
      Result := (AShot2D <> nil) and (AShot3DLit <> nil) and (AShot3DMask <> nil);
    finally
      DestroyWindowForTest(Win);
    end;
  end;

var
  SyntheticRef, SyntheticCand: TRGBAlphaImage;
  DiffStats: TRHIVisualDiffMetrics;
  UnitSuite, LiveSuite: TRHIVisualRegressionSuite;
  VkShot2D, VkShot3DLit, VkShot3DMask: TRGBAlphaImage;
  GlShot2D, GlShot3DLit, GlShot3DMask: TRGBAlphaImage;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedOnInit: TProcedure;
  VkValErrors, DummyGlErrors: Cardinal;
  {$if defined(UNIX) and not defined(DARWIN) and not defined(ANDROID)}
  HasDisplay: Boolean;
  {$endif}
begin
  { Part A: Deterministic unit verification of CompareImagesDetailedDiff & TRHIVisualRegressionSuite }
  SyntheticRef := TRGBAlphaImage.Create(16, 16);
  SyntheticCand := TRGBAlphaImage.Create(16, 16);
  UnitSuite := TRHIVisualRegressionSuite.Create(2);
  try
    SyntheticRef.Clear(Vector4Byte(60, 120, 200, 255));
    SyntheticCand.Clear(Vector4Byte(60, 120, 200, 255));
    AssertTrue('Identical images must pass with 0 RMSE',
      CompareImagesDetailedDiff(SyntheticRef, SyntheticCand, 0.001, DiffStats, 2));
    AssertSameValue(0.0, DiffStats.NormalizedRMSE, 1e-6);
    AssertSameValue(99.0, DiffStats.PSNRdB, 1e-3);
    AssertEquals(0, Integer(DiffStats.MaxChannelDelta));
    AssertEquals(0, Integer(DiffStats.DiffPixelCount));

    { Perturb 1 pixel by +20 on red channel -> MaxChannelDelta=20, DiffPixelCount=1 }
    SyntheticCand.PixelPtr(8, 8)^ := Vector4Byte(80, 120, 200, 255);
    UnitSuite.RecordComparison('Synthetic_NearExact', SyntheticRef, SyntheticCand, 0.02);
    AssertEquals(1, UnitSuite.CaseCount);
    AssertEquals(1, UnitSuite.PassedCount);
    AssertEquals(0, UnitSuite.FailedCount);
    AssertTrue(UnitSuite.AllPassed);
    AssertEquals(20, Integer(UnitSuite.GetCaseResult(0).Metrics.MaxChannelDelta));
    AssertEquals(1, Integer(UnitSuite.GetCaseResult(0).Metrics.DiffPixelCount));
    AssertTrue('Summary report must list PASS status',
      Pos('[PASS] Synthetic_NearExact', UnitSuite.BuildSummaryReport) > 0);
  finally
    FreeAndNil(UnitSuite);
    FreeAndNil(SyntheticCand);
    FreeAndNil(SyntheticRef);
  end;

  { Part B: Live side-by-side backendVulkan vs backendOpenGL TCastleWindow visual regression suite }
  if not CanCreateWindowForTest then
    Exit;

  {$if defined(UNIX) and not defined(DARWIN) and not defined(ANDROID)}
  HasDisplay := (GetEnvironmentVariable('DISPLAY') <> '') or
                (GetEnvironmentVariable('WAYLAND_DISPLAY') <> '');
  if not HasDisplay then
    Exit;
  {$endif}

  try
    if not LoadVulkan then
      Exit;
  except
    on Exception do
      Exit;
  end;

  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedOnInit := Application.OnInitialize;
  VkShot2D := nil;
  VkShot3DLit := nil;
  VkShot3DMask := nil;
  GlShot2D := nil;
  GlShot3DLit := nil;
  GlShot3DMask := nil;
  LiveSuite := TRHIVisualRegressionSuite.Create(4);
  try
    { 1. Render all 3 scenarios on pure-Vulkan TCastleWindow first }
    if not CaptureBackendScenarios(backendVulkan, VkShot2D, VkShot3DLit, VkShot3DMask, VkValErrors) then
      Exit;
    AssertEquals('Vulkan visual regression capture must produce 0 validation errors',
      0, Integer(VkValErrors));

    { 2. Render the exact same 3 scenarios on real OpenGL TCastleWindow }
    if not CaptureBackendScenarios(backendOpenGL, GlShot2D, GlShot3DLit, GlShot3DMask, DummyGlErrors) then
      Exit;

    { 3. Run side-by-side perceptual RMSE comparison across all 3 scenarios }
    LiveSuite.RecordComparison('2D_UI_Rectangles_And_TexturedSprite', GlShot2D, VkShot2D, 0.04);
    LiveSuite.RecordComparison('3D_Viewport_DirectionalLit_DepthOccluded_Boxes', GlShot3DLit, VkShot3DLit, 0.08);
    LiveSuite.RecordComparison('3D_Viewport_Unlit_ProceduralTextured_AlphaMask_Quad', GlShot3DMask, VkShot3DMask, 0.06);

    AssertEquals('Live regression suite must record 3 scenarios', 3, LiveSuite.CaseCount);
    AssertTrue('All side-by-side rbOpenGL vs rbVulkan visual regression cases must pass: ' +
      LineEnding + LiveSuite.BuildSummaryReport,
      LiveSuite.AllPassed);
  finally
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    Application.OnInitialize := SavedOnInit;
    FreeAndNil(LiveSuite);
    FreeAndNil(GlShot3DMask);
    FreeAndNil(GlShot3DLit);
    FreeAndNil(GlShot2D);
    FreeAndNil(VkShot3DMask);
    FreeAndNil(VkShot3DLit);
    FreeAndNil(VkShot2D);
  end;
end;

procedure TTestCastleVulkanRHI.TestShaderAndPipelineCachePackageBundlingAndDataSeedRHI;
var
  Compiler: TCastleShaderCompiler;
  SavedDiskBaseUrl, SavedBundledBaseUrl: String;
  TempRootDir, TempProjectDir, TempManifestFile: String;
  TempBuildCacheDir, TempPackagedDataDir, TempEmptyUserConfigDir: String;
  TempSrcPipelineCacheFile, TempBundledPipelineCacheFile, TempMissingUserPipelineCacheUrl: String;
  ManifestText: TStringList;
  Manifest: TCastleManifest;
  RealDev: TVulkanRHIDevice;
  BundledSpvCount: Cardinal;
  Gen: TCastleShaderGeneratorRHI;
  CoreForwardVS: String;
  LoadedSPIRV: TSPIRVBytecode;
  Reflected: TSPIRVReflectionInfo;
begin
  Compiler := TCastleShaderCompiler.Instance;
  SavedDiskBaseUrl := Compiler.DiskCacheBaseUrl;
  SavedBundledBaseUrl := Compiler.BundledCacheBaseUrl;

  TempRootDir := InclPathDelim(GetTempDir(False)) +
    'cge_phase112_bundle_' + IntToStr(Random(1000000));
  TempProjectDir := InclPathDelim(TempRootDir) + 'proj';
  TempBuildCacheDir := InclPathDelim(TempRootDir) + 'build_config_cache';
  TempPackagedDataDir := InclPathDelim(TempProjectDir) + 'data';
  TempEmptyUserConfigDir := InclPathDelim(TempRootDir) + 'fresh_user_config';
  CheckForceDirectories(TempPackagedDataDir);
  CheckForceDirectories(TempBuildCacheDir);
  CheckForceDirectories(TempEmptyUserConfigDir);

  ManifestText := TStringList.Create;
  Manifest := nil;
  RealDev := nil;
  Gen := nil;
  try
    { 1. Verify TCastleManifest ShouldBundleVulkanCaches parsing }
    TempManifestFile := InclPathDelim(TempProjectDir) + 'CastleEngineManifest.xml';
    ManifestText.Text :=
      '<?xml version="1.0" encoding="utf-8"?>' + LineEnding +
      '<project name="phase112_pkg_test" standalone_source="phase112_pkg_test.dpr" render_backend="vulkan">' + LineEnding +
      '</project>';
    ManifestText.SaveToFile(TempManifestFile);

    Manifest := TCastleManifest.CreateFromUrl(FilenameToUriSafe(TempManifestFile));
    AssertTrue('render_backend="vulkan" must enable ShouldPrewarmVulkanShaders',
      Manifest.ShouldPrewarmVulkanShaders);
    AssertTrue('render_backend="vulkan" must enable ShouldBundleVulkanCaches by default',
      Manifest.ShouldBundleVulkanCaches);
    FreeAndNil(Manifest);

    ManifestText.Text :=
      '<?xml version="1.0" encoding="utf-8"?>' + LineEnding +
      '<project name="phase112_pkg_test" standalone_source="phase112_pkg_test.dpr" render_backend="vulkan" bundle_vulkan_caches="false">' + LineEnding +
      '</project>';
    ManifestText.SaveToFile(TempManifestFile);
    Manifest := TCastleManifest.CreateFromUrl(FilenameToUriSafe(TempManifestFile));
    AssertFalse('bundle_vulkan_caches="false" must disable ShouldBundleVulkanCaches',
      Manifest.ShouldBundleVulkanCaches);
    FreeAndNil(Manifest);

    ManifestText.Text :=
      '<?xml version="1.0" encoding="utf-8"?>' + LineEnding +
      '<project name="phase112_pkg_test" standalone_source="phase112_pkg_test.dpr" render_backend="opengl">' + LineEnding +
      '</project>';
    ManifestText.SaveToFile(TempManifestFile);
    Manifest := TCastleManifest.CreateFromUrl(FilenameToUriSafe(TempManifestFile));
    AssertFalse('render_backend="opengl" must disable ShouldBundleVulkanCaches',
      Manifest.ShouldBundleVulkanCaches);
    FreeAndNil(Manifest);

    { 2. Point compiler disk cache to isolated TempBuildCacheDir and bundle into TempPackagedDataDir }
    Compiler.DiskCacheBaseUrl := FilenameToUriSafe(InclPathDelim(TempBuildCacheDir));
    Compiler.BundledCacheBaseUrl := '';
    Compiler.ClearCache(False);

    TempSrcPipelineCacheFile := InclPathDelim(TempRootDir) + 'prebaked_pipeline_cache.bin';
    if TVulkanRHIDevice.TryCreateOffscreen(RealDev) then
    begin
      RealDev.PrewarmStandardPipelines(True, True, FilenameToUriSafe(TempSrcPipelineCacheFile));
      RealDev.SavePipelineCache(FilenameToUriSafe(TempSrcPipelineCacheFile));
    end;

    BundledSpvCount := Compiler.BundleCoreAndCachedShadersToDataDirectory(
      TempPackagedDataDir, FilenameToUriSafe(TempSrcPipelineCacheFile));
    AssertTrue(Format('BundleCoreAndCachedShadersToDataDirectory must write >= 4 .spv files (got %d)',
      [BundledSpvCount]), BundledSpvCount >= 4);
    AssertTrue('Packaged shader_cache directory must exist',
      DirectoryExists(InclPathDelim(TempPackagedDataDir) + 'shader_cache'));

    TempBundledPipelineCacheFile := InclPathDelim(TempPackagedDataDir) + 'vulkan_pipeline_cache.bin';
    if RegularFileExists(TempSrcPipelineCacheFile) then
      AssertTrue('Pre-baked vulkan_pipeline_cache.bin must be bundled into packaged data/',
        RegularFileExists(TempBundledPipelineCacheFile));

    { 3. Simulate cold first boot on a fresh machine: empty DiskCacheBaseUrl + read-only BundledCacheBaseUrl }
    Compiler.DiskCacheBaseUrl := FilenameToUriSafe(InclPathDelim(TempEmptyUserConfigDir));
    Compiler.BundledCacheBaseUrl := FilenameToUriSafe(
      InclPathDelim(InclPathDelim(TempPackagedDataDir) + 'shader_cache'));
    Compiler.ClearCache(False);

    Gen := TCastleShaderGeneratorRHI.Create(rbVulkan);
    CoreForwardVS := Gen.FinalizeVertexShaderSource(
      Gen.GeneratePreamble(ssVertex) +
      'void main() {' + LineEnding +
      '  castle_vertex_eye = castle_ModelViewMatrix * castle_Vertex;' + LineEnding +
      '  castle_normal_eye = normalize(castle_NormalMatrix * castle_Normal);' + LineEnding +
      '  castle_tex_coord0 = castle_MultiTexCoord0;' + LineEnding +
      '  gl_Position = castle_ProjectionMatrix * castle_vertex_eye;' + LineEnding +
      '}');

    LoadedSPIRV := Compiler.GetOrCompileSPIRV(ssVertex, CoreForwardVS, 'cold_boot_from_bundle_vs');
    AssertTrue('Cold boot must load valid SPIR-V from bundled castle-data:/shader_cache/',
      InspectSPIRVBytecode(LoadedSPIRV, Reflected) and Reflected.IsValid and (Reflected.Stage = ssVertex));

    { 4. Verify TVulkanRHIDevice.LoadPipelineCache seeds VkPipelineCache from bundled data fallback when user config cache is absent }
    if (RealDev <> nil) and RegularFileExists(TempBundledPipelineCacheFile) then
    begin
      TempMissingUserPipelineCacheUrl := FilenameToUriSafe(
        InclPathDelim(TempEmptyUserConfigDir) + 'missing_user_pipeline_cache.bin');
      RealDev.BundledPipelineCacheFallbackUrl := FilenameToUriSafe(TempBundledPipelineCacheFile);
      RealDev.LoadPipelineCache(TempMissingUserPipelineCacheUrl);
      AssertTrue('LoadPipelineCache must seed from BundledPipelineCacheFallbackUrl when user config cache is absent',
        RealDev.PipelineCacheSeededFromBundle);
      AssertTrue('Seeded VkPipelineCache handle must be valid',
        RealDev.PipelineCache <> VK_NULL_HANDLE);
    end;
  finally
    Compiler.DiskCacheBaseUrl := SavedDiskBaseUrl;
    Compiler.BundledCacheBaseUrl := SavedBundledBaseUrl;
    Compiler.ClearCache(False);
    FreeAndNil(Gen);
    FreeAndNil(RealDev);
    FreeAndNil(Manifest);
    FreeAndNil(ManifestText);
    if DirectoryExists(TempRootDir) then
      RemoveNonEmptyDir(TempRootDir, True);
  end;
end;

procedure TTestCastleVulkanRHI.TestVulkanDebugUtilsObjectNamingLabelsAndRenderGraphScopesRHI;
var
  HeadlessDev, RealDev: TVulkanRHIDevice;
  Buf: TRHIBuffer;
  Tex, ExportTex: TRHITexture;
  VS, FS: TRHIShaderModule;
  Pipe: TRHIPipeline;
  QueryPool: TRHIQueryPool;
  PipeDesc: TRHIGraphicsPipelineDesc;
  TexDesc: TRHITextureDesc;
  QueryDesc: TRHIQueryPoolDesc;
  Graph: TRHIRenderGraph;
  Cmd: TVulkanRHICommandList;
  RGTempHandle, RGExportHandle: TRHIRenderGraphResourceHandle;
  Pass0, Pass1: TRHIRenderGraphPass;
  NamedBefore: Cardinal;
begin
  { Part A: Headless deterministic verification of object naming, markers & TRHIRenderGraph debug scopes }
  HeadlessDev := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($7513)));
  Buf := nil;
  Tex := nil;
  ExportTex := nil;
  VS := nil;
  FS := nil;
  Pipe := nil;
  QueryPool := nil;
  Graph := nil;
  try
    HeadlessDev.ResizeSwapchain(64, 64);
    NamedBefore := HeadlessDev.DebugObjectsNamedCount;
    Buf := HeadlessDev.CreateBuffer(
      TRHIBufferDesc.Create(256, [buVertex], muCpuToGpu, 'Phase113_DebugVBO'), nil);
    AssertTrue('Named buffer must increment DebugObjectsNamedCount',
      HeadlessDev.DebugObjectsNamedCount > NamedBefore);
    AssertEquals('LastNamedDebugObject must match buffer DebugName',
      'Phase113_DebugVBO', HeadlessDev.LastNamedDebugObject);

    TexDesc := TRHITextureDesc.Create2D(32, 32, pfRGBA8_UNorm, [tuColorAttachment, tuSampled], 1, 1);
    TexDesc.DebugName := 'Phase113_DebugTex';
    Tex := HeadlessDev.CreateTexture(TexDesc);
    AssertEquals('LastNamedDebugObject must match texture View DebugName',
      'Phase113_DebugTex.View', HeadlessDev.LastNamedDebugObject);

    VS := HeadlessDev.CreateShaderModuleFromGLSL(ssVertex,
      'void main() { viewport_size; point_size; }', 'Primitive2D_VS');
    FS := HeadlessDev.CreateShaderModuleFromGLSL(ssFragment,
      'void main() { viewport_size; out_Color = pc.color; }', 'Primitive2D_FS');

    PipeDesc := Default(TRHIGraphicsPipelineDesc);
    PipeDesc.VertexShader := VS;
    PipeDesc.FragmentShader := FS;
    SetLength(PipeDesc.VertexInput.Bindings, 1);
    PipeDesc.VertexInput.Bindings[0].Binding := 0;
    PipeDesc.VertexInput.Bindings[0].Stride := SizeOf(TVector2);
    PipeDesc.VertexInput.Bindings[0].PerInstance := False;
    SetLength(PipeDesc.VertexInput.Attributes, 1);
    PipeDesc.VertexInput.Attributes[0].Location := 0;
    PipeDesc.VertexInput.Attributes[0].Binding := 0;
    PipeDesc.VertexInput.Attributes[0].Format := vafVector2;
    PipeDesc.VertexInput.Attributes[0].Offset := 0;
    PipeDesc.Rasterizer := TRHIRasterizerStateDesc.DefaultCullBack;
    PipeDesc.Rasterizer.CullMode := cmNone;
    PipeDesc.DepthStencil := TRHIDepthStencilStateDesc.DefaultDisabled;
    PipeDesc.BlendState := TRHIBlendStateDesc.DefaultOpaque;
    PipeDesc.PushConstantSize := 32;
    PipeDesc.PushConstantStages := [ssVertex, ssFragment];
    SetLength(PipeDesc.ColorAttachmentFormats, 1);
    PipeDesc.ColorAttachmentFormats[0] := pfRGBA8_UNorm;
    PipeDesc.DebugName := 'Phase113_DebugPSO';
    Pipe := HeadlessDev.GetOrCreatePipeline(PipeDesc);
    AssertTrue('Pipeline must be created', Pipe <> nil);

    FillChar(QueryDesc, SizeOf(QueryDesc), 0);
    QueryDesc.QueryType := qtTimestamp;
    QueryDesc.QueryCount := 4;
    QueryPool := HeadlessDev.CreateQueryPool(QueryDesc);
    AssertTrue('QueryPool must be created', QueryPool <> nil);

    TexDesc := TRHITextureDesc.Create2D(32, 32, pfRGBA8_UNorm, [tuColorAttachment, tuSampled], 1, 1);
    TexDesc.DebugName := 'Phase113_RGExport';
    ExportTex := HeadlessDev.CreateTexture(TexDesc);

    Graph := TRHIRenderGraph.Create(HeadlessDev);
    RGTempHandle := Graph.DeclareTransientTexture(
      'RG_TempColor', TRHITextureDesc.Create2D(32, 32, pfRGBA8_UNorm, [tuColorAttachment, tuSampled]));
    RGExportHandle := Graph.ImportExternalTexture('RG_FinalColor', ExportTex, rsUndefined, rsShaderRead);

    FRenderGraphPassExecCount := 0;
    Pass0 := Graph.AddPass('Phase113_GBuffer_Pass');
    Pass0.OnExecute := @DummyRenderGraphPassCallback;
    Pass0.WriteColorAttachment(RGTempHandle);
    Pass1 := Graph.AddPass('Phase113_Composite_Pass');
    Pass1.OnExecute := @DummyRenderGraphPassCallback;
    Pass1.ReadTexture(RGTempHandle);
    Pass1.WriteColorAttachment(RGExportHandle);
    Graph.Compile;

    Cmd := HeadlessDev.BeginFrame as TVulkanRHICommandList;
    try
      Cmd.PushDebugGroup('Phase113_OuterFrameScope', Vector4(0.2, 0.6, 1.0, 1.0));
      Cmd.InsertDebugMarker('Phase113_MidFrameMarker', Vector4(1.0, 0.9, 0.1, 1.0));
      Graph.Execute(Cmd);
      Cmd.PopDebugGroup;

      AssertEquals('TRHIRenderGraph.Execute must emit 2 automatic pass debug scopes',
        2, Integer(Graph.DebugScopesEmittedCount));
      AssertEquals('CommandList must record 1 outer + 2 graph = 3 PushDebugGroup calls',
        3, Integer(Cmd.DebugGroupPushCount));
      AssertEquals('CommandList must record 3 matching PopDebugGroup calls',
        3, Integer(Cmd.DebugGroupPopCount));
      AssertEquals('CommandList must record 1 InsertDebugMarker call',
        1, Integer(Cmd.DebugMarkerCount));
    finally
      HeadlessDev.EndFrameAndPresent;
    end;
  finally
    FreeAndNil(Graph);
    FreeAndNil(ExportTex);
    FreeAndNil(QueryPool);
    Pipe := nil;
    FreeAndNil(FS);
    FreeAndNil(VS);
    FreeAndNil(Tex);
    FreeAndNil(Buf);
    FreeAndNil(HeadlessDev);
  end;

  { Part B: Live Mesa Lavapipe 1.4 VK_EXT_debug_utils object naming, command/queue labels & validation gate }
  RealDev := nil;
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev, True) then
    Exit;
  Buf := nil;
  Tex := nil;
  ExportTex := nil;
  VS := nil;
  FS := nil;
  QueryPool := nil;
  Graph := nil;
  try
    RealDev.ResetValidationCounters;
    AssertTrue('Device/queue/pipeline-cache creation must already name >= 2 Vulkan objects',
      RealDev.DebugObjectsNamedCount >= 2);

    Buf := RealDev.CreateBuffer(
      TRHIBufferDesc.Create(256, [buUniform], muCpuToGpu, 'Phase113_LiveUBO'), nil);
    TexDesc := TRHITextureDesc.Create2D(32, 32, pfRGBA8_UNorm, [tuColorAttachment, tuSampled], 1, 1);
    TexDesc.DebugName := 'Phase113_LiveTex';
    Tex := RealDev.CreateTexture(TexDesc);
    VS := RealDev.CreateShaderModuleFromGLSL(ssVertex,
      'void main() { viewport_size; point_size; }', 'Primitive2D_VS');
    FS := RealDev.CreateShaderModuleFromGLSL(ssFragment,
      'void main() { viewport_size; out_Color = pc.color; }', 'Primitive2D_FS');

    PipeDesc := Default(TRHIGraphicsPipelineDesc);
    PipeDesc.VertexShader := VS;
    PipeDesc.FragmentShader := FS;
    SetLength(PipeDesc.VertexInput.Bindings, 1);
    PipeDesc.VertexInput.Bindings[0].Binding := 0;
    PipeDesc.VertexInput.Bindings[0].Stride := SizeOf(TVector2);
    PipeDesc.VertexInput.Bindings[0].PerInstance := False;
    SetLength(PipeDesc.VertexInput.Attributes, 1);
    PipeDesc.VertexInput.Attributes[0].Location := 0;
    PipeDesc.VertexInput.Attributes[0].Binding := 0;
    PipeDesc.VertexInput.Attributes[0].Format := vafVector2;
    PipeDesc.VertexInput.Attributes[0].Offset := 0;
    PipeDesc.Rasterizer := TRHIRasterizerStateDesc.DefaultCullBack;
    PipeDesc.Rasterizer.CullMode := cmNone;
    PipeDesc.DepthStencil := TRHIDepthStencilStateDesc.DefaultDisabled;
    PipeDesc.BlendState := TRHIBlendStateDesc.DefaultOpaque;
    PipeDesc.PushConstantSize := 32;
    PipeDesc.PushConstantStages := [ssVertex, ssFragment];
    SetLength(PipeDesc.ColorAttachmentFormats, 1);
    PipeDesc.ColorAttachmentFormats[0] := pfRGBA8_UNorm;
    PipeDesc.DebugName := 'Phase113_LivePSO';
    Pipe := RealDev.GetOrCreatePipeline(PipeDesc);
    AssertTrue('Live Vulkan pipeline must be created and named', Pipe <> nil);

    if RealDev.DebugUtilsActive and Assigned(vkSetDebugUtilsObjectNameEXT) then
      AssertTrue('Explicit SetDebugObjectName on live VkBuffer must return VK_SUCCESS',
        RealDev.SetDebugObjectName(VK_OBJECT_TYPE_BUFFER,
          (Buf as TVulkanRHIBuffer).Handle, 'Phase113_ExplicitRenamedUBO'));

    FillChar(QueryDesc, SizeOf(QueryDesc), 0);
    QueryDesc.QueryType := qtTimestamp;
    QueryDesc.QueryCount := 2;
    QueryPool := RealDev.CreateQueryPool(QueryDesc);

    TexDesc := TRHITextureDesc.Create2D(32, 32, pfRGBA8_UNorm, [tuColorAttachment, tuSampled], 1, 1);
    TexDesc.DebugName := 'Phase113_LiveRGExport';
    ExportTex := RealDev.CreateTexture(TexDesc);
    Graph := TRHIRenderGraph.Create(RealDev);
    RGTempHandle := Graph.DeclareTransientTexture(
      'LiveRG_Temp', TRHITextureDesc.Create2D(32, 32, pfRGBA8_UNorm, [tuColorAttachment, tuSampled]));
    RGExportHandle := Graph.ImportExternalTexture('LiveRG_Out', ExportTex, rsUndefined, rsShaderRead);
    Pass0 := Graph.AddPass('LiveRG_PassA');
    Pass0.OnExecute := @DummyRenderGraphPassCallback;
    Pass0.WriteColorAttachment(RGTempHandle);
    Pass1 := Graph.AddPass('LiveRG_PassB');
    Pass1.OnExecute := @DummyRenderGraphPassCallback;
    Pass1.ReadTexture(RGTempHandle);
    Pass1.WriteColorAttachment(RGExportHandle);
    Graph.Compile;

    RealDev.BeginQueueDebugLabel('Phase113_LiveQueueScope', Vector4(0.1, 0.8, 0.4, 1.0));
    RealDev.InsertQueueDebugLabel('Phase113_LiveQueueMarker', Vector4(1.0, 0.5, 0.1, 1.0));
    Cmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    Cmd.PushDebugGroup('Phase113_LiveCmdScope', Vector4(0.3, 0.5, 0.9, 1.0));
    Cmd.InsertDebugMarker('Phase113_LiveCmdMarker', Vector4(0.9, 0.9, 0.2, 1.0));
    Graph.Execute(Cmd);
    Cmd.PopDebugGroup;
    RealDev.EndOffscreenFrame;
    RealDev.EndQueueDebugLabel;

    AssertEquals('Live TRHIRenderGraph.Execute must emit 2 pass debug scopes',
      2, Integer(Graph.DebugScopesEmittedCount));
    RealDev.AssertZeroValidationErrors('Phase113.DebugUtilsAndRenderGraphScopes');
  finally
    FreeAndNil(Graph);
    FreeAndNil(ExportTex);
    FreeAndNil(QueryPool);
    FreeAndNil(FS);
    FreeAndNil(VS);
    FreeAndNil(Tex);
    FreeAndNil(Buf);
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipe3DPBRShadowMapsAndGpuSkeletalSkinningRHI;
var
  Compiler: TCastleShaderCompiler;
  SpvSkinnedVS, SpvPBRShadowFS, SpvPBRVSMFS: TSPIRVBytecode;
  ReflVS, ReflShadowFS, ReflVSMFS: TSPIRVReflectionInfo;
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  Container: TTestSizedVulkanContainer;
  Viewport: TCastleViewport;
  ColorTex, DepthTex: TRHITexture;
  PassInfo: TRHIRenderingInfo;
  ShadowScene, SkinScene: TCastleScene;
  ShadowRoot, SkinRoot: TX3DRootNode;
  NavInfo: TNavigationInfoNode;
  SpotLight: TSpotLightNode;
  GenShadow: TGeneratedShadowMapNode;
  FloorTrans, OccluderTrans, Joint0, Joint1: TTransformNode;
  FloorShape, OccluderShape, SkinShape: TShapeNode;
  FloorApp, OccluderApp, SkinApp: TAppearanceNode;
  FloorMat, OccluderMat, SkinMat: TPhysicalMaterialNode;
  FloorBox, OccluderBox: TBoxNode;
  TriSet: TTriangleSetNode;
  CoordNode: TCoordinateNode;
  SkinNode: TSkinNode;
  ShotPCF, ShotVSM, ShotSkinPose0, ShotSkinPose1: TRGBAlphaImage;
  CenterShadowLuma, OuterLitLuma, VSMCenterLuma, VSMOuterLuma: Integer;
begin
  { Part A: Verify built-in zero-dependency SPIR-V 1.0 compilation & SPIR-V reflection }
  Compiler := TCastleShaderCompiler.Create;
  try
    AssertTrue('TryGetBuiltInSPIRV must match skinned 3D vertex shader',
      Compiler.TryGetBuiltInSPIRV(ssVertex,
        'void main() { mat4 m = CastleSkinning.u_JointMatrices[0]; }',
        'CastleShapeVert_Perm01', SpvSkinnedVS));
    AssertTrue('BuiltIn3DSkinnedVertSPIRV must pass InspectSPIRVBytecode',
      InspectSPIRVBytecode(SpvSkinnedVS, ReflVS) and ReflVS.IsValid and (ReflVS.Stage = ssVertex));

    AssertTrue('TryGetBuiltInSPIRV must match PBR + shadow-map fragment shader',
      Compiler.TryGetBuiltInSPIRV(ssFragment,
        'uniform CastleMaterialBlock { vec4 a; }; uniform CastleLightsBlock { vec4 b; };' + LineEnding +
        'void main() {' + LineEnding +
        '  Lo += EvaluateDirectCookTorranceGGX(N, V, L, rad, base, m, r);' + LineEnding +
        '}',
        'CastleShapeFrag_Perm1000', SpvPBRShadowFS));
    AssertTrue('BuiltIn3DPBRShadowFragSPIRV must pass InspectSPIRVBytecode',
      InspectSPIRVBytecode(SpvPBRShadowFS, ReflShadowFS) and ReflShadowFS.IsValid and (ReflShadowFS.Stage = ssFragment));

    AssertTrue('TryGetBuiltInSPIRV must match PBR + VSM fragment shader',
      Compiler.TryGetBuiltInSPIRV(ssFragment,
        'uniform CastleMaterialBlock { vec4 a; }; uniform CastleLightsBlock { vec4 b; };' + LineEnding +
        'vec2 castle_sample_vsm_slot(float s, vec2 uv) { return vec2(1.0); }' + LineEnding +
        'void main() { Lo += EvaluateDirectCookTorranceGGX(N, V, L, rad, base, m, r); }',
        'CastleShapeFrag_Perm1000', SpvPBRVSMFS));
    AssertTrue('BuiltIn3DPBRVSMFragSPIRV must pass InspectSPIRVBytecode',
      InspectSPIRVBytecode(SpvPBRVSMFS, ReflVSMFS) and ReflVSMFS.IsValid and (ReflVSMFS.Stage = ssFragment));
  finally
    FreeAndNil(Compiler);
  end;

  { Part B & C: Live Real-GPU 3D PBR + Shadow Maps (PCF & VSM) + 2-Bone GPU TSkinNode Skinning }
  RealDev := nil;
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev, True) then
    Exit;

  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;

  Container := TTestSizedVulkanContainer.Create(nil);
  Viewport := nil;
  ShadowScene := nil;
  SkinScene := nil;
  ColorTex := nil;
  DepthTex := nil;
  ShotPCF := nil;
  ShotVSM := nil;
  ShotSkinPose0 := nil;
  ShotSkinPose1 := nil;
  try
    GLFeatures := nil;
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(RealDev);
    RealDev.ResetValidationCounters;

    Container.TestWidth := 128;
    Container.TestHeight := 128;
    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 128, 128);

    ColorTex := RealDev.CreateTexture(TRHITextureDesc.Create2D(128, 128, pfRGBA8_UNorm,
      [tuColorAttachment, tuSampled, tuTransferSrc]));
    DepthTex := RealDev.CreateTexture(TRHITextureDesc.Create2D(128, 128, pfD32_Float,
      [tuDepthStencil]));

    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := True;
    Viewport.BackgroundColor := Vector4(0.02, 0.02, 0.04, 1.0);
    Viewport.Camera.ProjectionType := ptOrthographic;
    Viewport.Camera.Orthographic.Width := 4.0;
    Viewport.Camera.Orthographic.Height := 4.0;
    Viewport.Camera.Orthographic.Origin := Vector2(0.5, 0.5);
    Viewport.Camera.SetView(
      Vector3(0.0, 0.0, 5.0),
      Vector3(0.0, 0.0, -1.0),
      Vector3(0.0, 1.0, 0.0));
    Container.Controls.InsertFront(Viewport);

    { --- Part B: 3D PBR Receiver Floor + Shadow-Casting SpotLight + Occluder Box --- }
    ShadowRoot := TX3DRootNode.Create;

    NavInfo := TNavigationInfoNode.Create;
    NavInfo.Headlight := False;
    ShadowRoot.AddChildren(NavInfo);

    GenShadow := TGeneratedShadowMapNode.Create;
    GenShadow.Update := upAlways;
    GenShadow.Size := 256;

    SpotLight := TSpotLightNode.Create;
    SpotLight.Location := Vector3(2.0, 0.0, 4.0);
    SpotLight.Direction := Vector3(-2.0, 0.0, -4.0).Normalize;
    SpotLight.CutOffAngle := Pi / 3.0;
    SpotLight.BeamWidth := Pi / 3.0;
    SpotLight.Attenuation := Vector3(1.0, 0.0, 0.0);
    SpotLight.Intensity := 4.0;
    SpotLight.Shadows := True;
    SpotLight.DefaultShadowMap := GenShadow;
    SpotLight.Global := True;
    ShadowRoot.AddChildren(SpotLight);

    { Receiver floor at Z = 0 covering [-1.9..+1.9]^2 }
    FloorTrans := TTransformNode.Create;
    FloorTrans.Translation := Vector3(0.0, 0.0, 0.0);
    FloorShape := TShapeNode.Create;
    FloorBox := TBoxNode.Create;
    FloorBox.Size := Vector3(3.8, 3.8, 0.1);
    FloorShape.Geometry := FloorBox;
    FloorApp := TAppearanceNode.Create;
    FloorMat := TPhysicalMaterialNode.Create;
    FloorMat.BaseColor := Vector3(0.92, 0.92, 0.95);
    FloorMat.Roughness := 0.65;
    FloorMat.Metallic := 0.0;
    FloorApp.Material := FloorMat;
    FloorShape.Appearance := FloorApp;
    FloorTrans.AddChildren(FloorShape);
    ShadowRoot.AddChildren(FloorTrans);

    { Occluder at (1.0, 0.0, 2.0): ray from (2,0,4) through (1,0,2) hits floor center (0,0,0) = pixel (64,64),
      while camera looks straight down -Z so Occluder only covers X in [0.65..1.35] (pixels [85..107]) }
    OccluderTrans := TTransformNode.Create;
    OccluderTrans.Translation := Vector3(1.0, 0.0, 2.0);
    OccluderShape := TShapeNode.Create;
    OccluderBox := TBoxNode.Create;
    OccluderBox.Size := Vector3(0.7, 1.2, 0.4);
    OccluderShape.Geometry := OccluderBox;
    OccluderApp := TAppearanceNode.Create;
    OccluderMat := TPhysicalMaterialNode.Create;
    OccluderMat.BaseColor := Vector3(0.2, 0.4, 0.9);
    OccluderMat.Roughness := 0.4;
    OccluderMat.Metallic := 0.0;
    OccluderApp.Material := OccluderMat;
    OccluderShape.Appearance := OccluderApp;
    OccluderTrans.AddChildren(OccluderShape);
    ShadowRoot.AddChildren(OccluderTrans);

    ShadowScene := TCastleScene.Create(nil);
    ShadowScene.RenderOptions.ShadowSampling := ssSimple;
    ShadowScene.Load(ShadowRoot, True);
    {$warnings off}
    Viewport.Items.MainScene := ShadowScene;
    {$warnings on}
    Viewport.Items.Add(ShadowScene);

    { Render 1: Hardware Depth Comparison Shadow Map (sampler2DShadow) }
    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    SetActiveCommandList(RealCmd);
    Container.EventUpdate;
    Viewport.BeforeRender;
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 128, 128),
      ColorTex, loClear, Viewport.BackgroundColor,
      DepthTex, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);
    Viewport.Render;
    Viewport.RenderOverChildren;
    RealCmd.EndRendering;
    RealDev.EndOffscreenFrame;

    ShotPCF := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 128, 128));
    CenterShadowLuma := Integer(ShotPCF.PixelPtr(64, 64)^.X) +
                        Integer(ShotPCF.PixelPtr(64, 64)^.Y) +
                        Integer(ShotPCF.PixelPtr(64, 64)^.Z);
    OuterLitLuma := Integer(ShotPCF.PixelPtr(24, 64)^.X) +
                    Integer(ShotPCF.PixelPtr(24, 64)^.Y) +
                    Integer(ShotPCF.PixelPtr(24, 64)^.Z);
    AssertTrue(Format('sampler2DShadow cast shadow pixel (64,64) luma (%d) must be darker than unoccluded PBR floor (24,64) luma (%d)',
      [CenterShadowLuma, OuterLitLuma]),
      OuterLitLuma > CenterShadowLuma + 80);

    { Render 2: Variance Shadow Maps (VSM Chebyshev moments via CastleVSMCasterFrag + BuiltIn3DPBRVSMFragSPIRV) }
    ShadowScene.GLContextClose;
    TTextureResources.Unprepare(GenShadow);
    ShadowScene.RenderOptions.ShadowSampling := ssVarianceShadowMaps;

    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    SetActiveCommandList(RealCmd);
    Container.EventUpdate;
    Viewport.BeforeRender;
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 128, 128),
      ColorTex, loClear, Viewport.BackgroundColor,
      DepthTex, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);
    Viewport.Render;
    Viewport.RenderOverChildren;
    RealCmd.EndRendering;
    RealDev.EndOffscreenFrame;

    ShotVSM := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 128, 128));
    VSMCenterLuma := Integer(ShotVSM.PixelPtr(64, 64)^.X) +
                     Integer(ShotVSM.PixelPtr(64, 64)^.Y) +
                     Integer(ShotVSM.PixelPtr(64, 64)^.Z);
    VSMOuterLuma := Integer(ShotVSM.PixelPtr(24, 64)^.X) +
                    Integer(ShotVSM.PixelPtr(24, 64)^.Y) +
                    Integer(ShotVSM.PixelPtr(24, 64)^.Z);
    AssertTrue(Format('VSM cast shadow pixel (64,64) luma (%d) must be darker than unoccluded PBR floor (24,64) luma (%d)',
      [VSMCenterLuma, VSMOuterLuma]),
      VSMOuterLuma > VSMCenterLuma + 60);

    TTextureResources.Unprepare(GenShadow);
    Viewport.Items.Remove(ShadowScene);
    FreeAndNil(ShadowScene);

    { --- Part C: Live Real-GPU 2-Bone TSkinNode Skeletal Skinning --- }
    SkinRoot := TX3DRootNode.Create;
    Joint0 := TTransformNode.Create('Joint0');
    Joint1 := TTransformNode.Create('Joint1');
    Joint0.AddChildren(Joint1);

    SkinShape := TShapeNode.Create;
    SkinApp := TAppearanceNode.Create;
    SkinMat := TPhysicalMaterialNode.Create;
    SkinMat.BaseColor := Vector3(0.0, 0.0, 0.0);
    SkinMat.EmissiveColor := Vector3(1.0, 0.15, 0.05);
    SkinApp.Material := SkinMat;
    SkinShape.Appearance := SkinApp;

    TriSet := TTriangleSetNode.Create;
    TriSet.Solid := False;
    CoordNode := TCoordinateNode.Create;
    CoordNode.SetPoint([
      Vector3(-0.45, -0.6, 0.0),
      Vector3( 0.45, -0.6, 0.0),
      Vector3( 0.45,  0.6, 0.0),
      Vector3(-0.45, -0.6, 0.0),
      Vector3( 0.45,  0.6, 0.0),
      Vector3(-0.45,  0.6, 0.0)
    ]);
    TriSet.Coord := CoordNode;
    TriSet.SetSkinJoints0([
      1, 0, 0, 0,
      1, 0, 0, 0,
      1, 0, 0, 0,
      1, 0, 0, 0,
      1, 0, 0, 0,
      1, 0, 0, 0
    ]);
    TriSet.SetSkinWeights0([
      Vector4(1.0, 0.0, 0.0, 0.0),
      Vector4(1.0, 0.0, 0.0, 0.0),
      Vector4(1.0, 0.0, 0.0, 0.0),
      Vector4(1.0, 0.0, 0.0, 0.0),
      Vector4(1.0, 0.0, 0.0, 0.0),
      Vector4(1.0, 0.0, 0.0, 0.0)
    ]);
    SkinShape.Geometry := TriSet;

    SkinNode := TSkinNode.Create('', '');
    SkinNode.Skeleton := Joint0;
    SkinNode.SetJoints([Joint0, Joint1]);
    SkinNode.SetInverseBindMatrices([TMatrix4.Identity, TMatrix4.Identity]);
    SkinNode.FdShapes.Add(SkinShape);
    SkinRoot.AddChildren(SkinNode);

    SkinScene := TCastleScene.Create(nil);
    SkinScene.Load(SkinRoot, True);
    {$warnings off}
    Viewport.Items.MainScene := SkinScene;
    {$warnings on}
    Viewport.Items.Add(SkinScene);

    { Pose 0: Joint1 at (0, 0, 0) -> skinned quad at screen center (64, 64), empty at right (102, 64) }
    Joint1.Translation := Vector3(0.0, 0.0, 0.0);
    SkinNode.InternalUpdateSkin;

    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    SetActiveCommandList(RealCmd);
    Container.EventUpdate;
    Viewport.BeforeRender;
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 128, 128),
      ColorTex, loClear, Viewport.BackgroundColor,
      DepthTex, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);
    Viewport.Render;
    Viewport.RenderOverChildren;
    RealCmd.EndRendering;
    RealDev.EndOffscreenFrame;

    ShotSkinPose0 := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 128, 128));
    AssertTrue('Pose 0: Skinned quad must appear at center (64,64) with R > 180',
      ShotSkinPose0.PixelPtr(64, 64)^.X > 180);
    AssertTrue('Pose 0: Right side (102,64) must be dark background R < 30',
      ShotSkinPose0.PixelPtr(102, 64)^.X < 30);

    { Pose 1: Translate Joint1 to (+1.2, 0, 0) -> GPU vertex skinning moves quad from (64,64) to (102,64)! }
    Joint1.Translation := Vector3(1.2, 0.0, 0.0);
    SkinNode.InternalUpdateSkin;

    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    SetActiveCommandList(RealCmd);
    Container.EventUpdate;
    Viewport.BeforeRender;
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 128, 128),
      ColorTex, loClear, Viewport.BackgroundColor,
      DepthTex, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);
    Viewport.Render;
    Viewport.RenderOverChildren;
    RealCmd.EndRendering;
    RealDev.EndOffscreenFrame;

    ShotSkinPose1 := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 128, 128));
    AssertTrue('Pose 1: Center (64,64) must now be dark background R < 30 after GPU bone translation',
      ShotSkinPose1.PixelPtr(64, 64)^.X < 30);
    AssertTrue('Pose 1: Skinned quad must deform on GPU to right side (102,64) with R > 180',
      ShotSkinPose1.PixelPtr(102, 64)^.X > 180);

    RealDev.AssertZeroValidationErrors('Phase113.PBRShadowMapsAndGpuSkinning');
  finally
    FreeAndNil(ShotSkinPose1);
    FreeAndNil(ShotSkinPose0);
    FreeAndNil(ShotVSM);
    FreeAndNil(ShotPCF);
    FreeAndNil(SkinScene);
    FreeAndNil(ShadowScene);
    FreeAndNil(Viewport);
    FreeAndNil(DepthTex);
    FreeAndNil(ColorTex);
    FreeAndNil(Container);
    FreeGlobalBatch2DRenderer;
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealOpenGLVsVulkanPBRMetallicRoughnessVisualParityRHI;

  procedure PopulatePBRSpheresScene(const AWindow: TCastleWindow);
  var
    Vp: TCastleViewport;
    Sc: TCastleScene;
    Root: TX3DRootNode;
    KeyLight: TDirectionalLightNode;
    LeftTrans, RightTrans: TTransformNode;
    LeftShape, RightShape: TShapeNode;
    LeftApp, RightApp: TAppearanceNode;
    LeftMat, RightMat: TPhysicalMaterialNode;
    LeftSphere, RightSphere: TSphereNode;
  begin
    Vp := TCastleViewport.Create(AWindow);
    Vp.FullSize := True;
    Vp.BackgroundColor := Vector4(0.05, 0.06, 0.09, 1.0);
    Vp.Camera.ProjectionType := ptOrthographic;
    Vp.Camera.Orthographic.Width := 4.4;
    Vp.Camera.Orthographic.Height := 3.3;
    Vp.Camera.Orthographic.Origin := Vector2(0.5, 0.5);
    Vp.Camera.SetView(
      Vector3(0.0, 0.0, 5.0),
      Vector3(0.0, 0.0, -1.0),
      Vector3(0.0, 1.0, 0.0));
    AWindow.Controls.InsertFront(Vp);

    Root := TX3DRootNode.Create;
    KeyLight := TDirectionalLightNode.Create;
    KeyLight.Direction := Vector3(-0.45, -0.45, -0.77).Normalize;
    KeyLight.Color := Vector3(1.0, 0.98, 0.94);
    KeyLight.Intensity := 2.4;
    KeyLight.Global := True;
    Root.AddChildren(KeyLight);

    { Left: Glossy Dielectric Crimson Sphere (Metallic = 0.0, Roughness = 0.28) }
    LeftTrans := TTransformNode.Create;
    LeftTrans.Translation := Vector3(-1.05, 0.0, 0.0);
    LeftShape := TShapeNode.Create;
    LeftSphere := TSphereNode.Create;
    LeftSphere.Radius := 0.85;
    LeftSphere.Slices := 24;
    LeftSphere.Stacks := 24;
    LeftShape.Geometry := LeftSphere;
    LeftApp := TAppearanceNode.Create;
    LeftMat := TPhysicalMaterialNode.Create;
    LeftMat.BaseColor := Vector3(0.85, 0.10, 0.12);
    LeftMat.Metallic := 0.0;
    LeftMat.Roughness := 0.28;
    LeftApp.Material := LeftMat;
    LeftShape.Appearance := LeftApp;
    LeftTrans.AddChildren(LeftShape);
    Root.AddChildren(LeftTrans);

    { Right: Brushed Gold Conductor Metallic Sphere (Metallic = 1.0, Roughness = 0.34) }
    RightTrans := TTransformNode.Create;
    RightTrans.Translation := Vector3(1.05, 0.0, 0.0);
    RightShape := TShapeNode.Create;
    RightSphere := TSphereNode.Create;
    RightSphere.Radius := 0.85;
    RightSphere.Slices := 24;
    RightSphere.Stacks := 24;
    RightShape.Geometry := RightSphere;
    RightApp := TAppearanceNode.Create;
    RightMat := TPhysicalMaterialNode.Create;
    RightMat.BaseColor := Vector3(1.0, 0.78, 0.32);
    RightMat.Metallic := 1.0;
    RightMat.Roughness := 0.34;
    RightApp.Material := RightMat;
    RightShape.Appearance := RightApp;
    RightTrans.AddChildren(RightShape);
    Root.AddChildren(RightTrans);

    Sc := TCastleScene.Create(AWindow);
    Sc.Load(Root, True);
    {$warnings off}
    Vp.Items.MainScene := Sc;
    {$warnings on}
    Vp.Items.Add(Sc);
  end;

  procedure PopulatePBRTexturedEmissiveScene(const AWindow: TCastleWindow);
  var
    Vp: TCastleViewport;
    Sc: TCastleScene;
    Root: TX3DRootNode;
    KeyLight: TDirectionalLightNode;
    BoxTrans: TTransformNode;
    BoxShape: TShapeNode;
    BoxApp: TAppearanceNode;
    BoxMat: TPhysicalMaterialNode;
    BoxGeo: TBoxNode;
    BaseImg, EmisImg: TRGBImage;
    BasePixTex, EmisPixTex: TPixelTextureNode;
    BaseProps, EmisProps: TTexturePropertiesNode;
    X, Y: Integer;
  begin
    Vp := TCastleViewport.Create(AWindow);
    Vp.FullSize := True;
    Vp.BackgroundColor := Vector4(0.04, 0.05, 0.07, 1.0);
    Vp.Camera.ProjectionType := ptOrthographic;
    Vp.Camera.Orthographic.Width := 3.6;
    Vp.Camera.Orthographic.Height := 2.7;
    Vp.Camera.Orthographic.Origin := Vector2(0.5, 0.5);
    Vp.Camera.SetView(
      Vector3(0.0, 0.0, 5.0),
      Vector3(0.0, 0.0, -1.0),
      Vector3(0.0, 1.0, 0.0));
    AWindow.Controls.InsertFront(Vp);

    Root := TX3DRootNode.Create;
    KeyLight := TDirectionalLightNode.Create;
    KeyLight.Direction := Vector3(-0.3, -0.4, -0.86).Normalize;
    KeyLight.Color := Vector3(1.0, 1.0, 1.0);
    KeyLight.Intensity := 2.2;
    KeyLight.Global := True;
    Root.AddChildren(KeyLight);

    BaseImg := TRGBImage.Create(8, 8);
    EmisImg := TRGBImage.Create(8, 8);
    for Y := 0 to 7 do
      for X := 0 to 7 do
      begin
        if ((X div 2) + (Y div 2)) mod 2 = 0 then
          BaseImg.PixelPtr(X, Y)^ := Vector3Byte(220, 210, 180)
        else
          BaseImg.PixelPtr(X, Y)^ := Vector3Byte(60, 140, 210);
        if (X >= 3) and (X <= 4) and (Y >= 3) and (Y <= 4) then
          EmisImg.PixelPtr(X, Y)^ := Vector3Byte(230, 90, 20)
        else
          EmisImg.PixelPtr(X, Y)^ := Vector3Byte(0, 0, 0);
      end;

    BasePixTex := TPixelTextureNode.Create;
    BasePixTex.FdImage.Value := BaseImg;
    BaseProps := TTexturePropertiesNode.Create;
    BaseProps.MagnificationFilter := magNearest;
    BaseProps.MinificationFilter := minNearest;
    BasePixTex.TextureProperties := BaseProps;

    EmisPixTex := TPixelTextureNode.Create;
    EmisPixTex.FdImage.Value := EmisImg;
    EmisProps := TTexturePropertiesNode.Create;
    EmisProps.MagnificationFilter := magNearest;
    EmisProps.MinificationFilter := minNearest;
    EmisPixTex.TextureProperties := EmisProps;

    BoxTrans := TTransformNode.Create;
    BoxTrans.Rotation := Vector4(0.0, 1.0, 0.0, 0.35);
    BoxShape := TShapeNode.Create;
    BoxGeo := TBoxNode.Create;
    BoxGeo.Size := Vector3(2.0, 1.8, 1.2);
    BoxShape.Geometry := BoxGeo;
    BoxApp := TAppearanceNode.Create;
    BoxMat := TPhysicalMaterialNode.Create;
    BoxMat.BaseColor := Vector3(1.0, 1.0, 1.0);
    BoxMat.BaseTexture := BasePixTex;
    BoxMat.EmissiveColor := Vector3(1.0, 1.0, 1.0);
    BoxMat.EmissiveTexture := EmisPixTex;
    BoxMat.Metallic := 0.15;
    BoxMat.Roughness := 0.45;
    BoxApp.Material := BoxMat;
    BoxShape.Appearance := BoxApp;
    BoxTrans.AddChildren(BoxShape);
    Root.AddChildren(BoxTrans);

    Sc := TCastleScene.Create(AWindow);
    Sc.Load(Root, True);
    {$warnings off}
    Vp.Items.MainScene := Sc;
    {$warnings on}
    Vp.Items.Add(Sc);
  end;

  function CapturePBRBackendScenarios(const ABackend: TRenderBackend;
    out AShotSpheres, AShotTexturedBox: TRGBAlphaImage;
    out AVkValidationErrors: Cardinal): Boolean;
  var
    Win: TCastleWindow;
    I: Integer;
  begin
    Result := False;
    AShotSpheres := nil;
    AShotTexturedBox := nil;
    AVkValidationErrors := 0;

    SetActiveCommandList(nil);
    SetRHIDevice(nil);
    ApplicationProperties.RenderBackend := ABackend;
    Application.OnInitialize := nil;
    Application.Initialize;

    Win := CreateWindowForTest;
    try
      Win.Width := 160;
      Win.Height := 120;
      Win.AntiAliasing := aaNone;
      try
        Win.Open;
      except
        on Exception do
        begin
          if not Win.Closed then
            Win.Close(False);
          Exit(False);
        end;
      end;

      if ABackend = backendVulkan then
      begin
        if not (RHIDevice is TVulkanRHIDevice) then
        begin
          Win.Close(False);
          Exit(False);
        end;
        TVulkanRHIDevice(RHIDevice).ResetValidationCounters;
      end else
      begin
        if RHIDevice <> nil then
        begin
          Win.Close(False);
          Exit(False);
        end;
      end;

      PopulatePBRSpheresScene(Win);
      for I := 0 to 1 do
      begin
        Win.Invalidate;
        Application.ProcessAllMessages;
      end;
      AShotSpheres := Win.Container.SaveScreenRgba;
      while Win.Controls.Count > 0 do
        Win.Controls[0].Free;

      PopulatePBRTexturedEmissiveScene(Win);
      for I := 0 to 1 do
      begin
        Win.Invalidate;
        Application.ProcessAllMessages;
      end;
      AShotTexturedBox := Win.Container.SaveScreenRgba;
      while Win.Controls.Count > 0 do
        Win.Controls[0].Free;

      if (ABackend = backendVulkan) and (RHIDevice is TVulkanRHIDevice) then
        AVkValidationErrors := TVulkanRHIDevice(RHIDevice).ValidationErrorCount;

      Win.Close(False);
      Result := (AShotSpheres <> nil) and (AShotTexturedBox <> nil);
    finally
      DestroyWindowForTest(Win);
    end;
  end;

var
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedOnInit: TProcedure;
  VkSpheres, VkTexturedBox, GlSpheres, GlTexturedBox: TRGBAlphaImage;
  VkValErrors, DummyGlErrors: Cardinal;
  PBRSuite: TRHIVisualRegressionSuite;
  {$if defined(UNIX) and not defined(DARWIN) and not defined(ANDROID)}
  HasDisplay: Boolean;
  {$endif}
begin
  if not CanCreateWindowForTest then
    Exit;

  {$if defined(UNIX) and not defined(DARWIN) and not defined(ANDROID)}
  HasDisplay := (GetEnvironmentVariable('DISPLAY') <> '') or
                (GetEnvironmentVariable('WAYLAND_DISPLAY') <> '');
  if not HasDisplay then
    Exit;
  {$endif}

  try
    if not LoadVulkan then
      Exit;
  except
    on Exception do
      Exit;
  end;

  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedOnInit := Application.OnInitialize;
  VkSpheres := nil;
  VkTexturedBox := nil;
  GlSpheres := nil;
  GlTexturedBox := nil;
  PBRSuite := TRHIVisualRegressionSuite.Create(4);
  try
    if not CapturePBRBackendScenarios(backendVulkan, VkSpheres, VkTexturedBox, VkValErrors) then
      Exit;
    AssertEquals('Vulkan PBR parity capture must produce 0 validation errors',
      0, Integer(VkValErrors));

    if not CapturePBRBackendScenarios(backendOpenGL, GlSpheres, GlTexturedBox, DummyGlErrors) then
      Exit;

    PBRSuite.RecordComparison('3D_PBR_Dielectric_And_GoldMetallic_Spheres', GlSpheres, VkSpheres, 0.08);
    PBRSuite.RecordComparison('3D_PBR_Textured_BaseColor_And_Emissive_Box', GlTexturedBox, VkTexturedBox, 0.08);

    AssertEquals('PBR parity suite must record 2 scenarios', 2, PBRSuite.CaseCount);
    AssertTrue('All rbOpenGL vs rbVulkan Cook-Torrance PBR visual parity cases must pass: ' +
      LineEnding + PBRSuite.BuildSummaryReport,
      PBRSuite.AllPassed);
  finally
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    Application.OnInitialize := SavedOnInit;
    FreeAndNil(PBRSuite);
    FreeAndNil(GlTexturedBox);
    FreeAndNil(GlSpheres);
    FreeAndNil(VkTexturedBox);
    FreeAndNil(VkSpheres);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipeIBLComputeBrdfLutPrefilterAndIrradianceCubemapRHI;
const
  Phase114ShaderChecks: array[0..10] of record
    Stage: TRHIShaderStage;
    DebugName: String;
  end = (
    (Stage: ssCompute;  DebugName: 'IBLBrdfLutComputeCS'),
    (Stage: ssCompute;  DebugName: 'IBLPrefilterEnvComputeCS'),
    (Stage: ssCompute;  DebugName: 'IBLIrradianceEnvComputeCS'),
    (Stage: ssVertex;   DebugName: 'CastleColorPerVertex3DVert'),
    (Stage: ssFragment; DebugName: 'CastleColorPerVertex3DFrag'),
    (Stage: ssVertex;   DebugName: 'CastleMultiTex3DVert'),
    (Stage: ssFragment; DebugName: 'CastleMultiTex3DFrag'),
    (Stage: ssFragment; DebugName: 'CastleMultiTexAdd3DFrag'),
    (Stage: ssFragment; DebugName: 'CastleCubeTex3DFrag'),
    (Stage: ssFragment; DebugName: 'CastleTex3DFrag'),
    (Stage: ssFragment; DebugName: 'CastlePBRIBL3DFrag')
  );
var
  I: Integer;
  SpirvBytes: TSPIRVBytecode;
  ReflInfo: TSPIRVReflectionInfo;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  FaceColors: array[0..5] of TVector3;
  LutTex, PrefilteredCube, IrradianceCube: TVulkanRHITexture;
  LutImg, SkyMip0Img, GroundMip0Img, SkyMip4Img, GroundMip4Img, IrrSkyImg, IrrGroundImg: TRGBAlphaImage;
  NormalSmoothPx, GrazingSmoothPx: TVector4Byte;
  SkyMip0B, GroundMip0B, SkyMip4B, GroundMip4B: Integer;
begin
  { 1. Verify all 11 Phase 114 zero-dependency SPIR-V 1.0 modules via TryGetBuiltInSPIRV & InspectSPIRVBytecode }
  for I := Low(Phase114ShaderChecks) to High(Phase114ShaderChecks) do
  begin
    AssertTrue('TryGetBuiltInSPIRV must resolve ' + Phase114ShaderChecks[I].DebugName,
      TCastleShaderCompiler.Instance.TryGetBuiltInSPIRV(
        Phase114ShaderChecks[I].Stage, '/* ' + Phase114ShaderChecks[I].DebugName + ' */',
        Phase114ShaderChecks[I].DebugName, SpirvBytes));
    AssertTrue('Built-in SPIR-V for ' + Phase114ShaderChecks[I].DebugName + ' must exceed minimal fallback size',
      Length(SpirvBytes) > 400);
    AssertTrue('InspectSPIRVBytecode must validate ' + Phase114ShaderChecks[I].DebugName,
      InspectSPIRVBytecode(SpirvBytes, ReflInfo) and ReflInfo.IsValid);
    AssertEquals('Reflected stage must match ' + Phase114ShaderChecks[I].DebugName,
      Ord(Phase114ShaderChecks[I].Stage), Ord(ReflInfo.Stage));
  end;

  { 2. Live real-GPU compute execution on Mesa Lavapipe Vulkan 1.4 }
  RealDev := nil;
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev, True) then
    Exit;

  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  LutImg := nil;
  SkyMip0Img := nil;
  GroundMip0Img := nil;
  SkyMip4Img := nil;
  GroundMip4Img := nil;
  IrrSkyImg := nil;
  IrrGroundImg := nil;
  try
    SetRHIDevice(RealDev);
    RealDev.ResetValidationCounters;

    { Asymmetric environment: +Y zenith = bright sky blue, -Y nadir = warm terracotta ground }
    FaceColors[0] := Vector3(0.28, 0.30, 0.32); // +X
    FaceColors[1] := Vector3(0.28, 0.30, 0.32); // -X
    FaceColors[2] := Vector3(0.15, 0.55, 1.00); // +Y (Sky)
    FaceColors[3] := Vector3(0.90, 0.30, 0.08); // -Y (Ground)
    FaceColors[4] := Vector3(0.28, 0.30, 0.32); // +Z
    FaceColors[5] := Vector3(0.28, 0.30, 0.32); // -Z

    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    SetActiveCommandList(RealCmd);
    LutTex := RealDev.IBLGenerator.GenerateBRDFIntegrationLUT(RealCmd, 32, 32);
    PrefilteredCube := RealDev.IBLGenerator.PrefilterEnvironmentCubemap(RealCmd, FaceColors, 16);
    IrradianceCube := RealDev.IBLGenerator.IrradianceEnvCubemap;
    RealDev.EndOffscreenFrame;

    AssertTrue('LutTex must be allocated on GPU', LutTex <> nil);
    AssertTrue('PrefilteredCube must be allocated on GPU', PrefilteredCube <> nil);
    AssertTrue('IrradianceCube must be allocated on GPU', IrradianceCube <> nil);
    AssertEquals('TotalBrdfLutDispatches must be 1', 1, RealDev.IBLGenerator.TotalBrdfLutDispatches);
    AssertEquals('TotalEnvPrefilterPasses must be 5 (16->8->4->2->1)', 5, RealDev.IBLGenerator.TotalEnvPrefilterPasses);
    AssertEquals('TotalIrradianceDispatches must be 6 (one per cubemap face)', 6, RealDev.IBLGenerator.TotalIrradianceDispatches);

    { Read back GPU-computed 2D BRDF Integration LUT }
    LutImg := RealDev.GrabTextureImage(LutTex, Rectangle(0, 0, 32, 32));
    NormalSmoothPx := LutImg.PixelPtr(29, 3)^;  // NdotV ~ 0.92, Roughness ~ 0.11
    GrazingSmoothPx := LutImg.PixelPtr(1, 3)^;  // NdotV ~ 0.05, Roughness ~ 0.11
    AssertTrue('GPU BRDF LUT at normal incidence smooth must have high Scale R > 180 (got ' + IntToStr(NormalSmoothPx.X) + ')',
      NormalSmoothPx.X > 180);
    AssertTrue('GPU BRDF LUT at grazing incidence must have significant Fresnel Bias G > 45 (got ' + IntToStr(GrazingSmoothPx.Y) + ')',
      GrazingSmoothPx.Y > 45);
    AssertTrue('GPU BRDF LUT grazing Fresnel Bias must exceed normal-incidence Bias',
      GrazingSmoothPx.Y > NormalSmoothPx.Y);

    { Read back GPU-convolved PrefilteredEnvCubemap subresources: Mip 0 vs Mip 4 }
    SkyMip0Img := RealDev.GrabTextureSubresourceImage(PrefilteredCube, 0, 2);    // +Y Mip 0 (16x16, roughness=0)
    GroundMip0Img := RealDev.GrabTextureSubresourceImage(PrefilteredCube, 0, 3); // -Y Mip 0 (16x16, roughness=0)
    SkyMip4Img := RealDev.GrabTextureSubresourceImage(PrefilteredCube, 4, 2);    // +Y Mip 4 (1x1, roughness=1)
    GroundMip4Img := RealDev.GrabTextureSubresourceImage(PrefilteredCube, 4, 3); // -Y Mip 4 (1x1, roughness=1)

    SkyMip0B := SkyMip0Img.PixelPtr(8, 8)^.Z;
    GroundMip0B := GroundMip0Img.PixelPtr(8, 8)^.Z;
    SkyMip4B := SkyMip4Img.PixelPtr(0, 0)^.Z;
    GroundMip4B := GroundMip4Img.PixelPtr(0, 0)^.Z;

    AssertTrue('Prefilter Mip 0 +Y sky center must preserve bright blue B > 220 (got ' + IntToStr(SkyMip0B) + ')',
      SkyMip0B > 220);
    AssertTrue('Prefilter Mip 0 -Y ground center must preserve warm orange R > 200, B < 50',
      (GroundMip0Img.PixelPtr(8, 8)^.X > 200) and (GroundMip0B < 50));
    AssertTrue('Prefilter Mip 4 (roughness=1) must convolve/blur +Y sky blue downward and -Y ground blue upward',
      (SkyMip4B < SkyMip0B) and (GroundMip4B > GroundMip0B));

    { Read back GPU-convolved cosine-weighted Lambertian IrradianceEnvCubemap }
    IrrSkyImg := RealDev.GrabTextureSubresourceImage(IrradianceCube, 0, 2);    // +Y face (8x8)
    IrrGroundImg := RealDev.GrabTextureSubresourceImage(IrradianceCube, 0, 3); // -Y face (8x8)
    AssertTrue('GPU IrradianceEnvCubemap +Y sky hemisphere must have higher blue irradiance than -Y ground',
      IrrSkyImg.PixelPtr(4, 4)^.Z > IrrGroundImg.PixelPtr(4, 4)^.Z + 40);
    AssertTrue('GPU IrradianceEnvCubemap -Y ground hemisphere must have higher red irradiance than +Y sky',
      IrrGroundImg.PixelPtr(4, 4)^.X > IrrSkyImg.PixelPtr(4, 4)^.X + 30);

    RealDev.AssertZeroValidationErrors('Phase114.IBLComputeBrdfLutPrefilterAndIrradiance');
  finally
    FreeAndNil(IrrGroundImg);
    FreeAndNil(IrrSkyImg);
    FreeAndNil(GroundMip4Img);
    FreeAndNil(SkyMip4Img);
    FreeAndNil(GroundMip0Img);
    FreeAndNil(SkyMip0Img);
    FreeAndNil(LutImg);
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipeSkyboxBackgroundCubemap3DTextureAndMultiTextureRHI;

  function MakeSolidPixelTexture(const AColor: TVector4Byte): TPixelTextureNode;
  var
    Img: TRGBAlphaImage;
  begin
    Result := TPixelTextureNode.Create;
    Img := TRGBAlphaImage.Create(4, 4);
    Img.Clear(AColor);
    Result.FdImage.Value := Img;
  end;

var
  SavedBackend: TRenderBackend;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  Container: TTestSizedVulkanContainer;
  ColorTex, DepthTex: TVulkanRHITexture;
  TexDesc: TRHITextureDesc;
  PassInfo: TRHIRenderingInfo;
  Viewport: TCastleViewport;
  Bg: TCastleBackground;
  FgScene, CubeVolScene, MultiTexScene: TCastleScene;
  FgRoot, CubeVolRoot, MultiRoot: TX3DRootNode;
  FgShape, CubeShape, VolShape, ModShape, AddShape: TShapeNode;
  FgApp, CubeApp, VolApp, ModApp, AddApp: TAppearanceNode;
  FgMat, CubeMat, VolMat, ModMat, AddMat: TUnlitMaterialNode;
  FgBox: TBoxNode;
  CubeTrans, VolTrans, ModTrans, AddTrans: TTransformNode;
  CubeSphere: TSphereNode;
  CubeMapNode: TComposedCubeMapTextureNode;
  VolTexNode: TPixelTexture3DNode;
  VolTriSet: TTriangleSetNode;
  VolCoord: TCoordinateNode;
  ModBox, AddBox: TBoxNode;
  MultiModNode, MultiAddNode: TMultiTextureNode;
  ShotBg, ShotCubeVol, ShotMulti: TRGBAlphaImage;
  TopSkyPx, BotGroundPx, CenterFgPx, CubePx, VolSlice0Px, VolSlice1Px, ModPx, AddPx: TVector4Byte;
begin
  RealDev := nil;
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev, True) then
    Exit;

  SavedBackend := ApplicationProperties.RenderBackend;
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;
  Container := nil;
  ColorTex := nil;
  DepthTex := nil;
  Viewport := nil;
  Bg := nil;
  FgScene := nil;
  CubeVolScene := nil;
  MultiTexScene := nil;
  ShotBg := nil;
  ShotCubeVol := nil;
  ShotMulti := nil;
  try
    GLFeatures := nil;
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(RealDev);
    RealDev.ResetValidationCounters;

    Container := TTestSizedVulkanContainer.Create(nil);
    Container.TestWidth := 128;
    Container.TestHeight := 128;
    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 128, 128);

    TexDesc := TRHITextureDesc.Create2D(128, 128, pfRGBA8_UNorm,
      [tuColorAttachment, tuSampled, tuTransferSrc, tuTransferDst], 1);
    TexDesc.DebugName := 'Phase114SceneColor';
    ColorTex := RealDev.CreateTexture(TexDesc) as TVulkanRHITexture;

    TexDesc := TRHITextureDesc.Create2D(128, 128, pfD32_Float,
      [tuDepthStencil, tuSampled, tuTransferSrc], 1);
    TexDesc.DebugName := 'Phase114SceneDepth';
    DepthTex := RealDev.CreateTexture(TexDesc) as TVulkanRHITexture;

    { --- Part A: TCastleBackground Sky/Ground Dome (TColorNode + DepthTest=False/DepthWrite=False) + Foreground 3D Mesh --- }
    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := False;
    Viewport.Width := 128;
    Viewport.Height := 128;
    Container.Controls.InsertFront(Viewport);

    Bg := TCastleBackground.Create(nil);
    Bg.SkyTopColor := Vector3(0.05, 0.35, 0.98);
    Bg.SkyEquatorColor := Vector3(0.10, 0.45, 0.98);
    Bg.GroundEquatorColor := Vector3(0.88, 0.38, 0.06);
    Bg.GroundBottomColor := Vector3(0.82, 0.28, 0.04);
    Bg.SmoothEquator := 0.0;
    Viewport.Background := Bg;

    Viewport.Camera.ProjectionType := ptPerspective;
    Viewport.Camera.Perspective.FieldOfView := DegToRad(60.0);
    Viewport.Camera.ProjectionNear := 0.1;
    Viewport.Camera.ProjectionFar := 100.0;
    Viewport.Camera.SetView(
      Vector3(0.0, 0.0, 4.0),
      Vector3(0.0, 0.0, -1.0),
      Vector3(0.0, 1.0, 0.0));

    FgRoot := TX3DRootNode.Create;
    FgShape := TShapeNode.Create;
    FgBox := TBoxNode.Create;
    FgBox.Size := Vector3(1.1, 1.1, 1.1);
    FgShape.Geometry := FgBox;
    FgApp := TAppearanceNode.Create;
    FgMat := TUnlitMaterialNode.Create;
    FgMat.EmissiveColor := Vector3(0.10, 0.92, 0.20);
    FgApp.Material := FgMat;
    FgShape.Appearance := FgApp;
    FgRoot.AddChildren(FgShape);

    FgScene := TCastleScene.Create(nil);
    FgScene.Load(FgRoot, True);
    Viewport.Items.Add(FgScene);

    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    SetActiveCommandList(RealCmd);
    Container.EventUpdate;
    Viewport.BeforeRender;
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 128, 128),
      ColorTex, loClear, Vector4(0.0, 0.0, 0.0, 1.0),
      DepthTex, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);
    Viewport.Render;
    Viewport.RenderOverChildren;
    RealCmd.EndRendering;
    RealDev.EndOffscreenFrame;

    ShotBg := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 128, 128));
    TopSkyPx := ShotBg.PixelPtr(64, 112)^;
    BotGroundPx := ShotBg.PixelPtr(64, 16)^;
    CenterFgPx := ShotBg.PixelPtr(64, 64)^;

    AssertTrue('Top viewport pixel (64,112) must render blue TCastleBackground sky dome (B > 170, R < 90), got R=' +
      IntToStr(TopSkyPx.X) + ' B=' + IntToStr(TopSkyPx.Z),
      (TopSkyPx.Z > 170) and (TopSkyPx.X < 90));
    AssertTrue('Bottom viewport pixel (64,16) must render warm TCastleBackground ground dome (R > 160, B < 60), got R=' +
      IntToStr(BotGroundPx.X) + ' B=' + IntToStr(BotGroundPx.Z),
      (BotGroundPx.X > 160) and (BotGroundPx.Z < 60));
    AssertTrue('Center pixel (64,64) must render depth-tested green foreground mesh UNOCCLUDED by skybox (G > 190, R < 80)',
      (CenterFgPx.Y > 190) and (CenterFgPx.X < 80));

    { --- Part B: TComposedCubeMapTextureNode (tdCube) & TPixelTexture3DNode (td3D with Depth=2) --- }
    Viewport.Background := nil;
    Viewport.Items.Remove(FgScene);
    FreeAndNil(FgScene);

    Viewport.BackgroundColor := Vector4(0.02, 0.02, 0.03, 1.0);
    Viewport.Camera.ProjectionType := ptOrthographic;
    Viewport.Camera.Orthographic.Width := 4.0;
    Viewport.Camera.Orthographic.Height := 4.0;
    Viewport.Camera.Orthographic.Origin := Vector2(0.5, 0.5);
    Viewport.Camera.SetView(
      Vector3(0.0, 0.0, 5.0),
      Vector3(0.0, 0.0, -1.0),
      Vector3(0.0, 1.0, 0.0));

    CubeVolRoot := TX3DRootNode.Create;

    { Top-half quad/sphere with TComposedCubeMapTextureNode: unlit looks along -Z (Front face = bright magenta) }
    CubeTrans := TTransformNode.Create;
    CubeTrans.Translation := Vector3(0.0, 1.0, 0.0);
    CubeShape := TShapeNode.Create;
    CubeSphere := TSphereNode.Create;
    CubeSphere.Radius := 0.75;
    CubeShape.Geometry := CubeSphere;
    CubeApp := TAppearanceNode.Create;
    CubeMat := TUnlitMaterialNode.Create;
    CubeMat.EmissiveColor := Vector3(1.0, 1.0, 1.0);
    CubeApp.Material := CubeMat;
    CubeMapNode := TComposedCubeMapTextureNode.Create;
    CubeMapNode.Front  := MakeSolidPixelTexture(Vector4Byte(240, 30, 230, 255)); // -Z view dir -> Magenta!
    CubeMapNode.Back   := MakeSolidPixelTexture(Vector4Byte(20, 200, 40, 255));
    CubeMapNode.Left   := MakeSolidPixelTexture(Vector4Byte(20, 40, 220, 255));
    CubeMapNode.Right  := MakeSolidPixelTexture(Vector4Byte(220, 200, 20, 255));
    CubeMapNode.Top    := MakeSolidPixelTexture(Vector4Byte(30, 220, 240, 255));
    CubeMapNode.Bottom := MakeSolidPixelTexture(Vector4Byte(220, 80, 20, 255));
    CubeApp.Texture := CubeMapNode;
    CubeShape.Appearance := CubeApp;
    CubeTrans.AddChildren(CubeShape);
    CubeVolRoot.AddChildren(CubeTrans);

    { Bottom-half 2 quads with TPixelTexture3DNode (Width=1, Height=1, Depth=2):
      Slice 0 (z < 0 -> w=0.1) = Pure Red $FF0000; Slice 1 (z > 0 -> w=0.9) = Pure Cyan $00FFFF }
    VolTrans := TTransformNode.Create;
    VolShape := TShapeNode.Create;
    VolTriSet := TTriangleSetNode.Create;
    VolTriSet.Solid := False;
    VolCoord := TCoordinateNode.Create;
    VolCoord.SetPoint([
      { Left quad at world z = -0.8 -> uvw.z = 0.1 -> Slice 0 (Red) }
      Vector3(-1.6, -1.6, -0.8), Vector3(-0.3, -1.6, -0.8), Vector3(-0.3, -0.3, -0.8),
      Vector3(-1.6, -1.6, -0.8), Vector3(-0.3, -0.3, -0.8), Vector3(-1.6, -0.3, -0.8),
      { Right quad at world z = +0.8 -> uvw.z = 0.9 -> Slice 1 (Cyan) }
      Vector3( 0.3, -1.6,  0.8), Vector3( 1.6, -1.6,  0.8), Vector3( 1.6, -0.3,  0.8),
      Vector3( 0.3, -1.6,  0.8), Vector3( 1.6, -0.3,  0.8), Vector3( 0.3, -0.3,  0.8)
    ]);
    VolTriSet.Coord := VolCoord;
    VolShape.Geometry := VolTriSet;
    VolApp := TAppearanceNode.Create;
    VolMat := TUnlitMaterialNode.Create;
    VolMat.EmissiveColor := Vector3(1.0, 1.0, 1.0);
    VolApp.Material := VolMat;
    VolTexNode := TPixelTexture3DNode.Create;
    VolTexNode.RepeatS := False;
    VolTexNode.RepeatT := False;
    VolTexNode.RepeatR := False;
    VolTexNode.SetImage([3, 1, 1, 2, Int32($FF1010), Int32($10E8FF)]);
    VolApp.Texture := VolTexNode;
    VolShape.Appearance := VolApp;
    VolTrans.AddChildren(VolShape);
    CubeVolRoot.AddChildren(VolTrans);

    CubeVolScene := TCastleScene.Create(nil);
    CubeVolScene.RenderOptions.MinificationFilter := minNearest;
    CubeVolScene.RenderOptions.MagnificationFilter := magNearest;
    CubeVolScene.Load(CubeVolRoot, True);
    Viewport.Items.Add(CubeVolScene);

    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    SetActiveCommandList(RealCmd);
    Container.EventUpdate;
    Viewport.BeforeRender;
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 128, 128),
      ColorTex, loClear, Viewport.BackgroundColor,
      DepthTex, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);
    Viewport.Render;
    RealCmd.EndRendering;
    RealDev.EndOffscreenFrame;

    ShotCubeVol := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 128, 128));
    CubePx := ShotCubeVol.PixelPtr(64, 96)^;
    VolSlice0Px := ShotCubeVol.PixelPtr(34, 34)^;
    VolSlice1Px := ShotCubeVol.PixelPtr(94, 34)^;

    AssertTrue('Cubemap sphere at (64,96) must sample Front (-Z) magenta face (R > 180, B > 170, G < 80)',
      (CubePx.X > 180) and (CubePx.Z > 170) and (CubePx.Y < 80));
    AssertTrue('3D volume texture Slice 0 at (34,34) must sample Red slice (R > 200, B < 50)',
      (VolSlice0Px.X > 200) and (VolSlice0Px.Z < 50));
    AssertTrue('3D volume texture Slice 1 at (94,34) must sample Cyan depth=1 slice (B > 200, G > 180, R < 50)',
      (VolSlice1Px.Z > 200) and (VolSlice1Px.Y > 180) and (VolSlice1Px.X < 50));

    { --- Part C: TMultiTextureNode (MODULATE & ADD) --- }
    Viewport.Items.Remove(CubeVolScene);
    FreeAndNil(CubeVolScene);

    MultiRoot := TX3DRootNode.Create;

    { Left box: MODULATE (Yellow (1, 1, 0) * Cyan (0, 1, 1) -> Green (0, 1, 0)!) }
    ModTrans := TTransformNode.Create;
    ModTrans.Translation := Vector3(-1.0, 0.0, 0.0);
    ModShape := TShapeNode.Create;
    ModBox := TBoxNode.Create;
    ModBox.Size := Vector3(1.4, 1.4, 0.5);
    ModShape.Geometry := ModBox;
    ModApp := TAppearanceNode.Create;
    ModMat := TUnlitMaterialNode.Create;
    ModMat.EmissiveColor := Vector3(1.0, 1.0, 1.0);
    ModApp.Material := ModMat;
    MultiModNode := TMultiTextureNode.Create;
    MultiModNode.SetTexture([
      MakeSolidPixelTexture(Vector4Byte(255, 255, 0, 255)),
      MakeSolidPixelTexture(Vector4Byte(0, 255, 255, 255))
    ]);
    MultiModNode.SetMode(['MODULATE', 'MODULATE']);
    ModApp.Texture := MultiModNode;
    ModShape.Appearance := ModApp;
    ModTrans.AddChildren(ModShape);
    MultiRoot.AddChildren(ModTrans);

    { Right box: ADD (Red (1, 0, 0) + Blue (0, 0, 1) -> Magenta (1, 0, 1)!) }
    AddTrans := TTransformNode.Create;
    AddTrans.Translation := Vector3(1.0, 0.0, 0.0);
    AddShape := TShapeNode.Create;
    AddBox := TBoxNode.Create;
    AddBox.Size := Vector3(1.4, 1.4, 0.5);
    AddShape.Geometry := AddBox;
    AddApp := TAppearanceNode.Create;
    AddMat := TUnlitMaterialNode.Create;
    AddMat.EmissiveColor := Vector3(1.0, 1.0, 1.0);
    AddApp.Material := AddMat;
    MultiAddNode := TMultiTextureNode.Create;
    MultiAddNode.SetTexture([
      MakeSolidPixelTexture(Vector4Byte(230, 0, 0, 255)),
      MakeSolidPixelTexture(Vector4Byte(0, 0, 230, 255))
    ]);
    MultiAddNode.SetMode(['MODULATE', 'ADD']);
    AddApp.Texture := MultiAddNode;
    AddShape.Appearance := AddApp;
    AddTrans.AddChildren(AddShape);
    MultiRoot.AddChildren(AddTrans);

    MultiTexScene := TCastleScene.Create(nil);
    MultiTexScene.Load(MultiRoot, True);
    Viewport.Items.Add(MultiTexScene);

    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    SetActiveCommandList(RealCmd);
    Container.EventUpdate;
    Viewport.BeforeRender;
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 128, 128),
      ColorTex, loClear, Viewport.BackgroundColor,
      DepthTex, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);
    Viewport.Render;
    RealCmd.EndRendering;
    RealDev.EndOffscreenFrame;

    ShotMulti := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 128, 128));
    ModPx := ShotMulti.PixelPtr(32, 64)^;
    AddPx := ShotMulti.PixelPtr(96, 64)^;

    AssertTrue('TMultiTextureNode MODULATE (Yellow * Cyan) at (32,64) must produce pure Green (G > 200, R < 30, B < 30)',
      (ModPx.Y > 200) and (ModPx.X < 30) and (ModPx.Z < 30));
    AssertTrue('TMultiTextureNode ADD (Red + Blue) at (96,64) must produce bright Magenta (R > 190, B > 190, G < 30)',
      (AddPx.X > 190) and (AddPx.Z > 190) and (AddPx.Y < 30));

    RealDev.AssertZeroValidationErrors('Phase114.SkyboxCubemap3DTexAndMultiTex');
  finally
    FreeAndNil(ShotMulti);
    FreeAndNil(ShotCubeVol);
    FreeAndNil(ShotBg);
    FreeAndNil(MultiTexScene);
    FreeAndNil(CubeVolScene);
    FreeAndNil(FgScene);
    if Viewport <> nil then
      Viewport.Background := nil;
    FreeAndNil(Bg);
    FreeAndNil(Viewport);
    FreeAndNil(DepthTex);
    FreeAndNil(ColorTex);
    FreeAndNil(Container);
    FreeGlobalBatch2DRenderer;
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealLavapipeEnvironmentLightSplitSumIBL3DViewportRHI;

  function MakeFaceTex(const AColor: TVector4Byte): TPixelTextureNode;
  var
    Img: TRGBAlphaImage;
  begin
    Result := TPixelTextureNode.Create;
    Img := TRGBAlphaImage.Create(8, 8);
    Img.Clear(AColor);
    Result.FdImage.Value := Img;
  end;

var
  SavedBackend: TRenderBackend;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  RealDev: TVulkanRHIDevice;
  RealCmd: TVulkanRHICommandList;
  Container: TTestSizedVulkanContainer;
  ColorTex, DepthTex: TVulkanRHITexture;
  TexDesc: TRHITextureDesc;
  PassInfo: TRHIRenderingInfo;
  Viewport: TCastleViewport;
  Scene: TCastleScene;
  Root: TX3DRootNode;
  NavInfo: TNavigationInfoNode;
  EnvLight: TEnvironmentLightNode;
  EnvCube: TComposedCubeMapTextureNode;
  MetalTrans, RoughTrans: TTransformNode;
  MetalShape, RoughShape: TShapeNode;
  MetalApp, RoughApp: TAppearanceNode;
  MetalMat, RoughMat: TPhysicalMaterialNode;
  MetalSphere, RoughSphere: TSphereNode;
  ShotIBL, ShotDiag: TRGBAlphaImage;
  MetalUpperPx, MetalLowerPx, RoughCenterPx, DiagPx, Frame2Px, SoloRoughPx, SampleRightPx: TVector4Byte;
  DX, DY, LeftNonBg, RightNonBg, MaxNonBgX, MinRightX, MinRightY, MaxRightY, SampleRX, SampleRY: Integer;
  DiagIBL: String;
begin
  RealDev := nil;
  if not TVulkanRHIDevice.TryCreateOffscreen(RealDev, True) then
    Exit;

  SavedBackend := ApplicationProperties.RenderBackend;
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;
  Container := nil;
  ColorTex := nil;
  DepthTex := nil;
  Viewport := nil;
  Scene := nil;
  ShotIBL := nil;
  try
    GLFeatures := nil;
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(RealDev);
    RealDev.ResetValidationCounters;

    Container := TTestSizedVulkanContainer.Create(nil);
    Container.TestWidth := 128;
    Container.TestHeight := 128;
    RenderContext := Container.Context;
    RenderContext.Viewport := Rectangle(0, 0, 128, 128);

    TexDesc := TRHITextureDesc.Create2D(128, 128, pfRGBA8_UNorm,
      [tuColorAttachment, tuSampled, tuTransferSrc, tuTransferDst], 1);
    TexDesc.DebugName := 'Phase114IBLViewportColor';
    ColorTex := RealDev.CreateTexture(TexDesc) as TVulkanRHITexture;

    TexDesc := TRHITextureDesc.Create2D(128, 128, pfD32_Float,
      [tuDepthStencil, tuSampled, tuTransferSrc], 1);
    TexDesc.DebugName := 'Phase114IBLViewportDepth';
    DepthTex := RealDev.CreateTexture(TexDesc) as TVulkanRHITexture;

    Viewport := TCastleViewport.Create(nil);
    Viewport.FullSize := False;
    Viewport.Width := 128;
    Viewport.Height := 128;
    Viewport.BackgroundColor := Vector4(0.01, 0.01, 0.02, 1.0);
    Viewport.Camera.ProjectionType := ptOrthographic;
    Viewport.Camera.Orthographic.Width := 4.4;
    Viewport.Camera.Orthographic.Height := 3.2;
    Viewport.Camera.Orthographic.Origin := Vector2(0.5, 0.5);
    Viewport.Camera.SetView(
      Vector3(0.0, 0.0, 5.0),
      Vector3(0.0, 0.0, -1.0),
      Vector3(0.0, 1.0, 0.0));
    Container.Controls.InsertFront(Viewport);

    Root := TX3DRootNode.Create;

    { Disable headlight so 100% of scene illumination comes from TEnvironmentLightNode Split-Sum IBL! }
    NavInfo := TNavigationInfoNode.Create;
    NavInfo.Headlight := False;
    Root.AddChildren(NavInfo);

    EnvCube := TComposedCubeMapTextureNode.Create;
    EnvCube.Top    := MakeFaceTex(Vector4Byte(25, 200, 255, 255)); // +Y Sky: Bright Cyan-Blue
    EnvCube.Bottom := MakeFaceTex(Vector4Byte(255, 95, 20, 255));  // -Y Ground: Warm Amber-Orange
    EnvCube.Front  := MakeFaceTex(Vector4Byte(90, 95, 110, 255));
    EnvCube.Back   := MakeFaceTex(Vector4Byte(90, 95, 110, 255));
    EnvCube.Left   := MakeFaceTex(Vector4Byte(90, 95, 110, 255));
    EnvCube.Right  := MakeFaceTex(Vector4Byte(90, 95, 110, 255));

    EnvLight := TEnvironmentLightNode.Create;
    EnvLight.Global := True;
    EnvLight.Intensity := 1.4;
    EnvLight.SpecularTexture := EnvCube;
    Root.AddChildren(EnvLight);

    { Left: Mirror-Smooth Chrome Metallic Sphere (BaseColor=White, Metallic=1.0, Roughness=0.06) }
    MetalTrans := TTransformNode.Create;
    MetalTrans.Translation := Vector3(-1.05, 0.0, 0.0);
    MetalShape := TShapeNode.Create;
    MetalSphere := TSphereNode.Create;
    MetalSphere.Radius := 0.90;
    MetalSphere.Slices := 32;
    MetalSphere.Stacks := 32;
    MetalShape.Geometry := MetalSphere;
    MetalApp := TAppearanceNode.Create;
    MetalMat := TPhysicalMaterialNode.Create;
    MetalMat.BaseColor := Vector3(0.96, 0.96, 0.98);
    MetalMat.Metallic := 1.0;
    MetalMat.Roughness := 0.06;
    MetalApp.Material := MetalMat;
    MetalShape.Appearance := MetalApp;
    MetalTrans.AddChildren(MetalShape);
    Root.AddChildren(MetalTrans);

    { Right: Rough Dielectric Albedo Sphere (BaseColor=White, Metallic=0.0, Roughness=0.75) }
    RoughTrans := TTransformNode.Create;
    RoughTrans.Translation := Vector3(1.05, 0.0, 0.0);
    RoughShape := TShapeNode.Create;
    RoughSphere := TSphereNode.Create;
    RoughSphere.Radius := 0.90;
    RoughSphere.Slices := 32;
    RoughSphere.Stacks := 32;
    RoughShape.Geometry := RoughSphere;
    RoughApp := TAppearanceNode.Create;
    RoughMat := TPhysicalMaterialNode.Create;
    RoughMat.BaseColor := Vector3(0.92, 0.92, 0.92);
    RoughMat.Metallic := 0.0;
    RoughMat.Roughness := 0.75;
    RoughApp.Material := RoughMat;
    RoughShape.Appearance := RoughApp;
    RoughTrans.AddChildren(RoughShape);
    Root.AddChildren(RoughTrans);

    Scene := TCastleScene.Create(nil);
    Scene.Load(Root, True);
    {$warnings off}
    Viewport.Items.MainScene := Scene;
    {$warnings on}
    Viewport.Items.Add(Scene);

    RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
    SetActiveCommandList(RealCmd);
    Container.EventUpdate;
    Viewport.BeforeRender;
    PassInfo := TRHIRenderingInfo.CreateColorDepth(
      Rectangle(0, 0, 128, 128),
      ColorTex, loClear, Viewport.BackgroundColor,
      DepthTex, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);
    Viewport.Render;
    RealCmd.EndRendering;
    RealDev.EndOffscreenFrame;

    ShotIBL := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 128, 128));
    { Left sphere center X ~ 33, radius ~ 26px (x=33, upper hemisphere y=82 reflects +Y sky; lower hemisphere y=46 reflects -Y ground) }
    MetalUpperPx := ShotIBL.PixelPtr(33, 82)^;
    MetalLowerPx := ShotIBL.PixelPtr(33, 46)^;
    RoughCenterPx := ShotIBL.PixelPtr(95, 64)^;

    AssertTrue('Metallic sphere upper hemisphere (33,82) must reflect +Y cyan sky via Split-Sum IBL (B > R + 50, B > 120), got R=' +
      IntToStr(MetalUpperPx.X) + ' G=' + IntToStr(MetalUpperPx.Y) + ' B=' + IntToStr(MetalUpperPx.Z),
      (MetalUpperPx.Z > MetalUpperPx.X + 50) and (MetalUpperPx.Z > 120));
    AssertTrue('Metallic sphere lower hemisphere (33,46) must reflect -Y warm amber ground via Split-Sum IBL (R > B + 50, R > 120), got R=' +
      IntToStr(MetalLowerPx.X) + ' G=' + IntToStr(MetalLowerPx.Y) + ' B=' + IntToStr(MetalLowerPx.Z),
      (MetalLowerPx.X > MetalLowerPx.Z + 50) and (MetalLowerPx.X > 120));

    DiagIBL := '';
    if Integer(RoughCenterPx.X) + Integer(RoughCenterPx.Y) + Integer(RoughCenterPx.Z) <= 180 then
    begin
      LeftNonBg := 0;
      RightNonBg := 0;
      MaxNonBgX := -1;
      MinRightX := 999;
      MinRightY := 999;
      MaxRightY := -1;
      SampleRX := -1;
      SampleRY := -1;
      SampleRightPx := Vector4Byte(0, 0, 0, 0);
      for DY := 0 to 127 do
        for DX := 0 to 127 do
        begin
          DiagPx := ShotIBL.PixelPtr(DX, DY)^;
          if (DiagPx.X <> 3) or (DiagPx.Y <> 3) or (DiagPx.Z <> 5) then
          begin
            if DX < 64 then
              Inc(LeftNonBg)
            else
            begin
              Inc(RightNonBg);
              if DX < MinRightX then MinRightX := DX;
              if DY < MinRightY then MinRightY := DY;
              if DY > MaxRightY then MaxRightY := DY;
              if SampleRX < 0 then
              begin
                SampleRX := DX;
                SampleRY := DY;
                SampleRightPx := DiagPx;
              end;
            end;
            if DX > MaxNonBgX then MaxNonBgX := DX;
          end;
        end;

      { Frame 2 diagnostic: re-render with all GPU buffers/textures already uploaded }
      RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
      SetActiveCommandList(RealCmd);
      Viewport.BeforeRender;
      RealCmd.BeginRendering(PassInfo);
      Viewport.Render;
      RealCmd.EndRendering;
      RealDev.EndOffscreenFrame;
      ShotDiag := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 128, 128));
      try
        Frame2Px := ShotDiag.PixelPtr(95, 64)^;
      finally
        FreeAndNil(ShotDiag);
      end;

      { Solo RoughShape diagnostic: hide MetalShape so RoughShape is Draw #1 }
      MetalShape.Visible := False;
      RealCmd := RealDev.BeginOffscreenFrame as TVulkanRHICommandList;
      SetActiveCommandList(RealCmd);
      Viewport.BeforeRender;
      RealCmd.BeginRendering(PassInfo);
      Viewport.Render;
      RealCmd.EndRendering;
      RealDev.EndOffscreenFrame;
      ShotDiag := RealDev.GrabTextureImage(ColorTex, Rectangle(0, 0, 128, 128));
      try
        SoloRoughPx := ShotDiag.PixelPtr(95, 64)^;
      finally
        FreeAndNil(ShotDiag);
      end;
      MetalShape.Visible := True;

      DiagIBL := Format(
        ' leftNonBg=%d rightNonBg=%d rBox=(%d..%d,%d..%d) rSamp@(%d,%d)=(%d,%d,%d) frame2=(%d,%d,%d) soloRough=(%d,%d,%d) pipes=%d',
        [LeftNonBg, RightNonBg, MinRightX, MaxNonBgX, MinRightY, MaxRightY,
         SampleRX, SampleRY, SampleRightPx.X, SampleRightPx.Y, SampleRightPx.Z,
         Frame2Px.X, Frame2Px.Y, Frame2Px.Z,
         SoloRoughPx.X, SoloRoughPx.Y, SoloRoughPx.Z,
         RealDev.PipelineCount]);
    end;

    AssertTrue(Format(
      'Rough dielectric sphere (95,64) with zero punctual lights must receive non-black diffuse+specular IBL (R+G+B > 180), got R=%d G=%d B=%d [p33_64=(%d,%d,%d) draws=%d shapes=%d%s]',
      [RoughCenterPx.X, RoughCenterPx.Y, RoughCenterPx.Z,
       ShotIBL.PixelPtr(33, 64)^.X, ShotIBL.PixelPtr(33, 64)^.Y, ShotIBL.PixelPtr(33, 64)^.Z,
       Viewport.Statistics.ShapesRendered,
       Viewport.Statistics.ShapesVisible,
       DiagIBL]),
      Integer(RoughCenterPx.X) + Integer(RoughCenterPx.Y) + Integer(RoughCenterPx.Z) > 180);

    RealDev.AssertZeroValidationErrors('Phase114.EnvironmentLightSplitSumIBL3DViewport');
  finally
    FreeAndNil(ShotIBL);
    FreeAndNil(Scene);
    FreeAndNil(Viewport);
    FreeAndNil(DepthTex);
    FreeAndNil(ColorTex);
    FreeAndNil(Container);
    FreeGlobalBatch2DRenderer;
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestSharedDeviceMultiControlSwapchainSurfacesHeadlessAndSimulatedRHI;
var
  HeadlessDev: TVulkanRHIDevice;
  Surf1, Surf2, Surf3: TCastleVulkanSwapchainSurface;
  Cmd: TRHICommandList;
  PassInfo: TRHIRenderingInfo;
  Tick: Integer;
begin
  HeadlessDev := TVulkanRHIDevice.CreateHeadless(nil);
  Surf1 := nil;
  Surf2 := nil;
  Surf3 := nil;
  try
    AssertEquals('Initial SwapchainSurfaceCount = 0', Cardinal(0), HeadlessDev.SwapchainSurfaceCount);

    Surf1 := HeadlessDev.CreateSimulatedSwapchainSurface(
      160, 120, 2, pfBGRA8_UNorm, pfD24_UNorm_S8_UInt, 'EditorLeftControl');
    Surf2 := HeadlessDev.CreateSimulatedSwapchainSurface(
      200, 100, 3, pfRGBA8_UNorm, pfD32_Float, 'EditorCenterControl');
    Surf2.AntiAliasing := aa4SamplesFaster;
    Surf3 := HeadlessDev.CreateSimulatedSwapchainSurface(
      80, 80, 2, pfBGRA8_UNorm, pfD24_UNorm_S8_UInt, 'EditorInspectorPreview');

    AssertEquals('SwapchainSurfaceCount = 3', Cardinal(3), HeadlessDev.SwapchainSurfaceCount);
    AssertTrue('GetSwapchainSurface(0) = Surf1', HeadlessDev.GetSwapchainSurface(0) = Surf1);
    AssertTrue('GetSwapchainSurface(1) = Surf2', HeadlessDev.GetSwapchainSurface(1) = Surf2);
    AssertTrue('GetSwapchainSurface(2) = Surf3', HeadlessDev.GetSwapchainSurface(2) = Surf3);
    AssertEquals('Surf1 extent width = 160', Cardinal(160), Surf1.SwapchainExtent.width);
    AssertEquals('Surf1 extent height = 120', Cardinal(120), Surf1.SwapchainExtent.height);
    AssertEquals('Surf1 SampleCount = 1', Cardinal(1), Surf1.SampleCount);
    AssertTrue('Surf1 MSAAColorTexture must be nil when SampleCount = 1', Surf1.MSAAColorTexture = nil);
    AssertEquals('Surf2 extent width = 200', Cardinal(200), Surf2.SwapchainExtent.width);
    AssertEquals('Surf2 image count = 3', Cardinal(3), Surf2.SwapchainImageCount);
    AssertEquals('Surf2 SampleCount = 4', Cardinal(4), Surf2.SampleCount);
    AssertTrue('Surf2 MSAAColorTexture must be allocated for 4x MSAA', Surf2.MSAAColorTexture <> nil);
    AssertTrue('Surf2 MSAADepthTexture must be allocated for 4x MSAA', Surf2.MSAADepthTexture <> nil);

    { Render 3 interleaved UI ticks across all 3 simulated control swapchains (> MaxFramesInFlight = 2) }
    for Tick := 0 to 2 do
    begin
      Cmd := HeadlessDev.BeginSurfaceFrame(Surf1);
      AssertTrue('BeginSurfaceFrame(Surf1) must return active command list', Cmd <> nil);
      AssertTrue('ActiveSwapchainSurface must route to Surf1', HeadlessDev.ActiveSwapchainSurface = Surf1);
      AssertTrue('GetSwapchainColorTexture must route to Surf1 color target',
        HeadlessDev.GetSwapchainColorTexture = Surf1.GetCurrentColorTexture);
      PassInfo := Surf1.BuildRenderingInfo(Rectangle(0, 0, 160, 120), Vector4(0.1, 0.2, 0.4, 1.0));
      Cmd.BeginRendering(PassInfo);
      Cmd.EndRendering;
      HeadlessDev.EndSurfaceFrameAndPresent(Surf1);

      Cmd := HeadlessDev.BeginSurfaceFrame(Surf2);
      AssertTrue('BeginSurfaceFrame(Surf2) must return active command list', Cmd <> nil);
      AssertTrue('ActiveSwapchainSurface must route to Surf2', HeadlessDev.ActiveSwapchainSurface = Surf2);
      PassInfo := Surf2.BuildRenderingInfo(Rectangle(0, 0, 200, 100), Vector4(0.4, 0.1, 0.2, 1.0));
      AssertTrue('Surf2 4x MSAA BuildRenderingInfo must attach ResolveTexture',
        PassInfo.ColorAttachments[0].ResolveTexture = Surf2.GetCurrentColorTexture);
      Cmd.BeginRendering(PassInfo);
      AssertTrue('During active MSAA pass GetSwapchainColorTexture resolves to Surf2 swapchain image',
        HeadlessDev.GetSwapchainColorTexture = Surf2.GetCurrentColorTexture);
      Cmd.EndRendering;
      HeadlessDev.EndSurfaceFrameAndPresent(Surf2);

      Cmd := HeadlessDev.BeginSurfaceFrame(Surf3);
      AssertTrue('BeginSurfaceFrame(Surf3) must return active command list', Cmd <> nil);
      PassInfo := Surf3.BuildRenderingInfo(Rectangle(0, 0, 80, 80), Vector4(0.2, 0.4, 0.1, 1.0));
      Cmd.BeginRendering(PassInfo);
      Cmd.EndRendering;
      HeadlessDev.EndSurfaceFrameAndPresent(Surf3);
    end;

    AssertEquals('Surf1 FramesPresentedCount = 3', Cardinal(3), Surf1.FramesPresentedCount);
    AssertEquals('Surf2 FramesPresentedCount = 3', Cardinal(3), Surf2.FramesPresentedCount);
    AssertEquals('Surf3 FramesPresentedCount = 3', Cardinal(3), Surf3.FramesPresentedCount);
    AssertEquals('TotalFramesPresented = 9', Cardinal(9), HeadlessDev.TotalFramesPresented);

    { Test 0x0 minimize pause & live resize recovery on Surf1 }
    Surf1.Resize(0, 0);
    AssertTrue('Surf1 must mark SwapchainMinimized on 0x0 resize', Surf1.SwapchainMinimized);
    AssertTrue('BeginSurfaceFrame on minimized Surf1 must return nil without error',
      HeadlessDev.BeginSurfaceFrame(Surf1) = nil);
    Surf1.Resize(240, 160);
    AssertFalse('Surf1 SwapchainMinimized must clear on non-zero resize', Surf1.SwapchainMinimized);
    AssertEquals('Surf1 resized width = 240', Cardinal(240), Surf1.SwapchainExtent.width);
    AssertEquals('Surf1 resized height = 160', Cardinal(160), Surf1.SwapchainExtent.height);

    { Destroy active Surf2 mid-session while keeping Surf1 and Surf3 active on the shared device }
    HeadlessDev.ActiveSwapchainSurface := Surf2;
    HeadlessDev.DestroySwapchainSurface(Surf2);
    AssertTrue('DestroySwapchainSurface must nil Surf2 reference', Surf2 = nil);
    AssertEquals('SwapchainSurfaceCount must drop to 2', Cardinal(2), HeadlessDev.SwapchainSurfaceCount);
    AssertTrue('ActiveSwapchainSurface must remain valid after destroying Surf2',
      HeadlessDev.ActiveSwapchainSurface = Surf3);

    Cmd := HeadlessDev.BeginSurfaceFrame(Surf1);
    AssertTrue('Surf1 must continue rendering after sibling Surf2 is destroyed', Cmd <> nil);
    PassInfo := Surf1.BuildRenderingInfo(Rectangle(0, 0, 240, 160), Vector4(0.1, 0.2, 0.4, 1.0));
    Cmd.BeginRendering(PassInfo);
    Cmd.EndRendering;
    HeadlessDev.EndSurfaceFrameAndPresent(Surf1);
    AssertEquals('Surf1 FramesPresentedCount = 4', Cardinal(4), Surf1.FramesPresentedCount);
  finally
    HeadlessDev.DestroySwapchainSurface(Surf3);
    HeadlessDev.DestroySwapchainSurface(Surf2);
    HeadlessDev.DestroySwapchainSurface(Surf1);
    FreeAndNil(HeadlessDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealVulkanMultiControlHeadlessSurfacesSharedDevice3DAnd2DRHI;
var
  RealDev: TVulkanRHIDevice;
  Surf1, Surf2, Surf3: TCastleVulkanSwapchainSurface;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  Cont1, Cont2, Cont3: TTestSizedVulkanContainer;
  VP1, VP2, VP3: TCastleViewport;
  SharedScene: TCastleScene;
  Root: TX3DRootNode;
  DirLight: TDirectionalLightNode;
  Shape: TShapeNode;
  Sphere: TSphereNode;
  App: TAppearanceNode;
  Mat: TPhysicalMaterialNode;
  BadgeCpu: TRGBAlphaImage;
  SharedBadge: TDrawableImage;
  RealCmd: TVulkanRHICommandList;
  PassInfo: TRHIRenderingInfo;
  Shot1, Shot2, Shot3, Shot1Resized: TRGBAlphaImage;
  Tick: Integer;

  procedure RenderControlSurface(const ASurf: TCastleVulkanSwapchainSurface;
    const ACont: TTestSizedVulkanContainer; const AVP: TCastleViewport;
    const ADrawBadge: Boolean);
  var
    W, H: Integer;
    Area: TRectangle;
  begin
    W := Integer(ASurf.SwapchainExtent.width);
    H := Integer(ASurf.SwapchainExtent.height);
    ACont.TestWidth := W;
    ACont.TestHeight := H;
    RenderContext := ACont.Context;

    RealCmd := RealDev.BeginSurfaceFrame(ASurf) as TVulkanRHICommandList;
    AssertTrue('BeginSurfaceFrame must acquire swapchain image on ' + ASurf.DebugName, RealCmd <> nil);
    SetActiveCommandList(RealCmd);

    ACont.EventUpdate;
    AVP.BeforeRender;

    Area := Rectangle(0, 0, W, H);
    RenderContext.Viewport := Area;
    PassInfo := ASurf.BuildRenderingInfo(Area, AVP.BackgroundColor, loClear, loClear, 1.0);
    RealCmd.BeginRendering(PassInfo);
    RealCmd.SetViewport(FloatRectangle(Area), 0.0, 1.0);
    RealCmd.SetScissor(Area);

    AVP.Render;
    if ADrawBadge and (SharedBadge <> nil) then
    begin
      SharedBadge.Draw(FloatRectangle(6, 6, 24, 24));
      TDrawableImage.BatchingFlush;
    end;
    AVP.RenderOverChildren;
    RealCmd.EndRendering;
    RealDev.EndSurfaceFrameAndPresent(ASurf);
  end;

begin
  if not IsVulkanInstanceExtensionSupported(VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME) then
    Exit;

  RealDev := nil;
  if not TVulkanRHIDevice.TryCreateSharedWithWSI(RealDev, True, @CreateHeadlessSurfaceForTest) then
    Exit;

  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;
  Surf1 := nil;
  Surf2 := nil;
  Surf3 := nil;
  Cont1 := nil;
  Cont2 := nil;
  Cont3 := nil;
  VP1 := nil;
  VP2 := nil;
  VP3 := nil;
  SharedScene := nil;
  SharedBadge := nil;
  Shot1 := nil;
  Shot2 := nil;
  Shot3 := nil;
  Shot1Resized := nil;
  try
    GLFeatures := nil;
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(RealDev);

    { Attach 3 independent live VkSurfaceKHR + VkSwapchainKHR control surfaces to 1 shared TVulkanRHIDevice }
    Surf1 := RealDev.CreateSwapchainSurface(
      TVulkanNativeSurfaceDesc.CreateHeadless, 160, 120, 'ControlPane1_Front');
    Surf2 := RealDev.CreateSwapchainSurface(
      TVulkanNativeSurfaceDesc.CreateHeadless, 128, 128, 'ControlPane2_SideHUD');
    Surf3 := RealDev.CreateSwapchainSurface(
      TVulkanNativeSurfaceDesc.CreateHeadless, 96, 96, 'ControlPane3_Preview');

    AssertEquals('RealDev.SwapchainSurfaceCount = 3', Cardinal(3), RealDev.SwapchainSurfaceCount);
    AssertTrue('Surf1 SwapchainHandle valid', Surf1.SwapchainHandle <> VK_NULL_HANDLE);
    AssertTrue('Surf2 SwapchainHandle valid', Surf2.SwapchainHandle <> VK_NULL_HANDLE);
    AssertTrue('Surf3 SwapchainHandle valid', Surf3.SwapchainHandle <> VK_NULL_HANDLE);
    AssertTrue('All 3 VkSwapchainKHR handles are distinct',
      (Surf1.SwapchainHandle <> Surf2.SwapchainHandle) and
      (Surf2.SwapchainHandle <> Surf3.SwapchainHandle) and
      (Surf1.SwapchainHandle <> Surf3.SwapchainHandle));

    { Build one shared 3D PBR scene + one shared 2D TDrawableImage rendered across multiple controls }
    Root := TX3DRootNode.Create;
    DirLight := TDirectionalLightNode.Create;
    DirLight.Direction := Vector3(0.0, 0.0, -1.0);
    DirLight.Intensity := 2.4;
    Root.AddChildren(DirLight);

    Shape := TShapeNode.Create;
    Sphere := TSphereNode.Create;
    Sphere.Radius := 1.25;
    Sphere.Slices := 24;
    Sphere.Stacks := 24;
    Shape.Geometry := Sphere;
    App := TAppearanceNode.Create;
    Mat := TPhysicalMaterialNode.Create;
    Mat.BaseColor := Vector3(0.10, 0.95, 0.25); { Vivid Emerald Green }
    Mat.Roughness := 0.35;
    Mat.Metallic := 0.0;
    App.Material := Mat;
    Shape.Appearance := App;
    Root.AddChildren(Shape);

    SharedScene := TCastleScene.Create(nil);
    SharedScene.Load(Root, True);

    BadgeCpu := TRGBAlphaImage.Create(16, 16);
    BadgeCpu.Clear(Vector4Byte(255, 230, 20, 255)); { Bright Gold HUD Badge }
    SharedBadge := TDrawableImage.Create(BadgeCpu, True, True);

    Cont1 := TTestSizedVulkanContainer.Create(nil);
    VP1 := TCastleViewport.Create(nil);
    VP1.FullSize := True;
    VP1.BackgroundColor := Vector4(0.02, 0.05, 0.45, 1.0); { Deep Navy }
    Cont1.Controls.InsertFront(VP1);
    VP1.Items.Add(SharedScene);
    VP1.Camera.SetWorldView(Vector3(0, 0, 3.8), Vector3(0, 0, -1), Vector3(0, 1, 0));

    Cont2 := TTestSizedVulkanContainer.Create(nil);
    VP2 := TCastleViewport.Create(nil);
    VP2.FullSize := True;
    VP2.BackgroundColor := Vector4(0.45, 0.03, 0.05, 1.0); { Deep Crimson }
    Cont2.Controls.InsertFront(VP2);
    VP2.Items.Remove(VP2.Camera);
    VP2.Items := VP1.Items;
    VP1.Items.Add(VP2.Camera);
    VP2.Camera.SetWorldView(Vector3(0, 0, 3.8), Vector3(0, 0, -1), Vector3(0, 1, 0));

    Cont3 := TTestSizedVulkanContainer.Create(nil);
    VP3 := TCastleViewport.Create(nil);
    VP3.FullSize := True;
    VP3.BackgroundColor := Vector4(0.38, 0.28, 0.02, 1.0); { Warm Bronze }
    Cont3.Controls.InsertFront(VP3);
    VP3.Items.Remove(VP3.Camera);
    VP3.Items := VP1.Items;
    VP1.Items.Add(VP3.Camera);
    VP3.Camera.SetWorldView(Vector3(0, 0, 3.8), Vector3(0, 0, -1), Vector3(0, 1, 0));

    { Render 2 full ticks across all 3 live swapchains (6 submissions across 2 frame-in-flight slots) }
    for Tick := 0 to 1 do
    begin
      RenderControlSurface(Surf1, Cont1, VP1, False);
      if Tick = 1 then
        Shot1 := RealDev.GrabTextureImage(Surf1.GetCurrentColorTexture, Rectangle(0, 0, 160, 120));

      RenderControlSurface(Surf2, Cont2, VP2, True);
      if Tick = 1 then
        Shot2 := RealDev.GrabTextureImage(Surf2.GetCurrentColorTexture, Rectangle(0, 0, 128, 128));

      RenderControlSurface(Surf3, Cont3, VP3, False);
      if Tick = 1 then
        Shot3 := RealDev.GrabTextureImage(Surf3.GetCurrentColorTexture, Rectangle(0, 0, 96, 96));
    end;

    AssertEquals('Shot1 dimensions 160x120', 160, Shot1.Width);
    AssertEquals('Shot2 dimensions 128x128', 128, Shot2.Width);
    AssertEquals('Shot3 dimensions 96x96', 96, Shot3.Width);

    { Verify each control swapchain rendered its own background + the shared 3D PBR emerald sphere }
    AssertTrue('Control 1 center (80,60) emerald sphere G > 140', Shot1.PixelPtr(80, 60)^.Y > 140);
    AssertTrue('Control 1 corner (4,4) navy background B > R + 60',
      Shot1.PixelPtr(4, 4)^.Z > Shot1.PixelPtr(4, 4)^.X + 60);

    AssertTrue('Control 2 center (64,64) emerald sphere G > 140', Shot2.PixelPtr(64, 64)^.Y > 140);
    AssertTrue('Control 2 top-right corner (120,120) crimson background R > B + 60',
      Shot2.PixelPtr(120, 120)^.X > Shot2.PixelPtr(120, 120)^.Z + 60);
    AssertTrue('Control 2 bottom-left (14,14) 2D gold HUD badge R > 200 and G > 180',
      (Shot2.PixelPtr(14, 14)^.X > 200) and (Shot2.PixelPtr(14, 14)^.Y > 180));

    AssertTrue('Control 3 center (48,48) emerald sphere G > 140', Shot3.PixelPtr(48, 48)^.Y > 140);
    AssertTrue('Control 3 corner (4,4) bronze background R > B + 40',
      Shot3.PixelPtr(4, 4)^.X > Shot3.PixelPtr(4, 4)^.Z + 40);

    { Resize Control 1 live (160x120 -> 208x144) AND close Control 2 mid-session }
    Surf1.Resize(208, 144);
    RealDev.DestroySwapchainSurface(Surf2);
    AssertTrue('Surf2 destroyed cleanly', Surf2 = nil);
    AssertEquals('Remaining SwapchainSurfaceCount = 2', Cardinal(2), RealDev.SwapchainSurfaceCount);

    { Continue rendering remaining Controls 1 & 3 using shared GPU scene }
    RenderControlSurface(Surf1, Cont1, VP1, False);
    Shot1Resized := RealDev.GrabTextureImage(Surf1.GetCurrentColorTexture, Rectangle(0, 0, 208, 144));
    RenderControlSurface(Surf3, Cont3, VP3, False);

    AssertEquals('Resized Shot1 width = 208', 208, Shot1Resized.Width);
    AssertEquals('Resized Shot1 height = 144', 144, Shot1Resized.Height);
    AssertTrue('Resized Control 1 center (104,72) shared emerald sphere still renders G > 140',
      Shot1Resized.PixelPtr(104, 72)^.Y > 140);

    RealDev.AssertZeroValidationErrors('Phase115.MultiControlHeadlessSurfacesSharedDevice');
  finally
    FreeAndNil(Shot1Resized);
    FreeAndNil(Shot3);
    FreeAndNil(Shot2);
    FreeAndNil(Shot1);
    FreeAndNil(VP3);
    FreeAndNil(VP2);
    if VP1 <> nil then VP1.Items.Remove(SharedScene);
    FreeAndNil(SharedBadge);
    FreeAndNil(SharedScene);
    FreeAndNil(VP1);
    FreeAndNil(Cont3);
    FreeAndNil(Cont2);
    FreeAndNil(Cont1);
    FreeGlobalBatch2DRenderer;
    RealDev.DestroySwapchainSurface(Surf3);
    RealDev.DestroySwapchainSurface(Surf2);
    RealDev.DestroySwapchainSurface(Surf1);
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(RealDev);
  end;
end;

procedure TTestCastleVulkanRHI.TestRealX11MultiChildWidgetSurfacesSharedVulkanDevicePresentAndResizeRHI;
{$if defined(UNIX) and not defined(DARWIN) and not defined(ANDROID)}
var
  XDisp: PDisplay;
  ScreenNum: Integer;
  RootWin, ParentFormWin, LeftChildWin, RightChildWin: TWindow;
  RealDev: TVulkanRHIDevice;
  LeftSurf, RightSurf: TCastleVulkanSwapchainSurface;
  SavedRHI: TRHIDevice;
  SavedCmd: TRHICommandList;
  SavedBackend: TRenderBackend;
  SavedCtx: TRenderContext;
  SavedGLFeatures: TGLFeatures;
  LeftCont, RightCont: TTestSizedVulkanContainer;
  LeftVP, RightVP: TCastleViewport;
  LeftScene, RightScene: TCastleScene;
  ShotLeft, ShotRight, ShotLeftResized: TRGBAlphaImage;
  Tick: Integer;

  function BuildColoredBoxScene(const ABaseColor: TVector3): TCastleScene;
  var
    Root: TX3DRootNode;
    DirLight: TDirectionalLightNode;
    Shape: TShapeNode;
    Box: TBoxNode;
    App: TAppearanceNode;
    Mat: TPhysicalMaterialNode;
  begin
    Root := TX3DRootNode.Create;
    DirLight := TDirectionalLightNode.Create;
    DirLight.Direction := Vector3(0.0, 0.0, -1.0);
    DirLight.Intensity := 2.2;
    Root.AddChildren(DirLight);

    Shape := TShapeNode.Create;
    Box := TBoxNode.Create;
    Box.Size := Vector3(2.2, 2.2, 0.6);
    Shape.Geometry := Box;
    App := TAppearanceNode.Create;
    Mat := TPhysicalMaterialNode.Create;
    Mat.BaseColor := ABaseColor;
    Mat.Roughness := 0.4;
    Mat.Metallic := 0.0;
    App.Material := Mat;
    Shape.Appearance := App;
    Root.AddChildren(Shape);

    Result := TCastleScene.Create(nil);
    Result.Load(Root, True);
  end;

  procedure RenderChildPane(const ASurf: TCastleVulkanSwapchainSurface;
    const ACont: TTestSizedVulkanContainer; const AVP: TCastleViewport);
  var
    W, H: Integer;
    Area: TRectangle;
    Cmd: TVulkanRHICommandList;
    PassInfo: TRHIRenderingInfo;
  begin
    W := Integer(ASurf.SwapchainExtent.width);
    H := Integer(ASurf.SwapchainExtent.height);
    ACont.TestWidth := W;
    ACont.TestHeight := H;
    RenderContext := ACont.Context;

    Cmd := RealDev.BeginSurfaceFrame(ASurf) as TVulkanRHICommandList;
    AssertTrue('BeginSurfaceFrame must succeed on X11 child window ' + ASurf.DebugName, Cmd <> nil);
    SetActiveCommandList(Cmd);

    ACont.EventUpdate;
    AVP.BeforeRender;

    Area := Rectangle(0, 0, W, H);
    RenderContext.Viewport := Area;
    PassInfo := ASurf.BuildRenderingInfo(Area, AVP.BackgroundColor, loClear, loClear, 1.0);
    Cmd.BeginRendering(PassInfo);
    Cmd.SetViewport(FloatRectangle(Area), 0.0, 1.0);
    Cmd.SetScissor(Area);
    AVP.Render;
    AVP.RenderOverChildren;
    Cmd.EndRendering;
    RealDev.EndSurfaceFrameAndPresent(ASurf);
  end;

begin
  if GetEnvironmentVariable('DISPLAY') = '' then
    Exit;
  if not IsVulkanInstanceExtensionSupported(VK_KHR_XLIB_SURFACE_EXTENSION_NAME) then
    Exit;

  XDisp := XOpenDisplay(nil);
  if XDisp = nil then
    Exit;

  ParentFormWin := 0;
  LeftChildWin := 0;
  RightChildWin := 0;
  RealDev := nil;
  LeftSurf := nil;
  RightSurf := nil;
  LeftCont := nil;
  RightCont := nil;
  LeftVP := nil;
  RightVP := nil;
  LeftScene := nil;
  RightScene := nil;
  ShotLeft := nil;
  ShotRight := nil;
  ShotLeftResized := nil;
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
  SavedBackend := ApplicationProperties.RenderBackend;
  SavedCtx := RenderContext;
  SavedGLFeatures := GLFeatures;
  try
    ScreenNum := DefaultScreen(XDisp);
    RootWin := RootWindow(XDisp, ScreenNum);

    { Create top-level parent form XWindow + 2 native child widget sub-windows (like 2 TCastleControls on a form) }
    ParentFormWin := XCreateSimpleWindow(XDisp, RootWin, 0, 0, 320, 160, 0,
      BlackPixel(XDisp, ScreenNum), BlackPixel(XDisp, ScreenNum));
    LeftChildWin := XCreateSimpleWindow(XDisp, ParentFormWin, 4, 8, 144, 120, 0,
      BlackPixel(XDisp, ScreenNum), BlackPixel(XDisp, ScreenNum));
    RightChildWin := XCreateSimpleWindow(XDisp, ParentFormWin, 164, 8, 144, 120, 0,
      BlackPixel(XDisp, ScreenNum), BlackPixel(XDisp, ScreenNum));
    XMapWindow(XDisp, LeftChildWin);
    XMapWindow(XDisp, RightChildWin);
    XMapWindow(XDisp, ParentFormWin);
    XSync(XDisp, False);

    if not TVulkanRHIDevice.TryCreateSharedWithWSI(RealDev, True) then
      Exit;

    GLFeatures := nil;
    ApplicationProperties.RenderBackend := backendVulkan;
    SetRHIDevice(RealDev);

    LeftSurf := RealDev.CreateSwapchainSurface(
      TVulkanNativeSurfaceDesc.CreateXlib(PVkXlibDisplay(XDisp), VkXlibWindow(LeftChildWin)),
      144, 120, 'X11LeftChildControl');
    RightSurf := RealDev.CreateSwapchainSurface(
      TVulkanNativeSurfaceDesc.CreateXlib(PVkXlibDisplay(XDisp), VkXlibWindow(RightChildWin)),
      144, 120, 'X11RightChildControl');

    AssertEquals('Shared X11 SwapchainSurfaceCount = 2', Cardinal(2), RealDev.SwapchainSurfaceCount);
    AssertEquals('LeftSurf extent 144x120', Cardinal(144), LeftSurf.SwapchainExtent.width);
    AssertEquals('RightSurf extent 144x120', Cardinal(144), RightSurf.SwapchainExtent.width);

    LeftScene := BuildColoredBoxScene(Vector3(1.0, 0.20, 0.05)); { Orange-Red box }
    RightScene := BuildColoredBoxScene(Vector3(0.10, 0.75, 1.0)); { Cyan-Blue box }

    LeftCont := TTestSizedVulkanContainer.Create(nil);
    LeftVP := TCastleViewport.Create(nil);
    LeftVP.FullSize := True;
    LeftVP.BackgroundColor := Vector4(0.02, 0.04, 0.25, 1.0);
    LeftCont.Controls.InsertFront(LeftVP);
    LeftVP.Items.Add(LeftScene);
    LeftVP.Camera.SetWorldView(Vector3(0, 0, 4.2), Vector3(0, 0, -1), Vector3(0, 1, 0));

    RightCont := TTestSizedVulkanContainer.Create(nil);
    RightVP := TCastleViewport.Create(nil);
    RightVP.FullSize := True;
    RightVP.BackgroundColor := Vector4(0.18, 0.04, 0.22, 1.0);
    RightCont.Controls.InsertFront(RightVP);
    RightVP.Items.Add(RightScene);
    RightVP.Camera.SetWorldView(Vector3(0, 0, 4.2), Vector3(0, 0, -1), Vector3(0, 1, 0));

    for Tick := 0 to 2 do
    begin
      RenderChildPane(LeftSurf, LeftCont, LeftVP);
      if Tick = 2 then
        ShotLeft := RealDev.GrabTextureImage(LeftSurf.GetCurrentColorTexture, Rectangle(0, 0, 144, 120));

      RenderChildPane(RightSurf, RightCont, RightVP);
      if Tick = 2 then
        ShotRight := RealDev.GrabTextureImage(RightSurf.GetCurrentColorTexture, Rectangle(0, 0, 144, 120));
    end;
    XSync(XDisp, False);

    AssertTrue('Left X11 child pane center (72,60) orange-red box R > B + 80',
      ShotLeft.PixelPtr(72, 60)^.X > ShotLeft.PixelPtr(72, 60)^.Z + 80);
    AssertTrue('Right X11 child pane center (72,60) cyan-blue box B > R + 80',
      ShotRight.PixelPtr(72, 60)^.Z > ShotRight.PixelPtr(72, 60)^.X + 80);

    { Live XResizeWindow on LeftChildWin (144x120 -> 176x136) + swapchain recreation }
    XResizeWindow(XDisp, LeftChildWin, 176, 136);
    XSync(XDisp, False);
    LeftSurf.Resize(176, 136);
    AssertEquals('Resized LeftSurf X11 swapchain width = 176', Cardinal(176), LeftSurf.SwapchainExtent.width);
    AssertEquals('Resized LeftSurf X11 swapchain height = 136', Cardinal(136), LeftSurf.SwapchainExtent.height);

    for Tick := 0 to 1 do
    begin
      RenderChildPane(LeftSurf, LeftCont, LeftVP);
      RenderChildPane(RightSurf, RightCont, RightVP);
    end;
    ShotLeftResized := RealDev.GrabTextureImage(LeftSurf.GetCurrentColorTexture, Rectangle(0, 0, 176, 136));
    AssertTrue('Resized Left X11 child pane center (88,68) orange-red box R > B + 80',
      ShotLeftResized.PixelPtr(88, 68)^.X > ShotLeftResized.PixelPtr(88, 68)^.Z + 80);

    { Close RightSurf child control first while LeftSurf continues presenting }
    RealDev.DestroySwapchainSurface(RightSurf);
    RenderChildPane(LeftSurf, LeftCont, LeftVP);
    XSync(XDisp, False);

    RealDev.AssertZeroValidationErrors('Phase115.X11MultiChildWidgetSurfaces');
  finally
    FreeAndNil(ShotLeftResized);
    FreeAndNil(ShotRight);
    FreeAndNil(ShotLeft);
    FreeAndNil(RightScene);
    FreeAndNil(LeftScene);
    FreeAndNil(RightVP);
    FreeAndNil(LeftVP);
    FreeAndNil(RightCont);
    FreeAndNil(LeftCont);
    FreeGlobalBatch2DRenderer;
    if RealDev <> nil then
    begin
      RealDev.DestroySwapchainSurface(RightSurf);
      RealDev.DestroySwapchainSurface(LeftSurf);
    end;
    GLFeatures := SavedGLFeatures;
    RenderContext := SavedCtx;
    SetActiveCommandList(SavedCmd);
    SetRHIDevice(SavedRHI);
    ApplicationProperties.RenderBackend := SavedBackend;
    FreeAndNil(RealDev);
    if RightChildWin <> 0 then
      XDestroyWindow(XDisp, RightChildWin);
    if LeftChildWin <> 0 then
      XDestroyWindow(XDisp, LeftChildWin);
    if ParentFormWin <> 0 then
      XDestroyWindow(XDisp, ParentFormWin);
    XSync(XDisp, False);
    XCloseDisplay(XDisp);
  end;
{$else}
begin
  { Non-X11 target OS }
{$endif}
end;

