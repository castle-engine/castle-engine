  if instance = nil then;
  if pAllocator = nil then;
  GMockLastSurfaceCreateInfoSType := pCreateInfo^.sType;
  GMockLastWin32HInstance := pCreateInfo^.hinstance;
  GMockLastWin32HWND := pCreateInfo^.hwnd;
  pSurface^ := VkSurfaceKHR($A001);
  Result := VK_SUCCESS;
