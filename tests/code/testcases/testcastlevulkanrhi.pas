  Wait60Hz := TCastleVulkanFramePacer.EvaluateFramePacingWaitMicroseconds(60.0, 10.0, 250.0);
  WaitOverBudget := TCastleVulkanFramePacer.EvaluateFramePacingWaitMicroseconds(60.0, 20.0, 250.0);
