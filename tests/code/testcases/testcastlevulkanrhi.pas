  Side: Integer;
begin
  Device := TVulkanRHIDevice.CreateHeadless(VkPhysicalDevice(PtrUInt($7402)));
  Device.ResizeSwapchain(256, 256);
  SavedRHI := RHIDevice;
  SavedCmd := ActiveCommandList;
