  Gen: TCastleShaderGeneratorRHI;
  GlassGLSL: String;
  Src0, Src1: TVector3;
begin
  Gen := TCastleShaderGeneratorRHI.Create(rbVulkan);
  try
    { 1. Verify Dual-Source Colored Glass GLSL 450 functions }
    GlassGLSL := Gen.GenerateDualSourceGlassTransmissionFunctions;
