<?xml version="1.0" encoding="utf-8"?>

<!--
Specify basic information about the project, including how this project is build.
See https://castle-engine.io/project_manifest for documentation of this file.
-->

<project name="castle-tester"
  standalone_source="castle_tester_standalone.dpr"
  game_units="GameInitialize, TestCases"
  qualified_name="io.castleengine.castletester"
  caption="Castle Tester"
>
  <compiler_options detect_memory_leaks="true">
    <search_paths>
      <path value="code/" />
      <path value="code/testcases/" />
      <path value="code/tester-castle/" />
      <path value="../tools/common-code/" />

      <!--
        Define this path only temporarily (do not commit),
        to test that our FpJson and friends (JsonScanner, JsonReader)
        compile with FPC. This is useful just to test
        they compile/work, on machines where FPC is available but not Delphi.

        In normal usage, this path should remain commented out,
        as with FPC we use FPC's built-in FpJson and friends.
        This path should only be used with Delphi (and our build tool
        already passes this path when building with Delphi).
      -->
      <!-- <path value="../src/compatibility/delphi-only/fcl-json/" /> -->
    </search_paths>
    <custom_options>
      <!--
        Hide warnings about deprecated stuff.
        In tests, we often deliberately test deprecated API, to make sure it still works.
      -->
      <option>-vm5043</option> <!-- Symbol "$1" is deprecated -->
      <option>-vm5066</option> <!-- Symbol "$1" is deprecated: "$2" -->
      <option>-vm5074</option> <!-- Unit "$1" is deprecated -->
      <option>-vm5075</option> <!-- Unit "$1" is deprecated: "$2" -->
    </custom_options>
    <defines>
      <define>CASTLE_STRICT</define>

      <!--
        See ../doc/miscellaneous_notes/ansistring_encoding.md
        about the 2 symbols below.

        The scary symbol I_UNDERSTAND_THAT_NON_ASCII_CHARACTERS_ARE_BROKEN
        is needed to make CASTLE_ANSISTRING_UNCHANGED compile with FPC,
        and yes, in effect non-ASCII characters are broken in some cases.
        See above mentioned document for details.
      -->
      <!--define>CASTLE_ANSISTRING_UNCHANGED</define-->
      <!--define>I_UNDERSTAND_THAT_NON_ASCII_CHARACTERS_ARE_BROKEN</define-->
    </defines>
  </compiler_options>
</project>
