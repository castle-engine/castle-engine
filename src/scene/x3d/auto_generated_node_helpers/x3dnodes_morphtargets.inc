{$ifdef read_interface}

  public
    { Create node fields and events. }
    procedure CreateNode; override;
    class function ClassX3DType: String; override;

    strict private FFdWeights: TMFFloat;
    { Internal wrapper for property @code(Weights). This wrapper API may change, we advise to access simpler @code(Weights) instead, if it is defined (TODO: for now, some field types do not have a simpler counterpart). }
    public property FdWeights: TMFFloat read FFdWeights;
    { Weights for each morph target in @link(FdTargets), in the range [0,1]. }
    procedure SetWeights(const Value: array of Single); overload;
    { Weights for each morph target in @link(FdTargets), in the range [0,1]. }
    procedure SetWeights(const Value: TSingleList); overload;

    strict private FFdTargets: TMFNode;
    { Internal wrapper for property @code(Targets). This wrapper API may change, we advise to access simpler @code(Targets) instead, if it is defined (TODO: for now, some field types do not have a simpler counterpart). }
    public property FdTargets: TMFNode read FFdTargets;
    { Morph targets, applied with the corresponding weights in @link(FdWeights). }
    procedure SetTargets(const Value: array of TMorphTargetNode);

{$endif read_interface}

{$ifdef read_implementation}

{ TMorphTargetsNode ----------------------------------------------- }

procedure TMorphTargetsNode.SetWeights(const Value: array of Single);
begin
  FdWeights.Send(Value);
end;

procedure TMorphTargetsNode.SetWeights(const Value: TSingleList);
begin
  FdWeights.Send(Value);
end;

procedure TMorphTargetsNode.SetTargets(const Value: array of TMorphTargetNode);
var
  L: Integer;
  A: array of TX3DNode;
begin
  L := High(Value) + 1;
  SetLength(A, L);
  if L > 0 then
    Move(Value[0], A[0], L * SizeOf(TMorphTargetNode));
  FdTargets.Send(A);
end;

class function TMorphTargetsNode.ClassX3DType: String;
begin
  Result := 'MorphTargets';
end;

procedure TMorphTargetsNode.CreateNode;
begin
  inherited;

  FFdWeights := TMFFloat.Create(Self, True, 'weights', []);
   FdWeights.ChangeAlways := chVisibleNonGeometry;
  AddField(FFdWeights);

  FFdTargets := TMFNode.Create(Self, True, 'targets', [TMorphTargetNode]);
   FdTargets.ChangeAlways := chVisibleNonGeometry;
  AddField(FFdTargets);

  DefaultContainerField := 'targets';
end;

{$endif read_implementation}
