function VK_VERSION_MINOR(const Version: Cardinal): Cardinal; inline;
function VK_VERSION_PATCH(const Version: Cardinal): Cardinal; inline;

{ Loads the Vulkan shared library dynamically. Returns True if successfully loaded. }
function LoadVulkan: Boolean;
{ Reloads MoltenVK ICD directly on Apple platforms when the Vulkan loader cannot locate an ICD JSON. }
function LoadVulkanDirectMoltenVKFallback: Boolean;
{ Populates instance-level function pointers using vkGetInstanceProcAddr. }
procedure LoadVulkanInstance(const Instance: VkInstance);
{ Populates device-level function pointers using vkGetDeviceProcAddr. }
procedure LoadVulkanDevice(const Device: VkDevice);
{ Unloads instance- and device-scoped function pointers when Instance is destroyed. }
procedure UnloadVulkanInstance(const Instance: VkInstance);
{ Unloads the Vulkan library. }
procedure FreeVulkan;
{ Returns True if Vulkan library is currently loaded. }
function IsVulkanLoaded: Boolean;
{ Returns True if a live VkInstance dispatch table is currently loaded. }
function IsVulkanInstanceLoaded: Boolean;

implementation

var
  VulkanLibrary: TDynLib = nil;
  LoadedVulkanInstance: VkInstance = nil;

function VK_MAKE_VERSION(const Major, Minor, Patch: Cardinal): Cardinal;
begin
  Result := (Major shl 22) or (Minor shl 12) or (Patch and $FFF);
end;

function VK_VERSION_MAJOR(const Version: Cardinal): Cardinal;
begin
  Result := (Version shr 22) and $7F;
end;

function VK_VERSION_MINOR(const Version: Cardinal): Cardinal;
begin
  Result := (Version shr 12) and $3FF;
end;

function VK_VERSION_PATCH(const Version: Cardinal): Cardinal;
begin
  Result := Version and $FFF;
end;

function IsVulkanLoaded: Boolean;
begin
  Result := VulkanLibrary <> nil;
end;

function IsVulkanInstanceLoaded: Boolean;
begin
  Result := LoadedVulkanInstance <> nil;
end;

function LoadVulkanFromLibraryNames(const ALibNames: array of String): Boolean;
var
  I: Integer;
begin
  for I := Low(ALibNames) to High(ALibNames) do
  begin
    if ALibNames[I] = '' then
      Continue;
    try
      VulkanLibrary := TDynLib.Load(ALibNames[I], false);
      if VulkanLibrary <> nil then
        Break;
    except
      VulkanLibrary := nil;
    end;
  end;

  if VulkanLibrary = nil then
    Exit(False);

  Pointer(vkGetInstanceProcAddr) := VulkanLibrary.Symbol('vkGetInstanceProcAddr');
  if not Assigned(vkGetInstanceProcAddr) then
  begin
    WritelnLog('Vulkan', 'vkGetInstanceProcAddr not exported by Vulkan library');
    FreeAndNil(VulkanLibrary);
    Exit(False);
  end;

  Pointer(vkCreateInstance) := vkGetInstanceProcAddr(nil, 'vkCreateInstance');
  Pointer(vkEnumerateInstanceExtensionProperties) := vkGetInstanceProcAddr(nil, 'vkEnumerateInstanceExtensionProperties');
  Pointer(vkEnumerateInstanceLayerProperties) := vkGetInstanceProcAddr(nil, 'vkEnumerateInstanceLayerProperties');
  Pointer(vkEnumerateInstanceVersion) := vkGetInstanceProcAddr(nil, 'vkEnumerateInstanceVersion');
  Result := True;
end;

function LoadVulkan: Boolean;
const
  {$if defined(MSWINDOWS)}
  VulkanLibNames: array[0..0] of String = ('vulkan-1.dll');
  {$elseif defined(DARWIN)}
  VulkanLibNames: array[0..6] of String = (
    'libvulkan.1.dylib',
    '/opt/homebrew/lib/libvulkan.1.dylib',
    '/usr/local/lib/libvulkan.1.dylib',
    'libMoltenVK.dylib',
    '/opt/homebrew/lib/libMoltenVK.dylib',
    '/usr/local/lib/libMoltenVK.dylib',
    'libvulkan.dylib'
  );
  {$elseif defined(ANDROID)}
  VulkanLibNames: array[0..1] of String = (
    'libvulkan.so',
    'libvulkan.so.1'
  );
  {$else}
  VulkanLibNames: array[0..2] of String = (
    'libvulkan.so.1',
    'libvulkan.so',
    'libvulkan.so.0'
  );
  {$endif}
var
  CustomLib: String;
begin
  if VulkanLibrary <> nil then
    Exit(True);

  CustomLib := Trim(GetEnvironmentVariable('CASTLE_VULKAN_LIBRARY'));
  if CustomLib <> '' then
  begin
    if LoadVulkanFromLibraryNames([CustomLib]) then
      Exit(True);
    WritelnLog('Vulkan', 'CASTLE_VULKAN_LIBRARY="%s" could not be loaded; falling back to default Vulkan library search', [CustomLib]);
  end;

  if not LoadVulkanFromLibraryNames(VulkanLibNames) then
  begin
    WritelnLog('Vulkan', 'Could not locate Vulkan dynamic library');
    Exit(False);
  end;

  Result := True;
end;

function LoadVulkanDirectMoltenVKFallback: Boolean;
{$if defined(DARWIN)}
const
  MoltenVKLibNames: array[0..2] of String = (
    'libMoltenVK.dylib',
    '/opt/homebrew/lib/libMoltenVK.dylib',
    '/usr/local/lib/libMoltenVK.dylib'
  );
begin
  FreeVulkan;
  Result := LoadVulkanFromLibraryNames(MoltenVKLibNames);
end;
{$else}
begin
  Result := False;
end;
{$endif}

