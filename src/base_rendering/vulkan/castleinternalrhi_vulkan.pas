    Bindings[2].Binding := 2;
    Bindings[2].DescriptorType := dtCombinedImageSampler;
    Bindings[2].Count := 1;
    Bindings[2].StageFlags := [ssCompute];

    Bindings[3].Binding := 3;
    Bindings[3].DescriptorType := dtStorageImage;
    Bindings[3].Count := 1;
