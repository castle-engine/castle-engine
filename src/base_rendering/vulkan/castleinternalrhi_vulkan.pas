constructor TCastleVulkanHiZPyramidGenerator.Create(const ADevice: TVulkanRHIDevice);
begin
  inherited Create;
  FDevice := ADevice;
  FHiZPyramidTexture := nil;
  FMipLevelCount := 0;
  FBuildDispatchCount := 0;
  FDownsampleComputePipeline := nil;
end;

